	PackSize: { Min: number, Max: number }?,
	TerritoryRadius: number?,
	ActiveDuring: "Night" | "Day" | "Always",
	Loot: { LootEntry },
	BakedAttackAnimName: string?,
	StatsKey: string?,
}

return {
	Bunny = {
