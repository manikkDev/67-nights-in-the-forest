		Tier = "Solitary",
		RigStyle = "Procedural",
		WalkSpeed = 9,
		RunSpeed = 20,
		MaxHealth = 220,
		AttackDamage = 30,
		AttackRange = 8,
		AttackCooldown = 1.8,
		AggroRange = 26,
		LoseAggroRange = 42,
