          <Item class="ModuleScript" referent="125">
            <Properties>
              <string name="Name">GameStateController</string>
              <string name="Source"><![CDATA[--[[
    @file    GameStateController.luau
    @author  manik
    @date    2025

    @summary
    Tracks whether the local player has entered the actual game.

    @description
    Follows MatchFlowService states. GameStarted fires only after the
    Day 1 intro card finishes, so HUD/tools stay gated through waiting
    and the teleport fade.

    @exports
    - GameStateController.GameStarted  -> Signal
    - GameStateController:IsInGame()   -> boolean
    - GameStateController:GetState()   -> string
    - GameStateController:MarkIntroComplete()
]]

-- // VARIABLES // --

-- | Services | --
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local Signal = require(ReplicatedStorage.Packages.Signal)

-- | Objects | --
local GameStateController = Knit.CreateController({
	Name = "GameStateController",
})

export type FlowState = "Lobby" | "Waiting" | "Countdown" | "Story" | "Day1" | "InGame"

-- | State Management | --
local flowState: FlowState = "Lobby"
local isInGame = false
local gameStartedSignal: any = nil

-- // FUNCTIONS // --

--[[
    @summary  Returns true once the player has teleported to the game map.
    @returns  boolean
]]
function GameStateController:IsInGame(): boolean
	return isInGame
end

function GameStateController:GetState(): FlowState
	return flowState
end

--[[
    @summary  Unlock gameplay after the Day 1 card fades out.
]]
function GameStateController:MarkIntroComplete()
	if isInGame then
		return
	end
	flowState = "InGame"
	isInGame = true
	if gameStartedSignal then
		gameStartedSignal:Fire()
	end
end

-- // INITIALIZATION // --

function GameStateController:KnitInit()
	gameStartedSignal = Signal.new()
	GameStateController.GameStarted = gameStartedSignal
end

function GameStateController:KnitStart()
	local matchFlow = Knit.GetService("MatchFlowService")

	matchFlow.FlowStateChanged:Connect(function(state: string)
		if state == "Lobby" or state == "Waiting" or state == "Countdown" or state == "Story" or state == "Day1" then
			flowState = state
			if state == "Lobby" then
				isInGame = false
			end
		elseif state == "InGame" then
			flowState = "Day1"
			-- Safety net: if IntroController is not present or already destroyed,
			-- mark intro complete so tools/HUD are unlocked.
			if not isInGame then
				task.wait(3)
				if not isInGame then
					GameStateController:MarkIntroComplete()
				end
			end
		end
	end)

end

return GameStateController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="126">
            <Properties>
              <string name="Name">HarvestController</string>
              <string name="Source"><![CDATA[--[[
    @file    HarvestController.luau
    @author  manik
    @date    2025

    @summary
    Client-side axe tool handling, swing animation, and chop feedback.

    @description
    Listens for Tool.Activated on the locally-equipped Axe to trigger
    a swing animation and fire the server's RequestChop remote.  Also
    listens for the server's TreeChopped signal and applies a short
    procedural camera shake via Humanoid.CameraOffset.

    @exports
    - HarvestController (Knit Controller)
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local Janitor = require(ReplicatedStorage.Packages.Janitor)

-- | Objects | --
local HarvestController = Knit.CreateController({
	Name = "HarvestController",
})

-- | Configuration | --
local SHAKE_DURATION = 0.15
local SHAKE_MAGNITUDE = 0.12
local AXE_TOOL_NAME = "Axe"
local CHOP_COOLDOWN = 0.5

-- | State Management | --
local janitor = Janitor.new()
local toolJanitor = Janitor.new()
local charJanitor = Janitor.new()
local lastChopTime = 0
local swingAnimationId: string? = nil
local cachedAnimTrack: AnimationTrack? = nil
local gameStateController: any = nil

-- // FUNCTIONS // --

--[[
    @summary  Apply a brief decaying random offset to the local
              character's camera to sell a chop impact.
]]
local function shakeCamera()
	task.spawn(function()
		local character = Players.LocalPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			return
		end

		local elapsed = 0
		while elapsed < SHAKE_DURATION do
			local dt = task.wait()
			elapsed += dt
			local falloff = 1 - (elapsed / SHAKE_DURATION)
			humanoid.CameraOffset = Vector3.new(
				(math.random() - 0.5) * 2 * SHAKE_MAGNITUDE * falloff,
				(math.random() - 0.5) * 2 * SHAKE_MAGNITUDE * falloff,
				0
			)
		end
		humanoid.CameraOffset = Vector3.zero
	end)
end

--[[
    @summary  Cache the axe swing Animation asset for playback.
    @desc     The server now publishes a short built-in R15 tool-slash
              Animation (asset 522635514), which is a quick overhead
              strike that fits an axe/pickaxe chop.
]]
local function ensureSwingAnimation()
	if swingAnimationId then
		return
	end

	local anim = ReplicatedStorage:FindFirstChild("AxeStrikeAnimation")
	if not anim or not anim:IsA("Animation") then
		warn("[HarvestController] AxeStrikeAnimation not found in ReplicatedStorage")
		return
	end

	swingAnimationId = anim.AnimationId
end

--[[
    @summary  Play the axe swing animation on the local character.
    @desc     Loads the registered animation onto the character's
              Animator.  Caches the AnimationTrack per character to
              avoid creating new tracks on every swing.
]]
local function playSwingAnimation()
	ensureSwingAnimation()
	if not swingAnimationId then
		return
	end

	local character = Players.LocalPlayer.Character
	if not character then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		return
	end

	-- If we have a cached track and it still belongs to this animator, reuse it
	if cachedAnimTrack and cachedAnimTrack.Parent == animator then
		cachedAnimTrack:Play()
		return
	end

	-- Build a fresh Animation instance and load it
	local animInstance = Instance.new("Animation")
	animInstance.AnimationId = swingAnimationId

	cachedAnimTrack = animator:LoadAnimation(animInstance)
	if cachedAnimTrack then
		cachedAnimTrack.Priority = Enum.AnimationPriority.Action
		cachedAnimTrack:Play()
	end
end

--[[
    @summary  Handle a click-to-chop request from the equipped axe.
    @desc     Checks client-side cooldown, plays the swing animation,
              and fires the server RequestChop remote.
]]
local CarryController = require(script.Parent.CarryController)

local function onToolActivated()
	if not gameStateController or not gameStateController:IsInGame() then
		return
	end
	if CarryController.IsDragging() or CarryController.GetHoveredModel() then
		return
	end

	local now = os.clock()
	if (now - lastChopTime) < CHOP_COOLDOWN then
		return
	end
	lastChopTime = now

	playSwingAnimation()

	local combatService = Knit.GetService("CombatService")
	combatService.RequestAttack()
end

--[[
    @summary  Wire Tool.Activated on the given tool.
]]
local function wireTool(tool: Tool)
	toolJanitor:Cleanup()
	toolJanitor:Add(tool.Activated:Connect(onToolActivated), "Disconnect")
end

--[[
    @summary  Watch the player's Backpack and Character for the Axe tool
              being equipped.
]]
local function watchForAxe(player: Player)
	local function checkCharacter(character: Model)
		cachedAnimTrack = nil
		toolJanitor:Cleanup()
		charJanitor:Cleanup()

		local tool = character:FindFirstChild(AXE_TOOL_NAME)
		if tool and tool:IsA("Tool") then
			wireTool(tool)
		end

		charJanitor:Add(character.ChildAdded:Connect(function(child)
			if child:IsA("Tool") and child.Name == AXE_TOOL_NAME then
				wireTool(child)
			end
		end), "Disconnect")
	end

	janitor:Cleanup()
	janitor:Add(player.CharacterAdded:Connect(checkCharacter), "Disconnect")

	if player.Character then
		checkCharacter(player.Character)
	end
end

-- // INITIALIZATION // --

function HarvestController:KnitStart()
	gameStateController = Knit.GetController("GameStateController")
	local harvestService = Knit.GetService("HarvestService")
	harvestService.TreeChopped:Connect(function()
		shakeCamera()
	end)

	local player = Players.LocalPlayer

	local function onGameStarted()
		watchForAxe(player)
	end

	if gameStateController and gameStateController:IsInGame() then
		onGameStarted()
	else
		if gameStateController then
			gameStateController.GameStarted:Connect(onGameStarted)
		end
	end

end

return HarvestController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="127">
            <Properties>
              <string name="Name">HealthBarController</string>
              <string name="Source"><![CDATA[--[[
    @file    HealthBarController.luau
    @author  manik
    @date    2025

    @summary
    Client-side health bars and floating damage numbers for all
    AnimalAIService NPCs.

    @description
    Subscribes to AnimalAIService.NpcHealthChanged and renders a
    professional BillboardGui health bar above each damaged NPC,
    plus a floating damage number that rises and fades.  Health bars
    auto-hide after 5 seconds without a hit.  Bar colour interpolates
    from green → yellow → red based on health ratio.

    @exports
    - HealthBarController (Knit Controller)
]]

-- // VARIABLES // --

-- | Services | --
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)

-- | Objects | --
local HealthBarController = Knit.CreateController({
	Name = "HealthBarController",
})

-- | Configuration | --
local BAR_WIDTH = 6
local BAR_HEIGHT = 0.7
local BAR_OFFSET = Vector3.new(0, 4, 0)
local BAR_HIDE_DELAY = 5
local BAR_FADE_DURATION = 0.4
local DAMAGE_NUMBER_LIFETIME = 1.2
local DAMAGE_NUMBER_RISE = 3
local DAMAGE_NUMBER_MAX_OFFSET = 1.5

-- | State Management | --
local activeBars: { [Model]: { gui: BillboardGui, fill: Frame, bg: Frame, lastHit: number } } = {}

-- // FUNCTIONS // --

-- | Private | --

--[[
    @summary  Pick a colour along the green → yellow → red gradient
              based on a 0–1 health ratio.
    @param    ratio  number
    @returns  Color3
]]
local function healthColor(ratio: number): Color3
	ratio = math.clamp(ratio, 0, 1)
	if ratio > 0.5 then
		-- Green to Yellow
		local t = (1 - ratio) * 2
		return Color3.fromRGB(0, 255, 60):Lerp(Color3.fromRGB(255, 255, 0), t)
	else
		-- Yellow to Red
		local t = 1 - (ratio * 2)
		return Color3.fromRGB(255, 255, 0):Lerp(Color3.fromRGB(255, 0, 0), t)
	end
end

--[[
    @summary  Create a BillboardGui health bar above a model.
    @param    model  Model
    @returns  BillboardGui, Frame
]]
local function createHealthBar(model: Model): (BillboardGui, Frame, Frame)
	local gui = Instance.new("BillboardGui")
	gui.Name = "NpcHealthBar"
	gui.Adornee = model
	gui.Size = UDim2.fromScale(BAR_WIDTH / 3, BAR_HEIGHT)
	gui.StudsOffsetWorldSpace = BAR_OFFSET
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 120
	gui.ResetOnSpawn = false

	-- Background frame (dark rounded container)
	local bg = Instance.new("Frame")
	bg.Name = "Background"
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
	bg.BackgroundTransparency = 0.5
	bg.BorderSizePixel = 0
	bg.Parent = gui

	local bgCorner = Instance.new("UICorner")
	bgCorner.CornerRadius = UDim.new(0.3, 0)
	bgCorner.Parent = bg

	local bgStroke = Instance.new("UIStroke")
	bgStroke.Color = Color3.fromRGB(255, 255, 255)
	bgStroke.Transparency = 0.6
	bgStroke.Thickness = 1.5
	bgStroke.Parent = bg

	-- Padding container
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.06, 0)
	pad.PaddingRight = UDim.new(0.06, 0)
	pad.PaddingTop = UDim.new(0.1, 0)
	pad.PaddingBottom = UDim.new(0.1, 0)
	pad.Parent = bg

	-- Fill bar
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(0, 255, 60)
	fill.BorderSizePixel = 0
	fill.Parent = bg

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0.25, 0)
	fillCorner.Parent = fill

	gui.Parent = model

	return gui, fill, bg
end

--[[
    @summary  Spawn a floating damage number at a world position.
    @param    position  Vector3
    @param    amount    number
]]
local function spawnDamageNumber(position: Vector3, amount: number)
	local attachment = Instance.new("Part")
	attachment.Anchored = true
	attachment.CanCollide = false
	attachment.CanQuery = false
	attachment.Transparency = 1
	attachment.Size = Vector3.new(0.2, 0.2, 0.2)
	attachment.Position = position + Vector3.new(
		(math.random() - 0.5) * DAMAGE_NUMBER_MAX_OFFSET,
		0,
		(math.random() - 0.5) * DAMAGE_NUMBER_MAX_OFFSET
	)
	attachment.Parent = workspace

	local gui = Instance.new("BillboardGui")
	gui.Adornee = attachment
	gui.Size = UDim2.fromScale(4, 2)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 0, 0)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 100
	gui.Parent = attachment

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = "-" .. tostring(amount)
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = if amount >= 25
		then Color3.fromRGB(255, 60, 60)
		elseif amount >= 15
			then Color3.fromRGB(255, 140, 60)
			else Color3.fromRGB(255, 200, 80)
	label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	label.TextStrokeTransparency = 0.2
	label.Parent = gui

	-- Scale pop: start small, pop to full
	gui.Size = UDim2.fromScale(2, 1)
	TweenService:Create(gui, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = UDim2.fromScale(4, 2),
	}):Play()

	-- Tween upward and fade
	local startPos = attachment.Position
	local endPos = startPos + Vector3.new(0, DAMAGE_NUMBER_RISE, 0)

	local tweenInfo = TweenInfo.new(DAMAGE_NUMBER_LIFETIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	TweenService:Create(attachment, tweenInfo, { Position = endPos }):Play()
	TweenService:Create(label, tweenInfo, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()

	Debris:AddItem(attachment, DAMAGE_NUMBER_LIFETIME + 0.2)
end

--[[
    @summary  Show or update a health bar for a damaged NPC.
    @param    model        Model
    @param    healthRatio  number  (0–1)
    @param    damage       number
    @param    position     Vector3
]]
local function onNpcHealthChanged(model: Model, healthRatio: number, damage: number, position: Vector3)
	if not model or not model.Parent then
		return
	end

	local entry = activeBars[model]
	if not entry then
		local gui, fill, bg = createHealthBar(model)
		entry = {
			gui = gui,
			fill = fill,
			bg = bg,
			lastHit = os.clock(),
		}
		activeBars[model] = entry

		-- Start invisible and fade in
		bg.BackgroundTransparency = 1
		fill.BackgroundTransparency = 1
		TweenService:Create(bg, TweenInfo.new(0.2), { BackgroundTransparency = 0.15 }):Play()
		TweenService:Create(fill, TweenInfo.new(0.2), { BackgroundTransparency = 0 }):Play()
	end

	entry.lastHit = os.clock()

	-- Tween fill width and colour
	local targetSize = UDim2.fromScale(math.clamp(healthRatio, 0, 1), 1)
	local targetColor = healthColor(healthRatio)

	TweenService:Create(entry.fill, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = targetSize,
		BackgroundColor3 = targetColor,
	}):Play()

	-- Spawn damage number
	if damage > 0 then
		spawnDamageNumber(position, damage)
	end
end

--[[
    @summary  Hide and clean up a health bar for a model.
    @param    model  Model
]]
local function removeHealthBar(model: Model)
	local entry = activeBars[model]
	if not entry then
		return
	end
	activeBars[model] = nil

	-- Fade out
	TweenService:Create(entry.bg, TweenInfo.new(BAR_FADE_DURATION), { BackgroundTransparency = 1 }):Play()
	TweenService:Create(entry.fill, TweenInfo.new(BAR_FADE_DURATION), { BackgroundTransparency = 1 }):Play()

	Debris:AddItem(entry.gui, BAR_FADE_DURATION + 0.1)
end

-- | Heartbeat | --

--[[
    @summary  Periodically hide health bars that haven't been hit recently.
]]
local function startHideLoop()
	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		for model, entry in pairs(activeBars) do
			if not model.Parent then
				removeHealthBar(model)
			elseif (now - entry.lastHit) > BAR_HIDE_DELAY then
				removeHealthBar(model)
			end
		end
	end)
end

-- // INITIALIZATION // --

function HealthBarController:KnitStart()
	local animalAIService = Knit.GetService("AnimalAIService")

	animalAIService.NpcHealthChanged:Connect(function(model: Model, healthRatio: number, damage: number, position: Vector3)
		onNpcHealthChanged(model, healthRatio, damage, position)
	end)

	animalAIService.NpcDied:Connect(function(model: Model, _position: Vector3, _key: string)
		if model then
			removeHealthBar(model)
		end
	end)

	startHideLoop()
end

return HealthBarController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="128">
            <Properties>
              <string name="Name">HudController</string>
              <string name="Source"><![CDATA[--[[
    @file    HudController.luau
    @author  manik
    @date    2025

    @summary
    Binds DayLabel/NightLabel GUIs to the live TimeService clock.

    @description
    Creates TextLabels inside the existing DayLabel and NightLabel
    ScreenGuis in StarterGui, then listens to TimeService signals
    to toggle visibility and update the day/night counter text.

    @exports
    - HudController (Knit Controller)
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)

-- | Objects | --
local HudController = Knit.CreateController({
	Name = "HudController",
})

-- | Configuration | --
local DAY_STROKE_COLOR = Color3.fromRGB(255, 180, 60)
local NIGHT_STROKE_COLOR = Color3.fromRGB(100, 130, 220)
local DAY_GRADIENT = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(80, 70, 50)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(55, 50, 40)),
})
local NIGHT_GRADIENT = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(50, 50, 75)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(30, 30, 50)),
})

-- | State Management | --
local phaseGui: ScreenGui? = nil
local banner: Frame? = nil
local shadow: Frame? = nil
local phaseText: TextLabel? = nil
local gradient: UIGradient? = nil
local stroke: UIStroke? = nil
local currentDayNumber = 1
local gameStateController: any = nil
local labelsEnabled = false

-- // FUNCTIONS // --

--[[
    @summary  Build the top-center day/night banner and disable legacy labels.
]]
local function createPhaseUi()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	if not playerGui then
		return
	end

	for _, name in ipairs({ "DayLabel", "NightLabel" }) do
		local legacy = playerGui:FindFirstChild(name)
		if legacy and legacy:IsA("ScreenGui") then
			legacy.Enabled = false
		end
	end

	phaseGui = Instance.new("ScreenGui")
	phaseGui.Name = "PhaseIndicator"
	phaseGui.ResetOnSpawn = false
	phaseGui.IgnoreGuiInset = true
	phaseGui.DisplayOrder = 50
	phaseGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	phaseGui.Enabled = false
	phaseGui.Parent = playerGui

	shadow = Instance.new("Frame")
	shadow.Name = "BannerShadow"
	shadow.Size = UDim2.new(0, 144, 0, 40)
	shadow.Position = UDim2.new(0.5, 2, 0, 14)
	shadow.AnchorPoint = Vector2.new(0.5, 0)
	shadow.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	shadow.BackgroundTransparency = 0.55
	shadow.BorderSizePixel = 0
	shadow.ZIndex = 1
	shadow.Parent = phaseGui

	local shadowCorner = Instance.new("UICorner")
	shadowCorner.CornerRadius = UDim.new(0, 10)
	shadowCorner.Parent = shadow

	banner = Instance.new("Frame")
	banner.Name = "PhaseBanner"
	banner.Size = UDim2.new(0, 140, 0, 36)
	banner.Position = UDim2.new(0.5, 0, 0, 12)
	banner.AnchorPoint = Vector2.new(0.5, 0)
	banner.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	banner.BackgroundTransparency = 0.15
	banner.BorderSizePixel = 0
	banner.ZIndex = 2
	banner.Parent = phaseGui

	local bannerCorner = Instance.new("UICorner")
	bannerCorner.CornerRadius = UDim.new(0, 10)
	bannerCorner.Parent = banner

	gradient = Instance.new("UIGradient")
	gradient.Rotation = 90
	gradient.Color = DAY_GRADIENT
	gradient.Parent = banner

	stroke = Instance.new("UIStroke")
	stroke.Thickness = 1.5
	stroke.Transparency = 0.25
	stroke.Color = DAY_STROKE_COLOR
	stroke.Parent = banner

	phaseText = Instance.new("TextLabel")
	phaseText.Name = "PhaseText"
	phaseText.Size = UDim2.new(1, -16, 1, 0)
	phaseText.Position = UDim2.new(0, 8, 0, 0)
	phaseText.BackgroundTransparency = 1
	phaseText.TextColor3 = Color3.fromRGB(255, 255, 255)
	phaseText.Font = Enum.Font.GothamBlack
	phaseText.TextSize = 20
	phaseText.TextXAlignment = Enum.TextXAlignment.Center
	phaseText.TextYAlignment = Enum.TextYAlignment.Center
	phaseText.Text = "Day 1"
	phaseText.ZIndex = 3
	phaseText.Parent = banner
end

--[[
    @summary  Update banner colors and text for the current phase.
    @param   phase  string  -- "Day" or "Night"
]]
local function updateBanner(phase: string, dayNumber: number)
	if not banner or not phaseText or not stroke or not gradient then
		return
	end
	local isDay = phase == "Day"
	phaseText.Text = phase .. " " .. dayNumber
	stroke.Color = if isDay then DAY_STROKE_COLOR else NIGHT_STROKE_COLOR
	gradient.Color = if isDay then DAY_GRADIENT else NIGHT_GRADIENT
end

--[[
    @summary  Show the Day banner.
]]
local function showDay()
	if phaseGui then phaseGui.Enabled = labelsEnabled end
	updateBanner("Day", currentDayNumber)
end

--[[
    @summary  Show the Night banner.
]]
local function showNight()
	if phaseGui then phaseGui.Enabled = labelsEnabled end
	updateBanner("Night", currentDayNumber)
end

-- // INITIALIZATION // --

function HudController:KnitInit()
	createPhaseUi()
end

function HudController:KnitStart()
	gameStateController = Knit.GetController("GameStateController")
	local timeService = Knit.GetService("TimeService")
	local runStateService = Knit.GetService("RunStateService")

	local function enableLabels()
		labelsEnabled = true
		if phaseGui then phaseGui.Enabled = true end
	end

	if gameStateController and gameStateController:IsInGame() then
		enableLabels()
	else
		if gameStateController then
			gameStateController.GameStarted:Connect(function()
				enableLabels()
				showDay()
			end)
		end
	end

	timeService.DayStarted:Connect(function()
		if labelsEnabled then
			showDay()
		end
	end)

	timeService.NightStarted:Connect(function()
		if labelsEnabled then
			showNight()
		end
	end)

	timeService.DawnAdvanced:Connect(function(payload)
		if typeof(payload) == "table" and typeof(payload.displayedDay) == "number" then
			currentDayNumber = payload.displayedDay
		end
		if labelsEnabled then
			showDay()
		end
	end)

	timeService:GetProgress():andThen(function(progress)
		if typeof(progress) == "table" and typeof(progress.displayedDay) == "number" then
			currentDayNumber = progress.displayedDay
		end
	end)

	-- Use :Observe() to sync to the current server phase state. Unlike :Get(),
	-- :Observe() fires the initial value once the property has synced from the
	-- server (via task.defer if already ready), and on every subsequent change.
	local phaseState = timeService.GetPhaseState
	if phaseState then
		phaseState:Observe(function(currentPhase: any)
			if currentPhase == "Night" then
				showNight()
			else
				showDay()
			end
		end)
	end

	runStateService.RunPhaseChanged:Connect(function(payload)
		if typeof(payload) == "table" and payload.phase == "Lobby" then
			labelsEnabled = false
			currentDayNumber = 1
			if phaseGui then
				phaseGui.Enabled = false
			end
		end
	end)
end

return HudController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="129">
            <Properties>
              <string name="Name">HungerController</string>
              <string name="Source"><![CDATA[--[[
    @file    HungerController.luau
    @author  manik
    @date    2025

    @summary
    Compact, polished survival HUD showing health and hunger.

    @description
    Builds a modern "VITALS" card in the top-left with icon + bar +
    percentage for each stat, matching the dark-slate / warm-stroke
    visual style used by the inventory and campfire systems.
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)

-- | Objects | --
local HungerController = Knit.CreateController({
	Name = "HungerController",
})

-- | Configuration | --
local TWEEN_INFO = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local CARD_BG = Color3.fromRGB(38, 40, 48)
local CARD_STROKE = Color3.fromRGB(230, 160, 70)
local TEXT_LIGHT = Color3.fromRGB(240, 240, 245)
local TEXT_DIM = Color3.fromRGB(170, 170, 180)
local BAR_BG = Color3.fromRGB(28, 28, 34)
local BAR_STROKE = Color3.fromRGB(80, 80, 90)

local HEALTH_COLOR = Color3.fromRGB(230, 75, 75)
local HUNGER_COLOR = Color3.fromRGB(230, 170, 50)

-- | State Management | --
local healthFill: Frame? = nil
local hungerFill: Frame? = nil
local healthValueLabel: TextLabel? = nil
local hungerValueLabel: TextLabel? = nil
local survivalGui: ScreenGui? = nil

-- // FUNCTIONS // --

local function setFillAndLabel(fill: Frame?, label: TextLabel?, current: number, max: number, color: Color3)
	if not fill or not label then
		return
	end
	local clamped = math.clamp(if max > 0 then current / max else 0, 0, 1)
	local percent = math.round(clamped * 100)

	TweenService:Create(fill, TWEEN_INFO, { Size = UDim2.new(clamped, 0, 1, 0) }):Play()

	label.Text = tostring(percent) .. "%"
	label.TextColor3 = color:Lerp(TEXT_DIM, 1 - clamped)
end

local function buildStatRow(parent: Frame, name: string, y: number, labelText: string, color: Color3): (Frame, TextLabel)
	local icon = Instance.new("Frame")
	icon.Name = name .. "Icon"
	icon.Size = UDim2.new(0, 18, 0, 18)
	icon.Position = UDim2.new(0, 10, 0, y + 4)
	icon.BackgroundColor3 = color
	icon.BorderSizePixel = 0
	icon.Parent = parent

	local iconCorner = Instance.new("UICorner")
	iconCorner.CornerRadius = UDim.new(1, 0)
	iconCorner.Parent = icon

	local iconStroke = Instance.new("UIStroke")
	iconStroke.Color = color
	iconStroke.Transparency = 0.4
	iconStroke.Thickness = 1.5
	iconStroke.Parent = icon

	local label = Instance.new("TextLabel")
	label.Name = name .. "Label"
	label.Size = UDim2.new(0, 52, 0, 18)
	label.Position = UDim2.new(0, 34, 0, y + 4)
	label.BackgroundTransparency = 1
	label.Text = labelText
	label.TextColor3 = TEXT_DIM
	label.Font = Enum.Font.GothamBold
	label.TextSize = 11
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = parent

	local barBackground = Instance.new("Frame")
	barBackground.Name = name .. "BarBackground"
	barBackground.Size = UDim2.new(0, 110, 0, 10)
	barBackground.Position = UDim2.new(0, 88, 0, y + 7)
	barBackground.BackgroundColor3 = BAR_BG
	barBackground.BackgroundTransparency = 0.05
	barBackground.BorderSizePixel = 0
	barBackground.Parent = parent

	local bgCorner = Instance.new("UICorner")
	bgCorner.CornerRadius = UDim.new(0, 4)
	bgCorner.Parent = barBackground

	local bgStroke = Instance.new("UIStroke")
	bgStroke.Color = BAR_STROKE
	bgStroke.Transparency = 0.5
	bgStroke.Thickness = 1
	bgStroke.Parent = barBackground

	local barFill = Instance.new("Frame")
	barFill.Name = name .. "BarFill"
	barFill.Size = UDim2.new(1, 0, 1, 0)
	barFill.BackgroundColor3 = color
	barFill.BackgroundTransparency = 0.05
	barFill.BorderSizePixel = 0
	barFill.Parent = barBackground

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0, 4)
	fillCorner.Parent = barFill

	local fillGradient = Instance.new("UIGradient")
	fillGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, color),
		ColorSequenceKeypoint.new(1, color:Lerp(Color3.new(0, 0, 0), 0.35)),
	})
	fillGradient.Rotation = 90
	fillGradient.Parent = barFill

	local fillStroke = Instance.new("UIStroke")
	fillStroke.Color = color
	fillStroke.Transparency = 0.65
	fillStroke.Thickness = 1
	fillStroke.Parent = barFill

	local valueLabel = Instance.new("TextLabel")
	valueLabel.Name = name .. "Value"
	valueLabel.Size = UDim2.new(0, 44, 0, 18)
	valueLabel.Position = UDim2.new(0, 200, 0, y + 4)
	valueLabel.BackgroundTransparency = 1
	valueLabel.Text = "100%"
	valueLabel.TextColor3 = TEXT_LIGHT
	valueLabel.Font = Enum.Font.GothamBold
	valueLabel.TextSize = 12
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right
	valueLabel.Parent = parent

	return barFill, valueLabel
end

local function buildSurvivalGui()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	if not playerGui then
		return
	end
	local existing = playerGui:FindFirstChild("HealthBarFill")
	if existing then
		existing:Destroy()
	end

	local existingSurvival = playerGui:FindFirstChild("SurvivalGui")
	if existingSurvival then
		existingSurvival:Destroy()
	end

	local gui = Instance.new("ScreenGui")
	gui.Name = "SurvivalGui"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 2
	gui.Enabled = false
	gui.Parent = playerGui
	survivalGui = gui

	local panel = Instance.new("Frame")
	panel.Name = "SurvivalPanel"
	panel.Size = UDim2.new(0, 250, 0, 96)
	panel.Position = UDim2.new(0, 20, 0, 70)
	panel.AnchorPoint = Vector2.new(0, 0)
	panel.BackgroundColor3 = CARD_BG
	panel.BackgroundTransparency = 0.02
	panel.BorderSizePixel = 0
	panel.Parent = gui

	local panelCorner = Instance.new("UICorner")
	panelCorner.CornerRadius = UDim.new(0, 12)
	panelCorner.Parent = panel

	local panelStroke = Instance.new("UIStroke")
	panelStroke.Color = CARD_STROKE
	panelStroke.Transparency = 0.25
	panelStroke.Thickness = 1.5
	panelStroke.Parent = panel

	local header = Instance.new("TextLabel")
	header.Name = "Header"
	header.Size = UDim2.new(1, -20, 0, 18)
	header.Position = UDim2.new(0, 10, 0, 6)
	header.BackgroundTransparency = 1
	header.Text = "VITALS"
	header.TextColor3 = TEXT_DIM
	header.Font = Enum.Font.GothamBold
	header.TextSize = 11
	header.TextXAlignment = Enum.TextXAlignment.Left
	header.Parent = panel

	healthFill, healthValueLabel = buildStatRow(panel, "Health", 28, "HP", HEALTH_COLOR)
	hungerFill, hungerValueLabel = buildStatRow(panel, "Hunger", 58, "HUNGER", HUNGER_COLOR)
end

--[[
    @summary  Bind the Health bar to a character's Humanoid.
    @param    character  Model  -- the local player's character
]]
local function bindHumanoid(character: Model)
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	local function updateHealth()
		setFillAndLabel(healthFill, healthValueLabel, humanoid.Health, humanoid.MaxHealth, HEALTH_COLOR)
	end
	updateHealth()
	humanoid.HealthChanged:Connect(updateHealth)
end

-- // INITIALIZATION // --

function HungerController:KnitInit()
	buildSurvivalGui()

	local player = Players.LocalPlayer
	if player.Character then
		bindHumanoid(player.Character)
	end
	player.CharacterAdded:Connect(bindHumanoid)

	-- Set initial hunger to full so the bar doesn't flash empty
	if hungerFill and hungerValueLabel then
		hungerFill.Size = UDim2.new(1, 0, 1, 0)
		hungerValueLabel.Text = "100%"
		hungerValueLabel.TextColor3 = HUNGER_COLOR
	end
end

function HungerController:KnitStart()
	local gameStateController = Knit.GetController("GameStateController")
	local hungerService = Knit.GetService("HungerService")
	local runStateService = Knit.GetService("RunStateService")

	local function showGui()
		if survivalGui then
			survivalGui.Enabled = true
		end
	end

	if gameStateController and gameStateController:IsInGame() then
		showGui()
	else
		if gameStateController then
			gameStateController.GameStarted:Connect(showGui)
		end
	end

	hungerService.HungerChanged:Connect(function(hunger, maxHunger)
		setFillAndLabel(hungerFill, hungerValueLabel, hunger, maxHunger, HUNGER_COLOR)
	end)

	runStateService.RunPhaseChanged:Connect(function(payload)
		if typeof(payload) == "table" and payload.phase == "Lobby" and survivalGui then
			survivalGui.Enabled = false
		end
	end)
end

return HungerController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="130">
            <Properties>
              <string name="Name">IntroController</string>
              <string name="Source"><![CDATA[--[[
    @file    IntroController.luau
    @author  manik
    @date    2025

    @summary
    Client presenter for the Create Party lobby and match intro.

    @description
    Shows a "Create Party" panel on teleporter touch. Only party size 1
    is enabled. Clicking Create starts a 5-second countdown, then fades
    to the story text, teleports the player, shows Day 1 on black, and
    slowly reveals the base map before gameplay begins.
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local StarterGui = game:GetService("StarterGui")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local Janitor = require(ReplicatedStorage.Packages.Janitor)
local IntroAssets = require(ReplicatedStorage.Shared.IntroAssets)
local Constants = require(ReplicatedStorage.Shared.Constants)

-- | Objects | --
local IntroController = Knit.CreateController({
	Name = "IntroController",
})

-- | Configuration | --
local PANEL_FADE = 0.3
local STORY_FADE = Constants.MATCH_STORY_FADE_SECONDS or 1.2
local REVEAL_SECONDS = Constants.MATCH_REVEAL_SECONDS or 2.5

local PANEL = IntroAssets.PanelBackdrop or Color3.fromRGB(25, 25, 25)
local PANEL_ALPHA = IntroAssets.PanelBackgroundTransparency or 0.25
local CREAM = IntroAssets.TitleColor or Color3.fromRGB(232, 220, 190)
local HANDWRITTEN = IntroAssets.TitleHandwritten or CREAM
local BODY = IntroAssets.BodyText or CREAM
local SIZE_BTN = IntroAssets.SizeButton or Color3.fromRGB(160, 160, 160)
local SIZE_DISABLED = IntroAssets.SizeButtonDisabled or Color3.fromRGB(90, 90, 90)
local SIZE_SELECTED = IntroAssets.SizeButtonSelected or Color3.fromRGB(255, 210, 50)
local CREATE = IntroAssets.CreateButton or Color3.fromRGB(95, 190, 70)
local CLOSE = IntroAssets.CloseButton or Color3.fromRGB(220, 60, 60)
local CUSTOMIZE = IntroAssets.CustomizeButton or Color3.fromRGB(80, 80, 80)
local STORY = IntroAssets.StoryText or Color3.fromRGB(170, 90, 90)

local TITLE_OUT = 1.0
local STORY_BACK = IntroAssets.StoryScreenBackdrop or Color3.fromRGB(10, 10, 10)
local STORY_HEADER = IntroAssets.StoryHeaderColor or Color3.fromRGB(220, 60, 60)
local STORY_PANEL = IntroAssets.StoryPanelBackdrop or Color3.fromRGB(30, 30, 30)
local STORY_CAPTION = IntroAssets.StoryPanelCaption or Color3.fromRGB(230, 220, 200)
local STORY_PLACEHOLDER = IntroAssets.StoryPanelPlaceholder or Color3.fromRGB(55, 55, 55)
local PLAY = IntroAssets.PlayButtonColor or Color3.fromRGB(95, 190, 70)

-- | State Management | --
local player = Players.LocalPlayer
local janitor = Janitor.new()
local waitingJanitor = Janitor.new()
local screenGui: ScreenGui? = nil
local titleScreen: Frame? = nil
local createPartyFrame: Frame? = nil
local storyFrame: Frame? = nil
local dayFrame: Frame? = nil
local countdownLabel: TextLabel? = nil
local createButton: TextButton? = nil
local sizeButtons: { TextButton } = {}
local selectedSize = 1
local countdownEndsAt: number? = nil
local flowState = "Lobby"
local introFinished = false
local titleDismissed = false
local savedWalkSpeed = 16
local savedJumpPower = 50
local savedJumpHeight = 7.2
local movementLocked = false
local gameStateController: any = nil

-- // FUNCTIONS // --

local function tween(instance: Instance, info: TweenInfo, props: { [string]: any })
	local t = TweenService:Create(instance, info, props)
	t:Play()
	return t
end

local function fadeText(textObject: TextLabel | TextButton, transparency: number, duration: number)
	tween(textObject, TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
		TextTransparency = transparency,
		TextStrokeTransparency = math.clamp(transparency + 0.4, 0, 1),
	})
end

local function fadeGui(guiObject: GuiObject, transparency: number, duration: number)
	tween(guiObject, TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
		BackgroundTransparency = transparency,
	})

	for _, desc in ipairs(guiObject:GetDescendants()) do
		if desc:IsA("TextLabel") or desc:IsA("TextButton") then
			tween(desc, TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
				TextTransparency = transparency,
				TextStrokeTransparency = math.clamp(transparency + 0.4, 0, 1),
			})
		elseif desc:IsA("ImageLabel") then
			local imageProps: { [string]: any } = { ImageTransparency = transparency }
			if desc.Image == "rbxassetid://0" or desc.Image == "" then
				imageProps.BackgroundTransparency = transparency
			end
			tween(desc, TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), imageProps)
		elseif desc:IsA("Frame") and desc.BackgroundTransparency < 1 then
			tween(desc, TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
				BackgroundTransparency = math.max(desc.BackgroundTransparency, transparency),
			})
		end
	end
end

local function setGroupTransparency(guiObject: GuiObject, transparency: number)
	guiObject.BackgroundTransparency = if guiObject.BackgroundTransparency < 1 then transparency else 1
	for _, desc in ipairs(guiObject:GetDescendants()) do
		if desc:IsA("TextLabel") or desc:IsA("TextButton") then
			desc.TextTransparency = transparency
			desc.TextStrokeTransparency = math.clamp(transparency + 0.4, 0, 1)
		elseif desc:IsA("ImageLabel") then
			desc.ImageTransparency = transparency
			desc.BackgroundTransparency = transparency
		end
	end
end

local function lockMovement()
	if movementLocked then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	savedWalkSpeed = humanoid.WalkSpeed
	savedJumpPower = humanoid.JumpPower
	savedJumpHeight = humanoid.JumpHeight
	humanoid.WalkSpeed = 0
	humanoid.JumpPower = 0
	humanoid.JumpHeight = 0
	movementLocked = true
end

local function unlockMovement()
	if not movementLocked then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = savedWalkSpeed
		humanoid.JumpPower = savedJumpPower
		humanoid.JumpHeight = savedJumpHeight
	end
	movementLocked = false
end

local function lockCamera()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	camera.CameraType = Enum.CameraType.Scriptable
end

local function unlockCamera()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	camera.CameraType = Enum.CameraType.Custom
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
end

local function formatCountdown(seconds: number): string
	return tostring(math.max(0, math.floor(seconds + 0.5)))
end

local function makeLabel(parent: Instance, name: string, text: string, size: number, color: Color3, position: UDim2, sizeDim: UDim2): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Size = sizeDim
	label.Position = position
	label.Font = Enum.Font.GothamBlack
	label.TextSize = size
	label.TextColor3 = color
	label.Text = text
	label.TextWrapped = true
	label.ZIndex = 10
	label.Parent = parent
	return label
end

local function makeButton(parent: Instance, name: string, text: string, textSize: number, color: Color3, position: UDim2, sizeDim: UDim2, radius: number?): TextButton
	local button = Instance.new("TextButton")
	button.Name = name
	button.Text = text
	button.TextColor3 = Color3.new(1, 1, 1)
	button.TextSize = textSize
	button.Font = Enum.Font.GothamBlack
	button.AutoButtonColor = true
	button.BackgroundColor3 = color
	button.BackgroundTransparency = 0
	button.Position = position
	button.Size = sizeDim
	button.ZIndex = 10
	button.Parent = parent
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 8)
	corner.Parent = button
	return button
end

local function makeCircleButton(parent: Instance, name: string, text: string, color: Color3, position: UDim2, sizeDim: UDim2): TextButton
	local button = Instance.new("TextButton")
	button.Name = name
	button.Text = text
	button.TextColor3 = Color3.new(1, 1, 1)
	button.TextSize = 24
	button.Font = Enum.Font.GothamBlack
	button.AutoButtonColor = true
	button.BackgroundColor3 = color
	button.BackgroundTransparency = 0
	button.Position = position
	button.Size = sizeDim
	button.ZIndex = 10
	button.Parent = parent
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = button
	return button
end

local function updateSizeButtons()
	for i, button in ipairs(sizeButtons) do
		if i == selectedSize then
			button.BackgroundColor3 = SIZE_SELECTED
			button.TextColor3 = Color3.new(0.1, 0.1, 0.1)
		else
			button.BackgroundColor3 = if i == 1 then SIZE_BTN else SIZE_DISABLED
			button.TextColor3 = if i == 1 then Color3.new(1, 1, 1) else Color3.new(0.6, 0.6, 0.6)
		end
	end
	if createButton then
		createButton.Text = "Create"
		createButton.BackgroundColor3 = CREATE
	end
end

local function buildGui()
	local playerGui = player:WaitForChild("PlayerGui")
	if not playerGui then
		return
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "IntroGui"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 80
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = playerGui
	screenGui = gui

	local panel = Instance.new("Frame")
	panel.Name = "CreatePartyFrame"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.fromOffset(420, 360)
	panel.BackgroundColor3 = PANEL
	panel.BackgroundTransparency = PANEL_ALPHA
	panel.BorderSizePixel = 0
	panel.Visible = false
	panel.ZIndex = 20
	panel.Parent = gui
	createPartyFrame = panel
	local panelCorner = Instance.new("UICorner")
	panelCorner.CornerRadius = UDim.new(0, 16)
	panelCorner.Parent = panel

	local close = makeCircleButton(panel, "CloseButton", "X", CLOSE,
		UDim2.new(1, -12, 0, 12), UDim2.fromOffset(36, 36))
	close.AnchorPoint = Vector2.new(1, 0)

	local title = makeLabel(panel, "CreatePartyTitle", "Create Party", 28, HANDWRITTEN,
		UDim2.fromScale(0.5, 0.06), UDim2.new(0, 260, 0, 40))
	title.AnchorPoint = Vector2.new(0.5, 0)
	title.Font = Enum.Font.Gotham

	local partySize = makeLabel(panel, "PartySizeTitle", "Party Size", 36, BODY,
		UDim2.fromScale(0.5, 0.22), UDim2.new(0, 260, 0, 44))
	partySize.AnchorPoint = Vector2.new(0.5, 0)

	local sizeHolder = Instance.new("Frame")
	sizeHolder.Name = "SizeHolder"
	sizeHolder.AnchorPoint = Vector2.new(0.5, 0.5)
	sizeHolder.Position = UDim2.fromScale(0.5, 0.4)
	sizeHolder.Size = UDim2.fromOffset(280, 56)
	sizeHolder.BackgroundTransparency = 1
	sizeHolder.ZIndex = 22
	sizeHolder.Parent = panel
	local sizeList = Instance.new("UIListLayout")
	sizeList.FillDirection = Enum.FillDirection.Horizontal
	sizeList.HorizontalAlignment = Enum.HorizontalAlignment.Center
	sizeList.VerticalAlignment = Enum.VerticalAlignment.Center
	sizeList.Padding = UDim.new(0, 12)
	sizeList.Parent = sizeHolder

	for i = 1, 5 do
		local btn = makeButton(sizeHolder, "Size" .. i, tostring(i), 22,
			if i == 1 then SIZE_BTN else SIZE_DISABLED,
			UDim2.new(), UDim2.fromOffset(48, 48), 8)
		btn.LayoutOrder = i
		table.insert(sizeButtons, btn)
		if i ~= 1 then
			btn.AutoButtonColor = false
			btn.Active = false
		end
	end

	local createBtn = makeButton(panel, "CreateButton", "Create", 24, CREATE,
		UDim2.fromScale(0.5, 0.58), UDim2.fromOffset(320, 52), 10)
	createBtn.AnchorPoint = Vector2.new(0.5, 0)
	createButton = createBtn

	local customize = makeButton(panel, "CustomizeButton", "customize", 18, CUSTOMIZE,
		UDim2.fromScale(0.5, 0.75), UDim2.fromOffset(140, 32), 8)
	customize.AnchorPoint = Vector2.new(0.5, 0)

	local countLabel = makeLabel(panel, "CountdownLabel", "5", 64, CREAM,
		UDim2.fromScale(0.5, 0.58), UDim2.new(0, 320, 0, 80))
	countLabel.AnchorPoint = Vector2.new(0.5, 0)
	countLabel.Visible = false
	countdownLabel = countLabel

	local story = Instance.new("Frame")
	story.Name = "StoryFrame"
	story.Size = UDim2.fromScale(1, 1)
	story.BackgroundColor3 = Color3.new(0, 0, 0)
	story.BorderSizePixel = 0
	story.BackgroundTransparency = 1
	story.Visible = false
	story.ZIndex = 30
	story.Parent = gui
	storyFrame = story

	local story1 = makeLabel(story, "StoryLine1", "• Survive 99 Nights", 48, STORY,
		UDim2.fromScale(0.1, 0.42), UDim2.fromScale(0.8, 0.12))
	story1.TextXAlignment = Enum.TextXAlignment.Center

	local story2 = makeLabel(story, "StoryLine2", "• Finding the Missing Children will help", 32, STORY,
		UDim2.fromScale(0.1, 0.55), UDim2.fromScale(0.8, 0.1))
	story2.TextXAlignment = Enum.TextXAlignment.Center

	local day = Instance.new("Frame")
	day.Name = "DayFrame"
	day.Size = UDim2.fromScale(1, 1)
	day.BackgroundColor3 = Color3.new(0, 0, 0)
	day.BorderSizePixel = 0
	day.Visible = false
	day.ZIndex = 35
	day.Parent = gui
	dayFrame = day

	local dayText = makeLabel(day, "DayText", "Day 1", 54, CREAM,
		UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(400, 90))
	dayText.AnchorPoint = Vector2.new(0.5, 0.5)
	dayText.Font = Enum.Font.Gotham

	updateSizeButtons()
end

local function buildTitleScreen()
	if not screenGui then
		return
	end

	local title = Instance.new("Frame")
	title.Name = "TitleScreen"
	title.Size = UDim2.fromScale(1, 1)
	title.BackgroundColor3 = STORY_BACK
	title.BorderSizePixel = 0
	title.Visible = false
	title.ZIndex = 5
	title.Parent = screenGui
	titleScreen = title

	local header = makeLabel(title, "TitleHeader",
		"THIS GAME IS BASED ON A TRUE STORY. SOME DETAILS HAVE BEEN CHANGED",
		30, STORY_HEADER,
		UDim2.fromScale(0.5, 0.05), UDim2.new(0.9, 0, 0, 70))
	header.AnchorPoint = Vector2.new(0.5, 0)
	header.TextXAlignment = Enum.TextXAlignment.Center
	header.TextYAlignment = Enum.TextYAlignment.Top
	header.TextWrapped = true
	header.ZIndex = 10
	header.Font = Enum.Font.Bangers
	header.TextStrokeColor3 = Color3.new(0, 0, 0)
	header.TextStrokeTransparency = 1

	local panelsHolder = Instance.new("Frame")
	panelsHolder.Name = "PanelsHolder"
	panelsHolder.AnchorPoint = Vector2.new(0.5, 0.5)
	panelsHolder.Position = UDim2.fromScale(0.5, 0.52)
	panelsHolder.Size = UDim2.new(0.95, 0, 0.65, 0)
	panelsHolder.BackgroundTransparency = 1
	panelsHolder.BorderSizePixel = 0
	panelsHolder.ZIndex = 6
	panelsHolder.ClipsDescendants = true
	panelsHolder.Parent = title

	local holderList = Instance.new("UIListLayout")
	holderList.FillDirection = Enum.FillDirection.Horizontal
	holderList.HorizontalAlignment = Enum.HorizontalAlignment.Center
	holderList.VerticalAlignment = Enum.VerticalAlignment.Center
	holderList.Padding = UDim.new(0, 12)
	holderList.SortOrder = Enum.SortOrder.LayoutOrder
	holderList.Parent = panelsHolder

	local imageIds = IntroAssets.StoryPanelImages or {}
	local storyPanels = IntroAssets.StoryPanels or {}

	for i = 1, 4 do
		local panel = Instance.new("Frame")
		panel.Name = "StoryPanel" .. i
		panel.Size = UDim2.new(0.18, 0, 0.62, 0)
		panel.BackgroundColor3 = STORY_PANEL
		panel.BackgroundTransparency = 1
		panel.BorderSizePixel = 0
		panel.ZIndex = 7
		panel.LayoutOrder = i
		panel.ClipsDescendants = true
		panel.Parent = panelsHolder

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 8)
		corner.Parent = panel

		local stroke = Instance.new("UIStroke")
		stroke.Color = Color3.fromRGB(60, 60, 60)
		stroke.Thickness = 1
		stroke.Transparency = 0.4
		stroke.Parent = panel

		local pad = Instance.new("UIPadding")
		pad.PaddingTop = UDim.new(0, 8)
		pad.PaddingBottom = UDim.new(0, 8)
		pad.PaddingLeft = UDim.new(0, 8)
		pad.PaddingRight = UDim.new(0, 8)
		pad.Parent = panel

		local list = Instance.new("UIListLayout")
		list.FillDirection = Enum.FillDirection.Vertical
		list.HorizontalAlignment = Enum.HorizontalAlignment.Center
		list.VerticalAlignment = Enum.VerticalAlignment.Top
		list.Padding = UDim.new(0, 4)
		list.SortOrder = Enum.SortOrder.LayoutOrder
		list.Parent = panel

		local image = Instance.new("ImageLabel")
		image.Name = "Image"
		image.LayoutOrder = 1
		image.Size = UDim2.new(1, 0, 0.7, 0)
		image.BackgroundColor3 = STORY_PLACEHOLDER
		image.BackgroundTransparency = 1
		image.BorderSizePixel = 0
		image.ScaleType = Enum.ScaleType.Crop
		image.ZIndex = 8
		image.Parent = panel

		local id = imageIds[i]
		if id and id ~= "" then
			image.Image = id
			image.BackgroundTransparency = 1
		end

		local caption = makeLabel(panel, "Caption",
			typeof(storyPanels[i]) == "table" and storyPanels[i].caption or "",
			14, STORY_CAPTION,
			UDim2.new(), UDim2.new(1, 0, 0.28, 0))
		caption.LayoutOrder = 2
		caption.ZIndex = 8
		caption.TextWrapped = true
		caption.TextXAlignment = Enum.TextXAlignment.Center
		caption.TextYAlignment = Enum.TextYAlignment.Center
		caption.Font = Enum.Font.Gotham
		caption.RichText = true
	end

	local play = Instance.new("TextButton")
	play.Name = "PlayButton"
	play.Text = "PLAY"
	play.TextColor3 = Color3.new(1, 1, 1)
	play.TextSize = 46
	play.Font = Enum.Font.Bangers
	play.TextStrokeColor3 = Color3.new(0, 0, 0)
	play.TextStrokeTransparency = 1
	play.AutoButtonColor = true
	play.BackgroundColor3 = PLAY
	play.BackgroundTransparency = 0
	play.Position = UDim2.new(0.5, 0, 1, -70)
	play.Size = UDim2.fromOffset(280, 64)
	play.AnchorPoint = Vector2.new(0.5, 0.5)
	play.ZIndex = 10
	play.Parent = title

	local playCorner = Instance.new("UICorner")
	playCorner.CornerRadius = UDim.new(0, 12)
	playCorner.Parent = play
end

local function showTitleScreen()
	if not titleScreen or titleDismissed then
		return
	end

	titleScreen.Visible = true
	titleScreen.BackgroundTransparency = 1
	setGroupTransparency(titleScreen, 1)

	if screenGui then
		screenGui.DisplayOrder = 10000
	end
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
	end)

	local camera = Workspace.CurrentCamera
	if camera then
		camera.CameraType = Enum.CameraType.Scriptable
	end
	lockMovement()
	lockCamera()

	-- fade in background
	tween(titleScreen, TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
		BackgroundTransparency = 0,
	})

	local header = titleScreen:FindFirstChild("TitleHeader")
	if header and header:IsA("TextLabel") then
		task.delay(0.15, function()
			fadeText(header, 0, 0.5)
		end)
	end

	local panelsHolder = titleScreen:FindFirstChild("PanelsHolder")
	if panelsHolder then
		for i, panel in ipairs(panelsHolder:GetChildren()) do
			if panel:IsA("Frame") then
				task.delay(0.35 + (i - 1) * 0.1, function()
					fadeGui(panel, 0, 0.4)
				end)
			end
		end
	end

	local play = titleScreen:FindFirstChild("PlayButton")
	if play and (play:IsA("TextButton") or play:IsA("TextLabel")) then
		task.delay(0.85, function()
			fadeText(play, 0, 0.4)
		end)
	end
end

local function hideTitleScreen(fromPlay: boolean?)
	if not titleScreen or titleDismissed then
		return
	end
	titleDismissed = true

	if fromPlay then
		unlockCamera()
	end

	fadeGui(titleScreen, 1, TITLE_OUT)

	local play = titleScreen:FindFirstChild("PlayButton")
	if play and play:IsA("TextButton") then
		tween(play, TweenInfo.new(TITLE_OUT, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
			BackgroundTransparency = 1,
		})
	end

	task.delay(TITLE_OUT, function()
		if titleScreen then
			titleScreen.Visible = false
		end
		if screenGui then
			screenGui.DisplayOrder = 80
		end
		pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true)
		end)
		if fromPlay then
			unlockMovement()
		end
	end)
end

local function destroyIntroGui()
	waitingJanitor:Cleanup()
	janitor:Cleanup()
	unlockMovement()
	unlockCamera()
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true)
	end)
	if screenGui then
		screenGui:Destroy()
		screenGui = nil
	end
	titleScreen = nil
	createPartyFrame = nil
	storyFrame = nil
	dayFrame = nil
	countdownLabel = nil
	createButton = nil
	sizeButtons = {}
end

local function startCountdownLoop()
	waitingJanitor:Cleanup()
	waitingJanitor:Add(RunService.RenderStepped:Connect(function()
		if not countdownLabel or not countdownEndsAt then
			return
		end
		countdownLabel.Text = formatCountdown(countdownEndsAt - Workspace:GetServerTimeNow())
	end), "Disconnect")
end

local function showCreateParty()
	if not createPartyFrame then
		return
	end
	if titleScreen then
		if titleScreen.Visible then
			hideTitleScreen()
		end
	end
	createPartyFrame.Visible = true
	setGroupTransparency(createPartyFrame, 1)
	fadeGui(createPartyFrame, PANEL_ALPHA, PANEL_FADE)
	lockMovement()
	lockCamera()
end

local function showCountdown()
	if not createPartyFrame then
		return
	end
	for _, btn in ipairs(sizeButtons) do
		btn.Visible = false
	end
	if createButton then
		createButton.Visible = false
	end
	local customize = createPartyFrame:FindFirstChild("CustomizeButton")
	if customize then
		customize.Visible = false
	end
	if countdownLabel then
		countdownLabel.Visible = true
	end
	startCountdownLoop()
end

local function showStory()
	if not createPartyFrame then
		return
	end
	setGroupTransparency(createPartyFrame, 1)
	task.delay(PANEL_FADE, function()
		if createPartyFrame then
			createPartyFrame.Visible = false
		end
	end)
	if not storyFrame then
		return
	end
	storyFrame.Visible = true
	setGroupTransparency(storyFrame, 1)
	storyFrame.BackgroundTransparency = 1
	fadeGui(storyFrame, 0, STORY_FADE)
	storyFrame.BackgroundTransparency = 0
	lockMovement()
	lockCamera()
end

local function showDayCard()
	if storyFrame then
		storyFrame.Visible = false
	end
	if not dayFrame then
		return
	end
	dayFrame.Visible = true
	setGroupTransparency(dayFrame, 1)
	dayFrame.BackgroundTransparency = 1
	fadeGui(dayFrame, 0, 0.6)
	dayFrame.BackgroundTransparency = 0

	-- Teleport already happened while the screen was black; snap the
	-- camera to the player at the campfire before the reveal begins.
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local camera = Workspace.CurrentCamera
	if camera and humanoid then
		camera.CameraType = Enum.CameraType.Custom
		camera.CameraSubject = humanoid
	end
end

local function finishIntro()
	if introFinished then
		return
	end
	introFinished = true
	if not dayFrame then
		unlockMovement()
		unlockCamera()
		if gameStateController then
			gameStateController:MarkIntroComplete()
		end
		destroyIntroGui()
		return
	end
	fadeGui(dayFrame, 1, REVEAL_SECONDS)
	task.delay(REVEAL_SECONDS, function()
		unlockMovement()
		unlockCamera()
		if gameStateController then
			gameStateController:MarkIntroComplete()
		end
		destroyIntroGui()
	end)
end

-- // INITIALIZATION // --

function IntroController:KnitInit()
	buildGui()
	buildTitleScreen()
end

function IntroController:KnitStart()
	gameStateController = Knit.GetController("GameStateController")
	local matchFlow = Knit.GetService("MatchFlowService")

	-- Title screen PLAY button dismisses it and lets the player roam the lobby.
	if titleScreen then
		local play = titleScreen:FindFirstChild("PlayButton")
		if play then
			play.MouseButton1Click:Connect(function()
				hideTitleScreen(true)
			end)
		end
	end

	if createButton then
		createButton.MouseButton1Click:Connect(function()
			if selectedSize ~= 1 or flowState ~= "Waiting" then
				return
			end
			matchFlow.RequestStart:Fire()
		end)
	end

	for i, btn in ipairs(sizeButtons) do
		btn.MouseButton1Click:Connect(function()
			if flowState ~= "Waiting" then
				return
			end
			if i == 1 then
				selectedSize = 1
				updateSizeButtons()
			end
		end)
	end

	matchFlow.FlowStateChanged:Connect(function(state: string)
		if state == flowState then
			return
		end
		-- Title screen is only for the Lobby; dismiss it once the game flow advances.
		if titleScreen then
			if titleScreen.Visible and state ~= "Lobby" then
				hideTitleScreen()
			end
		end
		flowState = state
		if state == "Waiting" then
			showCreateParty()
		elseif state == "Countdown" then
			showCountdown()
		elseif state == "Story" then
			showStory()
		elseif state == "Day1" then
			showDayCard()
		elseif state == "InGame" then
			finishIntro()
		end
	end)

	matchFlow.Countdown:Connect(function(payload)
		if typeof(payload) == "table" and typeof(payload.endsAt) == "number" then
			countdownEndsAt = payload.endsAt
		end
	end)

	-- If the player is still in the Lobby, show the title screen immediately.
	-- Skip if the game has already advanced past Lobby (e.g. test mode).
	if flowState == "Lobby" then
		showTitleScreen()
	end

end

return IntroController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="131">
            <Properties>
              <string name="Name">InventoryController</string>
              <string name="Source"><![CDATA[--[[
    @file    InventoryController.luau
    @author  manik
    @date    2026

    @summary
    Professional carry-bag inventory UI — compact right-side sidebar.

    @description
    A vertical resource sidebar that slides in from the right when the Carry Bag
    tool is equipped. Each resource row shows a coloured icon slot, the resource
    name, a bold count, and (on hover) Eat / Drop action pills. A slim capacity
    bar with a numeric readout sits at the bottom of the panel.

    On touch devices the action pills stay visible because there is no hover.

    @exports
    - InventoryController (Knit Controller)
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)

-- | Objects | --
local InventoryController = Knit.CreateController({
	Name = "InventoryController",
})

-- | Configuration | --
local BAG_TOOL_NAME = "Carry Bag"

-- Panel dimensions
local PANEL_WIDTH = 220
local PANEL_MARGIN = 16
local ROW_HEIGHT = 38
local ROW_GAP = 4
local PANEL_PADDING = 10
local PANEL_GAP = 8
local ICON_SIZE = 28
local HEADER_HEIGHT = 18
local CAPACITY_CONTAINER_HEIGHT = 24
local DROP_ALL_HEIGHT = 28
local ROW_PADDING_X = 8
local ROW_PADDING_Y = 5
local ACTION_BUTTON_WIDTH = 36
local ACTION_GAP = 5
local CAPACITY_HEIGHT = 4

-- Tween timings
local TWEEN_SLIDE = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TWEEN_BOUNCE = TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local TWEEN_HOVER = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TWEEN_FADE = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TWEEN_COUNT_POP = TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local TWEEN_CAPACITY = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- Content data
local EDIBLE_RESOURCES = { Berries = true, Mushrooms = true, RawMeat = true, CookedMeat = true, RabbitMeat = true }
local ROW_ORDER = {
	"Wood",
	"Scrap",
	"Coal",
	"Berries",
	"Mushrooms",
	"RabbitMeat",
	"RawMeat",
	"CookedMeat",
	"Bandage",
	"CultistGem",
}
local ROW_COLORS = {
	Wood = Color3.fromRGB(170, 110, 65),
	Scrap = Color3.fromRGB(150, 155, 165),
	Coal = Color3.fromRGB(70, 70, 75),
	Bandage = Color3.fromRGB(235, 235, 225),
	CultistGem = Color3.fromRGB(175, 90, 210),
	Berries = Color3.fromRGB(195, 50, 80),
	Mushrooms = Color3.fromRGB(210, 110, 95),
	RawMeat = Color3.fromRGB(200, 100, 100),
	CookedMeat = Color3.fromRGB(215, 160, 80),
	RabbitMeat = Color3.fromRGB(200, 100, 100),
}
local ROW_DESCRIPTIONS = {
	Wood = "Used for building and fueling campfires.",
	Scrap = "Salvaged metal used for advanced crafting.",
	Coal = "Burns far longer than wood in the campfire.",
	Bandage = "Revives a downed teammate.",
	CultistGem = "A rare cultist relic used in late crafting.",
	Berries = "Restores a small amount of hunger.",
	Mushrooms = "Restores a small amount of hunger.",
	RawMeat = "Cook it at the campfire to restore more hunger.",
	CookedMeat = "A filling meal that restores lots of hunger.",
	RabbitMeat = "Fresh rabbit meat. Cook it at the campfire.",
}

-- | State Management | --
local localPlayer = Players.LocalPlayer

type RowEntry = {
	row: Frame,
	icon: Frame,
	countLabel: TextLabel,
	nameLabel: TextLabel,
	countBadge: TextLabel,
	eatButton: TextButton,
	dropButton: TextButton,
	actionContainer: Frame,
	lastCount: number,
}

local rowEntries: { [string]: RowEntry } = {}

local bagPanel: Frame? = nil
local bagGui: ScreenGui? = nil
local bagShadow: Frame? = nil
local capacityFill: Frame? = nil
local capacityText: TextLabel? = nil
local tooltipFrame: Frame? = nil
local tooltipTitle: TextLabel? = nil
local tooltipCount: TextLabel? = nil
local tooltipDesc: TextLabel? = nil

local isOpen = false
local useHover = UserInputService.MouseEnabled and not UserInputService.TouchEnabled
local gameStateController: any = nil

-- // FUNCTIONS // --

--[[
    @summary  Build the hover tooltip that appears to the left of a row.
]]
local function buildTooltip(parent: ScreenGui): Frame
	local tooltip = Instance.new("Frame")
	tooltip.Name = "CarryBagTooltip"
	tooltip.Size = UDim2.new(0, 220, 0, 0)
	tooltip.AutomaticSize = Enum.AutomaticSize.Y
	tooltip.BackgroundColor3 = Color3.fromRGB(24, 24, 28)
	tooltip.BackgroundTransparency = 1
	tooltip.BorderSizePixel = 0
	tooltip.ZIndex = 50
	tooltip.Visible = false
	tooltip.Parent = parent

	local tooltipGradient = Instance.new("UIGradient")
	tooltipGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(235, 235, 245)),
	})
	tooltipGradient.Rotation = 90
	tooltipGradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(1, 0.35),
	})
	tooltipGradient.Parent = tooltip

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = tooltip

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(100, 100, 115)
	stroke.Thickness = 1
	stroke.Transparency = 0.1
	stroke.Parent = tooltip

	local arrow = Instance.new("Frame")
	arrow.Name = "Arrow"
	arrow.Size = UDim2.new(0, 12, 0, 12)
	arrow.Position = UDim2.new(0, -6, 0, 8)
	arrow.Rotation = 45
	arrow.BackgroundColor3 = Color3.fromRGB(24, 24, 28)
	arrow.BorderSizePixel = 0
	arrow.ZIndex = 49
	arrow.Parent = tooltip

	local arrowCorner = Instance.new("UICorner")
	arrowCorner.CornerRadius = UDim.new(0, 2)
	arrowCorner.Parent = arrow

	local arrowStroke = Instance.new("UIStroke")
	arrowStroke.Color = Color3.fromRGB(100, 100, 115)
	arrowStroke.Thickness = 1
	arrowStroke.Transparency = 0.1
	arrowStroke.Parent = arrow

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = tooltip

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 12)
	padding.PaddingRight = UDim.new(0, 12)
	padding.PaddingTop = UDim.new(0, 10)
	padding.PaddingBottom = UDim.new(0, 10)
	padding.Parent = tooltip

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Size = UDim2.new(1, 0, 0, 18)
	title.BackgroundTransparency = 1
	title.TextColor3 = Color3.fromRGB(245, 245, 245)
	title.Font = Enum.Font.GothamBlack
	title.TextSize = 16
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextYAlignment = Enum.TextYAlignment.Top
	title.LayoutOrder = 1
	title.Parent = tooltip

	local count = Instance.new("TextLabel")
	count.Name = "Count"
	count.Size = UDim2.new(1, 0, 0, 16)
	count.BackgroundTransparency = 1
	count.TextColor3 = Color3.fromRGB(200, 200, 210)
	count.Font = Enum.Font.GothamBold
	count.TextSize = 13
	count.TextXAlignment = Enum.TextXAlignment.Left
	count.TextYAlignment = Enum.TextYAlignment.Top
	count.LayoutOrder = 2
	count.Parent = tooltip

	local desc = Instance.new("TextLabel")
	desc.Name = "Description"
	desc.Size = UDim2.new(1, 0, 0, 0)
	desc.AutomaticSize = Enum.AutomaticSize.Y
	desc.BackgroundTransparency = 1
	desc.TextColor3 = Color3.fromRGB(170, 170, 185)
	desc.Font = Enum.Font.Gotham
	desc.TextSize = 13
	desc.TextWrapped = true
	desc.TextXAlignment = Enum.TextXAlignment.Left
	desc.TextYAlignment = Enum.TextYAlignment.Top
	desc.LayoutOrder = 3
	desc.Parent = tooltip

	tooltipTitle = title
	tooltipCount = count
	tooltipDesc = desc

	return tooltip
end

--[[
    @summary  Show the tooltip anchored to the left of the given row.
]]
local function showTooltip(row: Frame, resourceName: string, count: number)
	if not tooltipFrame or not tooltipTitle or not tooltipCount or not tooltipDesc then
		return
	end

	tooltipTitle.Text = resourceName
	tooltipCount.Text = "Count: " .. tostring(count)
	tooltipDesc.Text = ROW_DESCRIPTIONS[resourceName] or ""

	local color = ROW_COLORS[resourceName] or Color3.fromRGB(245, 245, 245)
	tooltipTitle.TextColor3 = color

	local arrow = tooltipFrame:FindFirstChild("Arrow")
	if arrow and arrow:IsA("Frame") then
		arrow.BackgroundColor3 = color
		local arrowStroke = arrow:FindFirstChildOfClass("UIStroke")
		if arrowStroke then
			arrowStroke.Color = color
		end
	end

	local stroke = tooltipFrame:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = color
	end

	local rowPos = row.AbsolutePosition
	local rowSize = row.AbsoluteSize

	-- Tooltip width is fixed at 200, height is automatic.
	local targetX = rowPos.X - 220 - 14
	local targetY = rowPos.Y + (rowSize.Y - 60) / 2

	-- Clamp to screen edges.
	local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize
	if viewport then
		targetX = math.max(8, math.min(targetX, viewport.X - 228))
		targetY = math.max(8, math.min(targetY, viewport.Y - 60))
	end

	tooltipFrame.Position = UDim2.fromOffset(targetX, targetY)
	tooltipFrame.Visible = true

	TweenService:Create(tooltipFrame, TWEEN_FADE, { BackgroundTransparency = 0 }):Play()
	local arrowObj = tooltipFrame:FindFirstChild("Arrow")
	if arrowObj then
		arrowObj.Position = UDim2.new(0, -6, 0, math.clamp(rowSize.Y / 2 - 6, 8, 80))
	end
end

--[[
    @summary  Hide the tooltip.
]]
local function hideTooltip()
	if tooltipFrame then
		local tween = TweenService:Create(tooltipFrame, TWEEN_FADE, { BackgroundTransparency = 1 })
		tween:Play()
		tween.Completed:Connect(function()
			if tooltipFrame and tooltipFrame.BackgroundTransparency >= 0.99 then
				tooltipFrame.Visible = false
			end
		end)
	end
end

--[[
    @summary  Build a small pill-style action button.
]]
local function buildPillButton(name: string, text: string, color: Color3, hoverColor: Color3, parent: Frame): TextButton
	local button = Instance.new("TextButton")
	button.Name = name
	button.Size = UDim2.new(0, ACTION_BUTTON_WIDTH, 0, 22)
	button.BackgroundColor3 = color
	button.BackgroundTransparency = 0.15
	button.BorderSizePixel = 0
	button.AutoButtonColor = false
	button.Text = text
	button.TextColor3 = Color3.fromRGB(255, 255, 255)
	button.Font = Enum.Font.GothamBold
	button.TextSize = 11
	button.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = button

	local stroke = Instance.new("UIStroke")
	stroke.Color = hoverColor
	stroke.Thickness = 1
	stroke.Transparency = 0.7
	stroke.Parent = button

	button.MouseEnter:Connect(function()
		TweenService:Create(button, TWEEN_HOVER, { BackgroundColor3 = hoverColor, Size = UDim2.new(0, ACTION_BUTTON_WIDTH + 4, 0, 22) }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(button, TWEEN_HOVER, { BackgroundColor3 = color, Size = UDim2.new(0, ACTION_BUTTON_WIDTH, 0, 22) }):Play()
	end)
	button.MouseButton1Down:Connect(function()
		TweenService:Create(button, TWEEN_HOVER, { Size = UDim2.new(0, ACTION_BUTTON_WIDTH - 2, 0, 20) }):Play()
	end)
	button.MouseButton1Up:Connect(function()
		TweenService:Create(button, TWEEN_HOVER, { Size = UDim2.new(0, ACTION_BUTTON_WIDTH, 0, 22) }):Play()
	end)

	return button
end

--[[
    @summary  Build the capacity bar with numeric label at the bottom of the panel.
]]
local function buildCapacityBar(parent: Frame, y: number)
	local contentW = PANEL_WIDTH - 2 * PANEL_PADDING
	local container = Instance.new("Frame")
	container.Name = "CapacityContainer"
	container.Position = UDim2.new(0, PANEL_PADDING, 0, y)
	container.Size = UDim2.new(0, contentW, 0, CAPACITY_HEIGHT + 20)
	container.BackgroundTransparency = 1
	container.BorderSizePixel = 0
	container.Parent = parent

	local barBackground = Instance.new("Frame")
	barBackground.Name = "CapacityBarBackground"
	barBackground.Size = UDim2.new(1, 0, 0, CAPACITY_HEIGHT)
	barBackground.Position = UDim2.new(0, 0, 0, 0)
	barBackground.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
	barBackground.BackgroundTransparency = 0.2
	barBackground.BorderSizePixel = 0
	barBackground.Parent = container

	local bgCorner = Instance.new("UICorner")
	bgCorner.CornerRadius = UDim.new(1, 0)
	bgCorner.Parent = barBackground

	local fill = Instance.new("Frame")
	fill.Name = "CapacityFill"
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(110, 210, 130)
	fill.BackgroundTransparency = 0.05
	fill.BorderSizePixel = 0
	fill.Parent = barBackground

	local fillGradient = Instance.new("UIGradient")
	fillGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 200, 200)),
	})
	fillGradient.Rotation = 90
	fillGradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.7),
		NumberSequenceKeypoint.new(1, 0.9),
	})
	fillGradient.Parent = fill

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = fill

	local glow = Instance.new("Frame")
	glow.Name = "CapacityGlow"
	glow.Size = UDim2.new(1, 0, 1, 6)
	glow.Position = UDim2.new(0, 0, 0, -3)
	glow.BackgroundColor3 = Color3.fromRGB(110, 210, 130)
	glow.BackgroundTransparency = 0.6
	glow.BorderSizePixel = 0
	glow.ZIndex = 0
	glow.Parent = fill

	local glowCorner = Instance.new("UICorner")
	glowCorner.CornerRadius = UDim.new(1, 0)
	glowCorner.Parent = glow

	local glowGradient = Instance.new("UIGradient")
	glowGradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.7),
		NumberSequenceKeypoint.new(0.5, 0.9),
		NumberSequenceKeypoint.new(1, 1),
	})
	glowGradient.Parent = glow

	local label = Instance.new("TextLabel")
	label.Name = "CapacityText"
	label.Size = UDim2.new(1, 0, 0, 16)
	label.Position = UDim2.new(0, 0, 0, CAPACITY_HEIGHT + 4)
	label.BackgroundTransparency = 1
	label.Text = "0/5"
	label.TextColor3 = Color3.fromRGB(200, 200, 210)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 13
	label.TextXAlignment = Enum.TextXAlignment.Right
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.Parent = container

	capacityFill = fill
	capacityText = label
end

--[[
    @summary  Build the Drop All button that lives at the bottom of the panel.
]]
local function buildDropAllButton(parent: Frame, y: number): TextButton
	local contentW = PANEL_WIDTH - 2 * PANEL_PADDING
	local container = Instance.new("Frame")
	container.Name = "DropAllContainer"
	container.Position = UDim2.new(0, PANEL_PADDING, 0, y)
	container.Size = UDim2.new(0, contentW, 0, 28)
	container.BackgroundTransparency = 1
	container.BorderSizePixel = 0
	container.Parent = parent

	local button = Instance.new("TextButton")
	button.Name = "DropAllButton"
	button.Size = UDim2.new(1, 0, 1, 0)
	button.BackgroundColor3 = Color3.fromRGB(160, 60, 60)
	button.BackgroundTransparency = 0.12
	button.BorderSizePixel = 0
	button.AutoButtonColor = false
	button.Text = "DROP ALL"
	button.TextColor3 = Color3.fromRGB(255, 255, 255)
	button.Font = Enum.Font.GothamBlack
	button.TextSize = 16
	button.Parent = container

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = button

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(190, 75, 75)
	stroke.Thickness = 1
	stroke.Transparency = 0.3
	stroke.Parent = button

	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 200, 200)),
	})
	gradient.Rotation = 90
	gradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.6),
		NumberSequenceKeypoint.new(1, 0.85),
	})
	gradient.Parent = button

	button.MouseEnter:Connect(function()
		TweenService:Create(button, TWEEN_HOVER, { BackgroundColor3 = Color3.fromRGB(190, 75, 75), Size = UDim2.new(1, 4, 1, 4) }):Play()
		TweenService:Create(stroke, TWEEN_HOVER, { Color = Color3.fromRGB(210, 95, 95) }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(button, TWEEN_HOVER, { BackgroundColor3 = Color3.fromRGB(160, 60, 60), Size = UDim2.new(1, 0, 1, 0) }):Play()
		TweenService:Create(stroke, TWEEN_HOVER, { Color = Color3.fromRGB(190, 75, 75) }):Play()
	end)
	button.MouseButton1Down:Connect(function()
		TweenService:Create(button, TWEEN_HOVER, { Size = UDim2.new(1, -2, 1, -2) }):Play()
	end)
	button.MouseButton1Up:Connect(function()
		TweenService:Create(button, TWEEN_HOVER, { Size = UDim2.new(1, 0, 1, 0) }):Play()
	end)

	return button
end

--[[
    @summary  Build a single resource row with icon, labels, and action pills.
]]
local function buildRow(resourceName: string, index: number, parent: Frame): RowEntry
	local color = ROW_COLORS[resourceName] or Color3.fromRGB(120, 120, 120)

	local row = Instance.new("Frame")
	row.Name = resourceName .. "Row"
	row.Size = UDim2.new(1, 0, 0, ROW_HEIGHT)
	row.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
	row.BackgroundTransparency = 0.3
	row.BorderSizePixel = 0
	row.LayoutOrder = index
	row.ClipsDescendants = true
	row.Parent = parent

	local rowCorner = Instance.new("UICorner")
	rowCorner.CornerRadius = UDim.new(0, 8)
	rowCorner.Parent = row

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, ROW_PADDING_X)
	padding.PaddingRight = UDim.new(0, ROW_PADDING_X)
	padding.PaddingTop = UDim.new(0, ROW_PADDING_Y)
	padding.PaddingBottom = UDim.new(0, ROW_PADDING_Y)
	padding.Parent = row

	-- Icon slot with initial.
	local icon = Instance.new("Frame")
	icon.Name = "IconSlot"
	icon.Size = UDim2.new(0, ICON_SIZE, 0, ICON_SIZE)
	icon.Position = UDim2.new(0, 0, 0.5, -ICON_SIZE / 2)
	icon.BackgroundColor3 = color
	icon.BackgroundTransparency = 0.15
	icon.BorderSizePixel = 0
	icon.Parent = row

	local iconGradient = Instance.new("UIGradient")
	iconGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 200, 200)),
	})
	iconGradient.Rotation = -45
	iconGradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 0.25),
	})
	iconGradient.Parent = icon

	local iconStroke = Instance.new("UIStroke")
	iconStroke.Color = Color3.fromRGB(255, 255, 255)
	iconStroke.Thickness = 1
	iconStroke.Transparency = 0.5
	iconStroke.Parent = icon

	local iconCorner = Instance.new("UICorner")
	iconCorner.CornerRadius = UDim.new(0, 8)
	iconCorner.Parent = icon

	local iconInitial = Instance.new("TextLabel")
	iconInitial.Name = "Initial"
	iconInitial.Size = UDim2.new(1, 0, 1, 0)
	iconInitial.BackgroundTransparency = 1
	iconInitial.Text = string.sub(resourceName, 1, 1)
	iconInitial.TextColor3 = Color3.fromRGB(255, 255, 255)
	iconInitial.Font = Enum.Font.GothamBlack
	iconInitial.TextSize = 15
	iconInitial.TextXAlignment = Enum.TextXAlignment.Center
	iconInitial.TextYAlignment = Enum.TextYAlignment.Center
	iconInitial.Parent = icon

	-- Count badge overlaid on the icon.
	local badge = Instance.new("TextLabel")
	badge.Name = "CountBadge"
	badge.Size = UDim2.new(0, 18, 0, 14)
	badge.Position = UDim2.new(1, -14, 1, -12)
	badge.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
	badge.BackgroundTransparency = 0.15
	badge.BorderSizePixel = 0
	badge.Text = "0"
	badge.TextColor3 = Color3.fromRGB(255, 255, 255)
	badge.Font = Enum.Font.GothamBold
	badge.TextSize = 11
	badge.TextXAlignment = Enum.TextXAlignment.Center
	badge.TextYAlignment = Enum.TextYAlignment.Center
	badge.Parent = icon

	local badgeCorner = Instance.new("UICorner")
	badgeCorner.CornerRadius = UDim.new(0, 4)
	badgeCorner.Parent = badge

	-- Name + count block in the centre.
	local textContainer = Instance.new("Frame")
	textContainer.Name = "TextContainer"
	textContainer.Size = UDim2.new(1, -(ICON_SIZE + ACTION_BUTTON_WIDTH * 2 + ACTION_GAP * 2 + 16), 1, 0)
	textContainer.Position = UDim2.new(0, ICON_SIZE + 10, 0, 0)
	textContainer.BackgroundTransparency = 1
	textContainer.BorderSizePixel = 0
	textContainer.ClipsDescendants = true
	textContainer.Parent = row

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "Name"
	nameLabel.Size = UDim2.new(1, 0, 0, 15)
	nameLabel.Position = UDim2.new(0, 0, 0, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = resourceName
	nameLabel.TextColor3 = Color3.fromRGB(225, 225, 235)
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextSize = 13
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.TextYAlignment = Enum.TextYAlignment.Bottom
	nameLabel.Parent = textContainer

	local countLabel = Instance.new("TextLabel")
	countLabel.Name = "Count"
	countLabel.Size = UDim2.new(1, 0, 0, 14)
	countLabel.Position = UDim2.new(0, 0, 0, 15)
	countLabel.BackgroundTransparency = 1
	countLabel.Text = "0"
	countLabel.TextColor3 = Color3.fromRGB(180, 180, 190)
	countLabel.Font = Enum.Font.Gotham
	countLabel.TextSize = 12
	countLabel.TextXAlignment = Enum.TextXAlignment.Left
	countLabel.TextYAlignment = Enum.TextYAlignment.Top
	countLabel.Parent = textContainer

	-- Action buttons container on the right.
	local actionContainer = Instance.new("Frame")
	actionContainer.Name = "ActionContainer"
	actionContainer.Size = UDim2.new(0, ACTION_BUTTON_WIDTH * 2 + ACTION_GAP, 1, 0)
	actionContainer.Position = UDim2.new(1, -(ACTION_BUTTON_WIDTH * 2 + ACTION_GAP), 0, 0)
	actionContainer.BackgroundTransparency = 1
	actionContainer.BorderSizePixel = 0
	actionContainer.ClipsDescendants = false
	actionContainer.Parent = row

	local eatButton = buildPillButton(
		"EatButton",
		"EAT",
		Color3.fromRGB(65, 155, 90),
		Color3.fromRGB(80, 180, 110),
		actionContainer
	)
	eatButton.Position = UDim2.new(0, 0, 0.5, -11)
	eatButton.Visible = EDIBLE_RESOURCES[resourceName] == true

	local dropButton = buildPillButton(
		"DropButton",
		"DROP",
		Color3.fromRGB(170, 75, 65),
		Color3.fromRGB(195, 90, 75),
		actionContainer
	)
	dropButton.Position = UDim2.new(0, ACTION_BUTTON_WIDTH + ACTION_GAP, 0.5, -11)

	-- Keep action buttons always visible so hover/click is reliable.
	-- Hover effects are still handled by onEnter/onLeave.
	actionContainer.BackgroundTransparency = 1

	local entry: RowEntry = {
		row = row,
		icon = icon,
		countLabel = countLabel,
		nameLabel = nameLabel,
		countBadge = badge,
		eatButton = eatButton,
		dropButton = dropButton,
		actionContainer = actionContainer,
		lastCount = 0,
	}

	-- Row hover interactions (desktop only).
	if useHover then
		local function onEnter()
			TweenService:Create(row, TWEEN_HOVER, { BackgroundColor3 = Color3.fromRGB(48, 48, 58), BackgroundTransparency = 0.3 }):Play()
			TweenService:Create(icon, TWEEN_HOVER, { BackgroundTransparency = 0.05, Size = UDim2.new(0, ICON_SIZE + 4, 0, ICON_SIZE + 4), Position = UDim2.new(0, -2, 0.5, -(ICON_SIZE + 4) / 2) }):Play()
			TweenService:Create(iconStroke, TWEEN_HOVER, { Transparency = 0.35 }):Play()
			TweenService:Create(entry.nameLabel, TWEEN_HOVER, { TextColor3 = Color3.fromRGB(255, 255, 255) }):Play()
			TweenService:Create(entry.countLabel, TWEEN_HOVER, { TextColor3 = Color3.fromRGB(225, 225, 235) }):Play()

			showTooltip(row, resourceName, entry.lastCount)
		end

		local function onLeave()
			TweenService:Create(row, TWEEN_HOVER, { BackgroundColor3 = Color3.fromRGB(35, 35, 42), BackgroundTransparency = 0.3 }):Play()
			TweenService:Create(icon, TWEEN_HOVER, { BackgroundTransparency = 0.15, Size = UDim2.new(0, ICON_SIZE, 0, ICON_SIZE), Position = UDim2.new(0, 0, 0.5, -ICON_SIZE / 2) }):Play()
			TweenService:Create(iconStroke, TWEEN_HOVER, { Transparency = 0.5 }):Play()
			TweenService:Create(entry.nameLabel, TWEEN_HOVER, { TextColor3 = Color3.fromRGB(225, 225, 235) }):Play()
			TweenService:Create(entry.countLabel, TWEEN_HOVER, { TextColor3 = Color3.fromRGB(180, 180, 190) }):Play()

			hideTooltip()
		end

		row.MouseEnter:Connect(onEnter)
		row.MouseLeave:Connect(onLeave)
		icon.MouseEnter:Connect(onEnter)
		icon.MouseLeave:Connect(onLeave)
		textContainer.MouseEnter:Connect(onEnter)
		textContainer.MouseLeave:Connect(onLeave)
		actionContainer.MouseEnter:Connect(onEnter)
		actionContainer.MouseLeave:Connect(onLeave)
	end

	rowEntries[resourceName] = entry
	return entry
end

--[[
    @summary  Build the complete bag GUI ScreenGui and panel.
]]
local function buildBagGui(): ScreenGui
	local gui = Instance.new("ScreenGui")
	gui.Name = "CarryBagGui"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Enabled = false

	-- Compute total height explicitly.
	local rowsHeight = #ROW_ORDER * ROW_HEIGHT + (#ROW_ORDER - 1) * ROW_GAP
	local totalHeight = PANEL_PADDING + HEADER_HEIGHT + PANEL_GAP + rowsHeight
		+ PANEL_GAP + CAPACITY_CONTAINER_HEIGHT + PANEL_GAP + DROP_ALL_HEIGHT + PANEL_PADDING

	local panel = Instance.new("Frame")
	panel.Name = "BagPanel"
	panel.AnchorPoint = Vector2.new(1, 1)
	panel.Position = UDim2.new(1, PANEL_WIDTH + PANEL_MARGIN + 20, 1, -PANEL_MARGIN)
	panel.Size = UDim2.new(0, PANEL_WIDTH, 0, totalHeight)
	panel.BackgroundColor3 = Color3.fromRGB(55, 55, 65)
	panel.BackgroundTransparency = 0.15

	local panelGradient = Instance.new("UIGradient")
	panelGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(220, 220, 230)),
	})
	panelGradient.Rotation = 90
	panelGradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(1, 0.35),
	})
	panelGradient.Parent = panel
	panel.BorderSizePixel = 0
	panel.ClipsDescendants = false
	panel.Active = true
	panel.ZIndex = 1
	panel.Parent = gui

	bagPanel = panel
	bagGui = gui

	-- Shadow behind the panel.
	local shadow = Instance.new("Frame")
	shadow.Name = "BagShadow"
	shadow.AnchorPoint = Vector2.new(1, 1)
	shadow.Position = UDim2.new(1, PANEL_WIDTH + PANEL_MARGIN + 26, 1, -PANEL_MARGIN + 6)
	shadow.Size = UDim2.new(0, PANEL_WIDTH + 12, 0, totalHeight + 12)
	shadow.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	shadow.BackgroundTransparency = 0.45
	shadow.BorderSizePixel = 0
	shadow.ZIndex = 0
	shadow.Parent = gui

	local shadowCorner = Instance.new("UICorner")
	shadowCorner.CornerRadius = UDim.new(0, 18)
	shadowCorner.Parent = shadow

	bagShadow = shadow

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 16)
	corner.Parent = panel

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(170, 170, 190)
	stroke.Thickness = 1.5
	stroke.Transparency = 0.3
	stroke.Parent = panel

	local contentW = PANEL_WIDTH - 2 * PANEL_PADDING
	local function nextY(y: number, h: number): number
		return y + h + PANEL_GAP
	end

	local y = PANEL_PADDING

	-- Header.
	local header = Instance.new("TextLabel")
	header.Name = "Header"
	header.Position = UDim2.new(0, PANEL_PADDING, 0, y)
	header.Size = UDim2.new(0, contentW, 0, HEADER_HEIGHT)
	header.BackgroundTransparency = 1
	header.Text = "CARRY BAG"
	header.TextColor3 = Color3.fromRGB(245, 245, 245)
	header.Font = Enum.Font.GothamBlack
	header.TextSize = 15
	header.TextXAlignment = Enum.TextXAlignment.Left
	header.TextYAlignment = Enum.TextYAlignment.Center
	header.Parent = panel

	local hairline = Instance.new("Frame")
	hairline.Name = "HeaderHairline"
	hairline.Position = UDim2.new(0, PANEL_PADDING, 0, y + HEADER_HEIGHT - 2)
	hairline.Size = UDim2.new(0, contentW, 0, 1)
	hairline.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	hairline.BackgroundTransparency = 0.9
	hairline.BorderSizePixel = 0
	hairline.Parent = panel

	y = nextY(y, HEADER_HEIGHT)

	-- Rows container.
	local rowsContainer = Instance.new("Frame")
	rowsContainer.Name = "RowsContainer"
	rowsContainer.Position = UDim2.new(0, PANEL_PADDING, 0, y)
	rowsContainer.Size = UDim2.new(0, contentW, 0, rowsHeight)
	rowsContainer.BackgroundTransparency = 1
	rowsContainer.BorderSizePixel = 0
	rowsContainer.Parent = panel
	y = nextY(y, rowsHeight)

	local rowsLayout = Instance.new("UIListLayout")
	rowsLayout.Padding = UDim.new(0, ROW_GAP)
	rowsLayout.SortOrder = Enum.SortOrder.LayoutOrder
	rowsLayout.Parent = rowsContainer

	for i, resourceName in ipairs(ROW_ORDER) do
		buildRow(resourceName, i, rowsContainer)
	end

	buildCapacityBar(panel, y)
	y = nextY(y, CAPACITY_CONTAINER_HEIGHT)

	buildDropAllButton(panel, y)

	tooltipFrame = buildTooltip(gui)

	return gui
end

--[[
    @summary  Update capacity bar fill, colour, and label.
]]
local function updateCapacity(total: number, capacity: number)
	if not capacityFill or not capacityText then
		return
	end

	local ratio = math.clamp(total / capacity, 0, 1)
	local color: Color3
	if ratio >= 1 then
		color = Color3.fromRGB(220, 80, 80)
	elseif ratio >= 0.75 then
		color = Color3.fromRGB(230, 170, 60)
	else
		color = Color3.fromRGB(110, 210, 130)
	end

	TweenService:Create(capacityFill, TWEEN_CAPACITY, { Size = UDim2.new(ratio, 0, 1, 0), BackgroundColor3 = color }):Play()

	local glow = capacityFill:FindFirstChild("CapacityGlow")
	if glow and glow:IsA("Frame") then
		TweenService:Create(glow, TWEEN_CAPACITY, { BackgroundColor3 = color }):Play()
	end

	capacityText.Text = string.format("%d/%d", total, capacity)

	local dropAllContainer = bagPanel and bagPanel:FindFirstChild("DropAllContainer")
	local dropAllButton = dropAllContainer and dropAllContainer:FindFirstChild("DropAllButton")
	if dropAllButton and dropAllButton:IsA("TextButton") then
		dropAllButton.Active = total > 0
	end
end

--[[
    @summary  Update all count labels, badges, capacity, and play count pop.
]]
local function updateDisplay(resources: { [string]: number }?, capacity: number?)
	local resourceCounts = resources or {}

	local total = 0
	for resourceName, entry in pairs(rowEntries) do
		local count = resourceCounts[resourceName] or 0
		total += count

		entry.countLabel.Text = tostring(count)
		entry.countBadge.Text = tostring(count)
		entry.countBadge.Visible = count > 0

		-- Count pop animation when a value changes.
		if count ~= entry.lastCount then
			entry.lastCount = count
			local originalSize = entry.countLabel.TextSize
			entry.countLabel.TextSize = 16
			TweenService:Create(entry.countLabel, TWEEN_COUNT_POP, { TextSize = originalSize }):Play()
		end

		-- Empty row dimming.
		local dim = count == 0
		local rowTrans = dim and 0.6 or 0.3
		local iconTrans = dim and 0.45 or 0.15
		local nameColor = dim and Color3.fromRGB(160, 160, 170) or Color3.fromRGB(225, 225, 235)
		local countColor = dim and Color3.fromRGB(130, 130, 140) or Color3.fromRGB(180, 180, 190)
		if isOpen then
			TweenService:Create(entry.row, TWEEN_FADE, { BackgroundTransparency = rowTrans }):Play()
			TweenService:Create(entry.icon, TWEEN_FADE, { BackgroundTransparency = iconTrans }):Play()
			TweenService:Create(entry.nameLabel, TWEEN_FADE, { TextColor3 = nameColor }):Play()
			TweenService:Create(entry.countLabel, TWEEN_FADE, { TextColor3 = countColor }):Play()
		end

		-- Disable action buttons when there is nothing to eat/drop.
		if entry.eatButton then
			entry.eatButton.Active = count > 0
		end
		if entry.dropButton then
			entry.dropButton.Active = count > 0
		end

		-- Update tooltip if currently visible for this row.
		if tooltipFrame and tooltipFrame.Visible and tooltipTitle and tooltipCount and tooltipTitle.Text == resourceName then
			tooltipCount.Text = "Count: " .. tostring(count)
		end
	end

	updateCapacity(total, capacity or 5)
end

--[[
    @summary  Slide the bag panel onto the screen.
]]
local function showBag()
	if not gameStateController or not gameStateController:IsInGame() then
		return
	end
	if not bagPanel then
		return
	end
	if isOpen then
		return
	end
	isOpen = true
	if bagGui then
		bagGui.Enabled = true
	end

	for i, resourceName in ipairs(ROW_ORDER) do
		local entry = rowEntries[resourceName]
		if entry then
			entry.row.BackgroundTransparency = 1
			entry.icon.BackgroundTransparency = 1
			task.delay(i * 0.04, function()
				if not isOpen then
					return
				end
				TweenService:Create(entry.row, TWEEN_FADE, { BackgroundTransparency = 0.3 }):Play()
				TweenService:Create(entry.icon, TWEEN_FADE, { BackgroundTransparency = 0.15 }):Play()
			end)
		end
	end

	TweenService:Create(bagPanel, TWEEN_BOUNCE, { Position = UDim2.new(1, -PANEL_MARGIN, 1, -PANEL_MARGIN) }):Play()
	if bagShadow then
		TweenService:Create(bagShadow, TWEEN_BOUNCE, { Position = UDim2.new(1, -PANEL_MARGIN + 6, 1, -PANEL_MARGIN + 6) }):Play()
	end
end

--[[
    @summary  Slide the bag panel off the screen.
]]
local function hideBag()
	if not bagPanel then
		return
	end
	if not isOpen then
		return
	end
	isOpen = false
	if bagGui then
		bagGui.Enabled = false
	end

	hideTooltip()

	for i, resourceName in ipairs(ROW_ORDER) do
		local entry = rowEntries[resourceName]
		if entry then
			task.delay(i * 0.02, function()
				TweenService:Create(entry.row, TWEEN_FADE, { BackgroundTransparency = 1 }):Play()
				TweenService:Create(entry.icon, TWEEN_FADE, { BackgroundTransparency = 1 }):Play()
			end)
		end
	end

	TweenService:Create(bagPanel, TWEEN_SLIDE, { Position = UDim2.new(1, PANEL_WIDTH + PANEL_MARGIN + 20, 1, -PANEL_MARGIN) }):Play()
	if bagShadow then
		TweenService:Create(bagShadow, TWEEN_SLIDE, { Position = UDim2.new(1, PANEL_WIDTH + PANEL_MARGIN + 26, 1, -PANEL_MARGIN + 6) }):Play()
	end
end

--[[
    @summary  Wire the Drop All button and all Eat/Drop buttons.
]]
local function wireInteractions()
	local inventoryService = Knit.GetService("InventoryService")
	local forageService = Knit.GetService("ForageService")

	if not bagPanel then
		return
	end

	local dropAllContainer = bagPanel:FindFirstChild("DropAllContainer")
	local dropAllButton = dropAllContainer and dropAllContainer:FindFirstChild("DropAllButton")
	if dropAllButton and dropAllButton:IsA("TextButton") then
		dropAllButton.MouseButton1Click:Connect(function()
			inventoryService:RequestDropAll():catch(function(err)
				warn("[InventoryController] RequestDropAll failed:", err)
			end)
		end)
	end

	for resourceName, entry in pairs(rowEntries) do
		if EDIBLE_RESOURCES[resourceName] then
			entry.eatButton.MouseButton1Click:Connect(function()
				forageService:RequestEat(resourceName):andThen(function(ate)
					if not ate then
						warn("[InventoryController] RequestEat did not consume", resourceName)
					end
				end):catch(function(err)
					warn("[InventoryController] RequestEat failed:", err)
				end)
			end)
		end

		entry.dropButton.MouseButton1Click:Connect(function()
			inventoryService:RequestDrop(resourceName, 1):catch(function(err)
				warn("[InventoryController] RequestDrop failed:", err)
			end)
		end)
	end
end

--[[
    @summary  Attach equip/unequip listeners to a Carry Bag tool.
]]
local function hookTool(tool: Tool)
	tool.Equipped:Connect(showBag)
	tool.Unequipped:Connect(hideBag)
end

--[[
    @summary  Check backpack and character for the bag tool.
]]
local function findBagTool(): Tool?
	local character = localPlayer.Character
	if character then
		local held = character:FindFirstChild(BAG_TOOL_NAME)
		if held and held:IsA("Tool") then
			return held
		end
	end

	local backpack = localPlayer:FindFirstChild("Backpack")
	if backpack then
		local stored = backpack:FindFirstChild(BAG_TOOL_NAME)
		if stored and stored:IsA("Tool") then
			return stored
		end
	end

	return nil
end

--[[
    @summary  Watch for the bag tool appearing or being equipped.
]]
local function watchBagTool()
	local tool = findBagTool()
	if tool then
		hookTool(tool)
		if tool.Parent == localPlayer.Character then
			showBag()
		end
	end

	local backpack = localPlayer:WaitForChild("Backpack")
	if not backpack then
		return
	end
	local function onChildAdded(child: Instance)
		if child.Name == BAG_TOOL_NAME and child:IsA("Tool") then
			hookTool(child)
		end
	end

	backpack.ChildAdded:Connect(onChildAdded)

	local function onCharacterAdded(character: Model)
		local held = character:WaitForChild(BAG_TOOL_NAME, 5)
		if held and held:IsA("Tool") then
			hookTool(held)
			showBag()
		end
		character.ChildRemoved:Connect(function(child)
			if child.Name == BAG_TOOL_NAME and child:IsA("Tool") then
				hideBag()
			end
		end)
	end

	if localPlayer.Character then
		onCharacterAdded(localPlayer.Character)
	end
	localPlayer.CharacterAdded:Connect(onCharacterAdded)
end

-- // INITIALIZATION // --

function InventoryController:KnitInit()
	local playerGui = localPlayer:WaitForChild("PlayerGui")
	if not playerGui then
		warn("[InventoryController] PlayerGui not found")
		return
	end
	local ok, gui = pcall(buildBagGui)
	if not ok or not gui then
		warn("[InventoryController] Failed to build bag GUI:", gui)
		return
	end
	gui.Parent = playerGui
end

function InventoryController:KnitStart()
	gameStateController = Knit.GetController("GameStateController")
	local inventoryService = Knit.GetService("InventoryService")

	local function onGameStarted()
		wireInteractions()
		watchBagTool()

		inventoryService.ResourcesChanged:Connect(function(resources, capacity)
			updateDisplay(resources, capacity)
		end)

		inventoryService:GetSnapshot():andThen(function(snapshot)
			if typeof(snapshot) == "table" then
				updateDisplay(snapshot.resources, snapshot.capacity)
			end
		end):catch(function(err)
			warn("[InventoryController] Initial snapshot failed:", err)
		end)
	end

	local ok, err = pcall(function()
		if gameStateController and gameStateController:IsInGame() then
			onGameStarted()
		else
			if gameStateController then
				gameStateController.GameStarted:Connect(onGameStarted)
			end
		end
	end)

	if not ok then
		warn("[InventoryController] KnitStart error:", err)
	end
end

return InventoryController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="132">
            <Properties>
              <string name="Name">LifeStateController</string>
              <string name="Source"><![CDATA[--[[
    @file    LifeStateController.luau
    @author  manik
    @date    2025

    @summary
    Downed timer, teammate alerts, revive feedback, spectator camera,
    and reset-button protection for the managed life-state system.
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local Janitor = require(ReplicatedStorage.Packages.Janitor)

-- | Objects | --
local LifeStateController = Knit.CreateController({
	Name = "LifeStateController",
})
local janitor = Janitor.new()

-- | Configuration | --
local NEXT_ACTION = "SpectateNext"
local PREVIOUS_ACTION = "SpectatePrevious"

-- | State Management | --
local lifeService: any = nil
local gui: ScreenGui? = nil
local overlay: Frame? = nil
local titleLabel: TextLabel? = nil
local timerLabel: TextLabel? = nil
local hintLabel: TextLabel? = nil
local selfState = "Lobby"
local bleedOutAt = 0
local spectateIndex = 1

-- // FUNCTIONS // --

--[[
    @summary  Build the life-state overlay once.
]]
local function buildUi()
	if gui then
		return
	end
	gui = Instance.new("ScreenGui")
	gui.Name = "LifeStateGui"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.Enabled = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	overlay = Instance.new("Frame")
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.BackgroundColor3 = Color3.fromRGB(45, 5, 8)
	overlay.BackgroundTransparency = 0.42
	overlay.BorderSizePixel = 0
	overlay.Parent = gui

	titleLabel = Instance.new("TextLabel")
	titleLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	titleLabel.Position = UDim2.fromScale(0.5, 0.4)
	titleLabel.Size = UDim2.new(0.9, 0, 0, 60)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Font = Enum.Font.GothamBlack
	titleLabel.Text = "YOU ARE DOWNED"
	titleLabel.TextColor3 = Color3.fromRGB(245, 225, 215)
	titleLabel.TextScaled = true
	titleLabel.Parent = overlay
	local titleConstraint = Instance.new("UITextSizeConstraint")
	titleConstraint.MaxTextSize = 40
	titleConstraint.MinTextSize = 20
	titleConstraint.Parent = titleLabel

	timerLabel = Instance.new("TextLabel")
	timerLabel.AnchorPoint = Vector2.new(0.5, 0)
	timerLabel.Position = UDim2.fromScale(0.5, 0.48)
	timerLabel.Size = UDim2.fromOffset(240, 48)
	timerLabel.BackgroundTransparency = 1
	timerLabel.Font = Enum.Font.GothamBlack
	timerLabel.Text = "45.0"
	timerLabel.TextColor3 = Color3.fromRGB(255, 90, 80)
	timerLabel.TextSize = 34
	timerLabel.Parent = overlay

	hintLabel = Instance.new("TextLabel")
	hintLabel.AnchorPoint = Vector2.new(0.5, 0)
	hintLabel.Position = UDim2.fromScale(0.5, 0.56)
	hintLabel.Size = UDim2.new(0.85, 0, 0, 52)
	hintLabel.BackgroundTransparency = 1
	hintLabel.Font = Enum.Font.Gotham
	hintLabel.Text = "A teammate needs a Bandage to revive you"
	hintLabel.TextColor3 = Color3.fromRGB(225, 215, 210)
	hintLabel.TextSize = 17
	hintLabel.TextWrapped = true
	hintLabel.Parent = overlay
end

--[[
    @summary  Return living teammates that can be spectated.
    @returns  { Player }
]]
local function livingTeammates(): { Player }
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= Players.LocalPlayer
			and player.Character
			and player.Character:GetAttribute("LifeState") == "Alive"
		then
			table.insert(list, player)
		end
	end
	return list
end

--[[
    @summary  Set the camera to a living teammate at the current index.
]]
local function updateSpectatorCamera()
	local targets = livingTeammates()
	if #targets == 0 then
		return
	end
	spectateIndex = ((spectateIndex - 1) % #targets) + 1
	local humanoid = targets[spectateIndex].Character and targets[spectateIndex].Character:FindFirstChildOfClass("Humanoid")
	if humanoid and workspace.CurrentCamera then
		workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
		workspace.CurrentCamera.CameraSubject = humanoid
	end
	if hintLabel then
		hintLabel.Text = "Spectating " .. targets[spectateIndex].DisplayName .. "  •  Q/E or shoulders to switch"
	end
end

--[[
    @summary  Restore the local character camera after revival or lobby return.
]]
local function restoreCamera()
	local humanoid = Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
	if humanoid and workspace.CurrentCamera then
		workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
		workspace.CurrentCamera.CameraSubject = humanoid
	end
	ContextActionService:UnbindAction(NEXT_ACTION)
	ContextActionService:UnbindAction(PREVIOUS_ACTION)
end

--[[
    @summary  Cycle the spectator target in one direction.
    @param    actionName  string
    @param    inputState  UserInputState
    @returns  ContextActionResult
]]
local function onSpectateAction(actionName: string, inputState: Enum.UserInputState): Enum.ContextActionResult
	if inputState ~= Enum.UserInputState.Begin then
		return Enum.ContextActionResult.Sink
	end
	spectateIndex += if actionName == NEXT_ACTION then 1 else -1
	updateSpectatorCamera()
	return Enum.ContextActionResult.Sink
end

--[[
    @summary  Apply one authoritative local life-state presentation.
    @param    state    string
    @param    payload  table
]]
local function applyState(state: string, payload)
	selfState = state
	buildUi()
	if state == "Downed" then
		bleedOutAt = payload.bleedOutAt or workspace:GetServerTimeNow()
		gui.Enabled = true
		overlay.BackgroundTransparency = 0.42
		titleLabel.Text = "YOU ARE DOWNED"
		hintLabel.Text = "A teammate needs a Bandage to revive you"
	elseif state == "Eliminated" then
		gui.Enabled = true
		overlay.BackgroundTransparency = 0.25
		titleLabel.Text = "YOU WERE LOST"
		timerLabel.Text = "SPECTATING"
		ContextActionService:BindAction(NEXT_ACTION, onSpectateAction, true, Enum.KeyCode.E, Enum.KeyCode.ButtonR1)
		ContextActionService:BindAction(PREVIOUS_ACTION, onSpectateAction, true, Enum.KeyCode.Q, Enum.KeyCode.ButtonL1)
		updateSpectatorCamera()
	else
		gui.Enabled = false
		bleedOutAt = 0
		restoreCamera()
	end
end

--[[
    @summary  Disable Roblox's direct reset path after CoreGui is ready.
]]
local function disableReset()
	for _ = 1, 20 do
		local ok = pcall(function()
			StarterGui:SetCore("ResetButtonCallback", false)
		end)
		if ok then
			return
		end
		task.wait(0.25)
	end
end

-- // INITIALIZATION // --

function LifeStateController:KnitStart()
	lifeService = Knit.GetService("PlayerLifeService")
	buildUi()
	task.spawn(disableReset)

	janitor:Add(lifeService.LifeStateChanged:Connect(function(payload)
		if typeof(payload) == "table" and payload.userId == Players.LocalPlayer.UserId then
			applyState(payload.state, payload)
		end
	end), "Disconnect")

	lifeService:GetSnapshot():andThen(function(snapshot)
		if typeof(snapshot) == "table" then
			applyState(snapshot.selfState or "Lobby", {})
		end
	end)

	janitor:Add(RunService.RenderStepped:Connect(function()
		if selfState == "Downed" and timerLabel then
			local remaining = math.max(0, bleedOutAt - workspace:GetServerTimeNow())
			timerLabel.Text = string.format("%.1f", remaining)
		end
	end), "Disconnect")
end

return LifeStateController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="133">
            <Properties>
              <string name="Name">OwlController</string>
              <string name="Source"><![CDATA[--[[
    @file    OwlController.luau
    @author  manik
    @date    2025

    @summary
    Client-side UI for the Owl NPC — eye icon detection meter,
    "The Owl has woken up" banner, scream flash, and damage feedback.

    @description
    Builds its own ScreenGui with:
    - A centred banner for the Owl awakening announcement
    - Two eye icons that tint from white to red based on the detection meter
    - A red screen flash when the Owl screams (enters chase)
    - A damage flash when the Owl contacts the local player

    @exports
    - OwlController (Knit Controller)
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)

-- | Objects | --
local OwlController = Knit.CreateController({
	Name = "OwlController",
})

-- | Configuration | --
local BANNER_FADE_IN = 0.4
local BANNER_HOLD = 3.5
local BANNER_FADE_OUT = 0.8
local BANNER_COLOR = Color3.fromRGB(180, 200, 255)
local SCREAM_FLASH_DURATION = 0.4
local DAMAGE_FLASH_DURATION = 0.35
local EYE_BASE_COLOR = Color3.fromRGB(220, 220, 220)
local EYE_DANGER_COLOR = Color3.fromRGB(220, 40, 40)

-- | State Management | --
local screenGui: ScreenGui? = nil
local banner: TextLabel? = nil
local bannerThread: thread? = nil
local eyeLeft: ImageLabel? = nil
local eyeRight: ImageLabel? = nil
local eyeContainer: Frame? = nil
local screamCorrection: ColorCorrectionEffect? = nil
local damageCorrection: ColorCorrectionEffect? = nil

-- // FUNCTIONS // --

-- | Private | --

--[[
    @summary  Build the Owl UI ScreenGui once.
]]
local function ensureGui()
	if screenGui then
		return
	end
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

	local gui = Instance.new("ScreenGui")
	gui.Name = "OwlUI"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.Parent = playerGui

	-- Banner (top centre)
	local label = Instance.new("TextLabel")
	label.Name = "OwlBanner"
	label.AnchorPoint = Vector2.new(0.5, 0)
	label.Position = UDim2.new(0.5, 0, 0.08, 0)
	label.Size = UDim2.new(0, 620, 0, 60)
	label.BackgroundColor3 = Color3.fromRGB(10, 10, 20)
	label.BackgroundTransparency = 1
	label.TextColor3 = BANNER_COLOR
	label.Font = Enum.Font.GothamBlack
	label.TextSize = 26
	label.TextTransparency = 1
	label.Text = ""
	label.Parent = gui

	-- Eye icon container (top centre, below banner)
	local container = Instance.new("Frame")
	container.Name = "EyeContainer"
	container.AnchorPoint = Vector2.new(0.5, 0)
	container.Position = UDim2.new(0.5, 0, 0.18, 0)
	container.Size = UDim2.new(0, 200, 0, 80)
	container.BackgroundTransparency = 1
	container.Visible = false
	container.Parent = gui

	-- Left eye
	local leftEye = Instance.new("ImageLabel")
	leftEye.Name = "EyeLeft"
	leftEye.AnchorPoint = Vector2.new(1, 0.5)
	leftEye.Position = UDim2.new(0.45, 0, 0.5, 0)
	leftEye.Size = UDim2.new(0, 70, 0, 70)
	leftEye.BackgroundTransparency = 1
	leftEye.Image = "rbxassetid://277232280" -- generic eye/circle icon
	leftEye.ImageColor3 = EYE_BASE_COLOR
	leftEye.ScaleType = Enum.ScaleType.Fit
	leftEye.Parent = container

	-- Right eye
	local rightEye = Instance.new("ImageLabel")
	rightEye.Name = "EyeRight"
	rightEye.AnchorPoint = Vector2.new(0, 0.5)
	rightEye.Position = UDim2.new(0.55, 0, 0.5, 0)
	rightEye.Size = UDim2.new(0, 70, 0, 70)
	rightEye.BackgroundTransparency = 1
	rightEye.Image = "rbxassetid://277232280"
	rightEye.ImageColor3 = EYE_BASE_COLOR
	rightEye.ScaleType = Enum.ScaleType.Fit
	rightEye.Parent = container

	screenGui = gui
	banner = label
	eyeContainer = container
	eyeLeft = leftEye
	eyeRight = rightEye
end

--[[
    @summary  Show the banner with fade in/hold/fade out.
    @param    text   string
    @param    color  Color3
]]
local function showBanner(text: string, color: Color3)
	ensureGui()
	if not banner then
		return
	end

	if bannerThread then
		task.cancel(bannerThread)
	end

	bannerThread = task.spawn(function()
		banner.Text = text
		banner.TextColor3 = color
		TweenService:Create(banner, TweenInfo.new(BANNER_FADE_IN), {
			TextTransparency = 0,
			BackgroundTransparency = 0.25,
		}):Play()
		task.wait(BANNER_FADE_IN + BANNER_HOLD)
		TweenService:Create(banner, TweenInfo.new(BANNER_FADE_OUT), {
			TextTransparency = 1,
			BackgroundTransparency = 1,
		}):Play()
		bannerThread = nil
	end)
end

--[[
    @summary  Update the eye icon colour based on detection meter (0-1).
    @param    meter  number
]]
local function updateEyeMeter(meter: number)
	ensureGui()
	if not eyeLeft or not eyeRight or not eyeContainer then
		return
	end

	if meter <= 0 then
		eyeContainer.Visible = false
		return
	end

	eyeContainer.Visible = true
	local color = EYE_BASE_COLOR:Lerp(EYE_DANGER_COLOR, meter)
	eyeLeft.ImageColor3 = color
	eyeRight.ImageColor3 = color
end

--[[
    @summary  Flash the screen red briefly (Owl scream).
]]
local function flashScream()
	local correction: ColorCorrectionEffect
	if not screamCorrection then
		local newCorrection = Instance.new("ColorCorrectionEffect") :: ColorCorrectionEffect
		newCorrection.Name = "OwlScreamFlash"
		newCorrection.Parent = Lighting
		screamCorrection = newCorrection
	end
	if not screamCorrection then
		return
	end
	correction = screamCorrection :: ColorCorrectionEffect
	correction.TintColor = Color3.fromRGB(255, 200, 200)
	correction.Brightness = 0.1
	correction.Contrast = 0.2

	task.spawn(function()
		TweenService:Create(correction, TweenInfo.new(SCREAM_FLASH_DURATION), {
			TintColor = Color3.fromRGB(255, 255, 255),
			Brightness = 0,
			Contrast = 0,
		}):Play()
	end)
end

--[[
    @summary  Flash the screen red when the local player takes Owl damage.
]]
local function flashDamage()
	local correction: ColorCorrectionEffect
	if not damageCorrection then
		local newCorrection = Instance.new("ColorCorrectionEffect") :: ColorCorrectionEffect
		newCorrection.Name = "OwlDamageFlash"
		newCorrection.Parent = Lighting
		damageCorrection = newCorrection
	end
	if not damageCorrection then
		return
	end
	correction = damageCorrection :: ColorCorrectionEffect
	correction.TintColor = Color3.fromRGB(160, 0, 0)
	correction.Brightness = 0

	task.spawn(function()
		TweenService:Create(correction, TweenInfo.new(DAMAGE_FLASH_DURATION), {
			TintColor = Color3.fromRGB(255, 255, 255),
		}):Play()
	end)
end

-- // INITIALIZATION // --

function OwlController:KnitStart()
	local owlService = Knit.GetService("OwlService")

	owlService.OwlActive:Connect(function()
		showBanner("The Owl has woken up...", BANNER_COLOR)
	end)

	owlService.OwlDetection:Connect(function(meter: number)
		updateEyeMeter(meter)
	end)

	owlService.OwlScream:Connect(function(_position: Vector3)
		flashScream()
		showBanner("The Owl is hunting you!", EYE_DANGER_COLOR)
	end)

	owlService.OwlContact:Connect(function(_position: Vector3)
		flashDamage()
	end)

	owlService.OwlStunned:Connect(function(_position: Vector3, _duration: number)
		showBanner("The Owl is stunned!", Color3.fromRGB(150, 200, 255))
	end)

	owlService.OwlRetreated:Connect(function()
		updateEyeMeter(0)
		showBanner("The Owl has flown away.", Color3.fromRGB(150, 200, 150))
	end)

end

return OwlController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="134">
            <Properties>
              <string name="Name">Phase4EffectsController</string>
              <string name="Source"><![CDATA[--[[
    @file    Phase4EffectsController.luau
    @author  manik
    @date    2025

    @summary
    Client-only ambience and short-lived feedback for crafting, building,
    cave reveals, child rescues, revives, and the final ending.
]]

-- // VARIABLES // --

-- | Services | --
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local Janitor = require(ReplicatedStorage.Packages.Janitor)
local AssetCatalog = require(ReplicatedStorage.Shared.AssetCatalog)

-- | Objects | --
local Phase4EffectsController = Knit.CreateController({
	Name = "Phase4EffectsController",
})
local janitor = Janitor.new()

-- | Configuration | --
local AUDIO_FADE = TweenInfo.new(2.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
local DAY_NIGHT_VOLUME = 0.24
local HORROR_VOLUME = 0.11

-- | State Management | --
local nightInsects: Sound? = nil
local horrorLayer: Sound? = nil
local impactSound: Sound? = nil
local transitionSound: Sound? = nil

-- // FUNCTIONS // --

--[[
    @summary  Create one managed Sound under SoundService.
    @param    name       string
    @param    soundId    string
    @param    looped     boolean
    @param    volume     number
    @returns  Sound
]]
local function createSound(name: string, soundId: string, looped: boolean, volume: number): Sound
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = soundId
	sound.Looped = looped
	sound.Volume = volume
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.Parent = SoundService
	janitor:Add(sound)
	return sound
end

--[[
    @summary  Crossfade the forest layers for the current phase.
    @param    isNight  boolean
]]
local function setNight(isNight: boolean)
	if not nightInsects or not horrorLayer then
		return
	end
	if not nightInsects.IsPlaying then
		nightInsects:Play()
	end
	if not horrorLayer.IsPlaying then
		horrorLayer:Play()
	end
	TweenService:Create(nightInsects, AUDIO_FADE, { Volume = if isNight then DAY_NIGHT_VOLUME else 0 }):Play()
	TweenService:Create(horrorLayer, AUDIO_FADE, { Volume = if isNight then HORROR_VOLUME else 0 }):Play()
end

--[[
    @summary  Emit a cleaned burst at one world position.
    @param    position  Vector3
    @param    color     Color3
    @param    count     number
]]
local function burst(position: Vector3, color: Color3, count: number)
	local anchor = Instance.new("Part")
	anchor.Name = "Phase4Effect"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.Position = position
	anchor.Parent = workspace

	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 0.6
	emitter.Lifetime = NumberRange.new(0.45, 0.9)
	emitter.Speed = NumberRange.new(5, 11)
	emitter.SpreadAngle = Vector2.new(70, 70)
	emitter.Drag = 3
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Rate = 0
	emitter.Parent = anchor
	emitter:Emit(count)
	Debris:AddItem(anchor, 2)
end

--[[
    @summary  Play the shared impact sound from the listener.
]]
local function playImpact()
	if impactSound then
		impactSound.TimePosition = 0
		impactSound:Play()
	end
end

-- // INITIALIZATION // --

function Phase4EffectsController:KnitStart()
	local timeService = Knit.GetService("TimeService")
	local craftingService = Knit.GetService("CraftingService")
	local buildingService = Knit.GetService("BuildingService")
	local rescueService = Knit.GetService("RescueService")
	local lifeService = Knit.GetService("PlayerLifeService")
	local endingService = Knit.GetService("EndingService")
	local runStateService = Knit.GetService("RunStateService")

	nightInsects = createSound("NightInsects", AssetCatalog.Audio.NightInsects, true, 0)
	horrorLayer = createSound("HorrorForest", AssetCatalog.Audio.HorrorForest, true, 0)
	impactSound = createSound("BuildImpact", AssetCatalog.Audio.BuildImpact, false, 0.3)
	transitionSound = createSound("EndingWhoosh", AssetCatalog.Audio.TransitionWhoosh, false, 0.4)

	janitor:Add(timeService.NightStarted:Connect(function()
		setNight(true)
	end), "Disconnect")
	janitor:Add(timeService.DayStarted:Connect(function()
		setNight(false)
	end), "Disconnect")

	janitor:Add(craftingService.CraftSucceeded:Connect(function()
		playImpact()
	end), "Disconnect")
	janitor:Add(buildingService.StructurePlaced:Connect(function(payload)
		if typeof(payload) == "table" and typeof(payload.cframe) == "CFrame" then
			burst(payload.cframe.Position, Color3.fromRGB(205, 155, 90), 18)
			playImpact()
		end
	end), "Disconnect")
	janitor:Add(rescueService.CaveUnlocked:Connect(function(payload)
		if typeof(payload) == "table" and typeof(payload.position) == "Vector3" then
			burst(payload.position + Vector3.new(0, 7, 0), Color3.fromRGB(215, 80, 65), 28)
		end
	end), "Disconnect")
	janitor:Add(rescueService.RescueChanged:Connect(function()
		local campfire = workspace:FindFirstChild("Campfire", true)
		if campfire and campfire:IsA("BasePart") then
			burst(campfire.Position + Vector3.new(0, 4, 0), Color3.fromRGB(245, 215, 105), 40)
		end
	end), "Disconnect")
	janitor:Add(lifeService.ReviveCompleted:Connect(function(targetUserId)
		local target = game:GetService("Players"):GetPlayerByUserId(targetUserId)
		local rootPart = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
		if rootPart and rootPart:IsA("BasePart") then
			burst(rootPart.Position, Color3.fromRGB(110, 225, 145), 24)
		end
	end), "Disconnect")
	janitor:Add(endingService.EndingStarted:Connect(function()
		setNight(false)
		if transitionSound then
			transitionSound:Play()
		end
	end), "Disconnect")
	janitor:Add(runStateService.RunPhaseChanged:Connect(function(payload)
		if typeof(payload) == "table" and payload.phase == "Lobby" then
			setNight(false)
		end
	end), "Disconnect")
end

return Phase4EffectsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="135">
            <Properties>
              <string name="Name">ProceduralAnimController</string>
              <string name="Source"><![CDATA[--[[
    @file    ProceduralAnimController.luau
    @author  manik
    @date    2025

    @summary
    Subtle idle-breathing motion for the local player's camera.

    @description
    Applies a small sine-wave offset to Humanoid.CameraOffset while
    the character is idle (not moving, not chopping/attacking), so
    standing still doesn't read as a frozen pose.  Disabled while
    another controller is actively driving CameraOffset (chop/combat
    shake), by only nudging when the offset is already near zero.

    @exports
    - ProceduralAnimController (Knit Controller)
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local Janitor = require(ReplicatedStorage.Packages.Janitor)

-- | Objects | --
local ProceduralAnimController = Knit.CreateController({
	Name = "ProceduralAnimController",
})

-- | Configuration | --
local BREATH_FREQUENCY = 1.6
local BREATH_AMPLITUDE = 0.035
local MOVE_SPEED_THRESHOLD = 1

-- | State Management | --
local janitor = Janitor.new()
local gameStateController: any = nil

-- // FUNCTIONS // --

--[[
    @summary  Heartbeat-driven idle breathing offset for the local character.
]]
local function onHeartbeat()
	if not gameStateController or not gameStateController:IsInGame() then
		return
	end

	local character = Players.LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not rootPart or not rootPart:IsA("BasePart") then
		return
	end

	if rootPart.AssemblyLinearVelocity.Magnitude > MOVE_SPEED_THRESHOLD then
		return
	end

	if humanoid.CameraOffset.Magnitude > BREATH_AMPLITUDE * 1.5 then
		return
	end

	local breath = math.sin(os.clock() * BREATH_FREQUENCY * math.pi) * BREATH_AMPLITUDE
	humanoid.CameraOffset = Vector3.new(0, breath, 0)
end

-- // INITIALIZATION // --

function ProceduralAnimController:KnitStart()
	gameStateController = Knit.GetController("GameStateController")
	janitor:Add(RunService.Heartbeat:Connect(onHeartbeat), "Disconnect")
end

return ProceduralAnimController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="136">
            <Properties>
              <string name="Name">RaidBannerController</string>
              <string name="Source"><![CDATA[--[[
    @file    RaidBannerController.luau
    @author  manik
    @date    2025

    @summary
    Shows the Cultist raid warning/started/cleared banner.

    @description
    Builds its own ScreenGui (no pre-placed one exists for raids) and
    fades a centred banner in and out in response to
    CultistRaidService's signals.

    @exports
    - RaidBannerController (Knit Controller)
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)

-- | Objects | --
local RaidBannerController = Knit.CreateController({
	Name = "RaidBannerController",
})

-- | Configuration | --
local FADE_IN_TIME = 0.4
local HOLD_TIME = 3.5
local FADE_OUT_TIME = 0.8
local WARNING_COLOR = Color3.fromRGB(200, 40, 40)
local CLEARED_COLOR = Color3.fromRGB(80, 200, 100)

-- | State Management | --
local screenGui: ScreenGui? = nil
local banner: TextLabel? = nil
local activeThread: thread? = nil

-- // FUNCTIONS // --

--[[
    @summary  Build the raid banner ScreenGui once.
]]
local function ensureGui()
	if screenGui then
		return
	end
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

	local gui = Instance.new("ScreenGui")
	gui.Name = "RaidBanner"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.Parent = playerGui

	local label = Instance.new("TextLabel")
	label.Name = "Banner"
	label.AnchorPoint = Vector2.new(0.5, 0)
	label.Position = UDim2.new(0.5, 0, 0.08, 0)
	label.Size = UDim2.new(0, 620, 0, 60)
	label.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
	label.BackgroundTransparency = 0.25
	label.TextColor3 = WARNING_COLOR
	label.Font = Enum.Font.GothamBlack
	label.TextSize = 26
	label.TextTransparency = 1
	label.BackgroundTransparency = 1
	label.Text = ""
	label.Parent = gui

	screenGui = gui
	banner = label
end

--[[
    @summary  Fade the banner in, hold, then fade it out with the given text/color.
    @param    text   string
    @param    color  Color3
]]
local function showBanner(text: string, color: Color3)
	ensureGui()
	if not banner then
		return
	end

	if activeThread then
		task.cancel(activeThread)
	end

	activeThread = task.spawn(function()
		banner.Text = text
		banner.TextColor3 = color
		TweenService:Create(banner, TweenInfo.new(FADE_IN_TIME), {
			TextTransparency = 0,
			BackgroundTransparency = 0.25,
		}):Play()
		task.wait(FADE_IN_TIME + HOLD_TIME)
		TweenService:Create(banner, TweenInfo.new(FADE_OUT_TIME), {
			TextTransparency = 1,
			BackgroundTransparency = 1,
		}):Play()
		activeThread = nil
	end)
end

-- // INITIALIZATION // --

function RaidBannerController:KnitStart()
	local cultistRaidService = Knit.GetService("CultistRaidService")

	cultistRaidService.RaidWarning:Connect(function(_dayNumber: number)
		showBanner("Something evil is approaching your campfire... it arrives tonight.", WARNING_COLOR)
	end)

	cultistRaidService.RaidStarted:Connect(function(_dayNumber: number, cultistCount: number)
		showBanner(("Cultists are attacking the camp! (%d raiders)"):format(cultistCount), WARNING_COLOR)
	end)

	cultistRaidService.RaidCleared:Connect(function(_dayNumber: number)
		showBanner("The raid has been repelled.", CLEARED_COLOR)
	end)

end

return RaidBannerController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="137">
            <Properties>
              <string name="Name">RescueController</string>
              <string name="Source"><![CDATA[--[[
    @file    RescueController.luau
    @author  manik
    @date    2025

    @summary
    Missing-child waypoint, carry/drop controls, cave notifications,
    and rescue progress feedback across keyboard, touch, and gamepad.
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local Janitor = require(ReplicatedStorage.Packages.Janitor)

-- | Objects | --
local RescueController = Knit.CreateController({
	Name = "RescueController",
})
local janitor = Janitor.new()

-- | Configuration | --
local DROP_ACTION = "DropRescuedChild"

-- | State Management | --
local rescueService: any = nil
local gui: ScreenGui? = nil
local waypointFrame: Frame? = nil
local arrowLabel: TextLabel? = nil
local waypointLabel: TextLabel? = nil
local progressLabel: TextLabel? = nil
local carryLabel: TextLabel? = nil
local bannerLabel: TextLabel? = nil
local targetPosition: Vector3? = nil
local targetName = ""
local carryingChild: string? = nil
local bannerHideAt = 0

-- // FUNCTIONS // --

--[[
    @summary  Build the rescue HUD once.
]]
local function buildUi()
	if gui then
		return
	end
	gui = Instance.new("ScreenGui")
	gui.Name = "RescueGui"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	waypointFrame = Instance.new("Frame")
	waypointFrame.AnchorPoint = Vector2.new(0.5, 0)
	waypointFrame.Position = UDim2.new(0.5, 0, 0, 86)
	waypointFrame.Size = UDim2.fromOffset(300, 62)
	waypointFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
	waypointFrame.BackgroundTransparency = 0.18
	waypointFrame.Visible = false
	waypointFrame.Parent = gui
	local waypointCorner = Instance.new("UICorner")
	waypointCorner.CornerRadius = UDim.new(0, 10)
	waypointCorner.Parent = waypointFrame

	arrowLabel = Instance.new("TextLabel")
	arrowLabel.Position = UDim2.fromOffset(10, 8)
	arrowLabel.Size = UDim2.fromOffset(44, 44)
	arrowLabel.BackgroundTransparency = 1
	arrowLabel.Font = Enum.Font.GothamBlack
	arrowLabel.Text = "▲"
	arrowLabel.TextColor3 = Color3.fromRGB(220, 70, 60)
	arrowLabel.TextSize = 34
	arrowLabel.Parent = waypointFrame

	waypointLabel = Instance.new("TextLabel")
	waypointLabel.Position = UDim2.fromOffset(58, 8)
	waypointLabel.Size = UDim2.new(1, -68, 1, -16)
	waypointLabel.BackgroundTransparency = 1
	waypointLabel.Font = Enum.Font.GothamBold
	waypointLabel.TextColor3 = Color3.fromRGB(240, 235, 220)
	waypointLabel.TextSize = 16
	waypointLabel.TextWrapped = true
	waypointLabel.TextXAlignment = Enum.TextXAlignment.Left
	waypointLabel.Parent = waypointFrame

	progressLabel = Instance.new("TextLabel")
	progressLabel.AnchorPoint = Vector2.new(1, 0)
	progressLabel.Position = UDim2.new(1, -18, 0, 86)
	progressLabel.Size = UDim2.fromOffset(170, 36)
	progressLabel.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
	progressLabel.BackgroundTransparency = 0.2
	progressLabel.Font = Enum.Font.GothamBold
	progressLabel.Text = "CHILDREN  0 / 4"
	progressLabel.TextColor3 = Color3.fromRGB(235, 225, 195)
	progressLabel.TextSize = 15
	progressLabel.Parent = gui
	local progressCorner = Instance.new("UICorner")
	progressCorner.CornerRadius = UDim.new(0, 8)
	progressCorner.Parent = progressLabel

	carryLabel = Instance.new("TextLabel")
	carryLabel.AnchorPoint = Vector2.new(0.5, 1)
	carryLabel.Position = UDim2.new(0.5, 0, 1, -82)
	carryLabel.Size = UDim2.new(0.8, 0, 0, 46)
	carryLabel.BackgroundColor3 = Color3.fromRGB(35, 30, 25)
	carryLabel.BackgroundTransparency = 0.12
	carryLabel.Font = Enum.Font.GothamBold
	carryLabel.Text = "Carrying child  •  G / B to drop"
	carryLabel.TextColor3 = Color3.fromRGB(245, 230, 190)
	carryLabel.TextSize = 17
	carryLabel.Visible = false
	carryLabel.Parent = gui
	local carryConstraint = Instance.new("UISizeConstraint")
	carryConstraint.MaxSize = Vector2.new(480, 46)
	carryConstraint.Parent = carryLabel
	local carryCorner = Instance.new("UICorner")
	carryCorner.CornerRadius = UDim.new(0, 9)
	carryCorner.Parent = carryLabel

	bannerLabel = Instance.new("TextLabel")
	bannerLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	bannerLabel.Position = UDim2.fromScale(0.5, 0.28)
	bannerLabel.Size = UDim2.new(0.85, 0, 0, 72)
	bannerLabel.BackgroundTransparency = 1
	bannerLabel.Font = Enum.Font.GothamBlack
	bannerLabel.TextColor3 = Color3.fromRGB(245, 220, 135)
	bannerLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
	bannerLabel.TextStrokeTransparency = 0.25
	bannerLabel.TextScaled = true
	bannerLabel.Visible = false
	bannerLabel.Parent = gui
	local bannerConstraint = Instance.new("UITextSizeConstraint")
	bannerConstraint.MaxTextSize = 34
	bannerConstraint.MinTextSize = 18
	bannerConstraint.Parent = bannerLabel
end

--[[
    @summary  Show a temporary rescue-system announcement.
    @param    text  string
]]
local function showBanner(text: string)
	bannerLabel.Text = text
	bannerLabel.Visible = true
	bannerHideAt = os.clock() + 4
end

--[[
    @summary  Request dropping the currently carried child.
]]
local function dropChild()
	if not carryingChild then
		return
	end
	rescueService:RequestDropChild()
end

--[[
    @summary  Handle the bound cross-platform drop action.
    @param    _actionName  string
    @param    inputState   UserInputState
    @returns  ContextActionResult
]]
local function onDropAction(_actionName: string, inputState: Enum.UserInputState): Enum.ContextActionResult
	if inputState == Enum.UserInputState.Begin then
		dropChild()
	end
	return Enum.ContextActionResult.Sink
end

--[[
    @summary  Enable or disable carry presentation and controls.
    @param    childId  string?
]]
local function setCarrying(childId: string?)
	carryingChild = childId
	carryLabel.Visible = childId ~= nil
	ContextActionService:UnbindAction(DROP_ACTION)
	if childId then
		carryLabel.Text = "Carrying " .. childId .. " Kid  •  G / B to drop"
		ContextActionService:BindAction(DROP_ACTION, onDropAction, true, Enum.KeyCode.G, Enum.KeyCode.ButtonB)
		ContextActionService:SetTitle(DROP_ACTION, "Drop Child")
		ContextActionService:SetPosition(DROP_ACTION, UDim2.new(1, -105, 1, -100))
	end
end

--[[
    @summary  Update the waypoint direction and distance every rendered frame.
]]
local function updateWaypoint()
	if bannerLabel.Visible and os.clock() >= bannerHideAt then
		bannerLabel.Visible = false
	end
	if not targetPosition then
		waypointFrame.Visible = false
		return
	end
	local rootPart = Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	local camera = workspace.CurrentCamera
	if not rootPart or not rootPart:IsA("BasePart") or not camera then
		waypointFrame.Visible = false
		return
	end
	waypointFrame.Visible = true
	local toTarget = targetPosition - rootPart.Position
	local flatTarget = Vector3.new(toTarget.X, 0, toTarget.Z)
	local flatLook = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
	if flatTarget.Magnitude > 0 and flatLook.Magnitude > 0 then
		local angle = math.atan2(flatLook:Cross(flatTarget).Y, flatLook:Dot(flatTarget))
		arrowLabel.Rotation = -math.deg(angle)
	end
	waypointLabel.Text = string.format("%s\n%.0f studs", targetName, toTarget.Magnitude)
end

-- // INITIALIZATION // --

function RescueController:KnitStart()
	rescueService = Knit.GetService("RescueService")
	local runStateService = Knit.GetService("RunStateService")
	buildUi()
	gui.Enabled = false

	janitor:Add(rescueService.WaypointChanged:Connect(function(payload)
		if typeof(payload) ~= "table" or payload.cleared == true then
			targetPosition = nil
			targetName = ""
			return
		end
		targetPosition = payload.position
		targetName = payload.displayName or "Missing Child"
	end), "Disconnect")

	janitor:Add(rescueService.CaveUnlocked:Connect(function(payload)
		if typeof(payload) == "table" then
			showBanner((payload.displayName or "A child") .. " can now be found")
		end
	end), "Disconnect")

	janitor:Add(rescueService.ChildCarryChanged:Connect(function(payload)
		if typeof(payload) == "table" and payload.userId == Players.LocalPlayer.UserId then
			setCarrying(if payload.carrying then payload.childId else nil)
		end
	end), "Disconnect")

	janitor:Add(rescueService.RescueChanged:Connect(function(payload)
		if typeof(payload) == "table" then
			progressLabel.Text = string.format("CHILDREN  %d / 4", payload.rescuedCount or 0)
			showBanner((payload.displayName or "Child") .. " RESCUED  •  " .. tostring(payload.multiplier or 1) .. "x DAYS")
			if targetName == payload.displayName then
				targetPosition = nil
			end
		end
	end), "Disconnect")

	rescueService:GetSnapshot():andThen(function(snapshot)
		if typeof(snapshot) == "table" then
			progressLabel.Text = string.format("CHILDREN  %d / 4", snapshot.rescuedCount or 0)
			setCarrying(snapshot.carrying)
		end
	end)

	janitor:Add(runStateService.RunPhaseChanged:Connect(function(payload)
		if typeof(payload) ~= "table" then
			return
		end
		if payload.phase == "Active" then
			gui.Enabled = true
		elseif payload.phase == "Lobby" then
			gui.Enabled = false
			targetPosition = nil
			setCarrying(nil)
			progressLabel.Text = "CHILDREN  0 / 4"
		end
	end), "Disconnect")

	janitor:Add(RunService.RenderStepped:Connect(updateWaypoint), "Disconnect")
end

return RescueController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="138">
            <Properties>
              <string name="Name">TimeController</string>
              <string name="Source"><![CDATA[--[[
    @file    TimeController.luau
    @author  manik
    @date    2025

    @summary
    Client-side listener for day/night phase changes.

    @description
    Subscribes to the server's DayStarted and NightStarted signals
    and triggers local-side reactions (UI indicators, ambient audio).
    Concrete UI and audio assets will be wired in a later phase; for
    now the controller exposes local signal hooks for downstream use.

    @exports
    - TimeController.DayStarted   (Signal, local)
    - TimeController.NightStarted (Signal, local)
]]

-- // VARIABLES // --

-- | Services | --
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local Signal = require(ReplicatedStorage.Packages.Signal)

-- | Objects | --
local TimeController = Knit.CreateController({
	Name = "TimeController",
})

-- | State Management | --
local dayStarted = Signal.new()
local nightStarted = Signal.new()

-- // FUNCTIONS // --

--[[
    @summary  Return the local DayStarted signal.
    @returns  Signal
]]
function TimeController:GetDayStartedSignal()
	return dayStarted
end

--[[
    @summary  Return the local NightStarted signal.
    @returns  Signal
]]
function TimeController:GetNightStartedSignal()
	return nightStarted
end

--[[
    @summary  Handler invoked when the server signals day has started.
]]
local function onDayStarted()
	dayStarted:Fire()
end

--[[
    @summary  Handler invoked when the server signals night has started.
]]
local function onNightStarted()
	nightStarted:Fire()
end

-- // INITIALIZATION // --

function TimeController:KnitStart()
	local timeService = Knit.GetService("TimeService")
	timeService.DayStarted:Connect(onDayStarted)
	timeService.NightStarted:Connect(onNightStarted)
end

return TimeController
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
