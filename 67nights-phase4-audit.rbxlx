		MaxHealth = 60,
		AttackDamage = 12,
		AttackRange = 6,
		AttackCooldown = 1.4,
		AggroRange = 40,
		LoseAggroRange = 60,
		PackSize = { Min = 3, Max = 5 },
		ActiveDuring = "Night",
		StatsKey = "WolvesKilled",
		Loot = {
			{ Resource = "RabbitMeat", Min = 1, Max = 2, Chance = 1 },
		},
	},
	AlphaWolfModel = {
		ModelName = "AlphaWolfModel",
		Tier = "Predator",
		RigStyle = "Procedural",
		WalkSpeed = 11,
		RunSpeed = 26,
		MaxHealth = 130,
		AttackDamage = 20,
		AttackRange = 7,
		AttackCooldown = 1.2,
		AggroRange = 46,
		LoseAggroRange = 65,
		PackSize = { Min = 1, Max = 2 },
		ActiveDuring = "Night",
		StatsKey = "WolvesKilled",
		Loot = {
			{ Resource = "RabbitMeat", Min = 2, Max = 3, Chance = 1 },
		},
	},
	Bear = {
