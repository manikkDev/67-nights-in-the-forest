--[[
    @summary  Build a single progress bar (background + fill).
    @param    name   string
    @param    y      number
    @param    color  Color3
    @returns  Frame
]]
local function buildStatRow(parent: Frame, name: string, y: number, labelText: string, color: Color3): (Frame, TextLabel)
	local panel = parent

	local icon = Instance.new("Frame")
	icon.Name = name .. "Icon"
	icon.Size = UDim2.new(0, 16, 0, 16)
	icon.Position = UDim2.new(0, PANEL_MARGIN, 0, y + 2)
	icon.BackgroundColor3 = color
	icon.BorderSizePixel = 0
	icon.Parent = panel

	local iconCorner = Instance.new("UICorner")
	iconCorner.CornerRadius = UDim.new(1, 0)
	iconCorner.Parent = icon

	local iconStroke = Instance.new("UIStroke")
	iconStroke.Color = color
	iconStroke.Transparency = 0.4
	iconStroke.Thickness = 1.5
	iconStroke.Parent = icon

	local label = Instance.new("TextLabel")
	label.Name = name .. "Label"
	label.Size = UDim2.new(0, 44, 0, 16)
	label.Position = UDim2.new(0, PANEL_MARGIN + 22, 0, y + 2)
	label.BackgroundTransparency = 1
	label.Text = labelText
	label.TextColor3 = Color3.fromRGB(220, 220, 225)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 11
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = panel

	local barBackground = Instance.new("Frame")
	barBackground.Name = name .. "BarBackground"
	barBackground.Size = UDim2.new(0, 96, 0, BAR_HEIGHT)
	barBackground.Position = UDim2.new(0, PANEL_MARGIN + 70, 0, y + 5)
	barBackground.BackgroundColor3 = Color3.fromRGB(28, 28, 34)
	barBackground.BackgroundTransparency = 0.05
	barBackground.BorderSizePixel = 0
	barBackground.Parent = panel

	local bgCorner = Instance.new("UICorner")
	bgCorner.CornerRadius = UDim.new(0, 4)
	bgCorner.Parent = barBackground

	local bgStroke = Instance.new("UIStroke")
	bgStroke.Color = Color3.fromRGB(80, 80, 90)
	bgStroke.Transparency = 0.5
	bgStroke.Thickness = 1
	bgStroke.Parent = barBackground

	local fill = Instance.new("Frame")
	fill.Name = name .. "Fill"
	fill.Size = UDim2.new(1, 0, 1, 0)
	fill.BackgroundColor3 = color
	fill.BackgroundTransparency = 0.05
	fill.BorderSizePixel = 0
	fill.Parent = barBackground

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0, 4)
	fillCorner.Parent = fill

	local fillGradient = Instance.new("UIGradient")
	fillGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, color),
		ColorSequenceKeypoint.new(1, color:Lerp(Color3.new(0, 0, 0), 0.35)),
	})
	fillGradient.Rotation = 90
	fillGradient.Parent = fill

	local fillStroke = Instance.new("UIStroke")
	fillStroke.Color = color
	fillStroke.Transparency = 0.65
	fillStroke.Thickness = 1
	fillStroke.Parent = fill

	local valueLabel = Instance.new("TextLabel")
	valueLabel.Name = name .. "Value"
	valueLabel.Size = UDim2.new(0, 52, 0, 16)
	valueLabel.Position = UDim2.new(0, PANEL_WIDTH - PANEL_MARGIN - 52, 0, y + 2)
	valueLabel.BackgroundTransparency = 1
	valueLabel.Text = "0/0"
	valueLabel.TextColor3 = Color3.fromRGB(240, 240, 245)
	valueLabel.Font = Enum.Font.GothamBold
	valueLabel.TextSize = 11
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right
	valueLabel.Parent = panel

	return fill, valueLabel
end

local function _findCampfireFire(): BasePart?
	local baseMap = workspace:FindFirstChild("Base-map")
	if not baseMap then
		return nil
	end
	local bonfire = baseMap:FindFirstChild("Bonfire")
	if not bonfire then
		return nil
	end
	return bonfire:FindFirstChild("Fire") :: BasePart?
end

--[[
    @summary  Build the world-space BillboardGui above the campfire.
]]
local function buildTopLevelProgressBar()
	task.spawn(function()
		local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
		if not playerGui then
			return
		end

		local existing = playerGui:FindFirstChild("CampfireLevelProgressBillboard")
		if existing then
			existing:Destroy()
		end

		-- The map/bonfire can take time to load, so wait for it instead of timing out quickly.
		local baseMap = workspace:WaitForChild("Base-map")
		if not baseMap then
			warn("[CampfireController] Base-map not found for billboard")
			return
		end
		local bonfire = baseMap:WaitForChild("Bonfire")
		if not bonfire then
			warn("[CampfireController] Bonfire not found for billboard")
			return
		end
		local firePart = bonfire:WaitForChild("Fire", 60) :: BasePart?
		if not firePart then
			-- The Fire part may stream in after a delay; try a slower retry.
			local start = os.clock()
			while not firePart and (os.clock() - start) < 60 do
				firePart = bonfire:FindFirstChild("Fire") :: BasePart?
				if not firePart then
					task.wait(1)
				end
			end
			if not firePart then
				warn("[CampfireController] Could not find campfire Fire part for billboard")
				return
			end
		end

		-- Remove any old placeholder billboard that may exist on the fire part.
		for _, child in ipairs(firePart:GetChildren()) do
			if child:IsA("BillboardGui") then
				child:Destroy()
			end
		end

		local billboard = Instance.new("BillboardGui")
		billboard.Name = "CampfireLevelProgressBillboard"
		billboard.Adornee = firePart
		billboard.AlwaysOnTop = true
		billboard.LightInfluence = 0
		billboard.Size = UDim2.new(BILLBOARD_WIDTH, 0, BILLBOARD_HEIGHT, 0)
		billboard.StudsOffsetWorldSpace = Vector3.new(0, BILLBOARD_Y_OFFSET, 0)
		billboard.Enabled = false
		billboard.Parent = firePart
		topLevelBillboard = billboard

		local container = Instance.new("Frame")
		container.Name = "Container"
		container.Size = UDim2.new(1, 0, 1, 0)
		container.BackgroundTransparency = 1
		container.BorderSizePixel = 0
		container.Parent = billboard

		local textLabel = Instance.new("TextLabel")
		textLabel.Name = "LevelText"
		textLabel.Size = UDim2.new(1, 0, 0.45, 0)
		textLabel.Position = UDim2.new(0, 0, 0, 0)
		textLabel.BackgroundTransparency = 1
		textLabel.Text = "level 1 progress: 0/100"
		textLabel.TextColor3 = Color3.fromRGB(240, 240, 240)
		textLabel.Font = Enum.Font.GothamBold
		textLabel.TextScaled = true
		textLabel.TextXAlignment = Enum.TextXAlignment.Center
		textLabel.TextYAlignment = Enum.TextYAlignment.Bottom

		local textStroke = Instance.new("UIStroke")
		textStroke.Color = Color3.fromRGB(0, 0, 0)
		textStroke.Thickness = 1.5
		textStroke.Transparency = 0.4
		textStroke.Parent = textLabel

		textLabel.Parent = container
		topLevelText = textLabel

		local barBackground = Instance.new("Frame")
		barBackground.Name = "BarBackground"
		barBackground.Size = UDim2.new(1, 0, 0.45, 0)
		barBackground.Position = UDim2.new(0, 0, 0.55, 0)
		barBackground.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		barBackground.BorderSizePixel = 0
		barBackground.Parent = container

		local barFill = Instance.new("Frame")
		barFill.Name = "BarFill"
		barFill.Size = UDim2.new(1, 0, 1, 0)
		barFill.BackgroundColor3 = TOP_BAR_COLOR
		barFill.BorderSizePixel = 0
		barFill.Parent = barBackground
		topLevelFill = barFill
	end)
end

--[[
    @summary  Build or rebuild the campfire HUD panel.
]]
local function buildGui()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	if not playerGui then
		return
	end
	local existing = playerGui:FindFirstChild("CampfireGui")
	if existing then
		existing:Destroy()
	end

	local gui = Instance.new("ScreenGui")
	gui.Name = "CampfireGui"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 2
	gui.Enabled = false
	gui.Parent = playerGui
	campfireGui = gui

	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(0, 1)
	panel.Position = UDim2.new(0, PANEL_MARGIN, 1, -PANEL_MARGIN)
	panel.Size = UDim2.new(0, PANEL_WIDTH, 0, PANEL_HEIGHT)
	panel.BackgroundColor3 = Color3.fromRGB(38, 40, 48)
	panel.BackgroundTransparency = 0.02
	panel.BorderSizePixel = 0
	panel.Parent = gui

	local panelCorner = Instance.new("UICorner")
	panelCorner.CornerRadius = UDim.new(0, 12)
	panelCorner.Parent = panel

	local panelStroke = Instance.new("UIStroke")
	panelStroke.Color = Color3.fromRGB(230, 160, 70)
	panelStroke.Transparency = 0.25
	panelStroke.Thickness = 1.5
	panelStroke.Parent = panel

	-- Keep the card solid; a UIGradient here would make it look glassy/transparent.

	local header = Instance.new("TextLabel")
	header.Name = "Header"
	header.Size = UDim2.new(0, 120, 0, 22)
	header.Position = UDim2.new(0, PANEL_MARGIN, 0, 8)
	header.BackgroundTransparency = 1
	header.Text = "CAMPFIRE"
	header.TextColor3 = Color3.fromRGB(230, 220, 200)
	header.Font = Enum.Font.GothamBlack
	header.TextSize = 16
	header.TextXAlignment = Enum.TextXAlignment.Left
	header.Parent = panel

	local levelLabelInstance = Instance.new("TextLabel") :: TextLabel
	levelLabelInstance.Name = "LevelLabel"
	levelLabelInstance.Size = UDim2.new(0, 70, 0, 22)
	levelLabelInstance.Position = UDim2.new(1, -PANEL_MARGIN - 70, 0, 8)
	levelLabelInstance.BackgroundTransparency = 1
	levelLabelInstance.Text = "LVL 1"
	levelLabelInstance.TextColor3 = Color3.fromRGB(230, 220, 200)
	levelLabelInstance.Font = Enum.Font.GothamBold
	levelLabelInstance.TextSize = 16
	levelLabelInstance.TextXAlignment = Enum.TextXAlignment.Right
	levelLabelInstance.Parent = panel
	levelLabel = levelLabelInstance

	fuelFill, fuelValueLabel = buildStatRow(panel, "Fuel", 38, "FUEL", Color3.fromRGB(245, 140, 50))
	levelFill, levelValueLabel = buildStatRow(panel, "Level", 72, "LEVEL", Color3.fromRGB(240, 180, 30))

	local statusLabelInstance = Instance.new("TextLabel") :: TextLabel
	statusLabelInstance.Name = "StatusLabel"
	statusLabelInstance.Size = UDim2.new(1, -PANEL_MARGIN * 2, 0, 16)
	statusLabelInstance.Position = UDim2.new(0, PANEL_MARGIN, 0, 106)
	statusLabelInstance.BackgroundTransparency = 1
	statusLabelInstance.Text = "Lit"
	statusLabelInstance.TextColor3 = Color3.fromRGB(120, 220, 120)
	statusLabelInstance.Font = Enum.Font.GothamBold
	statusLabelInstance.TextSize = 13
	statusLabelInstance.TextXAlignment = Enum.TextXAlignment.Left
	statusLabelInstance.Parent = panel
	statusLabel = statusLabelInstance

	buildWarning()
end

--[[
    @summary  Handler for FuelChanged signal.
]]
local function onFuelChanged(fuel: number, maxFuel: number, fraction: number, isLit: boolean)
	setFuelBar(fuel, maxFuel, isLit)

	-- Keep the warning hidden until we have seen a lit state at least once.
	if hasFuelState then
		setWarning(isLit)
	else
		setWarning(true)
		hasFuelState = true
	end
end

--[[
    @summary  Handler for LevelChanged signal.
]]
local function onLevelChanged(level: number, progress: number, requirement: number, levelFraction: number)
	setLevelBar(level, progress, requirement)
end

--[[
    @summary  Show the level-up banner then fade it out after a hold.
    @param    newLevel      number
    @param    previousLevel number
    @param    radius        number
    @param    maxFuel       number
]]
local function showLevelUp(newLevel: number, previousLevel: number, radius: number, maxFuel: number)
	if not levelUpGui or not levelUpBanner or not levelUpBackground or not levelUpStroke or not levelUpTitle or not levelUpSubtitle then
		return
	end

	-- Ignore duplicate level-up spams; only a new level should restart.
	if newLevel == levelUpShowingLevel then
		return
	end
	levelUpShowingLevel = newLevel

	levelUpTitle.Text = "CAMPFIRE LEVEL " .. tostring(newLevel) .. "!"
	levelUpSubtitle.Text = "Safe zone expanded to " .. tostring(math.round(radius or 0)) .. " studs"

	-- Start fully transparent and slide up while fading in.
	levelUpBanner.Position = UDim2.new(0.5, 0, 0.5, 60)
	levelUpBanner.Size = UDim2.new(0, 360, 0, 80)
	levelUpBackground.BackgroundTransparency = 1
	levelUpStroke.Transparency = 1
	levelUpTitle.TextTransparency = 1
	levelUpSubtitle.TextTransparency = 1
	levelUpGui.Enabled = true

	local inTweens: { Tween } = {}
	table.insert(inTweens, TweenService:Create(levelUpBanner, LEVELUP_TWEEN_INFO, {
		Position = UDim2.new(0.5, 0, 0.5, -40),
	}))
	table.insert(inTweens, TweenService:Create(levelUpBackground, LEVELUP_TWEEN_INFO, {
		BackgroundTransparency = 0.05,
	}))
	table.insert(inTweens, TweenService:Create(levelUpStroke, LEVELUP_TWEEN_INFO, {
		Transparency = 0.3,
	}))
	table.insert(inTweens, TweenService:Create(levelUpTitle, LEVELUP_TWEEN_INFO, {
		TextTransparency = 0,
	}))
	table.insert(inTweens, TweenService:Create(levelUpSubtitle, LEVELUP_TWEEN_INFO, {
		TextTransparency = 0,
	}))
	for _, tween in ipairs(inTweens) do
		tween:Play()
	end

	task.spawn(function()
		local expectedLevel = newLevel
		inTweens[1].Completed:Wait()

		if levelUpShowingLevel ~= expectedLevel then
			return
		end
		task.wait(LEVELUP_HOLD_TIME)
		if levelUpShowingLevel ~= expectedLevel or not levelUpBanner or not levelUpBackground or not levelUpStroke or not levelUpTitle or not levelUpSubtitle then
			return
		end

		local outTweens: { Tween } = {}
		table.insert(outTweens, TweenService:Create(levelUpBanner, LEVELUP_TWEEN_INFO, {
			Position = UDim2.new(0.5, 0, 0.5, -90),
		}))
		table.insert(outTweens, TweenService:Create(levelUpBackground, LEVELUP_TWEEN_INFO, {
			BackgroundTransparency = 1,
		}))
		table.insert(outTweens, TweenService:Create(levelUpStroke, LEVELUP_TWEEN_INFO, {
			Transparency = 1,
		}))
		table.insert(outTweens, TweenService:Create(levelUpTitle, LEVELUP_TWEEN_INFO, {
			TextTransparency = 1,
		}))
		table.insert(outTweens, TweenService:Create(levelUpSubtitle, LEVELUP_TWEEN_INFO, {
			TextTransparency = 1,
		}))
		for _, tween in ipairs(outTweens) do
			tween:Play()
		end
		outTweens[1].Completed:Wait()

		if levelUpGui and levelUpShowingLevel == expectedLevel then
			levelUpGui.Enabled = false
			levelUpShowingLevel = 0
		end
	end)
end

--[[
    @summary  Handler for the LevelUp signal.
]]
local function onLevelUp(level: number, previousLevel: number, radius: number, maxFuel: number)
	showLevelUp(level, previousLevel, radius, maxFuel)
end

-- // INITIALIZATION // --

function CampfireController:KnitStart()
	buildGui()
	buildTopLevelProgressBar()
	buildLevelUpBanner()
	buildWarning()

	local gameStateController = Knit.GetController("GameStateController")
	local runStateService = Knit.GetService("RunStateService")
	campfireService = Knit.GetService("CampfireService")

	local function onGameStarted()
		if campfireGui then
			campfireGui.Enabled = true
		end
		if warningGui then
			warningGui.Enabled = true
		end
		if topLevelBillboard then
			topLevelBillboard.Enabled = true
		end
	end

	if gameStateController and gameStateController:IsInGame() then
		onGameStarted()
	else
		if gameStateController then
			gameStateController.GameStarted:Connect(onGameStarted)
		end
	end

	campfireService.FuelChanged:Connect(onFuelChanged)
	campfireService.LevelChanged:Connect(onLevelChanged)
	campfireService.SafeZoneChanged:Connect(onSafeZoneChanged)
	campfireService.LevelUp:Connect(onLevelUp)

	-- Use :Observe() on ClientRemoteProperty objects to keep local state
	-- authoritative. :Observe() fires the initial value once the property
	-- has synced from the server, and on every subsequent change.
	if campfireService.IsLit then
		campfireService.IsLit:Observe(function(newValue: any)
			local newLit = newValue == true
			if newLit ~= isLit then
				isLit = newLit
				setWarning(isLit)
			end
		end)
	end
	if campfireService.SafeZoneRadius then
		campfireService.SafeZoneRadius:Observe(function(newValue: any)
			currentSafeZoneRadius = newValue or 0
		end)
	end

	runStateService.RunPhaseChanged:Connect(function(payload)
		if typeof(payload) == "table" and payload.phase == "Lobby" then
			if campfireGui then campfireGui.Enabled = false end
			if warningGui then warningGui.Enabled = false end
			if levelUpGui then levelUpGui.Enabled = false end
			if topLevelBillboard then topLevelBillboard.Enabled = false end
		end
	end)

	RunService.Heartbeat:Connect(onHeartbeat)

	-- The initial state is sent by the server through the signal connections.
end

return CampfireController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="120">
            <Properties>
              <string name="Name">CarryController</string>
              <string name="Source"><![CDATA[--[[
    @file    CarryController.luau
    @author  manik
    @date    2025

    @summary
    Cursor-aimed F-key pickup and drop for resource items.

    @description
    Raycasts from the camera through the mouse/center of the screen. When
    the player presses F while pointing at a pickup-able item within range,
    it fires the appropriate server remote to add one unit to their bag
    and destroy the world item. Pressing F while NOT looking at a valid
    target drops all carried items at the player's feet. The inventory UI
    is updated automatically by the server's ResourcesChanged signal.

    Hovering over a world item with the cursor highlights it and shows a
    floating label with the item name and the F-key prompt.

    @exports
    - CarryController (Knit Controller)
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)

-- | Objects | --
local CarryController = Knit.CreateController({
	Name = "CarryController",
})

-- | Configuration | --
local PICKUP_KEY = Enum.KeyCode.F
local PICKUP_RANGE = 12
local PICKUP_COOLDOWN = 0.2
local RAY_LENGTH = 32
local HOVER_EMISSIVE = Color3.fromRGB(160, 220, 255)
local BAG_TOOL_NAME = "Carry Bag"

-- | State Management | --
local localPlayer = Players.LocalPlayer
local gameStateController: any = nil
local harvestService: any = nil
local forageService: any = nil
local inventoryService: any = nil
local lastPickupTime = 0
local hoveredModel: Model? = nil
local hoverHighlight: Highlight? = nil
local hoverNameGui: BillboardGui? = nil

local draggingModel: Model? = nil
local draggingResourceName: string? = nil
local dragTarget: BasePart? = nil
local lastDragTargetSent = 0

-- | Helpers | --

--[[
    @summary  Return true when the player is holding the Carry Bag tool.
]]
local function isHoldingCarryBag(): boolean
	local character = localPlayer.Character
	if not character then
		return false
	end
	return character:FindFirstChild(BAG_TOOL_NAME) ~= nil
end

-- // FUNCTIONS // --

--[[
    @summary  Walk up an instance's parent chain to find the pickup model.
    @returns  Model?, string?  -- the pickup model and the resource name
]]
local function findPickupModel(instance: Instance): (Model?, string?)
	local current = instance
	while current do
		if current:IsA("Model") then
			local resource = current:GetAttribute("Resource")
			local wood = current:GetAttribute("PickupResource")
			local forage = current:GetAttribute("ForageResource")
			local name = resource or wood or forage
			if name and typeof(name) == "string" then
				return current, name
			end
		end
		current = current.Parent
	end
	return nil, nil
end

--[[
    @summary  Get the current camera and build a ray from it through the mouse.
    @returns  BasePart?, Vector3?  -- hit part and world position
]]
local function getMouseRay(): (BasePart?, Vector3?)
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end

	local character = localPlayer and localPlayer.Character
	local mousePos = UserInputService:GetMouseLocation()
	local ray = camera:ViewportPointToRay(mousePos.X, mousePos.Y, 0)

	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	local filterList: {Instance} = {}
	if character then
		table.insert(filterList, character)
	end
	raycastParams.FilterDescendantsInstances = filterList

	local result = workspace:Raycast(ray.Origin, ray.Direction * RAY_LENGTH, raycastParams)
	if not result then
		return nil
	end
	return result.Instance, result.Position
end

--[[
    @summary  Check whether the mouse cursor is currently over any UI element.
    @returns  boolean
]]
local function isMouseOverGui(): boolean
	local mouse = UserInputService:GetMouseLocation()
	local playerGui = localPlayer:FindFirstChild("PlayerGui")
	if not playerGui then
		return false
	end
	local objects = playerGui:GetGuiObjectsAtPosition(mouse.X, mouse.Y)
	for _, gui in ipairs(objects) do
		if gui:IsA("GuiObject") and gui.Visible then
			return true
		end
	end
	return false
end

--[[
    @summary  Check whether the player is close enough to the pickup target.
    @returns  boolean
]]
local function isInRange(model: Model): boolean
	local character = localPlayer and localPlayer.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart or not rootPart:IsA("BasePart") then
		return false
	end

	local targetPos = model:GetPivot().Position
	return (rootPart.Position - targetPos).Magnitude <= PICKUP_RANGE
end

--[[
    @summary  Find the best BasePart in a model to use as the hover anchor.
    @returns  BasePart?
]]
local function getModelAnchor(model: Model): BasePart?
	if model.PrimaryPart then
		return model.PrimaryPart
	end
	return model:FindFirstChildWhichIsA("BasePart", true)
end

--[[
    @summary  Remove the current hover highlight and label.
]]
local function clearHover()
	if hoverHighlight then
		hoverHighlight:Destroy()
		hoverHighlight = nil
	end
	if hoverNameGui then
		hoverNameGui:Destroy()
		hoverNameGui = nil
	end
	hoveredModel = nil
end

--[[
    @summary  Show a soft blue outline and a floating name label on a model.
    @param    model        Model    -- the model to highlight
    @param    resourceName string   -- the display name
]]
local function setHover(model: Model, resourceName: string, promptText: string?)
	promptText = promptText or "[F] Pickup"

	if hoveredModel == model and hoverNameGui then
		local background = hoverNameGui:FindFirstChild("LabelBackground")
		if background then
			local prompt = background:FindFirstChild("PromptLabel")
			if prompt and prompt:IsA("TextLabel") then
				prompt.Text = promptText
			end
		end
		return
	end
	clearHover()
	hoveredModel = model

	local highlight = Instance.new("Highlight") :: Highlight
	highlight.Name = "CarryHoverHighlight"
	highlight.Adornee = model
	highlight.FillColor = HOVER_EMISSIVE
	highlight.OutlineColor = HOVER_EMISSIVE
	highlight.FillTransparency = 0.85
	highlight.OutlineTransparency = 0.3
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = model
	hoverHighlight = highlight

	local anchor = getModelAnchor(model)
	if not anchor then
		return
	end

	local nameGui = Instance.new("BillboardGui") :: BillboardGui
	nameGui.Name = "CarryHoverLabel"
	nameGui.Adornee = anchor
	nameGui.Size = UDim2.new(0, 220, 0, 52)
	nameGui.SizeOffset = Vector2.new(0, 0.5)
	nameGui.StudsOffset = Vector3.new(0, 2.2, 0)
	nameGui.AlwaysOnTop = true
	nameGui.ClipsDescendants = false
	nameGui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	hoverNameGui = nameGui

	local background = Instance.new("Frame")
	background.Name = "LabelBackground"
	background.Size = UDim2.new(1, 0, 1, 0)
	background.BackgroundColor3 = Color3.fromRGB(32, 34, 40)
	background.BackgroundTransparency = 0.15
	background.BorderSizePixel = 0
	background.Parent = nameGui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = background

	local stroke = Instance.new("UIStroke")
	stroke.Color = HOVER_EMISSIVE
	stroke.Thickness = 1.5
	stroke.Parent = background

	local label = Instance.new("TextLabel")
	label.Name = "NameLabel"
	label.Size = UDim2.new(1, -8, 0.55, 0)
	label.Position = UDim2.new(0, 4, 0, 4)
	label.BackgroundTransparency = 1
	label.Text = resourceName
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 18
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.Parent = background

	local prompt = Instance.new("TextLabel")
	prompt.Name = "PromptLabel"
	prompt.Size = UDim2.new(1, -8, 0.4, 0)
	prompt.Position = UDim2.new(0, 4, 0.55, 0)
	prompt.BackgroundTransparency = 1
	prompt.Text = promptText
	prompt.TextColor3 = Color3.fromRGB(180, 220, 255)
	prompt.Font = Enum.Font.GothamBold
	prompt.TextSize = 14
	prompt.TextXAlignment = Enum.TextXAlignment.Center
	prompt.TextYAlignment = Enum.TextYAlignment.Center
	prompt.Parent = background
end

--[[
    @summary  Release the currently dragged item.
]]
local function stopDrag()
	if inventoryService then
		inventoryService:RequestDragStop()
	end
	draggingModel = nil
	draggingResourceName = nil
	dragTarget = nil
end

--[[
    @summary  Move the invisible drag target to the current mouse position in 3D space.
]]
local function updateDragTarget()
	if not dragTarget or not dragTarget.Parent then
		return
	end

	local camera = workspace.CurrentCamera
	if not camera then
		return
	end

	local mousePos = UserInputService:GetMouseLocation()
	local ray = camera:ViewportPointToRay(mousePos.X, mousePos.Y, 0)

	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	local filterList: {Instance} = {}
	if dragTarget then
		table.insert(filterList, dragTarget)
	end
	if draggingModel then
		table.insert(filterList, draggingModel)
	end
	local character = localPlayer.Character
	if character then
		table.insert(filterList, character)
	end
	raycastParams.FilterDescendantsInstances = filterList

	local result = workspace:Raycast(ray.Origin, ray.Direction * RAY_LENGTH, raycastParams)
	local targetPos = result and result.Position or (ray.Origin + ray.Direction * RAY_LENGTH)

	local now = os.clock()
	if now - lastDragTargetSent < 0.03 then
		return
	end
	lastDragTargetSent = now

	if inventoryService then
		inventoryService.DragTargetMoved:Fire(targetPos)
	end
end

--[[
    @summary  Per-frame hover check so items highlight as the cursor moves.
]]
local function updateHover()
	if not gameStateController or not gameStateController:IsInGame() then
		clearHover()
		return
	end

	if not isHoldingCarryBag() then
		if draggingModel then
			stopDrag()
		end
		clearHover()
		return
	end

	if draggingModel and draggingResourceName then
		if not draggingModel.Parent then
			stopDrag()
			clearHover()
			return
		end
		setHover(draggingModel, draggingResourceName, "Release [LMB]")
		updateDragTarget()
		return
	end

	if isMouseOverGui() then
		clearHover()
		return
	end

	local instance = getMouseRay()
	if not instance then
		clearHover()
		return
	end

	local model, resourceName = findPickupModel(instance)
	if model and resourceName then
		setHover(model, resourceName, "[LMB] Drag | [F] Pickup")
	else
		clearHover()
	end
end

--[[
    @summary  Try to pick up the item the player is looking at.
    @param    model         Model   -- the hovered pickup model
    @param    resourceName  string  -- resource type on the model
    @returns  boolean  -- true if a remote was fired
]]
local function tryPickup(model: Model, resourceName: string): boolean
	local now = os.clock()
	if now - lastPickupTime < PICKUP_COOLDOWN then
		return false
	end

	if UserInputService:GetFocusedTextBox() then
		return false
	end

	if not isInRange(model) then
		return false
	end

	lastPickupTime = now

	if resourceName == "Wood" and harvestService then
		harvestService:RequestPickup(model)
	elseif resourceName == "Berries" or resourceName == "Mushrooms" then
		if forageService then
			forageService:RequestPickup(model)
		end
	elseif inventoryService then
		inventoryService:RequestPickup(model)
	end

	return true
end

--[[
    @summary  Drop the oldest item the player is currently carrying.
]]
local function dropOne()
	local now = os.clock()
	if now - lastPickupTime < PICKUP_COOLDOWN then
		return
	end
	lastPickupTime = now

	if inventoryService then
		inventoryService:RequestDropOne()
	end
end

--[[
    @summary  Start dragging a world item with LMB.
    @param    model         Model
    @param    resourceName  string
    @returns  boolean
]]
local function startDrag(model: Model, resourceName: string): boolean
	if not isInRange(model) or not inventoryService then
		return false
	end

	-- ServicePromises is enabled, so RequestDragStart returns a Promise.
	-- Use :await() to get the synchronous boolean result.
	local promise = inventoryService:RequestDragStart(model)
	local ok, result = promise:await()
	if not ok or not result then
		return false
	end

	draggingModel = model
	draggingResourceName = resourceName

	local targetName = "DragTarget_" .. tostring(localPlayer.UserId)
	local target = workspace:WaitForChild(targetName, 2)
	if target and target:IsA("BasePart") then
		dragTarget = target
		updateDragTarget()
	else
		stopDrag()
		return false
	end
	return true
end

--[[
    @summary  Handle keyboard input for the pickup/drop key.
]]
local function onInputBegan(input: InputObject, gameProcessed: boolean)
	if gameProcessed then
		return
	end
	if not gameStateController or not gameStateController:IsInGame() then
		return
	end
	if not isHoldingCarryBag() then
		return
	end

	-- LMB drag start.
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		if isMouseOverGui() then
			return
		end
		if draggingModel then
			return
		end
		if UserInputService:GetFocusedTextBox() then
			return
		end

		local instance = getMouseRay()
		if not instance then
			return
		end

		local model, resourceName = findPickupModel(instance)
		if model and resourceName then
			startDrag(model, resourceName)
		end
		return
	end

	-- F key pickup/drop-one.
	if input.KeyCode ~= PICKUP_KEY then
		return
	end
	if draggingModel then
		return
	end
	if isMouseOverGui() then
		return
	end

	local instance = getMouseRay()
	if not instance then
		dropOne()
		return
	end

	local model, resourceName = findPickupModel(instance)
	if not model or not resourceName then
		dropOne()
		return
	end

	local pickedUp = tryPickup(model, resourceName)
	if not pickedUp then
		-- A valid item is under the cursor but it could be out of range,
		-- on cooldown, or the remote failed.  Do not drop in those cases.
	end
end

--[[
    @summary  Release LMB drag.
]]
local function onInputEnded(input: InputObject)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		if draggingModel then
			stopDrag()
		end
	end
end

-- // INITIALIZATION // --

function CarryController:KnitStart()
	harvestService = Knit.GetService("HarvestService")
	forageService = Knit.GetService("ForageService")
	inventoryService = Knit.GetService("InventoryService")
	gameStateController = Knit.GetController("GameStateController")

	UserInputService.InputBegan:Connect(onInputBegan)
	UserInputService.InputEnded:Connect(onInputEnded)
	RunService.RenderStepped:Connect(updateHover)

end

--[[
    @summary  Expose drag/hover state so other controllers can be context-aware.
]]
function CarryController.IsDragging(): boolean
	return draggingModel ~= nil
end

function CarryController.GetHoveredModel(): Model?
	return hoveredModel
end

return CarryController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="121">
            <Properties>
              <string name="Name">CombatController</string>
              <string name="Source"><![CDATA[--[[
    @file    CombatController.luau
    @author  manik
    @date    2025

    @summary
    Client-side Spear tool handling and shared melee/NPC-attack VFX.

    @description
    Wires the Spear's swing (the Axe's swing is handled by
    HarvestController, which now also routes through CombatService).
    Plays a spark burst and camera shake when a weapon hit lands, and
    a brief red damage flash when the local player is struck by an
    NPC or the Deer/Ram Monster stalkers.

    @exports
    - CombatController (Knit Controller)
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local Janitor = require(ReplicatedStorage.Packages.Janitor)

-- | Objects | --
local CombatController = Knit.CreateController({
	Name = "CombatController",
})

-- | Configuration | --
local SPEAR_TOOL_NAME = "Spear"
local SHAKE_DURATION = 0.15
local SHAKE_MAGNITUDE = 0.16
local DAMAGE_FLASH_DURATION = 0.35
local DAMAGE_FLASH_TINT = Color3.fromRGB(160, 0, 0)

-- | State Management | --
local janitor = Janitor.new()
local toolJanitor = Janitor.new()
local charJanitor = Janitor.new()
local gameStateController: any = nil
local damageCorrection: ColorCorrectionEffect? = nil

-- // FUNCTIONS // --

--[[
    @summary  Apply a brief decaying random offset to the local
              character's camera to sell an attack impact.
]]
local function shakeCamera()
	task.spawn(function()
		local character = Players.LocalPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			return
		end

		local elapsed = 0
		while elapsed < SHAKE_DURATION do
			local dt = task.wait()
			elapsed += dt
			local falloff = 1 - (elapsed / SHAKE_DURATION)
			humanoid.CameraOffset = Vector3.new(
				(math.random() - 0.5) * 2 * SHAKE_MAGNITUDE * falloff,
				(math.random() - 0.5) * 2 * SHAKE_MAGNITUDE * falloff,
				0
			)
		end
		humanoid.CameraOffset = Vector3.zero
	end)
end

--[[
    @summary  Spawn a short spark particle burst at a world position.
    @param    position  Vector3
]]
local function spawnHitSpark(position: Vector3)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.Position = position
	anchor.Parent = workspace

	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(Color3.fromRGB(255, 230, 160))
	emitter.Lifetime = NumberRange.new(0.2, 0.4)
	emitter.Speed = NumberRange.new(8, 16)
	emitter.SpreadAngle = Vector2.new(60, 60)
	emitter.Size = NumberSequence.new(0.25, 0.02)
	emitter.Rate = 0
	emitter.Parent = anchor

	emitter:Emit(16)
	Debris:AddItem(anchor, 1.5)
end

--[[
    @summary  Ensure a dedicated ColorCorrectionEffect exists for the
              damage flash so it doesn't fight CampSafetyController's.
    @returns  ColorCorrectionEffect
]]
local function ensureDamageCorrection(): ColorCorrectionEffect
	if damageCorrection and damageCorrection.Parent then
		return damageCorrection
	end
	local existing = Lighting:FindFirstChild("CombatDamageCorrection")
	if existing and existing:IsA("ColorCorrectionEffect") then
		damageCorrection = existing
		return existing
	end
	local correction = Instance.new("ColorCorrectionEffect")
	correction.Name = "CombatDamageCorrection"
	correction.TintColor = Color3.new(1, 1, 1)
	correction.Parent = Lighting
	damageCorrection = correction
	return correction
end

--[[
    @summary  Flash the screen red briefly to signal the local player
              was struck.
]]
local function flashDamage()
	local correction = ensureDamageCorrection()
	correction.TintColor = DAMAGE_FLASH_TINT
	TweenService:Create(correction, TweenInfo.new(DAMAGE_FLASH_DURATION, Enum.EasingStyle.Quad), {
		TintColor = Color3.new(1, 1, 1),
	}):Play()
end

--[[
    @summary  Wire Tool.Activated on the given Spear tool.
    @param    tool  Tool
]]
local function wireSpear(tool: Tool)
	toolJanitor:Cleanup()
	toolJanitor:Add(tool.Activated:Connect(function()
		if not gameStateController or not gameStateController:IsInGame() then
			return
		end
		local combatService = Knit.GetService("CombatService")
		combatService.RequestAttack()
	end), "Disconnect")
end

--[[
    @summary  Watch the player's Backpack and Character for the Spear
              tool being equipped.
    @param    player  Player
]]
local function watchForSpear(player: Player)
	local function checkCharacter(character: Model)
		toolJanitor:Cleanup()
		charJanitor:Cleanup()

		local tool = character:FindFirstChild(SPEAR_TOOL_NAME)
		if tool and tool:IsA("Tool") then
			wireSpear(tool)
		end

		charJanitor:Add(character.ChildAdded:Connect(function(child)
			if child:IsA("Tool") and child.Name == SPEAR_TOOL_NAME then
				wireSpear(child)
			end
		end), "Disconnect")
	end

	janitor:Cleanup()
	janitor:Add(player.CharacterAdded:Connect(checkCharacter), "Disconnect")

	if player.Character then
		checkCharacter(player.Character)
	end
end

-- // INITIALIZATION // --

function CombatController:KnitStart()
	gameStateController = Knit.GetController("GameStateController")
	local player = Players.LocalPlayer

	local function onGameStarted()
		watchForSpear(player)
	end

	if gameStateController and gameStateController:IsInGame() then
		onGameStarted()
	else
		if gameStateController then
			gameStateController.GameStarted:Connect(onGameStarted)
		end
	end

	local combatService = Knit.GetService("CombatService")
	combatService.AttackLanded:Connect(function(position: Vector3, _weaponName: string, wasImmune: boolean)
		spawnHitSpark(position)
		if not wasImmune then
			shakeCamera()
		end
	end)

	local animalAIService = Knit.GetService("AnimalAIService")
	animalAIService.NpcAttacked:Connect(function(_position: Vector3)
		shakeCamera()
		flashDamage()
	end)

	local deerService = Knit.GetService("DeerService")
	deerService.StalkerContact:Connect(function(_position: Vector3, _key: string)
		shakeCamera()
		flashDamage()
	end)

end

return CombatController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="122">
            <Properties>
              <string name="Name">CraftingController</string>
              <string name="Source"><![CDATA[--[[
    @file    CraftingController.luau
    @author  manik
    @date    2025

    @summary
    Responsive crafting bench menu for keyboard, touch, and gamepad.
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GuiService = game:GetService("GuiService")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local RecipeConfig = require(ReplicatedStorage.Shared.RecipeConfig)

-- | Objects | --
local CraftingController = Knit.CreateController({
	Name = "CraftingController",
})

-- | State Management | --
local craftingService: any = nil
local gui: ScreenGui? = nil
local panel: Frame? = nil
local titleLabel: TextLabel? = nil
local resourcesLabel: TextLabel? = nil
local listFrame: ScrollingFrame? = nil
local buttons: { [string]: TextButton } = {}
local currentState = { tier = 1, resources = {}, recipeCounts = {}, unlocks = {} }
local requestPending = false

-- // FUNCTIONS // --

--[[
    @summary  Return a stable recipe order for the menu.
    @returns  { table }
]]
local function orderedRecipes()
	local recipes = {}
	for _, recipe in pairs(RecipeConfig) do
		table.insert(recipes, recipe)
	end
	table.sort(recipes, function(a, b)
		if a.Tier ~= b.Tier then
			return a.Tier < b.Tier
		end
		return a.DisplayName < b.DisplayName
	end)
	return recipes
end

--[[
    @summary  Format a resource-cost map into readable text.
    @param    cost  table
    @returns  string
]]
local function formatCost(cost): string
	local parts = {}
	for resourceName, amount in pairs(cost) do
		table.insert(parts, amount .. " " .. resourceName)
	end
	table.sort(parts)
	return table.concat(parts, "  |  ")
end

--[[
    @summary  Return whether the current snapshot can pay one recipe.
    @param    recipe  table
    @returns  boolean
]]
local function canAfford(recipe): boolean
	for resourceName, amount in pairs(recipe.Cost) do
		if (currentState.resources[resourceName] or 0) < amount then
			return false
		end
	end
	return true
end

--[[
    @summary  Refresh recipe buttons from the authoritative snapshot.
]]
local function refreshDisplay()
	if titleLabel then
		titleLabel.Text = "CRAFTING BENCH  •  TIER " .. tostring(currentState.tier)
	end
	if resourcesLabel then
		resourcesLabel.Text = string.format(
			"Wood %d   Scrap %d   Cultist Gems %d",
			currentState.resources.Wood or 0,
			currentState.resources.Scrap or 0,
			currentState.resources.CultistGem or 0
		)
	end
	for recipeId, button in pairs(buttons) do
		local recipe = RecipeConfig[recipeId]
		local count = currentState.recipeCounts[recipeId] or 0
		local capReached = recipe.RunCap and count >= recipe.RunCap
		local tierLocked = recipe.Tier > currentState.tier
		local affordable = canAfford(recipe)
		button.Active = not requestPending and not capReached and not tierLocked and affordable
		button.AutoButtonColor = button.Active
		button.BackgroundColor3 = if tierLocked
			then Color3.fromRGB(55, 55, 60)
			elseif capReached
			then Color3.fromRGB(65, 75, 65)
			elseif affordable
			then Color3.fromRGB(70, 125, 70)
			else Color3.fromRGB(100, 70, 65)
		local statusText = if tierLocked
			then "\nRequires Tier " .. tostring(recipe.Tier)
			elseif capReached then "\nBuilt"
			else ""
		button.Text = recipe.DisplayName .. "\n" .. formatCost(recipe.Cost) .. statusText
	end
end

--[[
    @summary  Request one recipe and surface its result in the menu.
    @param    recipeId  string
]]
local function requestCraft(recipeId: string)
	if requestPending or not craftingService then
		return
	end
	requestPending = true
	refreshDisplay()
	craftingService:RequestCraft(recipeId):andThen(function(result)
		requestPending = false
		if typeof(result) == "table" and result.ok ~= true and resourcesLabel then
			resourcesLabel.Text = "Cannot craft: " .. tostring(result.code)
		end
		craftingService:GetBenchState():andThen(function(snapshot)
			if typeof(snapshot) == "table" then
				currentState = snapshot
				refreshDisplay()
			end
		end)
	end):catch(function()
		requestPending = false
		if resourcesLabel then
			resourcesLabel.Text = "Crafting request failed"
		end
		refreshDisplay()
	end)
end

--[[
    @summary  Build the crafting interface once for the local player.
]]
local function buildUi()
	if gui then
		return
	end

	gui = Instance.new("ScreenGui")
	gui.Name = "CraftingGui"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.Enabled = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.new(0.82, 0, 0.82, 0)
	panel.BackgroundColor3 = Color3.fromRGB(24, 24, 27)
	panel.BorderSizePixel = 0
	panel.Parent = gui
	local sizeConstraint = Instance.new("UISizeConstraint")
	sizeConstraint.MaxSize = Vector2.new(720, 620)
	sizeConstraint.MinSize = Vector2.new(300, 360)
	sizeConstraint.Parent = panel
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = panel

	titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "Title"
	titleLabel.Position = UDim2.new(0, 18, 0, 12)
	titleLabel.Size = UDim2.new(1, -90, 0, 34)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Font = Enum.Font.GothamBlack
	titleLabel.TextColor3 = Color3.fromRGB(235, 225, 195)
	titleLabel.TextSize = 22
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.Parent = panel

	local close = Instance.new("TextButton")
	close.Name = "Close"
	close.AnchorPoint = Vector2.new(1, 0)
	close.Position = UDim2.new(1, -12, 0, 12)
	close.Size = UDim2.fromOffset(44, 34)
	close.BackgroundColor3 = Color3.fromRGB(120, 55, 50)
	close.Font = Enum.Font.GothamBold
	close.Text = "X"
	close.TextColor3 = Color3.new(1, 1, 1)
	close.TextSize = 18
	close.Parent = panel
	local closeCorner = Instance.new("UICorner")
	closeCorner.CornerRadius = UDim.new(0, 8)
	closeCorner.Parent = close
	close.Activated:Connect(function()
		gui.Enabled = false
	end)

	resourcesLabel = Instance.new("TextLabel")
	resourcesLabel.Position = UDim2.new(0, 18, 0, 51)
	resourcesLabel.Size = UDim2.new(1, -36, 0, 26)
	resourcesLabel.BackgroundTransparency = 1
	resourcesLabel.Font = Enum.Font.Gotham
	resourcesLabel.TextColor3 = Color3.fromRGB(185, 185, 190)
	resourcesLabel.TextSize = 14
	resourcesLabel.TextXAlignment = Enum.TextXAlignment.Left
	resourcesLabel.Parent = panel

	listFrame = Instance.new("ScrollingFrame")
	listFrame.Name = "Recipes"
	listFrame.Position = UDim2.new(0, 16, 0, 84)
	listFrame.Size = UDim2.new(1, -32, 1, -100)
	listFrame.BackgroundTransparency = 1
	listFrame.BorderSizePixel = 0
	listFrame.ScrollBarThickness = 6
	listFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
	listFrame.CanvasSize = UDim2.new()
	listFrame.Parent = panel
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 7)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = listFrame

	for order, recipe in ipairs(orderedRecipes()) do
		local button = Instance.new("TextButton")
		button.Name = recipe.Id
		button.LayoutOrder = order
		button.Size = UDim2.new(1, -8, 0, 64)
		button.BackgroundColor3 = Color3.fromRGB(70, 125, 70)
		button.Font = Enum.Font.GothamBold
		button.TextColor3 = Color3.fromRGB(245, 245, 240)
		button.TextSize = 15
		button.TextWrapped = true
		button.Selectable = true
		button.Parent = listFrame
		local buttonCorner = Instance.new("UICorner")
		buttonCorner.CornerRadius = UDim.new(0, 8)
		buttonCorner.Parent = button
		button.Activated:Connect(function()
			requestCraft(recipe.Id)
		end)
		buttons[recipe.Id] = button
	end
end

--[[
    @summary  Open the menu and request a fresh authoritative snapshot.
]]
local function openMenu()
	buildUi()
	craftingService:GetBenchState():andThen(function(snapshot)
		if typeof(snapshot) == "table" then
			currentState = snapshot
		end
		refreshDisplay()
		gui.Enabled = true
		local firstRecipe = orderedRecipes()[1]
		if firstRecipe and buttons[firstRecipe.Id] then
			GuiService.SelectedObject = buttons[firstRecipe.Id]
		end
	end)
end

-- // INITIALIZATION // --

function CraftingController:KnitStart()
	craftingService = Knit.GetService("CraftingService")
	buildUi()
	craftingService.OpenCrafting:Connect(openMenu)
	craftingService.CraftSucceeded:Connect(function(_recipeId, result)
		if typeof(result) == "table" and result.outputKind == "Placement" and gui then
			gui.Enabled = false
		end
	end)
	craftingService.CraftingStateChanged:Connect(function(snapshot)
		if typeof(snapshot) == "table" then
			currentState.tier = snapshot.tier or currentState.tier
			currentState.recipeCounts = snapshot.recipeCounts or currentState.recipeCounts
			currentState.unlocks = snapshot.unlocks or currentState.unlocks
			if gui and gui.Enabled then
				craftingService:GetBenchState():andThen(function(fullSnapshot)
					if typeof(fullSnapshot) == "table" then
						currentState = fullSnapshot
						refreshDisplay()
					end
				end)
			end
		end
	end)
end

return CraftingController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="123">
            <Properties>
              <string name="Name">EndingController</string>
              <string name="Source"><![CDATA[--[[
    @file    EndingController.luau
    @author  manik
    @date    2025

    @summary
    Day 67 victory and defeat presentation with final run statistics.
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)

-- | Objects | --
local EndingController = Knit.CreateController({
	Name = "EndingController",
})

-- | State Management | --
local endingService: any = nil
local runStateService: any = nil
local gui: ScreenGui? = nil
local backdrop: Frame? = nil
local titleLabel: TextLabel? = nil
local subtitleLabel: TextLabel? = nil
local statsLabel: TextLabel? = nil

-- // FUNCTIONS // --

--[[
    @summary  Format seconds as minutes and seconds.
    @param    seconds  number
    @returns  string
]]
local function formatTime(seconds: number): string
	local total = math.max(0, math.floor(seconds))
	return string.format("%02d:%02d", math.floor(total / 60), total % 60)
end

--[[
    @summary  Build the ending overlay once.
]]
local function buildUi()
	if gui then
		return
	end
	gui = Instance.new("ScreenGui")
	gui.Name = "EndingGui"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 100
	gui.Enabled = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	backdrop = Instance.new("Frame")
	backdrop.Size = UDim2.fromScale(1, 1)
	backdrop.BackgroundColor3 = Color3.fromRGB(5, 7, 9)
	backdrop.BackgroundTransparency = 1
	backdrop.BorderSizePixel = 0
	backdrop.Parent = gui

	titleLabel = Instance.new("TextLabel")
	titleLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	titleLabel.Position = UDim2.fromScale(0.5, 0.24)
	titleLabel.Size = UDim2.new(0.9, 0, 0, 78)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Font = Enum.Font.GothamBlack
	titleLabel.Text = "DAY 67 SURVIVED"
	titleLabel.TextColor3 = Color3.fromRGB(240, 220, 165)
	titleLabel.TextTransparency = 1
	titleLabel.TextScaled = true
	titleLabel.Parent = backdrop
	local titleConstraint = Instance.new("UITextSizeConstraint")
	titleConstraint.MaxTextSize = 52
	titleConstraint.MinTextSize = 25
	titleConstraint.Parent = titleLabel

	subtitleLabel = Instance.new("TextLabel")
	subtitleLabel.AnchorPoint = Vector2.new(0.5, 0)
	subtitleLabel.Position = UDim2.fromScale(0.5, 0.32)
	subtitleLabel.Size = UDim2.new(0.9, 0, 0, 36)
	subtitleLabel.BackgroundTransparency = 1
	subtitleLabel.Font = Enum.Font.Gotham
	subtitleLabel.TextColor3 = Color3.fromRGB(190, 190, 185)
	subtitleLabel.TextSize = 19
	subtitleLabel.TextTransparency = 1
	subtitleLabel.Parent = backdrop

	statsLabel = Instance.new("TextLabel")
	statsLabel.AnchorPoint = Vector2.new(0.5, 0)
	statsLabel.Position = UDim2.fromScale(0.5, 0.41)
	statsLabel.Size = UDim2.new(0.86, 0, 0.48, 0)
	statsLabel.BackgroundColor3 = Color3.fromRGB(18, 20, 22)
	statsLabel.BackgroundTransparency = 0.2
	statsLabel.Font = Enum.Font.Gotham
	statsLabel.TextColor3 = Color3.fromRGB(225, 225, 220)
	statsLabel.TextSize = 18
	statsLabel.TextWrapped = true
	statsLabel.TextYAlignment = Enum.TextYAlignment.Top
	statsLabel.Text = ""
	statsLabel.TextTransparency = 1
	statsLabel.Parent = backdrop
	local statsCorner = Instance.new("UICorner")
	statsCorner.CornerRadius = UDim.new(0, 12)
	statsCorner.Parent = statsLabel
end

--[[
    @summary  Show the shared victory or defeat title transition.
    @param    payload  table
]]
local function showEnding(payload)
	buildUi()
	gui.Enabled = true
	backdrop.BackgroundTransparency = 1
	titleLabel.TextTransparency = 1
	subtitleLabel.TextTransparency = 1
	statsLabel.TextTransparency = 1
	statsLabel.Text = ""
	titleLabel.Text = if payload.victory then "DAY 67 SURVIVED" else "THE FOREST CLAIMED THE TEAM"
	titleLabel.TextColor3 = if payload.victory then Color3.fromRGB(240, 220, 165) else Color3.fromRGB(220, 75, 70)
	subtitleLabel.Text = "Reached Day " .. tostring(payload.displayedDay or 1) .. " in " .. formatTime(payload.elapsedSeconds or 0)
	TweenService:Create(backdrop, TweenInfo.new(0.8), { BackgroundTransparency = 0.08 }):Play()
	TweenService:Create(titleLabel, TweenInfo.new(0.8), { TextTransparency = 0 }):Play()
	TweenService:Create(subtitleLabel, TweenInfo.new(1), { TextTransparency = 0 }):Play()
end

--[[
    @summary  Populate the personal result details.
    @param    result  table
]]
local function showResults(result)
	local bedCount = 0
	local childCount = 0
	for sourceName in pairs(result.multiplierSources or {}) do
		if string.sub(sourceName, 1, 4) == "Bed:" then
			bedCount += 1
		elseif string.sub(sourceName, 1, 6) == "Child:" then
			childCount += 1
		end
	end
	statsLabel.Text = table.concat({
		"RUN RESULTS",
		"",
		string.format("Displayed Day        %d / %d", result.displayedDay or 1, result.goalDay or 67),
		string.format("Real Nights          %d", result.cycleIndex or 1),
		string.format("Run Time             %s", formatTime(result.elapsedSeconds or 0)),
		string.format("Day Multiplier       %dx  (Beds +%d, Children +%d)", result.multiplier or 1, bedCount, childCount),
		string.format("Children Rescued     %d / 4", result.childrenRescued or 0),
		string.format("Structures Built     %d", result.structuresBuilt or 0),
		string.format("Trees Chopped        %d", result.treesChopped or 0),
		string.format("Wolves Defeated      %d", result.wolvesKilled or 0),
		string.format("Cultists Defeated    %d", result.cultistsKilled or 0),
		string.format("Revives / Downs      %d / %d", result.revives or 0, result.downs or 0),
		"",
		if result.recordSaved then "Lifetime records saved" else "Records will retry next run",
	}, "\n")
	TweenService:Create(statsLabel, TweenInfo.new(0.6), { TextTransparency = 0 }):Play()
end

-- // INITIALIZATION // --

function EndingController:KnitStart()
	endingService = Knit.GetService("EndingService")
	runStateService = Knit.GetService("RunStateService")
	buildUi()
	endingService.EndingStarted:Connect(function(payload)
		if typeof(payload) == "table" then
			showEnding(payload)
		end
	end)
	endingService.ResultsReady:Connect(function(result)
		if typeof(result) == "table" then
			showResults(result)
		end
	end)
	runStateService.RunPhaseChanged:Connect(function(payload)
		if typeof(payload) == "table" and payload.phase == "Lobby" and gui then
			gui.Enabled = false
		end
	end)
end

return EndingController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="124">
            <Properties>
              <string name="Name">FlashlightController</string>
              <string name="Source"><![CDATA[--[[
    @file    FlashlightController.luau
    @author  manik
    @date    2025

    @summary
    Client-side flashlight toggle and battery HUD.

    @description
    Toggles the equipped Flashlight's SpotLight/Sound locally and
    reports the beam state to the server. Listens to FlashlightService
    for battery updates and displays a compact bottom-right panel with:

      - Flashlight ON/OFF indicator
      - Battery percentage and bar
      - Low-battery warning when below 20%
      - Beam state icon

    The panel only appears while the player owns a Flashlight.

    @exports
    - FlashlightController (Knit Controller)
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local Janitor = require(ReplicatedStorage.Packages.Janitor)

-- | Objects | --
local FlashlightController = Knit.CreateController({
	Name = "FlashlightController",
})

-- | Configuration | --
local FLASHLIGHT_TOOL_NAME = "Flashlight"
local PANEL_WIDTH = 160
local PANEL_HEIGHT = 58
local PANEL_MARGIN = 12
local LOW_BATTERY_THRESHOLD = 20
local WARNING_FLASH_INTERVAL = 0.35

-- | State Management | --
local janitor = Janitor.new()
local toolJanitor = Janitor.new()
local charJanitor = Janitor.new()
local gameStateController: any = nil
local flashlightService: any = nil

local beamOn = false
local batteryPercent = 100
local lowBatteryWarning = false

local panelGui: ScreenGui? = nil
local panelFrame: Frame? = nil
local batteryBar: Frame? = nil
local batteryFill: Frame? = nil
local batteryText: TextLabel? = nil
local statusText: TextLabel? = nil
local warningLabel: TextLabel? = nil
local warningThread: thread? = nil
local refreshPanelVisibility: () -> ()

-- // FUNCTIONS // --

--[[
    @summary  Return the equipped Flashlight Tool, if any.
    @returns  Tool?
]]
local function getEquippedFlashlight(): Tool?
	local character = Players.LocalPlayer.Character
	if not character then
		return nil
	end
	local tool = character:FindFirstChild(FLASHLIGHT_TOOL_NAME)
	if tool and tool:IsA("Tool") then
		return tool
	end
	return nil
end

--[[
    @summary  Turn the flashlight visual beam off.
    @param    tool  Tool
]]
local function turnOffVisuals(tool: Tool)
	local handle = tool:FindFirstChild("Handle")
	if not handle then
		return
	end
	local spotLight = handle:FindFirstChildOfClass("SpotLight")
	if spotLight then
		spotLight.Enabled = false
	end
end

--[[
    @summary  Get the color the battery bar should be at a given percent.
    @param    percent  number
    @returns  Color3
]]
local function batteryColor(percent: number): Color3
	if percent <= 20 then
		return Color3.fromRGB(255, 60, 60)
	elseif percent <= 50 then
		return Color3.fromRGB(255, 180, 40)
	end
	return Color3.fromRGB(60, 220, 120)
end

--[[
    @summary  Stop the low-battery warning pulse.
]]
local function stopWarningFlash()
	lowBatteryWarning = false
	warningThread = nil
	if warningLabel then
		warningLabel.TextTransparency = 0
	end
end

--[[
    @summary  Pulse the low-battery warning text.
]]
local function startWarningFlash()
	if warningThread then
		return
	end
	lowBatteryWarning = true
	warningThread = task.spawn(function()
		while lowBatteryWarning and warningLabel do
			TweenService:Create(warningLabel, TweenInfo.new(WARNING_FLASH_INTERVAL, Enum.EasingStyle.Sine), {
				TextTransparency = 0.3,
			}):Play()
			task.wait(WARNING_FLASH_INTERVAL)
			if not lowBatteryWarning or not warningLabel then
				break
			end
			TweenService:Create(warningLabel, TweenInfo.new(WARNING_FLASH_INTERVAL, Enum.EasingStyle.Sine), {
				TextTransparency = 1,
			}):Play()
			task.wait(WARNING_FLASH_INTERVAL)
		end
		warningThread = nil
	end)
end

--[[
    @summary  Update the on-screen battery bar and percentage text.
]]
local function updateFlashlightBeam(percent: number)
	local tool = getEquippedFlashlight()
	if not tool then
		return
	end
	local handle = tool:FindFirstChild("Handle")
	if not handle then
		return
	end
	local spotLight = handle:FindFirstChildOfClass("SpotLight")

	local t = math.clamp(percent / 100, 0, 1)

	-- Color shifts from warm white at full to dim yellow as battery drains
	local fullColor = Color3.fromRGB(255, 235, 180)
	local lowColor = Color3.fromRGB(255, 190, 70)
	local color = fullColor:Lerp(lowColor, 1 - t)

	if spotLight then
		spotLight.Color = color

		-- Single wide conical light: big circle around the player and long reach
		spotLight.Brightness = 2 + (5 - 2) * t
		spotLight.Range = 60 + (100 - 60) * t
		spotLight.Angle = 65 + (85 - 65) * t
	end
end

local function updateBatteryUI()
	if not panelFrame or not batteryBar or not batteryFill or not batteryText or not statusText or not warningLabel then
		return
	end

	batteryPercent = if batteryPercent then batteryPercent else 0
	beamOn = if beamOn == true then true else false

	batteryText.Text = string.format("%d%%", batteryPercent)
	statusText.Text = if beamOn then "ON" else "OFF"
	statusText.TextColor3 = if beamOn then Color3.fromRGB(140, 220, 255) else Color3.fromRGB(200, 200, 210)

	local scale = math.clamp(batteryPercent / 100, 0, 1)
	batteryFill.Size = UDim2.new(scale, 0, 1, 0)
	batteryFill.BackgroundColor3 = batteryColor(batteryPercent)

	if batteryPercent <= LOW_BATTERY_THRESHOLD then
		warningLabel.Text = "LOW BATTERY"
		warningLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
		startWarningFlash()
	else
		warningLabel.Text = ""
		stopWarningFlash()
	end
end

--[[
    @summary  Report the local player current beam state to the server.
    @param    isActive  boolean
]]
local function reportBeamState(isActive: boolean)
	beamOn = isActive
	if flashlightService then
		flashlightService.SetBeamActive(isActive)
	end
	updateBatteryUI()
end

--[[
    @summary  Apply a battery state update from the server.
    @param    percent  number
    @param    isOn     boolean
]]
local function applyBatteryUpdate(percent: number, isOn: boolean)
	batteryPercent = if typeof(percent) == "number" then math.clamp(percent, 0, 100) else 0
	beamOn = if isOn == true then true else false
	updateBatteryUI()
	updateFlashlightBeam(batteryPercent)

	-- If the server says battery is empty, force the visual beam off
	if not isOn and batteryPercent <= 0 then
		local tool = getEquippedFlashlight()
		if tool then
			turnOffVisuals(tool)
		end
	end
end

--[[
    @summary  Toggle the SpotLight/Sound on an equipped Flashlight tool.
    @param    tool  Tool
]]
local function toggleBeam(tool: Tool)
	local handle = tool:FindFirstChild("Handle")
	if not handle then
		return
	end
	local spotLight = handle:FindFirstChildOfClass("SpotLight")
	local sound = handle:FindFirstChildOfClass("Sound")

	local newState = false
	if spotLight then
		newState = not spotLight.Enabled
	end

	if newState and batteryPercent <= 0 then
		-- Cannot turn on with empty battery
		return
	end

	if spotLight then
		spotLight.Enabled = newState
	end

	updateFlashlightBeam(batteryPercent)
	reportBeamState(newState)

	if sound then
		sound:Play()
	end
end

--[[
    @summary  Wire Tool.Activated on the given Flashlight tool.
    @param    tool  Tool
]]
local function wireTool(tool: Tool)
	toolJanitor:Cleanup()
	toolJanitor:Add(tool.Activated:Connect(function()
		if not gameStateController or not gameStateController:IsInGame() then
			return
		end
		toggleBeam(tool)
	end), "Disconnect")
	toolJanitor:Add(tool.Unequipped:Connect(function()
		turnOffVisuals(tool)
		reportBeamState(false)
	end), "Disconnect")
end

--[[
    @summary  Watch the player Character for the Flashlight tool being
              equipped and keep the battery panel visible only while it is.
    @param    player  Player
]]
local function watchForFlashlight(player: Player)
	local function onToolSetChanged()
		refreshPanelVisibility()
	end

	local function checkCharacter(character: Model)
		toolJanitor:Cleanup()
		charJanitor:Cleanup()

		local tool = character:FindFirstChild(FLASHLIGHT_TOOL_NAME)
		if tool and tool:IsA("Tool") then
			wireTool(tool)
			-- Sync visual state with server
			local handle = tool:FindFirstChild("Handle")
			local spotLight = handle and handle:FindFirstChildOfClass("SpotLight")
			if spotLight then
				updateFlashlightBeam(batteryPercent)
				reportBeamState(spotLight.Enabled)
			end
		end

		charJanitor:Add(character.ChildAdded:Connect(function(child)
			if child:IsA("Tool") and child.Name == FLASHLIGHT_TOOL_NAME then
				wireTool(child)
				onToolSetChanged()
			end
		end), "Disconnect")
		charJanitor:Add(character.ChildRemoved:Connect(function(child)
			if child:IsA("Tool") and child.Name == FLASHLIGHT_TOOL_NAME then
				reportBeamState(false)
				onToolSetChanged()
			end
		end), "Disconnect")

		onToolSetChanged()
	end

	janitor:Cleanup()
	janitor:Add(player.CharacterAdded:Connect(checkCharacter), "Disconnect")
	janitor:Add(player.CharacterRemoving:Connect(function()
		reportBeamState(false)
		onToolSetChanged()
	end), "Disconnect")

	if player.Character then
		checkCharacter(player.Character)
	else
		refreshPanelVisibility()
	end
end

--[[
    @summary  Build the compact right-hand side battery panel.
]]
local function buildBatteryPanel()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

	local gui = Instance.new("ScreenGui")
	gui.Name = "FlashlightBatteryPanel"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets
	gui.DisplayOrder = 15

	local frame = Instance.new("Frame")
	frame.Name = "BatteryPanel"
	frame.AnchorPoint = Vector2.new(1, 0.5)
	frame.Position = UDim2.new(1, -PANEL_MARGIN, 0.5, 0)
	frame.Size = UDim2.new(0, PANEL_WIDTH, 0, PANEL_HEIGHT)
	frame.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
	frame.BackgroundTransparency = 0.05
	frame.BorderSizePixel = 0
	frame.Visible = false
	frame.ZIndex = 1
	frame.Parent = gui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 14)
	corner.Parent = frame

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(110, 110, 125)
	stroke.Thickness = 1.5
	stroke.Transparency = 0.3
	stroke.Parent = frame

	-- Flashlight icon and status
	local icon = Instance.new("TextLabel")
	icon.Name = "FlashlightIcon"
	icon.Position = UDim2.new(0, 10, 0, 6)
	icon.Size = UDim2.new(0, 20, 0, 20)
	icon.BackgroundTransparency = 1
	icon.Text = "🔦"
	icon.TextSize = 18
	icon.Font = Enum.Font.GothamBold
	icon.Parent = frame

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Position = UDim2.new(0, 34, 0, 6)
	title.Size = UDim2.new(0, 70, 0, 20)
	title.BackgroundTransparency = 1
	title.Text = "FLASH"
	title.TextColor3 = Color3.fromRGB(245, 245, 255)
	title.Font = Enum.Font.GothamBold
	title.TextSize = 12
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = frame

	local onOff = Instance.new("TextLabel")
	onOff.Name = "Status"
	onOff.Position = UDim2.new(1, -44, 0, 6)
	onOff.Size = UDim2.new(0, 38, 0, 20)
	onOff.BackgroundTransparency = 1
	onOff.Text = "OFF"
	onOff.TextColor3 = Color3.fromRGB(200, 200, 210)
	onOff.Font = Enum.Font.GothamBlack
	onOff.TextSize = 12
	onOff.TextXAlignment = Enum.TextXAlignment.Right
	onOff.Parent = frame

	-- Battery bar container
	local barContainer = Instance.new("Frame")
	barContainer.Name = "BatteryBarContainer"
	barContainer.Position = UDim2.new(0, 10, 0, 32)
	barContainer.Size = UDim2.new(1, -20, 0, 10)
	barContainer.BackgroundColor3 = Color3.fromRGB(60, 60, 68)
	barContainer.BackgroundTransparency = 0.2
	barContainer.BorderSizePixel = 0
	barContainer.Parent = frame

	local barCorner = Instance.new("UICorner")
	barCorner.CornerRadius = UDim.new(0, 6)
	barCorner.Parent = barContainer

	local fill = Instance.new("Frame")
	fill.Name = "BatteryFill"
	fill.Position = UDim2.new(0, 0, 0, 0)
	fill.Size = UDim2.new(1, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(60, 220, 120)
	fill.BackgroundTransparency = 0.1
	fill.BorderSizePixel = 0
	fill.Parent = barContainer

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0, 6)
	fillCorner.Parent = fill

	local percentage = Instance.new("TextLabel")
	percentage.Name = "BatteryText"
	percentage.Position = UDim2.new(0, 10, 0, 42)
	percentage.Size = UDim2.new(0, 60, 0, 14)
	percentage.BackgroundTransparency = 1
	percentage.Text = "100%"
	percentage.TextColor3 = Color3.fromRGB(230, 230, 240)
	percentage.Font = Enum.Font.GothamBold
	percentage.TextSize = 12
	percentage.TextXAlignment = Enum.TextXAlignment.Left
	percentage.Parent = frame

	local warn = Instance.new("TextLabel")
	warn.Name = "Warning"
	warn.Position = UDim2.new(1, -70, 0, 42)
	warn.Size = UDim2.new(0, 60, 0, 14)
	warn.BackgroundTransparency = 1
	warn.Text = ""
	warn.TextColor3 = Color3.fromRGB(255, 80, 80)
	warn.Font = Enum.Font.GothamBlack
	warn.TextSize = 10
	warn.TextXAlignment = Enum.TextXAlignment.Right
	warn.Parent = frame

	panelGui = gui
	panelFrame = frame
	batteryBar = barContainer
	batteryFill = fill
	batteryText = percentage
	statusText = onOff
	warningLabel = warn

	gui.Parent = playerGui
end

refreshPanelVisibility = function()
	if not panelFrame then
		return
	end

	local character = Players.LocalPlayer.Character
	local hasFlashlight = character and character:FindFirstChild(FLASHLIGHT_TOOL_NAME) ~= nil
	panelFrame.Visible = hasFlashlight
end

-- // INITIALIZATION // --

function FlashlightController:KnitStart()
	gameStateController = Knit.GetController("GameStateController")
	flashlightService = Knit.GetService("FlashlightService")

	local player = Players.LocalPlayer

	buildBatteryPanel()

	-- Request initial battery state and listen for updates
	if flashlightService then
		local ok, state = pcall(flashlightService.GetBatteryState)
		if ok and state and typeof(state) == "table" then
			batteryPercent = if typeof(state.percent) == "number" then math.clamp(state.percent, 0, 100) else 100
			beamOn = if state.isOn == true then true else false
			updateBatteryUI()
		end

		flashlightService.BatteryChanged:Connect(function(percent: number, isOn: boolean)
			applyBatteryUpdate(percent, isOn)
		end)
	end

	local function onGameStarted()
		watchForFlashlight(player)
	end

	if gameStateController and gameStateController:IsInGame() then
		onGameStarted()
	else
		if gameStateController then
			gameStateController.GameStarted:Connect(onGameStarted)
		end
	end

	updateBatteryUI()
end

return FlashlightController
]]></string>
            </Properties>
