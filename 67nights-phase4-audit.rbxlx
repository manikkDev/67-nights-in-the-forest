    </Properties>
    <Item class="Script" referent="75">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Intentionally empty: this file only exists because Rojo turns the
-- `src/server` folder into a Script when an init file is present.
-- The actual bootstrap logic lives in `Server.server.luau`.
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="76">
        <Properties>
          <string name="Name">CombatTargetRegistry</string>
          <string name="Source"><![CDATA[--[[
    @file    CombatTargetRegistry.luau
    @author  manik
    @date    2025

    @summary
    Shared lookup so CombatService can damage any NPC without knowing
    which owning service spawned it.

    @description
    AnimalAIService, DeerService, and CultistRaidService each register
    their spawned models here with a damage handler.  CombatService
    only needs a Model to find and drive that handler, and the
    "CombatTarget" CollectionService tag lets it enumerate every live
    target in one pass regardless of species.

    @exports
    - CombatTargetRegistry.Register(model, handlers)
    - CombatTargetRegistry.Unregister(model)
    - CombatTargetRegistry.Get(model) -> handlers?
]]

-- // VARIABLES // --

-- | Services | --
local CollectionService = game:GetService("CollectionService")

-- | Configuration | --
local TAG_NAME = "CombatTarget"

-- | State Management | --
local registry: { [Model]: any } = {}

-- // FUNCTIONS // --

--[[
    @summary  Register a spawned NPC model as a valid combat target.
    @param    model     Model    -- the NPC model
    @param    handlers  table    -- { ApplyDamage: (amount, attacker) -> (killed: boolean, immune: boolean), IsImmune: boolean? }
]]
local function register(model: Model, handlers: any)
	registry[model] = handlers
	CollectionService:AddTag(model, TAG_NAME)
end

--[[
    @summary  Remove a model from the combat target registry.
    @param    model  Model
]]
local function unregister(model: Model)
	registry[model] = nil
	if model.Parent then
		CollectionService:RemoveTag(model, TAG_NAME)
	end
end

--[[
    @summary  Return the damage handlers registered for a model, if any.
    @param    model  Model
    @returns  table?
]]
local function get(model: Model): any
	return registry[model]
end

return {
	TagName = TAG_NAME,
	Register = register,
	Unregister = unregister,
	Get = get,
}
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="77">
        <Properties>
          <string name="Name">Data</string>
        </Properties>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">ProfileTemplate</string>
            <string name="Source"><![CDATA[--[[
    @file    ProfileTemplate.luau
    @author  manik
    @date    2025

    @summary
    Default data template applied to every new player profile.

    @description
    Returned as a plain table. ProfileService deep-copies this template
    into a fresh profile via the `template` field of `ProfileStore`.
    All fields are server-authoritative; the client may never write
    to them directly.

    Two ownership tiers live here.  `Records`, `Unlocks`, `Settings`,
    and `Internal` survive between sessions.  Every other table is
    run-scoped: RunStateService clears it when a run starts and again
    when a run ends, so a finished camp never carries into a new run.
]]

return {
	DataVersion = 2,

	Records = {
		HighestDay = 0,
		FastestDay67Seconds = 0,
		Wins = 0,
		ChildrenRescued = 0,
		TreesChopped = 0,
		WolvesKilled = 0,
		CultistsKilled = 0,
		Revives = 0,
		Deaths = 0,
		TotalPlaytime = 0,
	},

	Unlocks = {},

	Settings = {
		ReducedMotion = false,
		MusicVolume = 0.7,
		SfxVolume = 1,
	},

	Internal = {
		LastAppliedRunId = "",
	},

	Resources = {
		Wood = 0,
		Scrap = 0,
		Coal = 0,
		Berries = 0,
		Mushrooms = 0,
		RawMeat = 0,
		RabbitMeat = 0,
		CookedMeat = 0,
		OwlFeather = 0,
		CultistGem = 0,
		Bandage = 0,
	},

	Survival = {
		Health = 100,
		MaxHealth = 100,
		Hunger = 100,
		MaxHunger = 100,
		DeathCount = 0,
		HighestNightSurvived = 0,
	},

	Base = {
		BedCount = 0,
		DayMultiplier = 1,
		UnlockedStructures = {},
	},

	Inventory = {
		HasBag = true,
		PickupOrder = {},
	},

	Rescue = {
		ChildrenRescued = {},
		CavesUnlocked = {},
	},

	Stats = {
		TreesChopped = 0,
		WolvesKilled = 0,
		CultistsKilled = 0,
		StructuresBuilt = 0,
		ChildrenRescued = 0,
		Revives = 0,
		Downs = 0,
		TotalPlaytime = 0,
	},

	Campfire = {
		Level = 1,
		Progress = 0,
		Fuel = 0,
	},
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="79">
        <Properties>
          <string name="Name">Server</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
    @file    Server.server.luau
    @author  manik
    @date    2025

    @summary
    Server-side Knit bootstrapper.

    @description
    Requires every ModuleScript inside `src/Server/Services`, then
    starts the Knit framework.  Each service registers itself with
    Knit at require-time, so order does not matter.
]]

-- // VARIABLES // --

-- | Services | --
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)

-- | Objects | --
local services = script.Parent.Services

-- // FUNCTIONS // --

-- // INITIALIZATION // --

for _, module in ipairs(services:GetChildren()) do
	if module:IsA("ModuleScript") then
		local ok, err = pcall(require, module)
		if not ok then
			warn("[Server] Failed to require service", module.Name, "-", err)
		end
	end
end

Knit.Start():andThen(function()
	print("[Server] Knit started")
end):catch(warn)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="80">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="81">
          <Properties>
            <string name="Name">AnimalAIService</string>
            <string name="Source"><![CDATA[--[[
    @file    AnimalAIService.luau
    @author  manik
    @date    2025

    @summary
    Server-authoritative spawn/despawn and patrol/chase/attack/flee AI
    for every non-unique NPC species (passive, predator, and solitary).

    @description
    Generic per-species state machine driven by `NpcConfig`.  Owns the
    day/night population cycle for Bunny/Wolf/AlphaWolf/Bear, and
    exposes SpawnNpc/DespawnAllOfSpecies so CultistRaidService can
    reuse the same chase/attack machinery for raid waves without a
    second implementation.  Every spawned NPC is registered with
    `CombatTargetRegistry` so CombatService can damage it generically.

    @exports
    - AnimalAIService:SpawnNpc(speciesKey, cframe) -> Model?
    - AnimalAIService:DespawnAllOfSpecies(speciesKey)
    - Knit Signal: NpcAttacked(position)  (server -> client, VFX hook)
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local PathfindingService = game:GetService("PathfindingService")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local Signal = require(ReplicatedStorage.Packages.Signal)
local NpcConfig = require(ReplicatedStorage.Shared.NpcConfig)
local CombatTargetRegistry = require(script.Parent.Parent.CombatTargetRegistry)

-- | Objects | --
local AnimalAIService = Knit.CreateService({
	Name = "AnimalAIService",
	Client = {
		NpcAttacked = Knit.CreateSignal(),
		NpcDied = Knit.CreateSignal(),
		NpcHealthChanged = Knit.CreateSignal(),
	},
})

AnimalAIService.NpcDiedServer = Signal.new()

-- | Configuration | --
local NPC_SOURCE_PATH = ServerStorage.Assets["Assets Npcs"]
local DECISION_INTERVAL = 0.25
local MIN_SPAWN_DIST = 25
local MAX_SPAWN_DIST = 90
local BUNNY_MIN_SPAWN_DIST = 70
local BUNNY_MAX_SPAWN_DIST = 150
local BEAR_MIN_SPAWN_DIST = 120
local BEAR_MAX_SPAWN_DIST = 220
local GAIT_AMPLITUDE = math.rad(35)
local GAIT_ARM_AMPLITUDE = math.rad(22)
local IDLE_LERP_SPEED = 6
local PATH_RECOMPUTE_INTERVAL = 1.5
local PATH_AGENT_RADIUS = 3.5
local PATH_AGENT_HEIGHT = 6
local LUNGE_DISTANCE = 2.5
local LUNGE_DURATION = 0.18
local DEATH_FADE_DELAY = 4
local HIT_FLASH_DURATION = 0.12
local WOLF_BASE_COUNT = 3
local WOLF_DAY_SCALING = 3
local ALPHA_START_DAY = 3
local WOLF_MIN_SPAWN_DIST = 150
local WOLF_MAX_SPAWN_DIST = 300
local PERSISTENT_TARGET_COUNTS = { Bunny = 8, Bear = 2, WolfModel = 3 }
local RESPAWN_CHECK_INTERVAL = 10

-- | State Management | --
local worldService: any = nil
local timeService: any = nil
local spawnService: any = nil
local inventoryService: any = nil
local playerDataService: any = nil
local playerLifeService: any = nil
local runStateService: any = nil
local activeNpcs: { [Model]: any } = {}
local speciesCounts: { [string]: number } = {}
local lastPhase: string = "Day"
local nightSpawnDone = false
local persistentSpawned = false
local respawnCheckTimer = 0
local treePivots: { CFrame } = {}
local groundBounds: { minX: number, maxX: number, minZ: number, maxZ: number }? = nil
local spawnPersistentPopulation: (() -> ())? = nil

-- // FUNCTIONS // --

-- | Private | --

--[[
    @summary  Collect tree pivots and ground bounds for spawn scattering.
]]
local function collectSpawnArea()
	if not worldService or not worldService:IsForestReady() then
		task.defer(collectSpawnArea)
		return
	end

	local baseMap = worldService:GetBaseMap()
	if not baseMap then
		task.defer(collectSpawnArea)
		return
	end

	treePivots = {}
	for _, descendant in ipairs(baseMap:GetDescendants()) do
		if descendant:IsA("Model") and (descendant.Name == "Tree" or descendant.Name == "bigtree") then
			table.insert(treePivots, descendant:GetPivot())
		elseif descendant:IsA("BasePart") and descendant.Name == "Земля" then
			local halfSize = descendant.Size / 2
			groundBounds = {
				minX = descendant.Position.X - halfSize.X,
				maxX = descendant.Position.X + halfSize.X,
				minZ = descendant.Position.Z - halfSize.Z,
				maxZ = descendant.Position.Z + halfSize.Z,
			}
		end
	end

end

--[[
    @summary  Pick a random ground position between MIN_SPAWN_DIST and
              MAX_SPAWN_DIST studs from the campfire.
    @returns  Vector3?
]]
local function pickSpawnPosition(minDist: number?, maxDist: number?): Vector3?
	if not worldService then
		return nil
	end
	local campfireCFrame = worldService:GetCampfireCFrame()
	if not campfireCFrame then
		return nil
	end
	local campfirePos = campfireCFrame.Position

	local distMin = minDist or MIN_SPAWN_DIST
	local distMax = maxDist or MAX_SPAWN_DIST

	for _ = 1, 12 do
		local angle = math.random() * math.pi * 2
		local dist = distMin + math.random() * (distMax - distMin)
		local candidate = campfirePos + Vector3.new(math.cos(angle) * dist, 0, math.sin(angle) * dist)
		if groundBounds then
			if
				candidate.X >= groundBounds.minX
				and candidate.X <= groundBounds.maxX
				and candidate.Z >= groundBounds.minZ
				and candidate.Z <= groundBounds.maxZ
			then
				return candidate
			end
		else
			return candidate
		end
	end

	if #treePivots > 0 then
		return treePivots[math.random(1, #treePivots)].Position
	end

	return campfirePos + Vector3.new(distMin, 0, 0)
end

--[[
    @summary  Raycast down from a candidate spawn position to find the
              ground CFrame, falling back to a fixed height if nothing
              is hit.
    @param    position  Vector3
    @returns  CFrame
]]
local function groundedCFrame(position: Vector3): CFrame
	local origin = position + Vector3.new(0, 200, 0)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local result = workspace:Raycast(origin, Vector3.new(0, -400, 0), params)
	if result then
		return CFrame.new(result.Position + Vector3.new(0, 3, 0))
	end
	return CFrame.new(position + Vector3.new(0, 5, 0))
end

--[[
    @summary  Collect every Motor6D whose second part is a leg or arm,
              tagged with which side it is on for gait phasing.
    @param    model  Model
    @returns  { { motor: Motor6D, originalC0: CFrame, isLeg: boolean, side: string } }
]]
local function collectGaitJoints(model: Model)
	local joints = {}
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("Motor6D") and descendant.Part1 then
			local partName = descendant.Part1.Name
			local lower = partName:lower()
			local isLeg = lower:find("leg") ~= nil
			local isArm = lower:find("arm") ~= nil
			if isLeg or isArm then
				local side = if lower:find("left") or lower:find("%.l") then "Left" else "Right"
				table.insert(joints, {
					motor = descendant,
					originalC0 = descendant.C0,
					isLeg = isLeg,
					side = side,
				})
			end
		end
	end
	return joints
end

--[[
    @summary  Resolve the R15/R6 default Animate-script walk animation
              id for a rig style, so no custom animation asset is needed.
    @param    rigStyle  "R15" | "R6"
    @returns  string?
]]
local function defaultWalkAnimationId(rigStyle: string): string?
	if rigStyle == "R15" then
		return "rbxassetid://913402848"
	elseif rigStyle == "R6" then
		return "rbxassetid://180426354"
	end
	return nil
end

--[[
    @summary  Resolve the R15/R6 default Animate-script idle animation id.
    @param    rigStyle  "R15" | "R6"
    @returns  string?
]]
local function defaultIdleAnimationId(rigStyle: string): string?
	if rigStyle == "R15" then
		return "rbxassetid://507766388"
	elseif rigStyle == "R6" then
		return "rbxassetid://180435571"
	end
	return nil
end

--[[
    @summary  Load walk/idle/attack AnimationTracks for a record's rig
              style, tolerating a bad asset id without erroring.
    @param    record  table
]]
local function buildAnimationTracks(record)
	local humanoid = record.humanoid
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	record.tracks = {}

	local function loadTrack(id: string, looped: boolean, priority: Enum.AnimationPriority?): AnimationTrack?
		local anim = Instance.new("Animation")
		anim.AnimationId = id
		local ok, track = pcall(function()
			return animator:LoadAnimation(anim)
		end)
		if not ok or not track then
			return nil
		end
		track.Looped = looped
		track.Priority = priority or Enum.AnimationPriority.Idle
		return track
	end

	if record.config.RigStyle == "R15" or record.config.RigStyle == "R6" then
		local walkId = defaultWalkAnimationId(record.config.RigStyle)
		local idleId = defaultIdleAnimationId(record.config.RigStyle)
		if walkId then
			record.tracks.Walk = loadTrack(walkId, true)
		end
		if idleId then
			record.tracks.Idle = loadTrack(idleId, true)
		end
	end

	if record.config.BakedAttackAnimName then
		local animInstance = record.model:FindFirstChild(record.config.BakedAttackAnimName, true)
		if animInstance and animInstance:IsA("Animation") then
			record.tracks.Attack = loadTrack(animInstance.AnimationId, false, Enum.AnimationPriority.Action)
		end
	end

	if record.config.RigStyle == "Procedural" then
		record.gaitJoints = collectGaitJoints(record.model)
	end
end

--[[
    @summary  Switch between the Idle and Walk baked tracks for
              R15/R6-rigged NPCs based on current movement.
    @param    record    table
    @param    isMoving  boolean
]]
local function updateBakedLocomotion(record, isMoving: boolean)
	if not record.tracks then
		return
	end
	local walk = record.tracks.Walk
	local idle = record.tracks.Idle
	if isMoving then
		if walk and not walk.IsPlaying then
			walk:Play(0.2)
		end
		if idle and idle.IsPlaying then
			idle:Stop(0.2)
		end
	else
		if walk and walk.IsPlaying then
			walk:Stop(0.2)
		end
		if idle and not idle.IsPlaying then
			idle:Play(0.2)
		end
	end
end

--[[
    @summary  Drive procedural leg/arm swing via Motor6D offsets for
              custom rigs with no baked locomotion animation.
    @param    record    table
    @param    dt        number
    @param    isMoving  boolean
]]
local function applyProceduralGait(record, dt: number, isMoving: boolean)
	if not record.gaitJoints then
		return
	end

	if isMoving then
		local speedFactor = math.clamp(record.humanoid.WalkSpeed / 10, 0.6, 2.6)
		record.gaitPhase = (record.gaitPhase or 0) + dt * 8 * speedFactor
	end

	for _, joint in ipairs(record.gaitJoints) do
		local target: CFrame
		if isMoving then
			local phaseOffset = if joint.side == "Right" then math.pi else 0
			local amplitude = if joint.isLeg then GAIT_AMPLITUDE else GAIT_ARM_AMPLITUDE
			local swing = math.sin(record.gaitPhase + phaseOffset) * amplitude
			target = joint.originalC0 * CFrame.Angles(swing, 0, 0)
		else
			target = joint.originalC0
		end
		joint.motor.C0 = joint.motor.C0:Lerp(target, math.clamp(dt * IDLE_LERP_SPEED, 0, 1))
	end
end

--[[
    @summary  Fire a Knit signal to every currently-connected player.
    @param    signal  KnitSignal
]]
local function broadcastToAll(signal, ...)
	for _, player in ipairs(Players:GetPlayers()) do
		signal:Fire(player, ...)
	end
end

--[[
    @summary  Roll loot from a species' loot table and grant it to the killer.
    @param    player  Player
    @param    loot    { NpcConfig.LootEntry }
]]
local function grantLoot(record, player: Player)
	if not inventoryService then
		return
	end
	for _, entry in ipairs(record.config.Loot or {}) do
		if math.random() <= entry.Chance then
			local amount = math.random(entry.Min, entry.Max)
			if entry.Resource == "RabbitMeat" then
				for _ = 1, amount do
					local drop = inventoryService:BuildDropModel("RabbitMeat")
					if drop then
						local pos = record.model:GetPivot().Position
						local offset = Vector3.new((math.random() - 0.5) * 5, 2, (math.random() - 0.5) * 5)
						drop:PivotTo(CFrame.new(pos + offset))
						drop.Parent = worldService and worldService:GetBaseMap() or record.model.Parent
						Debris:AddItem(drop, 300)
					end
				end
			else
				inventoryService:AddResource(player, entry.Resource, amount)
			end
		end
	end
end

--[[
    @summary  Play a short lunge-forward Tween on the NPC's root part to
              sell a melee attack without a baked swing animation.
    @param    record  table
]]
local function playLunge(record)
	local rootPart = record.rootPart
	if not rootPart then
		return
	end
	local originalCFrame = rootPart.CFrame
	local lungeCFrame = originalCFrame * CFrame.new(0, 0, -LUNGE_DISTANCE)
	local tweenOut = TweenService:Create(rootPart, TweenInfo.new(LUNGE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		CFrame = lungeCFrame,
	})
	tweenOut.Completed:Once(function()
		TweenService:Create(rootPart, TweenInfo.new(LUNGE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			CFrame = originalCFrame,
		}):Play()
	end)
	tweenOut:Play()
end

--[[
    @summary  Flash an NPC's parts red briefly to give hit feedback.
    @param    model  Model
]]
local function flashHit(model: Model)
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			local highlight = Instance.new("Highlight")
			highlight.FillColor = Color3.fromRGB(255, 40, 40)
			highlight.FillTransparency = 0.4
			highlight.OutlineTransparency = 1
			highlight.Adornee = model
			highlight.Parent = model
			Debris:AddItem(highlight, HIT_FLASH_DURATION)
			break
		end
	end
end

--[[
    @summary  Remove a record from all tracking tables and destroy its model.
    @param    record  table
]]
local function cleanupRecord(record)
	activeNpcs[record.model] = nil
	speciesCounts[record.key] = math.max((speciesCounts[record.key] or 1) - 1, 0)
	CombatTargetRegistry.Unregister(record.model)
	if record.model.Parent then
		record.model:Destroy()
	end
end

--[[
    @summary  Kill an NPC: grant loot, bump stats, ragdoll, then remove
              it after a short delay so the death reads clearly.
    @param    record    table
    @param    attacker  Player?
]]
local function killNpc(record, attacker: Player?)
	if record.isDead then
		return
	end
	record.isDead = true

	if attacker then
		grantLoot(record, attacker)
		if record.config.StatsKey and playerDataService then
			playerDataService:UpdateData(attacker, function(data)
				data.Stats[record.config.StatsKey] = (data.Stats[record.config.StatsKey] or 0) + 1
			end)
		end
	end

	broadcastToAll(AnimalAIService.Client.NpcDied, record.model, record.model:GetPivot().Position, record.key)
	AnimalAIService.NpcDiedServer:Fire(record.model, record.key, attacker)

	if record.humanoid then
		record.humanoid.WalkSpeed = 0
		pcall(function()
			record.humanoid:SetStateEnabled(Enum.HumanoidStateType.Physics, true)
		end)
		record.humanoid.Health = 0
	end

	CombatTargetRegistry.Unregister(record.model)
	Debris:AddItem(record.model, DEATH_FADE_DELAY)
	task.delay(DEATH_FADE_DELAY, function()
		activeNpcs[record.model] = nil
		speciesCounts[record.key] = math.max((speciesCounts[record.key] or 1) - 1, 0)
	end)
end

--[[
    @summary  Apply combat damage to a spawned NPC, killing it if its
              health reaches zero.
    @param    record    table
    @param    amount    number
    @param    attacker  Player?
    @returns  boolean, boolean  -- killed, immune
]]
local function applyDamageToRecord(record, amount: number, attacker: Player?): (boolean, boolean)
	if record.isDead then
		return false, false
	end
	if record.config.MaxHealth <= 0 then
		flashHit(record.model)
		return false, true
	end
	record.health -= amount
	flashHit(record.model)

	local maxHealth = record.config.MaxHealth
	local healthRatio = math.clamp(record.health / maxHealth, 0, 1)
	local position = record.rootPart.Position
	broadcastToAll(AnimalAIService.Client.NpcHealthChanged, record.model, healthRatio, amount, position, record.key)

	if record.health <= 0 then
		killNpc(record, attacker)
		return true, false
	end
	return false, false
end

--[[
    @summary  Return the nearest in-game player within range of a position.
    @param    position  Vector3
    @param    range     number
    @returns  Player?, number?  -- player and distance
]]
local function findNearestPlayer(position: Vector3, range: number): (Player?, number?)
	local nearest: Player? = nil
	local nearestDist: number? = nil
	for _, player in ipairs(Players:GetPlayers()) do
		if spawnService and not spawnService:IsPlayerSpawned(player) then
			continue
		end
		if playerLifeService and not playerLifeService:IsAlive(player) then
			continue
		end
		local character = player.Character
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		if not rootPart or not rootPart:IsA("BasePart") then
			continue
		end
		local dist = (rootPart.Position - position).Magnitude
		if dist <= range and (not nearestDist or dist < nearestDist) then
			nearest = player
			nearestDist = dist
		end
	end
	return nearest, nearestDist
end

--[[
    @summary  Attempt to compute a PathfindingService route to a
              destination, falling back to a direct heading on failure.
    @param    record       table
    @param    destination  Vector3
]]
local function recomputePath(record, destination: Vector3)
	record.lastPathRecompute = os.clock()
	record.waypoints = nil
	record.waypointIndex = 1

	local path = PathfindingService:CreatePath({
		AgentRadius = PATH_AGENT_RADIUS,
		AgentHeight = PATH_AGENT_HEIGHT,
		AgentCanJump = false,
	})

	local ok = pcall(function()
		path:ComputeAsync(record.rootPart.Position, destination)
	end)

	if ok and path.Status == Enum.PathStatus.Success then
		record.waypoints = path:GetWaypoints()
	end
end

--[[
    @summary  Move an NPC toward a destination, following a computed
              path when available and re-planning periodically.
    @param    record       table
    @param    destination  Vector3
]]
local function moveTowards(record, destination: Vector3)
	local now = os.clock()
	if not record.waypoints or (now - (record.lastPathRecompute or 0)) >= PATH_RECOMPUTE_INTERVAL then
		recomputePath(record, destination)
	end

	if record.waypoints and record.waypoints[record.waypointIndex] then
		local waypoint = record.waypoints[record.waypointIndex]
		if (record.rootPart.Position - waypoint.Position).Magnitude < 4 then
			record.waypointIndex += 1
		end
		local target = record.waypoints[record.waypointIndex]
		record.humanoid:MoveTo(if target then target.Position else destination)
	else
		record.humanoid:MoveTo(destination)
	end
end

--[[
    @summary  Decide the next state (Idle/Patrol/Chase/Attack/Flee) for
              an NPC based on its tier, config, and nearby players.
    @param    record  table
]]
local function updateState(record)
	local config = record.config
	if config.AggroRange <= 0 then
		record.state = "Idle"
		record.target = nil
		return
	end

	local position = record.rootPart.Position
	local nearestPlayer, distance = findNearestPlayer(position, config.AggroRange)

	if config.Tier == "Passive" then
		if nearestPlayer and distance then
			if record.state ~= "Flee" then
				record.state = "Flee"
				record.target = nearestPlayer
				record.fleeStartleUntil = os.clock() + 0.2
				record.fleeZigzagPhase = 0
			end
		elseif record.target and record.state == "Flee" then
			local character = (record.target :: Player).Character
			local rootPart = character and character:FindFirstChild("HumanoidRootPart")
			if not rootPart or (record.rootPart.Position - rootPart.Position).Magnitude > config.LoseAggroRange then
				record.state = "Patrol"
				record.target = nil
			end
		else
			record.state = "Patrol"
		end
		return
	end

	-- Predator / Solitary
	if config.Tier == "Solitary" and config.TerritoryRadius then
		local distFromSpawn = (position - record.spawnPosition).Magnitude
		if record.state == "Chase" and distFromSpawn > config.TerritoryRadius then
			record.state = "Patrol"
			record.target = nil
			return
		end
	end

	if record.target then
		local character = (record.target :: Player).Character
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		if not rootPart or not spawnService or not spawnService:IsPlayerSpawned(record.target) then
			record.state = "Patrol"
			record.target = nil
			return
		end
		local dist = (position - rootPart.Position).Magnitude
		if dist > config.LoseAggroRange then
			record.state = "Patrol"
			record.target = nil
			return
		end
		record.state = if dist <= config.AttackRange then "Attack" else "Chase"
		return
	end

	if nearestPlayer then
		if config.Tier == "Solitary" and config.TerritoryRadius then
			if (record.spawnPosition - position).Magnitude > config.TerritoryRadius then
				return
			end
		end
		record.target = nearestPlayer
		record.state = "Chase"
	else
		record.state = "Patrol"
	end
end

--[[
    @summary  Execute movement/attack behavior for the record's current state.
    @param    record  table
    @param    dt      number
]]
local function runStateBehavior(record, dt: number)
	local config = record.config
	local isMoving = false

	if record.state == "Idle" then
		record.humanoid.WalkSpeed = 0
	elseif record.state == "Patrol" then
		if record.patrolPauseUntil and os.clock() < record.patrolPauseUntil then
			record.humanoid.WalkSpeed = 0
		else
			record.patrolPauseUntil = nil
			record.humanoid.WalkSpeed = config.WalkSpeed
			if not record.patrolTarget or (record.rootPart.Position - record.patrolTarget).Magnitude < 4 then
				if config.Tier == "Passive" then
					record.patrolPauseUntil = os.clock() + math.random(2, 4)
				end
				local offset = Vector3.new((math.random() - 0.5) * 30, 0, (math.random() - 0.5) * 30)
				record.patrolTarget = record.spawnPosition + offset
			end
			record.humanoid:MoveTo(record.patrolTarget)
			isMoving = true
		end
	elseif record.state == "Chase" then
		record.humanoid.WalkSpeed = config.RunSpeed
		local character = (record.target :: Player).Character
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		if rootPart then
			moveTowards(record, rootPart.Position)
			isMoving = true
		end
	elseif record.state == "Flee" then
		local now = os.clock()
		if record.fleeStartleUntil and now < record.fleeStartleUntil then
			record.humanoid.WalkSpeed = 0
			isMoving = false
		else
			record.fleeStartleUntil = nil
			record.humanoid.WalkSpeed = config.RunSpeed * (config.FleeSpeedMultiplier or 1.0)
			local character = record.target and (record.target :: Player).Character
			local rootPart = character and character:FindFirstChild("HumanoidRootPart")
			if rootPart then
				local away = (record.rootPart.Position - rootPart.Position)
				if away.Magnitude > 0.1 then
					local awayUnit = away.Unit
					local perp = Vector3.new(-awayUnit.Z, 0, awayUnit.X)
					record.fleeZigzagPhase = (record.fleeZigzagPhase or 0) + dt * 3
					local zigzag = math.sin(record.fleeZigzagPhase) * 0.35
					local fleeDir = (awayUnit + perp * zigzag).Unit
					local fleeTarget = record.rootPart.Position + fleeDir * 15
					record.humanoid:MoveTo(fleeTarget)
					isMoving = true
				end
			end
		end
	elseif record.state == "Attack" then
		record.humanoid.WalkSpeed = 0
		local now = os.clock()
		if not record.lastAttackTime or (now - record.lastAttackTime) >= config.AttackCooldown then
			record.lastAttackTime = now
			local targetPlayer = record.target :: Player?
			if targetPlayer and playerLifeService and playerLifeService:IsAlive(targetPlayer) then
				playLunge(record)
				if record.tracks and record.tracks.Attack then
					record.tracks.Attack:Play()
				end
				playerLifeService:ApplyDamage(targetPlayer, config.AttackDamage, record.speciesKey)
				broadcastToAll(AnimalAIService.Client.NpcAttacked, record.rootPart.Position)
			end
		end
	end

	if config.RigStyle == "R15" or config.RigStyle == "R6" then
		updateBakedLocomotion(record, isMoving)
	elseif config.RigStyle == "Procedural" then
		applyProceduralGait(record, dt, isMoving)
	end
end

--[[
    @summary  Per-heartbeat driver for one NPC record.
    @param    record  table
    @param    dt      number
]]
local function tickRecord(record, dt: number)
	if record.isDead then
		return
	end
	if not record.model.Parent or not record.humanoid or record.humanoid.Health <= 0 then
		cleanupRecord(record)
		return
	end

	local now = os.clock()
	if now >= (record.nextDecisionTime or 0) then
		record.nextDecisionTime = now + DECISION_INTERVAL
		updateState(record)
	end

	runStateBehavior(record, dt)
end

--[[
    @summary  Clone an NPC template, place it, and register it for the
              generic AI tick and combat targeting.
    @param    speciesKey  string          -- key into NpcConfig
    @param    cframe      CFrame          -- spawn CFrame
    @returns  Model?
]]
function AnimalAIService:SpawnNpc(speciesKey: string, cframe: CFrame): Model?
	local config = NpcConfig[speciesKey]
	if not config then
		warn("[AnimalAIService] Unknown species key", speciesKey)
		return nil
	end

	local template = NPC_SOURCE_PATH:FindFirstChild(config.ModelName)
	if not template or not template:IsA("Model") then
		warn("[AnimalAIService] Missing NPC template", config.ModelName)
		return nil
	end

	local model = template:Clone()
	model:PivotTo(cframe)
	model.Parent = workspace

	local humanoid = model:FindFirstChildOfClass("Humanoid") or model:FindFirstChild("NPC")
	local rootPart = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("HRP")
	if not humanoid or not humanoid:IsA("Humanoid") or not rootPart then
		warn("[AnimalAIService] Template", config.ModelName, "missing Humanoid/root part")
		model:Destroy()
		return nil
	end

	humanoid.MaxHealth = math.max(config.MaxHealth, 1)
	humanoid.Health = humanoid.MaxHealth
	humanoid.WalkSpeed = config.WalkSpeed

	local record = {
		model = model,
		humanoid = humanoid,
		rootPart = rootPart,
		config = config,
		key = speciesKey,
		state = "Patrol",
		target = nil,
		health = config.MaxHealth,
		spawnPosition = cframe.Position,
		gaitPhase = 0,
		isDead = false,
	}

	buildAnimationTracks(record)
	activeNpcs[model] = record
	speciesCounts[speciesKey] = (speciesCounts[speciesKey] or 0) + 1

	CombatTargetRegistry.Register(model, {
		ApplyDamage = function(amount: number, attacker: Player?)
			return applyDamageToRecord(record, amount, attacker)
		end,
		IsImmune = config.MaxHealth <= 0,
	})

	return model
end

--[[
    @summary  Destroy every currently-spawned NPC of a given species.
    @param    speciesKey  string
]]
function AnimalAIService:DespawnAllOfSpecies(speciesKey: string)
	for model, record in pairs(activeNpcs) do
		if record.key == speciesKey and model:GetAttribute("GuardCaveId") == nil then
			cleanupRecord(record)
		end
	end
end

--[[
    @summary  Destroy every generic NPC without scheduling replacements.
]]
function AnimalAIService:CleanupAll()
	for _, record in pairs(activeNpcs) do
		cleanupRecord(record)
	end
	activeNpcs = {}
	speciesCounts = {}
	persistentSpawned = false
	respawnCheckTimer = 0
end

--[[
    @summary  Destroy all generic NPCs and start a fresh run population.
]]
function AnimalAIService:ResetForRun()
	self:CleanupAll()
	lastPhase = "Day"
	nightSpawnDone = false

	local capturedRunId = runStateService and runStateService:GetRunId()
	task.delay(1, function()
		if runStateService and runStateService:IsCurrentRun(capturedRunId) then
			spawnPersistentPopulation()
		end
	end)
end

--[[
    @summary  Spawn a wolf pack (regular or alpha-led) around a random
              point at spawn distance from the campfire.
    @param    dayNumber  number
]]
local function spawnWolfPack(dayNumber: number)
	local center = pickSpawnPosition(WOLF_MIN_SPAWN_DIST, WOLF_MAX_SPAWN_DIST)
	if not center then
		return
	end

	local packSize = math.clamp(WOLF_BASE_COUNT + math.floor(dayNumber / WOLF_DAY_SCALING), WOLF_BASE_COUNT, 8)
	for i = 1, packSize do
		local offset = Vector3.new((math.random() - 0.5) * 12, 0, (math.random() - 0.5) * 12)
		local cframe = groundedCFrame(center + offset)
		AnimalAIService:SpawnNpc("WolfModel", cframe)
	end

	if dayNumber >= ALPHA_START_DAY then
		local alphaCount = if dayNumber >= ALPHA_START_DAY * 2 then 2 else 1
		for i = 1, alphaCount do
			local offset = Vector3.new((math.random() - 0.5) * 12, 0, (math.random() - 0.5) * 12)
			local cframe = groundedCFrame(center + offset)
			AnimalAIService:SpawnNpc("AlphaWolfModel", cframe)
		end
	end
end

--[[
    @summary  Spawn the always-present Bunny/Bear population once,
              at server start (they persist across the whole run).
]]
spawnPersistentPopulation = function()
	if persistentSpawned then
		return
	end
	persistentSpawned = true

	for _ = 1, PERSISTENT_TARGET_COUNTS.Bunny do
		local position = pickSpawnPosition(BUNNY_MIN_SPAWN_DIST, BUNNY_MAX_SPAWN_DIST)
		if position then
			AnimalAIService:SpawnNpc("Bunny", groundedCFrame(position))
		end
	end

	for _ = 1, PERSISTENT_TARGET_COUNTS.Bear do
		local bearPosition = pickSpawnPosition(BEAR_MIN_SPAWN_DIST, BEAR_MAX_SPAWN_DIST)
		if bearPosition then
			AnimalAIService:SpawnNpc("Bear", groundedCFrame(bearPosition))
		end
	end

	for _ = 1, PERSISTENT_TARGET_COUNTS.WolfModel do
		local wolfPosition = pickSpawnPosition(WOLF_MIN_SPAWN_DIST, WOLF_MAX_SPAWN_DIST)
		if wolfPosition then
			AnimalAIService:SpawnNpc("WolfModel", groundedCFrame(wolfPosition))
		end
	end
end

--[[
    @summary  Respawn a fallen persistent-population NPC once its
              species count drops below the target headcount.
    @param    dt  number
]]
local function checkPersistentRespawn(dt: number)
	respawnCheckTimer += dt
	if respawnCheckTimer < RESPAWN_CHECK_INTERVAL then
		return
	end
	respawnCheckTimer = 0

	for speciesKey, targetCount in pairs(PERSISTENT_TARGET_COUNTS) do
		local current = speciesCounts[speciesKey] or 0
		if current < targetCount then
			local position
			if speciesKey == "Bear" then
				position = pickSpawnPosition(BEAR_MIN_SPAWN_DIST, BEAR_MAX_SPAWN_DIST)
			elseif speciesKey == "WolfModel" then
				position = pickSpawnPosition(WOLF_MIN_SPAWN_DIST, WOLF_MAX_SPAWN_DIST)
			elseif speciesKey == "Bunny" then
				position = pickSpawnPosition(BUNNY_MIN_SPAWN_DIST, BUNNY_MAX_SPAWN_DIST)
			else
				position = pickSpawnPosition()
			end
			if position then
				AnimalAIService:SpawnNpc(speciesKey, groundedCFrame(position))
			end
		end
	end
end

--[[
    @summary  Watch for day/night transitions and spawn/despawn the
              night predator population accordingly.
]]
local function onHeartbeat(dt: number)
	if timeService and timeService:IsRunning() then
		local phase = timeService:GetCurrentPhase()
		if phase ~= lastPhase then
			lastPhase = phase
			if phase == "Night" and not nightSpawnDone then
				nightSpawnDone = true
				spawnWolfPack(timeService:GetDayNumber())
			elseif phase == "Day" then
				nightSpawnDone = false
			end
		end
	end

	if persistentSpawned then
		checkPersistentRespawn(dt)
	end

	for _, record in pairs(activeNpcs) do
		tickRecord(record, dt)
	end
end

-- // INITIALIZATION // --

function AnimalAIService:KnitStart()
	worldService = Knit.GetService("WorldService")
	timeService = Knit.GetService("TimeService")
	spawnService = Knit.GetService("SpawnService")
	inventoryService = Knit.GetService("InventoryService")
	playerDataService = Knit.GetService("PlayerDataService")
	playerLifeService = Knit.GetService("PlayerLifeService")
	runStateService = Knit.GetService("RunStateService")

	collectSpawnArea()
	runStateService.RunCleaned:Connect(function()
		AnimalAIService:CleanupAll()
	end)

	RunService.Heartbeat:Connect(onHeartbeat)

end

return AnimalAIService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="82">
          <Properties>
            <string name="Name">BuildingService</string>
            <string name="Source"><![CDATA[--[[
    @file    BuildingService.luau
    @author  manik
    @date    2025

    @summary
    Server-authoritative structure placement, beds, gates, traps,
    farms, structure health, and run cleanup.

    @exports
    - BuildingService:DamageStructure(model, amount) -> boolean
    - BuildingService:GetStructures() -> table
    - Knit Remote: RequestPlace(tokenId, cframe)
    - Knit Remote: RequestToggleGate(structureId)
    - Knit Remote: RequestHarvest(structureId)
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local HttpService = game:GetService("HttpService")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local RunConfig = require(ReplicatedStorage.Shared.RunConfig)
local StructureConfig = require(ReplicatedStorage.Shared.StructureConfig)
local CombatTargetRegistry = require(script.Parent.Parent.CombatTargetRegistry)

-- | Objects | --
local BuildingService = Knit.CreateService({
	Name = "BuildingService",
	Client = {
		StructurePlaced = Knit.CreateSignal(),
		StructureChanged = Knit.CreateSignal(),
		StructureDestroyed = Knit.CreateSignal(),
	},
})

-- | Configuration | --
local PLACE_COOLDOWN = 0.2
local INTERACT_RANGE = 12
local FARM_GROWTH_CYCLES = 2
local FARM_YIELD = 2
local TRAP_DAMAGE = 40
local STRUCTURE_TAG = "RunStructure"

-- | State Management | --
local runStateService: any = nil
local craftingService: any = nil
local worldService: any = nil
local inventoryService: any = nil
local timeService: any = nil

local structures: { [string]: { model: Model, definition: any, ownerUserId: number, placedCycle: number } } = {}
local placementCooldowns: { [Player]: number } = {}
local structuresFolder: Folder? = nil
local groundPart: BasePart? = nil

-- // FUNCTIONS // --

-- | Private | --

--[[
    @summary  Return whether every numeric CFrame component is finite.
    @param    cframe  CFrame
    @returns  boolean
]]
local function isFiniteCFrame(cframe: CFrame): boolean
	local components = { cframe:GetComponents() }
	for _, component in ipairs(components) do
		if component ~= component or component == math.huge or component == -math.huge then
			return false
		end
	end
	return true
end

--[[
    @summary  Return the Base-map ground part used by placement raycasts.
    @returns  BasePart?
]]
local function getGroundPart(): BasePart?
	if groundPart and groundPart.Parent then
		return groundPart
	end
	local baseMap = worldService and worldService:GetBaseMap()
	if not baseMap then
		return nil
	end
	groundPart = baseMap:FindFirstChild("Земля", true)
	if groundPart and not groundPart:IsA("BasePart") then
		groundPart = nil
	end
	return groundPart
end

--[[
    @summary  Build a simple server-owned model for a missing template.
    @param    structureId  string
    @returns  Model
]]
local function buildGeneratedTemplate(structureId: string): Model
	local model = Instance.new("Model")
	model.Name = structureId

	local main = Instance.new("Part")
	main.Name = "Main"
	main.Anchored = true
	main.Material = Enum.Material.WoodPlanks
	main.Color = Color3.fromRGB(105, 72, 42)
	main.Parent = model
	model.PrimaryPart = main

	if structureId == "FarmPlot" then
		main.Size = Vector3.new(10, 1, 8)
		main.Material = Enum.Material.Ground
		main.Color = Color3.fromRGB(82, 55, 35)
		for index = 1, 4 do
			local crop = Instance.new("Part")
			crop.Name = "Crop"
			crop.Shape = Enum.PartType.Ball
			crop.Size = Vector3.new(0.7, 0.7, 0.7)
			crop.Color = Color3.fromRGB(75, 150, 65)
			crop.Material = Enum.Material.Grass
			crop.Anchored = true
			crop.CanCollide = false
			local x = if index <= 2 then -2.5 else 2.5
			local z = if index % 2 == 0 then -2 else 2
			crop.CFrame = main.CFrame * CFrame.new(x, 0.8, z)
			crop.Parent = model
		end
	elseif structureId == "BearTrap" then
		main.Size = Vector3.new(5, 0.4, 5)
		main.Material = Enum.Material.Metal
		main.Color = Color3.fromRGB(90, 90, 95)
		main.Transparency = 0.15
	else
		main.Size = Vector3.new(6, 4, 5)
	end

	return model
end

--[[
    @summary  Clone the configured source for a structure.
    @param    definition  table
    @returns  Model?
]]
local function cloneTemplate(definition): Model?
	if definition.TemplateCategory == "Generated" then
		return buildGeneratedTemplate(definition.Id)
	end

	local categoryName = if definition.TemplateCategory == "Items" then "Assets Items" else "Assets maps items"
	local category = ServerStorage.Assets:FindFirstChild(categoryName)
	local source = category and category:FindFirstChild(definition.TemplateName)
	if not source then
		return nil
	end

	local model: Model
	if source:IsA("Model") then
		model = source:Clone()
	elseif source:IsA("BasePart") then
		model = Instance.new("Model")
		local part = source:Clone()
		part.Parent = model
		model.PrimaryPart = part
	else
		return nil
	end

	if not model.PrimaryPart then
		model.PrimaryPart = model:FindFirstChildWhichIsA("BasePart", true)
	end
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BaseScript") or descendant:IsA("ModuleScript") then
			descendant:Destroy()
		elseif descendant:IsA("BasePart") then
			descendant.Anchored = true
		end
	end
	return model
end

--[[
    @summary  Apply visual differences to each bed tier.
    @param    model        Model
    @param    structureId  string
]]
local function styleBed(model: Model, structureId: string)
	local colors = {
		OldBed = Color3.fromRGB(105, 85, 65),
		RegularBed = Color3.fromRGB(70, 120, 95),
		GoodBed = Color3.fromRGB(145, 95, 55),
		GiantBed = Color3.fromRGB(120, 75, 150),
	}
	local targetColor = colors[structureId]
	if not targetColor then
		return
	end
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") and descendant.Material ~= Enum.Material.Wood then
			descendant.Color = targetColor
		end
	end
	if structureId == "GiantBed" then
		model:ScaleTo(1.35)
	elseif structureId == "GoodBed" then
		model:ScaleTo(1.12)
	end
end

--[[
    @summary  Snap a requested placement to authoritative ground and rotation.
    @param    requested   CFrame
    @param    definition  table
    @returns  CFrame?
]]
local function authoritativeCFrame(requested: CFrame, definition): CFrame?
	local grid = RunConfig.PlacementGrid
	local snappedX = math.round(requested.Position.X / grid) * grid
	local snappedZ = math.round(requested.Position.Z / grid) * grid
	local _, yaw = requested:ToEulerAnglesYXZ()
	local rotationStep = math.rad(RunConfig.PlacementRotationDegrees)
	local snappedYaw = math.round(yaw / rotationStep) * rotationStep

	local origin = Vector3.new(snappedX, requested.Position.Y + 80, snappedZ)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	local baseMap = worldService and worldService:GetBaseMap()
	if not baseMap then
		return nil
	end
	params.FilterDescendantsInstances = { baseMap }
	local result = workspace:Raycast(origin, Vector3.new(0, -180, 0), params)
	if not result then
		return nil
	end
	local upDot = result.Normal:Dot(Vector3.yAxis)
	local slope = math.deg(math.acos(math.clamp(upDot, -1, 1)))
	if slope > math.min(definition.MaxSlope, RunConfig.PlacementMaxSlope) then
		return nil
	end

	local y = result.Position.Y + definition.Footprint.Y * 0.5
	return CFrame.new(snappedX, y, snappedZ) * CFrame.Angles(0, snappedYaw, 0)
end

--[[
    @summary  Return whether a footprint is free of blocking geometry.
    @param    player       Player
    @param    cframe       CFrame
    @param    definition   table
    @returns  boolean
]]
local function isFootprintFree(player: Player, cframe: CFrame, definition): boolean
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	local exclusions = { player.Character, getGroundPart() }
	local filtered = {}
	for _, instance in ipairs(exclusions) do
		if instance then
			table.insert(filtered, instance)
		end
	end
	overlap.FilterDescendantsInstances = filtered

	local size = Vector3.new(
		math.max(0.1, definition.Footprint.X - 0.2),
		math.max(0.1, definition.Footprint.Y - 0.2),
		math.max(0.1, definition.Footprint.Z - 0.2)
	)
	for _, part in ipairs(workspace:GetPartBoundsInBox(cframe, size, overlap)) do
		if part.CanCollide and part.Transparency < 0.95 then
			return false
		end
	end
	return true
end

--[[
    @summary  Return whether a position lies within the camp build radius.
    @param    position  Vector3
    @returns  boolean
]]
local function isInsideBuildZone(position: Vector3): boolean
	local campfireCFrame = worldService and worldService:GetCampfireCFrame()
	if not campfireCFrame then
		return false
	end
	local offset = Vector3.new(position.X, 0, position.Z) - Vector3.new(campfireCFrame.Position.X, 0, campfireCFrame.Position.Z)
	return offset.Magnitude <= RunConfig.CampBuildRadius
end

--[[
    @summary  Return how many authoritative structures currently exist.
    @returns  number
]]
local function structureCount(): number
	local count = 0
	for _ in pairs(structures) do
		count += 1
	end
	return count
end

--[[
    @summary  Broadcast one structure delta to every run member.
    @param    signal  table
    @param    payload table
]]
local function broadcast(signal, payload)
	for _, player in ipairs(runStateService:GetMembers()) do
		signal:Fire(player, payload)
	end
end

--[[
    @summary  Add interactions and behavior specific to one structure type.
    @param    record  table
]]
local function wireStructure(record)
	local model = record.model
	local structureId = record.definition.Id
	local anchor = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
	if not anchor then
		return
	end

	if structureId == "LogGate" then
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Toggle Gate"
		prompt.ObjectText = "Log Gate"
		prompt.MaxActivationDistance = INTERACT_RANGE
		prompt.Parent = anchor
		prompt.Triggered:Connect(function(player)
			BuildingService.Client:RequestToggleGate(player, model:GetAttribute("StructureId"))
		end)
	elseif structureId == "FarmPlot" then
		model:SetAttribute("ReadyCycle", timeService:GetCycleIndex() + FARM_GROWTH_CYCLES)
		model:SetAttribute("Ready", false)
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Harvest"
		prompt.ObjectText = "Farm Plot"
		prompt.MaxActivationDistance = INTERACT_RANGE
		prompt.Enabled = false
		prompt.Parent = anchor
		prompt.Triggered:Connect(function(player)
			BuildingService.Client:RequestHarvest(player, model:GetAttribute("StructureId"))
		end)
	elseif structureId == "BearTrap" then
		model:SetAttribute("Armed", true)
		anchor.Touched:Connect(function(hit)
			if model:GetAttribute("Armed") ~= true then
				return
			end
			local target = hit:FindFirstAncestorOfClass("Model")
			if not target or not CollectionService:HasTag(target, CombatTargetRegistry.TagName) then
				return
			end
			local handlers = CombatTargetRegistry.Get(target)
			if not handlers then
				return
			end
			model:SetAttribute("Armed", false)
			handlers.ApplyDamage(TRAP_DAMAGE, nil)
			BuildingService:DamageStructure(model, record.definition.MaxHealth)
		end)
	end
end

--[[
    @summary  Mark ready farm plots at dawn.
    @param    payload  table
]]
local function onDawn(payload)
	for _, record in pairs(structures) do
		if record.definition.Id == "FarmPlot" and record.model.Parent then
			local readyCycle = record.model:GetAttribute("ReadyCycle")
			if typeof(readyCycle) == "number" and payload.cycleIndex >= readyCycle then
				record.model:SetAttribute("Ready", true)
				local prompt = record.model:FindFirstChildWhichIsA("ProximityPrompt", true)
				if prompt then
					prompt.Enabled = true
				end
			end
		end
	end
end

-- | Public | --

--[[
    @summary  Return a shallow copy of all live structure records.
    @returns  table
]]
function BuildingService:GetStructures(): { [string]: any }
	return table.clone(structures)
end

--[[
    @summary  Damage and destroy a registered structure when depleted.
    @param    model   Model
    @param    amount  number
    @returns  boolean  -- true when the structure was destroyed
]]
function BuildingService:DamageStructure(model: Model, amount: number): boolean
	if typeof(amount) ~= "number" or amount <= 0 then
		return false
	end
	local structureId = model:GetAttribute("StructureId")
	local record = typeof(structureId) == "string" and structures[structureId] or nil
	if not record then
		return false
	end
	local health = math.max(0, (model:GetAttribute("Health") or record.definition.MaxHealth) - amount)
	model:SetAttribute("Health", health)
	broadcast(BuildingService.Client.StructureChanged, { structureId = structureId, health = health })
	if health > 0 then
		return false
	end

	structures[structureId] = nil
	CollectionService:RemoveTag(model, STRUCTURE_TAG)
	broadcast(BuildingService.Client.StructureDestroyed, { structureId = structureId, position = model:GetPivot().Position })
	model:Destroy()
	return true
end

--[[
    @summary  Validate and place one crafted structure.
    @param    player           Player  -- injected by Knit
    @param    tokenId          string
    @param    requestedCFrame  CFrame
    @returns  table
]]
function BuildingService.Client:RequestPlace(player: Player, tokenId: string, requestedCFrame: CFrame): { [string]: any }
	if typeof(tokenId) ~= "string" or typeof(requestedCFrame) ~= "CFrame" or not isFiniteCFrame(requestedCFrame) then
		return { ok = false, code = "INVALID_REQUEST" }
	end
	if not runStateService:IsActive() or not runStateService:IsMember(player) then
		return { ok = false, code = "NOT_ACTIVE" }
	end
	if structureCount() >= RunConfig.MaxStructures then
		return { ok = false, code = "TOTAL_CAP_REACHED" }
	end

	local token = craftingService:GetPlacementToken(player, tokenId)
	if not token or token.runId ~= runStateService:GetRunId() then
		return { ok = false, code = "INVALID_TOKEN" }
	end
	local definition = StructureConfig[token.structureId]
	if not definition then
		return { ok = false, code = "INVALID_STRUCTURE" }
	end

	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not rootPart or not rootPart:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
		return { ok = false, code = "INVALID_PLAYER" }
	end
	if (rootPart.Position - requestedCFrame.Position).Magnitude > RunConfig.PlacementMaxRange then
		return { ok = false, code = "TOO_FAR" }
	end
	if not isInsideBuildZone(requestedCFrame.Position) then
		return { ok = false, code = "OUTSIDE_BUILD_ZONE" }
	end

	local now = os.clock()
	if placementCooldowns[player] and now - placementCooldowns[player] < PLACE_COOLDOWN then
		return { ok = false, code = "RATE_LIMITED" }
	end
	placementCooldowns[player] = now

	local finalCFrame = authoritativeCFrame(requestedCFrame, definition)
	if not finalCFrame then
		return { ok = false, code = "INVALID_GROUND" }
	end
	if not isFootprintFree(player, finalCFrame, definition) then
		return { ok = false, code = "OVERLAP" }
	end

	local model = cloneTemplate(definition)
	if not model then
		return { ok = false, code = "MISSING_TEMPLATE" }
	end
	styleBed(model, definition.Id)
	local capturedRunId = runStateService:GetRunId()
	local structureId = HttpService:GenerateGUID(false)
	model.Name = definition.Id
	model:SetAttribute("StructureId", structureId)
	model:SetAttribute("StructureType", definition.Id)
	model:SetAttribute("OwnerUserId", player.UserId)
	model:SetAttribute("RunId", capturedRunId)
	model:SetAttribute("MaxHealth", definition.MaxHealth)
	model:SetAttribute("Health", definition.MaxHealth)
	model:SetAttribute("PlacedCycle", timeService:GetCycleIndex())
	model.Parent = structuresFolder
	model:PivotTo(finalCFrame)
	CollectionService:AddTag(model, STRUCTURE_TAG)

	if not craftingService:ConsumePlacementToken(player, tokenId) or not runStateService:IsCurrentRun(capturedRunId) then
		model:Destroy()
		return { ok = false, code = "RUN_CHANGED" }
	end

	local record = {
		model = model,
		definition = definition,
		ownerUserId = player.UserId,
		placedCycle = timeService:GetCycleIndex(),
	}
	structures[structureId] = record
	wireStructure(record)
	runStateService:IncrementStat(player, "StructuresBuilt", 1)

	if definition.MultiplierPoints then
		runStateService:AddMultiplierSource("Bed:" .. definition.Id, definition.MultiplierPoints)
	end

	local payload = {
		structureId = structureId,
		structureType = definition.Id,
		ownerUserId = player.UserId,
		cframe = finalCFrame,
		health = definition.MaxHealth,
	}
	broadcast(BuildingService.Client.StructurePlaced, payload)
	return { ok = true, code = "OK", structure = payload }
end

--[[
    @summary  Toggle a nearby live gate between blocking and open states.
    @param    player       Player  -- injected by Knit
    @param    structureId  string
    @returns  boolean
]]
function BuildingService.Client:RequestToggleGate(player: Player, structureId: string): boolean
	if typeof(structureId) ~= "string" then
		return false
	end
	local record = structures[structureId]
	if not record or record.definition.Id ~= "LogGate" then
		return false
	end
	local rootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not rootPart or not rootPart:IsA("BasePart") or (rootPart.Position - record.model:GetPivot().Position).Magnitude > INTERACT_RANGE then
		return false
	end
	local isOpen = record.model:GetAttribute("Open") == true
	record.model:SetAttribute("Open", not isOpen)
	for _, descendant in ipairs(record.model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.CanCollide = isOpen
			descendant.Transparency = if isOpen then math.max(0, descendant.Transparency - 0.35) else math.min(0.65, descendant.Transparency + 0.35)
		end
	end
	broadcast(BuildingService.Client.StructureChanged, { structureId = structureId, open = not isOpen })
	return true
end

--[[
    @summary  Collect a ready farm and begin its next growth cycle.
    @param    player       Player  -- injected by Knit
    @param    structureId  string
    @returns  boolean
]]
function BuildingService.Client:RequestHarvest(player: Player, structureId: string): boolean
	if typeof(structureId) ~= "string" then
		return false
	end
	local record = structures[structureId]
	if not record or record.definition.Id ~= "FarmPlot" or record.model:GetAttribute("Ready") ~= true then
		return false
	end
	local rootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not rootPart or not rootPart:IsA("BasePart") or (rootPart.Position - record.model:GetPivot().Position).Magnitude > INTERACT_RANGE then
		return false
	end
	local added = inventoryService:AddResource(player, "Berries", FARM_YIELD)
	if added <= 0 then
		return false
	end
	record.model:SetAttribute("Ready", false)
	record.model:SetAttribute("ReadyCycle", timeService:GetCycleIndex() + FARM_GROWTH_CYCLES)
	local prompt = record.model:FindFirstChildWhichIsA("ProximityPrompt", true)
	if prompt then
		prompt.Enabled = false
	end
	broadcast(BuildingService.Client.StructureChanged, { structureId = structureId, ready = false })
	return true
end

-- // INITIALIZATION // --

function BuildingService:KnitStart()
	runStateService = Knit.GetService("RunStateService")
	craftingService = Knit.GetService("CraftingService")
	worldService = Knit.GetService("WorldService")
	inventoryService = Knit.GetService("InventoryService")
	timeService = Knit.GetService("TimeService")

	runStateService.RunStarted:Connect(function()
		structures = {}
		placementCooldowns = {}
		groundPart = nil
		structuresFolder = Instance.new("Folder")
		structuresFolder.Name = "Structures"
		structuresFolder.Parent = runStateService:GetRuntimeFolder()
	end)
	runStateService.RunCleaned:Connect(function()
		structures = {}
		structuresFolder = nil
		placementCooldowns = {}
	end)
	timeService:OnDawn(onDawn)

	Players.PlayerRemoving:Connect(function(player)
		placementCooldowns[player] = nil
	end)
end

return BuildingService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="83">
          <Properties>
            <string name="Name">CampfireService</string>
            <string name="Source"><![CDATA[--[[
    @file    CampfireService.luau
    @author  manik
    @date    2025

    @summary
    Server-authoritative campfire fuel, level-up, and dynamic fire visuals.

    @description
    Tracks a shared campfire Level (1-6) and a current Fuel value that
    drains over time. Players feed the fire by dropping Wood near the
    Campfire anchor; each log adds both current
    fuel and progress toward the next campfire level. Every level raises
    the campfire's max fuel, safe-zone radius, fire size/light range, and
    slows fuel drain. If Fuel reaches 0 the fire goes out, the safe zone
    disappears, and a warning is broadcast.

    @exports
    - CampfireService:GetFuel()            -> number
    - CampfireService:GetFuelLimit()       -> number
    - CampfireService:GetFuelFraction()    -> number
    - CampfireService:GetLevel()           -> number
    - CampfireService:GetLevelProgress()   -> number, number, number
    - CampfireService:IsLit()              -> boolean
    - CampfireService:GetSafeZoneRadius()  -> number
    - CampfireService:IsInSafeZone(pos)    -> boolean
    - Knit Signal: FuelChanged(fuel, maxFuel, fraction, isLit)
    - Knit Signal: LevelChanged(level, progress, requirement, levelFraction)
    - Knit Signal: SafeZoneChanged(radius, isActive)
    - Knit Remote: RequestFuelCampfire(amount)
    - Knit Remote: GetState() -> fuel, maxFuel, level, progress, requirement, isLit
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local Signal = require(ReplicatedStorage.Packages.Signal)

-- | Objects | --
local createSuccess, CampfireService = pcall(Knit.CreateService, {
	Name = "CampfireService",
	Client = {
		FuelChanged = Knit.CreateSignal(),
		LevelChanged = Knit.CreateSignal(),
		SafeZoneChanged = Knit.CreateSignal(),
		LevelUp = Knit.CreateSignal(),
		SafeZoneRadius = Knit.CreateProperty(0),
		IsLit = Knit.CreateProperty(false),
	},
})

if not createSuccess then
	-- Rojo hot-reload: grab the existing service and continue so the new code runs
	CampfireService = Knit.GetService("CampfireService") :: any
end

if not CampfireService.Client then
	CampfireService.Client = {}
end
if not CampfireService.Client.FuelChanged then
	CampfireService.Client.FuelChanged = Knit.CreateSignal()
end
if not CampfireService.Client.LevelChanged then
	CampfireService.Client.LevelChanged = Knit.CreateSignal()
end
if not CampfireService.Client.SafeZoneChanged then
	CampfireService.Client.SafeZoneChanged = Knit.CreateSignal()
end
if not CampfireService.Client.LevelUp then
	CampfireService.Client.LevelUp = Knit.CreateSignal()
end
if not CampfireService.Client.SafeZoneRadius then
	CampfireService.Client.SafeZoneRadius = Knit.CreateProperty(0)
end
if not CampfireService.Client.IsLit then
	CampfireService.Client.IsLit = Knit.CreateProperty(false)
end

CampfireService.LevelChangedServer = CampfireService.LevelChangedServer or Signal.new()

-- | Configuration | --
local FEED_RANGE = 10
local FEED_COOLDOWN = 1
local WOOD_FUEL_VALUE = 25
local WOOD_LEVEL_VALUE_BASE = 12
local WOOD_LEVEL_VALUE_DECAY = 2.2

local MAX_FUEL_BY_LEVEL = { 100, 130, 170, 220, 280, 350 }
local SAFE_ZONE_RADIUS_BY_LEVEL = { 28, 36, 48, 62, 78, 98 }
local FUEL_DRAIN_BASE = 100 / 600
local FUEL_DRAIN_MULTIPLIER_BY_LEVEL = { 1.0, 0.9, 0.82, 0.75, 0.68, 0.6 }
local LEVEL_REQUIREMENTS = { 50, 120, 220, 360, 560, 820 }

local FIRE_SIZE_MIN = 0.5
local FIRE_SIZE_MAX = 12
local FIRE_SIZE_LEVEL_MULTIPLIER = { 0.85, 1.0, 1.08, 1.16, 1.24, 1.4 }
local FIRE_HEAT_MIN = 1
local FIRE_HEAT_MAX = 10
local LIGHT_RANGE_MIN = 6
local LIGHT_RANGE_MAX = 120
local LIGHT_RANGE_LEVEL_MULTIPLIER = { 0.85, 1.0, 1.08, 1.16, 1.24, 1.4 }
local LIGHT_BRIGHTNESS_MIN = 0.8
local LIGHT_BRIGHTNESS_MAX = 2
local FUEL_BROADCAST_INTERVAL = 1
local SAFE_ZONE_LINE_COUNT = 40
local SAFE_ZONE_LINE_THICKNESS = 0.8
local SAFE_ZONE_LINE_HEIGHT = 0.05
local SAFE_ZONE_LINE_FILL = 0.65
local SAFE_ZONE_LINE_COLOR = Color3.fromRGB(220, 255, 220)
local SAFE_ZONE_LINE_MATERIAL = Enum.Material.Neon
local SAFE_ZONE_LINE_TRANSPARENCY = 0
local SAFE_ZONE_LINE_OFF_TRANSPARENCY = 1
local SAFE_ZONE_BROADCAST_THRESHOLD = 0.5
local LOG_SCAN_INTERVAL = 0.2
local LOG_SCAN_RADIUS = 8

-- | State Management | --
local worldService: any = nil
local playerDataService: any = nil
local inventoryService: any = nil
local spawnService: any = nil
local stateLoaded = false
local level = 1
local levelProgress = 0
local maxFuel = MAX_FUEL_BY_LEVEL[1]
local fuel = 0
local isLit = false
local campfirePart: BasePart? = nil
local fireCenter: BasePart? = nil
local groundPart: BasePart? = nil
local fireInstance: Fire? = nil
local pointLight: PointLight? = nil
local feedCooldowns: { [Player]: number } = {}
local fuelBroadcastTimer = 0
local logScanTimer = 0
local safeZoneDots: { Part }? = nil
local currentSafeZoneRadius = 0
local lastBroadcastRadius = 0

-- // FUNCTIONS // --

--[[
    @summary  Return the current fuel level.
    @returns  number
]]
function CampfireService:GetFuel(): number
	return fuel
end

--[[
    @summary  Return the current maximum fuel (fuel limit).
    @returns  number
]]
function CampfireService:GetFuelLimit(): number
	return maxFuel
end

--[[
    @summary  Return the current fuel as a 0-1 fraction of the limit.
    @returns  number
]]
function CampfireService:GetFuelFraction(): number
	if maxFuel <= 0 then
		return 0
	end
	return fuel / maxFuel
end

--[[
    @summary  Return the current campfire level (1-6).
    @returns  number
]]
function CampfireService:GetLevel(): number
	return level
end

--[[
    @summary  Return the current level progress.
    @returns  number, number, number  -- progress, requirement, fraction
]]
function CampfireService:GetLevelProgress(): (number, number, number)
	local requirement = LEVEL_REQUIREMENTS[level] or LEVEL_REQUIREMENTS[#LEVEL_REQUIREMENTS]
	local fraction = if requirement > 0 then math.clamp(levelProgress / requirement, 0, 1) else 1
	return levelProgress, requirement, fraction
end

--[[
    @summary  Return true if the campfire still has fuel remaining.
    @returns  boolean
]]
function CampfireService:IsLit(): boolean
	return isLit
end

--[[
    @summary  Return the current safe zone radius in studs.
    @returns  number  -- 0 if fire is out
]]
function CampfireService:GetSafeZoneRadius(): number
	if not isLit then
		return 0
	end
	return currentSafeZoneRadius
end

--[[
    @summary  Check whether a world position is inside the safe zone.
    @param    position  Vector3  -- the position to test
    @returns  boolean
]]
function CampfireService:IsInSafeZone(position: Vector3): boolean
	if not isLit or not fireCenter then
		return false
	end
	local flatDist = (Vector3.new(position.X, 0, position.Z) - Vector3.new(fireCenter.Position.X, 0, fireCenter.Position.Z)).Magnitude
	return flatDist <= currentSafeZoneRadius
end

--[[
    @summary  Apply extra fuel drain from an external penalty source
              (e.g. an unresolved Cultist raid at dawn).
    @param    amount  number
]]
function CampfireService:ApplyExternalDrain(amount: number)
	if amount <= 0 or not isLit then
		return
	end
	fuel = math.clamp(fuel - amount, 0, maxFuel)
	if fuel <= 0 then
		isLit = false
	end
end

--[[
    @summary  Restore the campfire to its fresh-run state.
]]
function CampfireService:ResetForRun()
	stateLoaded = true
	level = 1
	levelProgress = 0
	maxFuel = MAX_FUEL_BY_LEVEL[1]
	fuel = 0
	isLit = false
	feedCooldowns = {}
	currentSafeZoneRadius = 0
	lastBroadcastRadius = 0
	CampfireService.LevelChangedServer:Fire(level, 0)
end

--[[
    @summary  Compute the level-progress value of one log at the current level.
    @returns  number
]]
local function getWoodLevelValue(): number
	return WOOD_LEVEL_VALUE_BASE / (WOOD_LEVEL_VALUE_DECAY ^ (level - 1))
end

--[[
    @summary  Process level-ups when the level bar overflows.
]]
local function processLevelUps()
	while level < #MAX_FUEL_BY_LEVEL and levelProgress >= (LEVEL_REQUIREMENTS[level] or math.huge) do
		local requirement = LEVEL_REQUIREMENTS[level] :: number
		levelProgress -= requirement
		level += 1
		maxFuel = MAX_FUEL_BY_LEVEL[level]
		fuel = math.clamp(fuel, 0, maxFuel)
		currentSafeZoneRadius = if isLit then SAFE_ZONE_RADIUS_BY_LEVEL[level] else 0
		for _, player in ipairs(Players:GetPlayers()) do
			CampfireService.Client.LevelUp:Fire(player, level, level - 1, currentSafeZoneRadius, maxFuel)
		end
		CampfireService.LevelChangedServer:Fire(level, level - 1)
	end

	-- Cap progress at the final level's requirement so the bar sits at 100%.
	if level == #MAX_FUEL_BY_LEVEL then
		local cap = LEVEL_REQUIREMENTS[level] or 0
		if levelProgress > cap then
			levelProgress = cap
		end
	end
end

--[[
    @summary  Load the shared campfire state from a player's profile.
    @param    player  Player
]]
local function loadCampfireStateFromPlayer(player: Player)
	if not playerDataService then
		stateLoaded = true
		return
	end

	local ok, data = pcall(playerDataService.GetData, playerDataService, player)
	if ok and data and data.Campfire then
		level = math.clamp(data.Campfire.Level, 1, #MAX_FUEL_BY_LEVEL)
		maxFuel = MAX_FUEL_BY_LEVEL[level]
		levelProgress = math.clamp(data.Campfire.Progress, 0, (LEVEL_REQUIREMENTS[level] or math.huge))
		fuel = math.clamp(data.Campfire.Fuel, 0, maxFuel)
		isLit = fuel > 0
	end

	stateLoaded = true
end

--[[
    @summary  Save the shared campfire state into a single player's profile.
    @param    player  Player
]]
local function saveCampfireStateToPlayer(player: Player)
	if not playerDataService then
		return
	end

	local ok = pcall(playerDataService.UpdateData, playerDataService, player, function(data)
		data.Campfire = { Level = level, Progress = levelProgress, Fuel = fuel }
	end)

	if not ok then
		warn("[CampfireService] Failed to save campfire state for", player.Name)
	end
end

--[[
    @summary  Save the shared campfire state to every player's profile.
]]
local function saveCampfireState()
	for _, player in ipairs(Players:GetPlayers()) do
		saveCampfireStateToPlayer(player)
	end
end

--[[
    @summary  Update the Fire effect and PointLight to match current fuel and level.
]]
local function updateFireVisuals()
	if not fireInstance and not pointLight then
		return
	end

	local fraction = if maxFuel > 0 then fuel / maxFuel else 0
	local sizeMax = FIRE_SIZE_MAX * FIRE_SIZE_LEVEL_MULTIPLIER[level]
	local heatMax = FIRE_HEAT_MAX * FIRE_SIZE_LEVEL_MULTIPLIER[level]
	local lightMax = LIGHT_RANGE_MAX * LIGHT_RANGE_LEVEL_MULTIPLIER[level]

	if fireInstance then
		fireInstance.Enabled = isLit and fuel > 0
		fireInstance.Size = FIRE_SIZE_MIN + (sizeMax - FIRE_SIZE_MIN) * fraction
		fireInstance.Heat = FIRE_HEAT_MIN + (heatMax - FIRE_HEAT_MIN) * fraction
	end

	if pointLight then
		pointLight.Enabled = isLit
		pointLight.Color = Color3.fromRGB(255, 130, 60)
		pointLight.Shadows = false
		local targetRange = math.clamp(currentSafeZoneRadius * 1.2, LIGHT_RANGE_MIN, lightMax)
		pointLight.Range = if isLit then targetRange else 0
		pointLight.Brightness = if isLit then LIGHT_BRIGHTNESS_MIN + (LIGHT_BRIGHTNESS_MAX - LIGHT_BRIGHTNESS_MIN) * fraction + 0.5 else 0
	end
end

--[[
    @summary  Position/orient the slim glowing line segments as a dashed ring
              around the campfire with the given radius and active state.
    @param    radius   number   -- ring radius in studs
    @param    active   boolean  -- whether the ring is visible
]]
local function updateSafeZoneVisuals(radius: number, active: boolean)
	if not safeZoneDots or not fireCenter or not campfirePart then
		return
	end

	local groundY: number
	if not groundPart then
		local dotFolder = safeZoneDots[1].Parent
		local dotMap = dotFolder and dotFolder.Parent
		if dotMap then
			groundPart = dotMap:FindFirstChild("Земля") :: BasePart?
			if not groundPart then
				for _, d in ipairs(dotMap:GetDescendants()) do
					if d:IsA("BasePart") and d.Size.Y < 50 and d.Size.X > 500 and d.Size.Z > 500 then
						groundPart = d :: BasePart
						break
					end
				end
			end
		end
	end
	if groundPart then
		groundY = groundPart.Position.Y + groundPart.Size.Y * 0.5 + SAFE_ZONE_LINE_HEIGHT
	else
		groundY = fireCenter.Position.Y + SAFE_ZONE_LINE_HEIGHT
	end
	local transparency = active and SAFE_ZONE_LINE_TRANSPARENCY or SAFE_ZONE_LINE_OFF_TRANSPARENCY
	local circumference = 2 * math.pi * radius
	local lineLength = (circumference / SAFE_ZONE_LINE_COUNT) * SAFE_ZONE_LINE_FILL

	for i, dot in ipairs(safeZoneDots) do
		local angle = (i - 1) * (2 * math.pi / SAFE_ZONE_LINE_COUNT)
		local normal = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local position = Vector3.new(
			fireCenter.Position.X + normal.X * radius,
			groundY,
			fireCenter.Position.Z + normal.Z * radius
		)

		dot.CFrame = CFrame.fromMatrix(position, normal, Vector3.new(0, 1, 0))
		dot.Size = Vector3.new(SAFE_ZONE_LINE_THICKNESS, SAFE_ZONE_LINE_HEIGHT, lineLength)
		dot.Transparency = transparency
	end
end

--[[
    @summary  Recompute safe zone radius and refresh the visual ring.
]]
local function updateSafeZone()
	currentSafeZoneRadius = if isLit then SAFE_ZONE_RADIUS_BY_LEVEL[level] else 0
	updateSafeZoneVisuals(currentSafeZoneRadius, isLit)
end

--[[
    @summary  Broadcast the current fuel state to a player (or all players if omitted).
    @param    target  Player?  -- nil to broadcast to all
]]
local function isPlayerInGame(player: Player): boolean
	if not spawnService then
		return false
	end
	return spawnService:IsPlayerSpawned(player)
end

local function broadcastFuel(target: Player?)
	local fraction = if maxFuel > 0 then fuel / maxFuel else 0
	if target then
		if isPlayerInGame(target) then
			CampfireService.Client.FuelChanged:Fire(target, fuel, maxFuel, fraction, isLit)
		end
		return
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if isPlayerInGame(player) then
			CampfireService.Client.FuelChanged:Fire(player, fuel, maxFuel, fraction, isLit)
		end
	end
end

--[[
    @summary  Broadcast the current level state to a player (or all players if omitted).
    @param    target  Player?  -- nil to broadcast to all
]]
local function broadcastLevel(target: Player?)
	local requirement = LEVEL_REQUIREMENTS[level] or LEVEL_REQUIREMENTS[#LEVEL_REQUIREMENTS]
	local levelFraction = if requirement > 0 then math.clamp(levelProgress / requirement, 0, 1) else 1
	if target then
		if isPlayerInGame(target) then
			CampfireService.Client.LevelChanged:Fire(target, level, levelProgress, requirement, levelFraction)
		end
		return
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if isPlayerInGame(player) then
			CampfireService.Client.LevelChanged:Fire(player, level, levelProgress, requirement, levelFraction)
		end
	end
end

--[[
    @summary  Broadcast the current safe zone to a player (or all players if omitted).
    @param    target  Player?  -- nil to broadcast to all
    @param    force   boolean? -- true to bypass the radius-change throttle
]]
local function broadcastSafeZone(target: Player?, force: boolean?)
	updateSafeZone()

	-- Keep the replicated properties always in sync with the server state.
	-- The SafeZoneChanged signal below is throttled to avoid spamming clients.
	if CampfireService.Client.SafeZoneRadius then
		CampfireService.Client.SafeZoneRadius:Set(currentSafeZoneRadius)
	end
	if CampfireService.Client.IsLit then
		CampfireService.Client.IsLit:Set(isLit)
	end

	local shouldBroadcast = force
		or math.abs(currentSafeZoneRadius - lastBroadcastRadius) >= SAFE_ZONE_BROADCAST_THRESHOLD
		or (isLit and lastBroadcastRadius <= 0)
		or (not isLit and lastBroadcastRadius > 0)

	if not shouldBroadcast then
		return
	end

	lastBroadcastRadius = currentSafeZoneRadius
	if target then
		if isPlayerInGame(target) then
			CampfireService.Client.SafeZoneChanged:Fire(target, currentSafeZoneRadius, isLit)
		end
		return
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if isPlayerInGame(player) then
			CampfireService.Client.SafeZoneChanged:Fire(player, currentSafeZoneRadius, isLit)
		end
	end
end

--[[
    @summary  Add fuel and level progress from a given number of logs.
    @param    woodAmount  number
]]
local function addFuel(woodAmount: number)
	if woodAmount <= 0 then
		return
	end

	local wasLit = isLit
	local previousLevel = level

	isLit = true
	fuel += woodAmount * WOOD_FUEL_VALUE
	fuel = math.clamp(fuel, 0, maxFuel)

	levelProgress += woodAmount * getWoodLevelValue()
	processLevelUps()
	updateSafeZone()

	-- If this was the spark that lit the fire and no real level-up happened,
	-- show the Campfire Level banner for the current level so the player
	-- gets clear feedback the campfire is now burning.
	if not wasLit and level == previousLevel then
		for _, player in ipairs(Players:GetPlayers()) do
			CampfireService.Client.LevelUp:Fire(player, level, level - 1, currentSafeZoneRadius, maxFuel)
		end
	end

	updateFireVisuals()
	broadcastSafeZone(nil, true)
	broadcastFuel()
	broadcastLevel()
	saveCampfireState()
end

--[[
    @summary  Validate and process a feed request, consuming Wood and
              adding both current fuel and level progress.
    @param    player  Player  -- the feeding player
    @param    amount  number  -- logs to feed (default 1)
]]
local function feedCampfire(player: Player, amount: number)
	if not campfirePart or not inventoryService then
		return
	end

	if amount <= 0 then
		return
	end

	local now = os.clock()
	if feedCooldowns[player] and (now - feedCooldowns[player]) < FEED_COOLDOWN then
		return
	end

	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart or not rootPart:IsA("BasePart") then
		return
	end

	if (rootPart.Position - campfirePart.Position).Magnitude > FEED_RANGE then
		return
	end

	if not inventoryService:ConsumeResource(player, "Wood", amount) then
		return
	end

	feedCooldowns[player] = now
	addFuel(amount)
end


--[[
    @summary  Convert a dropped RawMeat model into CookedMeat, either adding
              it to the original owner's inventory or spawning a pickup.
]]
local function cookRawMeat(model: Model)
	if not isLit or fuel <= 0 or not inventoryService then
		return
	end

	local ownerId = model:GetAttribute("DroppedBy")
	local owner: Player? = nil
	if ownerId and typeof(ownerId) == "number" then
		for _, player in ipairs(Players:GetPlayers()) do
			if player.UserId == ownerId then
				owner = player
				break
			end
		end
	end

	if owner then
		local added = inventoryService:AddResource(owner, "CookedMeat", 1)
		if added > 0 then
			model:Destroy()
			return
		end
	end

	local cooked = inventoryService:BuildDropModel("CookedMeat")
	if cooked then
		cooked:PivotTo(model:GetPivot())
		cooked.Parent = model.Parent
		Debris:AddItem(cooked, 300)
	end
	model:Destroy()
end

--[[
    @summary  Scan the area around the campfire for loose Log models and
              consume them as fuel, or cook RawMeat drops.
]]
local function scanForLogFuel()
	if not campfirePart or not inventoryService or not worldService then
		return
	end

	local baseMap = worldService:GetBaseMap()
	if not baseMap then
		return
	end

	local params = OverlapParams.new()
	params.FilterDescendantsInstances = { baseMap }
	params.FilterType = Enum.RaycastFilterType.Include

	local parts = workspace:GetPartBoundsInRadius(campfirePart.Position, LOG_SCAN_RADIUS, params)
	local consumedThisScan = {}
	for _, part in ipairs(parts) do
		if not part:IsA("BasePart") then
			continue
		end

		local model = part:FindFirstAncestorOfClass("Model")
		if not model then
			continue
		end
		if consumedThisScan[model] then
			continue
		end

		local resourceName = model:GetAttribute("Resource")
			or model:GetAttribute("PickupResource")
			or model:GetAttribute("ForageResource")
		if not resourceName or typeof(resourceName) ~= "string" then
			continue
		end
		if inventoryService:IsModelDragged(model) then
			continue
		end

		if resourceName == "Wood" or resourceName == "Coal" then
			consumedThisScan[model] = true
			addFuel(if resourceName == "Coal" then 3 else 1)
			model:Destroy()
		elseif resourceName == "RawMeat" or resourceName == "RabbitMeat" then
			consumedThisScan[model] = true
			cookRawMeat(model)
		end
	end
end

--[[
    @summary  Heartbeat-driven fuel drain and visual scaling.
    @param    dt  number  -- delta time in seconds
]]
local function onHeartbeat(dt: number)
	if isLit then
		local drain = FUEL_DRAIN_BASE * (FUEL_DRAIN_MULTIPLIER_BY_LEVEL[level] or 1) * dt
		fuel = math.clamp(fuel - drain, 0, maxFuel)
		if fuel <= 0 then
			isLit = false
		end
	end

	updateFireVisuals()
	updateSafeZone()
	broadcastSafeZone()

	logScanTimer += dt
	if logScanTimer >= LOG_SCAN_INTERVAL then
		logScanTimer = 0
		scanForLogFuel()
	end

	fuelBroadcastTimer += dt
	if fuelBroadcastTimer >= FUEL_BROADCAST_INTERVAL then
		fuelBroadcastTimer = 0
		broadcastFuel()
		broadcastLevel()
	end
end

--[[
    @summary  Locate the Bonfire's Fire effect and PointLight, and
              prepare the campfire anchor for drop-only fueling.
              Retries until WorldService has finished placing the
              campfire and bonfire.
]]
local function setupCampfire()
	if not worldService then
		task.defer(setupCampfire)
		return
	end

	local bonfire = worldService:GetBonfire()
	local anchor = worldService:GetCampfire()
	local map = bonfire and bonfire.Parent
	if not bonfire or not anchor then
		task.defer(setupCampfire)
		return
	end

	campfirePart = anchor :: BasePart
	if not campfirePart then
		return
	end

	-- Use the anchor as the safe-zone centre so it matches the spawn point.
	fireCenter = campfirePart

	local firePart = bonfire:FindFirstChild("Fire")
	if firePart and firePart:IsA("BasePart") then
		fireInstance = firePart:FindFirstChildOfClass("Fire")
	end

	for _, descendant in ipairs(bonfire:GetDescendants()) do
		if descendant:IsA("PointLight") then
			pointLight = descendant
			break
		end
	end

	if not pointLight and fireCenter then
		local newPointLight: PointLight = Instance.new("PointLight")
		newPointLight.Name = "CampfirePointLight"
		newPointLight.Parent = fireCenter
		pointLight = newPointLight
	end

	if pointLight then
		pointLight.Color = Color3.fromRGB(255, 130, 60)
		pointLight.Shadows = false
	end

	if map then
		for _, descendant in ipairs(map:GetDescendants()) do
			if
				descendant:IsA("BasePart")
				and descendant.Size.Y < 50
				and descendant.Size.X > 500
				and descendant.Size.Z > 500
			then
				groundPart = descendant
				break
			end
		end
	end

	-- Drop-only interaction: no Add Wood / Cook Meat proximity prompts.

	-- Remove any old safe zone visuals (disc or previous dots) before creating fresh dots
	local oldFolder = map and map:FindFirstChild("SafeZoneDots")
	if oldFolder then
		oldFolder:Destroy()
	end
	local oldDisc = map and map:FindFirstChild("SafeZone")
	if oldDisc then
		oldDisc:Destroy()
	end

	-- Create the safe zone visual: a dashed ring of slim glowing lines around the campfire
	local dotFolder = Instance.new("Folder")
	dotFolder.Name = "SafeZoneDots"
	dotFolder.Parent = map

	local dots = {}
	for i = 1, SAFE_ZONE_LINE_COUNT do
		local dot = Instance.new("Part")
		dot.Name = "SafeZoneLine" .. i
		dot.Shape = Enum.PartType.Block
		dot.Anchored = true
		dot.CanCollide = false
		dot.CanQuery = false
		dot.CanTouch = false
		dot.Material = SAFE_ZONE_LINE_MATERIAL
		dot.Color = SAFE_ZONE_LINE_COLOR
		dot.Transparency = SAFE_ZONE_LINE_OFF_TRANSPARENCY
		dot.Size = Vector3.new(SAFE_ZONE_LINE_THICKNESS, SAFE_ZONE_LINE_HEIGHT, 1)
		dot.CastShadow = false
		dot.Parent = dotFolder
		table.insert(dots, dot)
	end

	safeZoneDots = dots

	maxFuel = MAX_FUEL_BY_LEVEL[level]
	fuel = math.clamp(fuel, 0, maxFuel)
	isLit = fuel > 0

	updateFireVisuals()
	updateSafeZone()
	broadcastSafeZone(nil, true)

end

--[[
    @summary  Client-facing remote requesting the campfire be fed.
    @param    player  Player  -- injected by Knit
    @param    amount  number? -- logs to feed (default 1)
]]
function CampfireService.Client:RequestFuelCampfire(player: Player, amount: number?)
	local requested: number = if amount and typeof(amount) == "number" and amount >= 1 then amount else 1
	requested = math.floor(requested)
	self.Server:_FeedCampfire(player, requested)
end

--[[
    @summary  Internal server-only wrapper so both the Knit remote and
              the ProximityPrompt handler share one code path.
    @param    player  Player  -- the feeding player
    @param    amount  number
]]
function CampfireService:_FeedCampfire(player: Player, amount: number)
	feedCampfire(player, amount)
end

--[[
    @summary  Client-facing remote to fetch the full campfire state.
    @param    player  Player  -- injected by Knit
    @returns  number, number, number, number, number, boolean
]]
function CampfireService.Client:GetState(player: Player): (number, number, number, number, number, boolean)
	local requirement = LEVEL_REQUIREMENTS[level] or LEVEL_REQUIREMENTS[#LEVEL_REQUIREMENTS]
	return fuel, maxFuel, level, levelProgress, requirement, isLit
end

--[[
    @summary  Client-facing remote returning the current safe-zone radius
              and whether the fire is lit, so the client can initialise
              its state even if it missed the SafeZoneChanged signal.
    @returns  number, boolean  -- radius, isLit
]]
function CampfireService.Client:GetSafeZoneInfo(player: Player): (number, boolean)
	updateSafeZone()
	return currentSafeZoneRadius, isLit
end

-- // INITIALIZATION // --

function CampfireService:KnitStart()
	worldService = Knit.GetService("WorldService")
	playerDataService = Knit.GetService("PlayerDataService")
	inventoryService = Knit.GetService("InventoryService")
	spawnService = Knit.GetService("SpawnService")

	for _, player in ipairs(Players:GetPlayers()) do
		if not stateLoaded then
			loadCampfireStateFromPlayer(player)
		end
	end

	setupCampfire()
	CampfireService._HeartbeatConnection = RunService.Heartbeat:Connect(onHeartbeat)

	Players.PlayerAdded:Connect(function(player)
		if not stateLoaded then
			loadCampfireStateFromPlayer(player)
			updateFireVisuals()
			updateSafeZone()
			broadcastSafeZone(nil, true)
			broadcastFuel()
			broadcastLevel()
		elseif playerDataService then
			saveCampfireStateToPlayer(player)
		end

		if CampfireService.Client.SafeZoneRadius then
			CampfireService.Client.SafeZoneRadius:Set(currentSafeZoneRadius)
		end
		if CampfireService.Client.IsLit then
			CampfireService.Client.IsLit:Set(isLit)
		end

		local fraction = if maxFuel > 0 then fuel / maxFuel else 0
		local requirement = LEVEL_REQUIREMENTS[level] or LEVEL_REQUIREMENTS[#LEVEL_REQUIREMENTS]
		CampfireService.Client.SafeZoneChanged:Fire(player, currentSafeZoneRadius, isLit)
		CampfireService.Client.FuelChanged:Fire(player, fuel, maxFuel, fraction, isLit)
		CampfireService.Client.LevelChanged:Fire(player, level, levelProgress, requirement, math.clamp(levelProgress / requirement, 0, 1))
	end)

	if CampfireService.Client.SafeZoneRadius then
		CampfireService.Client.SafeZoneRadius:Set(currentSafeZoneRadius)
	end
	if CampfireService.Client.IsLit then
		CampfireService.Client.IsLit:Set(isLit)
	end

	for _, player in ipairs(Players:GetPlayers()) do
		local fraction = if maxFuel > 0 then fuel / maxFuel else 0
		local requirement = LEVEL_REQUIREMENTS[level] or LEVEL_REQUIREMENTS[#LEVEL_REQUIREMENTS]
		CampfireService.Client.SafeZoneChanged:Fire(player, currentSafeZoneRadius, isLit)
		CampfireService.Client.FuelChanged:Fire(player, fuel, maxFuel, fraction, isLit)
		CampfireService.Client.LevelChanged:Fire(player, level, levelProgress, requirement, math.clamp(levelProgress / requirement, 0, 1))

		if playerDataService then
			saveCampfireStateToPlayer(player)
		end
	end

end

-- Rojo hot-reload path: if the service already existed, the new module's KnitStart
-- won't be called by Knit, so run setup and wire events directly.
if not createSuccess then
	worldService = Knit.GetService("WorldService")
	playerDataService = Knit.GetService("PlayerDataService")
	inventoryService = Knit.GetService("InventoryService")

	if not CampfireService.Client then
		CampfireService.Client = {}
	end
	if not CampfireService.Client.FuelChanged then
		CampfireService.Client.FuelChanged = Knit.CreateSignal()
	end
	if not CampfireService.Client.LevelChanged then
		CampfireService.Client.LevelChanged = Knit.CreateSignal()
	end
	if not CampfireService.Client.SafeZoneChanged then
		CampfireService.Client.SafeZoneChanged = Knit.CreateSignal()
	end
	if not CampfireService.Client.LevelUp then
		CampfireService.Client.LevelUp = Knit.CreateSignal()
	end
	if not CampfireService.Client.SafeZoneRadius then
		CampfireService.Client.SafeZoneRadius = Knit.CreateProperty(0)
	end
	if not CampfireService.Client.IsLit then
		CampfireService.Client.IsLit = Knit.CreateProperty(false)
	end

	if CampfireService._HeartbeatConnection then
		CampfireService._HeartbeatConnection:Disconnect()
	end

	setupCampfire()
	CampfireService._HeartbeatConnection = RunService.Heartbeat:Connect(onHeartbeat)

end

Players.PlayerRemoving:Connect(function(player)
	feedCooldowns[player] = nil
end)

game:BindToClose(function()
	if playerDataService then
		saveCampfireState()
	end
end)

return CampfireService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="84">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--[[
    @file    CombatService.luau
    @author  manik
    @date    2025

    @summary
    Server-authoritative melee combat: range/cooldown/facing validation,
    NPC damage routing, and the Spear tool build/grant.

    @description
    A single click-to-attack remote drives both weapons.  The server
    finds the nearest registered `CombatTargetRegistry` NPC within
    range and facing angle of the attacker; if none is in range and
    the equipped tool is the Axe, the request falls back to
    HarvestService's tree-chop path so one click always does the
    contextually correct thing.  Never trusts a client-supplied target,
    distance, or damage amount.

    @exports
    - Knit Remote: RequestAttack()   (client -> server)
    - Knit Signal: AttackLanded(position, weaponName, wasImmune)
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local Constants = require(ReplicatedStorage.Shared.Constants)
local CombatTargetRegistry = require(script.Parent.Parent.CombatTargetRegistry)

-- | Objects | --
local CombatService = Knit.CreateService({
	Name = "CombatService",
	Client = {
		AttackLanded = Knit.CreateSignal(),
	},
})

-- | Configuration | --
local ITEMS_PATH = ServerStorage.Assets[Constants.ITEMS_PATH]
local AXE_TOOL_NAME = "Axe"
local SPEAR_TOOL_NAME = "Spear"
local ATTACK_RANGE = 8
local ATTACK_HALF_ANGLE = math.rad(60)
local WEAPON_DAMAGE = { Axe = 15, Spear = 25 }
local WEAPON_COOLDOWN = { Axe = 0.6, Spear = 0.9 }

-- | State Management | --
local harvestService: any = nil
local spawnService: any = nil
local spearTemplate: Tool? = nil
local attackCooldowns: { [Player]: number } = {}

-- // FUNCTIONS // --

--[[
    @summary  Build a wearable Spear Tool by cloning the Spear model
              and welding its parts onto a chosen Handle part.
    @returns  Tool?
]]
local function buildSpearTool(): Tool?
	local source = ITEMS_PATH:FindFirstChild("Spear")
	if not source then
		warn("[CombatService] Spear model not found in Assets Items")
		return nil
	end

	local clone = source:Clone()
	local shaft = clone:FindFirstChild("Union")
	if not shaft or not shaft:IsA("BasePart") then
		warn("[CombatService] Spear shaft (Union) not found")
		clone:Destroy()
		return nil
	end

	local tool = Instance.new("Tool")
	tool.Name = SPEAR_TOOL_NAME
	tool.RequiresHandle = true
	tool.GripPos = Vector3.new(0, -2, 0)
	tool.GripForward = Vector3.new(0, 0, -1)

	shaft.Name = "Handle"
	shaft.CanCollide = false
	shaft.Anchored = false

	for _, child in ipairs(clone:GetChildren()) do
		if child == shaft then
			continue
		elseif child:IsA("BasePart") then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = shaft
			weld.Part1 = child
			weld.Parent = shaft
			child.Anchored = false
			child.CanCollide = false
			child.Parent = tool
		elseif child:IsA("Model") then
			for _, sub in ipairs(child:GetDescendants()) do
				if sub:IsA("BasePart") then
					sub.Anchored = false
					sub.CanCollide = false
					local weld = Instance.new("WeldConstraint")
					weld.Part0 = shaft
					weld.Part1 = sub
					weld.Parent = shaft
				end
			end
			for _, sub in ipairs(child:GetChildren()) do
				sub.Parent = tool
			end
		end
	end

	shaft.Parent = tool
	clone:Destroy()
	return tool
end

--[[
    @summary  Grant the Spear tool to a player's Backpack and StarterGear.
    @param    player  Player
]]
local function giveSpear(player: Player)
	if not spearTemplate then
		return
	end
	if spawnService and not spawnService:IsPlayerSpawned(player) then
		return
	end

	local backpack = player:WaitForChild("Backpack")
	if not backpack:FindFirstChild(SPEAR_TOOL_NAME) then
		spearTemplate:Clone().Parent = backpack
	end

	local starterGear = player:WaitForChild("StarterGear")
	if not starterGear:FindFirstChild(SPEAR_TOOL_NAME) then
		spearTemplate:Clone().Parent = starterGear
	end
end

--[[
    @summary  Fire a Knit signal to every currently-connected player.
    @param    signal  KnitSignal
]]
local function broadcastToAll(signal, ...)
	for _, player in ipairs(Players:GetPlayers()) do
		signal:Fire(player, ...)
	end
end

--[[
    @summary  Return the player's currently-equipped weapon tool name,
              if any.
    @param    player  Player
    @returns  string?
]]
local function getEquippedWeaponName(player: Player): string?
	local character = player.Character
	if not character then
		return nil
	end
	local axe = character:FindFirstChild(AXE_TOOL_NAME)
	if axe and axe:IsA("Tool") then
		return AXE_TOOL_NAME
	end
	local spear = character:FindFirstChild(SPEAR_TOOL_NAME)
	if spear and spear:IsA("Tool") then
		return SPEAR_TOOL_NAME
	end
	return nil
end

--[[
    @summary  Find the nearest live combat target within range and
              facing angle of an attacking player.
    @param    player  Player
    @returns  Model?
]]
local function findNearestCombatTarget(player: Player): Model?
	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart or not rootPart:IsA("BasePart") then
		return nil
	end

	local nearest: Model? = nil
	local nearestDist = math.huge

	for _, model in ipairs(CollectionService:GetTagged(CombatTargetRegistry.TagName)) do
		if not model:IsA("Model") or not model.Parent then
			continue
		end
		local targetPart = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("HRP")
		if not targetPart or not targetPart:IsA("BasePart") then
			continue
		end

		local toTarget = targetPart.Position - rootPart.Position
		local dist = toTarget.Magnitude
		if dist > ATTACK_RANGE or dist <= 0 then
			continue
		end

		local angle = math.acos(math.clamp(rootPart.CFrame.LookVector.Unit:Dot(toTarget.Unit), -1, 1))
		if angle > ATTACK_HALF_ANGLE then
			continue
		end

		if dist < nearestDist then
			nearestDist = dist
			nearest = model
		end
	end

	return nearest
end

--[[
    @summary  Validate and process a melee attack request: hit the
              nearest in-range NPC, or fall back to tree chopping for
              the Axe when nothing is in range.
    @param    player  Player  -- injected by Knit
]]
function CombatService.Client:RequestAttack(player: Player)
	local weaponName = getEquippedWeaponName(player)
	if not weaponName then
		return
	end

	local now = os.clock()
	local cooldown = WEAPON_COOLDOWN[weaponName] or 1
	if attackCooldowns[player] and (now - attackCooldowns[player]) < cooldown then
		return
	end

	local target = findNearestCombatTarget(player)
	if target then
		attackCooldowns[player] = now
		local handlers = CombatTargetRegistry.Get(target)
		if handlers then
			local killed, immune = handlers.ApplyDamage(WEAPON_DAMAGE[weaponName] or 10, player)
			broadcastToAll(CombatService.Client.AttackLanded, target:GetPivot().Position, weaponName, immune == true)
		end
		return
	end

	if weaponName == AXE_TOOL_NAME and harvestService then
		harvestService:TryChopNearest(player)
	end
end

-- // INITIALIZATION // --

function CombatService:KnitStart()
	harvestService = Knit.GetService("HarvestService")
	spawnService = Knit.GetService("SpawnService")

	spearTemplate = buildSpearTool()

	if spawnService and spawnService.PlayerSpawned then
		spawnService.PlayerSpawned:Connect(giveSpear)
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if spawnService and spawnService:IsPlayerSpawned(player) then
			giveSpear(player)
		end
	end

end

Players.PlayerRemoving:Connect(function(player)
	attackCooldowns[player] = nil
end)

return CombatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="85">
          <Properties>
            <string name="Name">CookingService</string>
            <string name="Source"><![CDATA[--[[
    @file    CookingService.luau
    @author  manik
    @date    2025

    @summary
    Server-authoritative raw-meat-to-cooked-meat conversion at the Bonfire.

    @description
    Raw meat is converted to cooked meat automatically when it is dropped
    onto the lit Campfire.  Cooked meat restores more Hunger when eaten via
    ForageService's RequestEat.  The actual cooking logic is handled inside
    CampfireService so fueling and cooking share one drop-only interaction.

    @exports
    - (no public API; auto-cook handled by CampfireService)
]]

-- // VARIABLES // --

-- | Services | --
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)

-- | Objects | --
local CookingService = Knit.CreateService({
	Name = "CookingService",
})

-- | Configuration | --
-- Drop-only cooking no longer needs range/cooldown constants.

-- | State Management | --
-- Cooking logic now lives in CampfireService to support drop-only cooking.

-- // INITIALIZATION // --

function CookingService:KnitStart()
	-- Raw meat is cooked automatically when dropped onto the lit fire.
end

return CookingService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="86">
          <Properties>
            <string name="Name">CraftingService</string>
            <string name="Source"><![CDATA[--[[
    @file    CraftingService.luau
    @author  manik
    @date    2025

    @summary
    Server-authoritative crafting bench tiers, recipe transactions,
    recipe caps, unlocks, and one-use building placement tokens.

    @exports
    - CraftingService:GetBenchTier() -> number
    - CraftingService:GetPlacementToken(player, tokenId) -> table?
    - CraftingService:ConsumePlacementToken(player, tokenId) -> boolean
    - Knit Remote: GetBenchState()
    - Knit Remote: RequestCraft(recipeId)
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local RecipeConfig = require(ReplicatedStorage.Shared.RecipeConfig)

-- | Objects | --
local CraftingService = Knit.CreateService({
	Name = "CraftingService",
	Client = {
		OpenCrafting = Knit.CreateSignal(),
		CraftingStateChanged = Knit.CreateSignal(),
		CraftSucceeded = Knit.CreateSignal(),
	},
})

-- | Configuration | --
local BENCH_RANGE = 16
local CRAFT_COOLDOWN = 0.2
local BENCH_OFFSET = CFrame.new(14, 0, 0)

-- | State Management | --
local runStateService: any = nil
local playerDataService: any = nil
local inventoryService: any = nil
local worldService: any = nil

local benchTier = 1
local benchModel: Model? = nil
local recipeCounts: { [string]: number } = {}
local unlocks: { [string]: boolean } = {}
local placementTokens: { [Player]: { [string]: { structureId: string, runId: string } } } = {}
local craftCooldowns: { [Player]: number } = {}

-- // FUNCTIONS // --

-- | Private | --

--[[
    @summary  Return the world position used for crafting range checks.
    @returns  Vector3?
]]
local function getBenchPosition(): Vector3?
	if not benchModel or not benchModel.Parent then
		return nil
	end
	return benchModel:GetPivot().Position
end

--[[
    @summary  Return whether a player may interact with the live bench.
    @param    player  Player
    @returns  boolean
]]
local function isNearBench(player: Player): boolean
	local benchPosition = getBenchPosition()
	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not benchPosition or not rootPart or not rootPart:IsA("BasePart") then
		return false
	end
	if not humanoid or humanoid.Health <= 0 then
		return false
	end
	return (rootPart.Position - benchPosition).Magnitude <= BENCH_RANGE
end

--[[
    @summary  Return whether the player owns every cost in a recipe.
    @param    player  Player
    @param    cost    table
    @returns  boolean
]]
local function canAfford(player: Player, cost: { [string]: number }): boolean
	local data = playerDataService and playerDataService:GetData(player)
	if not data or not data.Resources then
		return false
	end
	for resourceName, amount in pairs(cost) do
		if (data.Resources[resourceName] or 0) < amount then
			return false
		end
	end
	return true
end

--[[
    @summary  Deduct a fully validated recipe cost without yielding.
    @param    player  Player
    @param    cost    table
]]
local function deductCost(player: Player, cost: { [string]: number })
	playerDataService:UpdateData(player, function(data)
		for resourceName, amount in pairs(cost) do
			data.Resources[resourceName] -= amount
			if data.Inventory and data.Inventory.PickupOrder then
				for _ = 1, amount do
					for index = #data.Inventory.PickupOrder, 1, -1 do
						if data.Inventory.PickupOrder[index] == resourceName then
							table.remove(data.Inventory.PickupOrder, index)
							break
						end
					end
				end
			end
		end
	end)
end

--[[
    @summary  Create and remember one opaque building placement token.
    @param    player       Player
    @param    structureId  string
    @returns  string
]]
local function grantPlacementToken(player: Player, structureId: string): string
	local tokenId = HttpService:GenerateGUID(false)
	placementTokens[player] = placementTokens[player] or {}
	placementTokens[player][tokenId] = {
		structureId = structureId,
		runId = runStateService:GetRunId(),
	}
	return tokenId
end

--[[
    @summary  Send a current crafting snapshot to all run members.
]]
local function broadcastState()
	local snapshot = {
		tier = benchTier,
		recipeCounts = table.clone(recipeCounts),
		unlocks = table.clone(unlocks),
	}
	for _, player in ipairs(runStateService:GetMembers()) do
		CraftingService.Client.CraftingStateChanged:Fire(player, snapshot)
	end
end

--[[
    @summary  Place the existing crafting table beside the campfire.
]]
local function placeBench()
	if benchModel then
		benchModel:Destroy()
		benchModel = nil
	end

	local mapsItems = ServerStorage.Assets:FindFirstChild("Assets maps items")
	local source = mapsItems and mapsItems:FindFirstChild("crafting-table")
	local campfireCFrame = worldService and worldService:GetCampfireCFrame()
	if not source or not source:IsA("Model") or not campfireCFrame then
		warn("[CraftingService] crafting-table asset or campfire is missing")
		return
	end

	local clone = source:Clone()
	clone.Name = "CraftingBench"
	for _, descendant in ipairs(clone:GetDescendants()) do
		if descendant:IsA("BaseScript") or descendant:IsA("ModuleScript") then
			descendant:Destroy()
		elseif descendant:IsA("BasePart") then
			descendant.Anchored = true
		end
	end
	clone.Parent = runStateService:GetRuntimeFolder()

	local pivot = clone:GetPivot()
	local _, size = clone:GetBoundingBox()
	clone:PivotTo(campfireCFrame * BENCH_OFFSET * CFrame.new(0, size.Y * 0.5, 0) * pivot.Rotation)
	benchModel = clone

	local anchor = clone.PrimaryPart or clone:FindFirstChildWhichIsA("BasePart", true)
	if anchor then
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "CraftingPrompt"
		prompt.ActionText = "Craft"
		prompt.ObjectText = "Crafting Bench"
		prompt.MaxActivationDistance = BENCH_RANGE
		prompt.HoldDuration = 0.25
		prompt.Parent = anchor
		prompt.Triggered:Connect(function(player)
			if runStateService:IsActive() and runStateService:IsMember(player) then
				CraftingService.Client.OpenCrafting:Fire(player)
			end
		end)
	end
end

--[[
    @summary  Clear all crafting progress and place a fresh bench.
]]
local function resetForRun()
	benchTier = 1
	recipeCounts = {}
	unlocks = {}
	placementTokens = {}
	craftCooldowns = {}
	placeBench()
	broadcastState()
end

-- | Public | --

--[[
    @summary  Return the current shared crafting bench tier.
    @returns  number
]]
function CraftingService:GetBenchTier(): number
	return benchTier
end

--[[
    @summary  Return whether a navigation utility has been crafted.
    @param    unlockId  string
    @returns  boolean
]]
function CraftingService:HasUnlock(unlockId: string): boolean
	return unlocks[unlockId] == true
end

--[[
    @summary  Return a copy of a live placement token owned by a player.
    @param    player   Player
    @param    tokenId  string
    @returns  table?
]]
function CraftingService:GetPlacementToken(player: Player, tokenId: string): { [string]: string }?
	local token = placementTokens[player] and placementTokens[player][tokenId]
	if not token then
		return nil
	end
	return table.clone(token)
end

--[[
    @summary  Consume one live placement token after successful placement.
    @param    player   Player
    @param    tokenId  string
    @returns  boolean
]]
function CraftingService:ConsumePlacementToken(player: Player, tokenId: string): boolean
	local token = placementTokens[player] and placementTokens[player][tokenId]
	if not token or token.runId ~= runStateService:GetRunId() then
		return false
	end
	placementTokens[player][tokenId] = nil
	return true
end

--[[
    @summary  Return the caller's current crafting state.
    @param    player  Player  -- injected by Knit
    @returns  table
]]
function CraftingService.Client:GetBenchState(player: Player): { [string]: any }
	local data = playerDataService and playerDataService:GetData(player)
	return {
		tier = benchTier,
		resources = if data then table.clone(data.Resources) else {},
		recipeCounts = table.clone(recipeCounts),
		unlocks = table.clone(unlocks),
		isNearBench = isNearBench(player),
	}
end

--[[
    @summary  Validate and perform one crafting transaction.
    @param    player    Player  -- injected by Knit
    @param    recipeId  string
    @returns  table
]]
function CraftingService.Client:RequestCraft(player: Player, recipeId: string): { [string]: any }
	if typeof(recipeId) ~= "string" then
		return { ok = false, code = "INVALID_RECIPE" }
	end
	if not runStateService:IsActive() or not runStateService:IsMember(player) then
		return { ok = false, code = "NOT_ACTIVE" }
	end

	local recipe = RecipeConfig[recipeId]
	if not recipe then
		return { ok = false, code = "INVALID_RECIPE" }
	end
	if recipe.Tier > benchTier then
		return { ok = false, code = "WRONG_TIER" }
	end
	if recipe.RunCap and (recipeCounts[recipeId] or 0) >= recipe.RunCap then
		return { ok = false, code = "CAP_REACHED" }
	end
	if not isNearBench(player) then
		return { ok = false, code = "NOT_NEAR_BENCH" }
	end

	local now = os.clock()
	if craftCooldowns[player] and now - craftCooldowns[player] < CRAFT_COOLDOWN then
		return { ok = false, code = "RATE_LIMITED" }
	end
	if not canAfford(player, recipe.Cost) then
		return { ok = false, code = "INSUFFICIENT_RESOURCES" }
	end

	craftCooldowns[player] = now
	local capturedRunId = runStateService:GetRunId()
	deductCost(player, recipe.Cost)
	if not runStateService:IsCurrentRun(capturedRunId) then
		return { ok = false, code = "RUN_CHANGED" }
	end

	recipeCounts[recipeId] = (recipeCounts[recipeId] or 0) + 1
	local response = { ok = true, code = "OK", outputKind = recipe.OutputKind, outputId = recipe.OutputId }

	if recipe.OutputKind == "Placement" then
		response.placementToken = grantPlacementToken(player, recipe.OutputId)
	elseif recipe.OutputKind == "Item" then
		inventoryService:AddResource(player, recipe.OutputId, 1)
	elseif recipe.OutputKind == "Unlock" then
		unlocks[recipe.OutputId] = true
	elseif recipe.OutputKind == "BenchUpgrade" then
		benchTier = math.max(benchTier, tonumber(recipe.OutputId) or benchTier)
	end

	inventoryService:Refresh(player)
	broadcastState()
	CraftingService.Client.CraftSucceeded:Fire(player, recipeId, response)
	return response
end

-- // INITIALIZATION // --

function CraftingService:KnitStart()
	runStateService = Knit.GetService("RunStateService")
	playerDataService = Knit.GetService("PlayerDataService")
	inventoryService = Knit.GetService("InventoryService")
	worldService = Knit.GetService("WorldService")

	runStateService.RunStarted:Connect(resetForRun)
	runStateService.RunCleaned:Connect(function()
		benchModel = nil
		placementTokens = {}
		craftCooldowns = {}
	end)

	Players.PlayerRemoving:Connect(function(player)
		placementTokens[player] = nil
		craftCooldowns[player] = nil
	end)
end

return CraftingService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="87">
          <Properties>
            <string name="Name">CultistRaidService</string>
            <string name="Source"><![CDATA[--[[
    @file    CultistRaidService.luau
    @author  manik
    @date    2025

    @summary
    Recurring timed Cultist raids on the campfire, with a warning,
    a fuel-decay penalty for unresolved raids, and a clear-out reward.

    @description
    Every RAID_INTERVAL_DAYS nights a wave of Cultist/Cultist2 spawns
    around the camp perimeter and marches on the campfire, reusing
    AnimalAIService's generic chase/attack state machine so raiders
    behave exactly like any other hostile NPC.  A warning fires at the
    start of the preceding day.  If any raider survives to dawn, the
    campfire's fuel drains faster in proportion to the number left.

    @exports
    - Knit Signal: RaidWarning(dayNumber)
    - Knit Signal: RaidStarted(dayNumber, cultistCount)
    - Knit Signal: RaidCleared(dayNumber)
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)

-- | Objects | --
local CultistRaidService = Knit.CreateService({
	Name = "CultistRaidService",
	Client = {
		RaidWarning = Knit.CreateSignal(),
		RaidStarted = Knit.CreateSignal(),
		RaidCleared = Knit.CreateSignal(),
	},
})

-- | Configuration | --
local RAID_INTERVAL_DAYS = 4
local BASE_RAID_SIZE = 3
local RAID_SIZE_GROWTH_PER_INTERVAL = 1
local MAX_RAID_SIZE = 8
local SPAWN_RADIUS = 55
local RAID_PENALTY_PER_SURVIVOR = 0.6
local RAID_CLEANUP_DELAY = 30
local CULTIST_MODEL_KEYS = { "Cultist", "Cultist2" }

-- | State Management | --
local timeService: any = nil
local worldService: any = nil
local animalAIService: any = nil
local campfireService: any = nil
local lastPhase: string = "Day"
local raidActive = false
local raidCultists: { Model } = {}
local raidDayNumber = 0
local cleanupScheduled = false

-- // FUNCTIONS // --

--[[
    @summary  Fire a Knit signal to every currently-connected player.
    @param    signal  KnitSignal
]]
local function broadcastToAll(signal, ...)
	for _, player in ipairs(Players:GetPlayers()) do
		signal:Fire(player, ...)
	end
end

--[[
    @summary  Return true if a raid should occur on the given day number.
    @param    dayNumber  number
    @returns  boolean
]]
local function isRaidDay(dayNumber: number): boolean
	return dayNumber > 0 and dayNumber % RAID_INTERVAL_DAYS == 0
end

--[[
    @summary  Compute how many cultists spawn for a given day number.
    @param    dayNumber  number
    @returns  number
]]
local function computeRaidSize(dayNumber: number): number
	local intervals = math.floor(dayNumber / RAID_INTERVAL_DAYS)
	return math.clamp(BASE_RAID_SIZE + (intervals - 1) * RAID_SIZE_GROWTH_PER_INTERVAL, BASE_RAID_SIZE, MAX_RAID_SIZE)
end

--[[
    @summary  Spawn a wave of cultists in a ring around the campfire.
    @param    count  number
]]
local function spawnRaidWave(count: number)
	if not worldService or not animalAIService then
		return
	end
	local campfireCFrame = worldService:GetCampfireCFrame()
	if not campfireCFrame then
		return
	end

	raidCultists = {}
	for i = 1, count do
		local angle = (i / count) * math.pi * 2
		local position = campfireCFrame.Position + Vector3.new(math.cos(angle) * SPAWN_RADIUS, 0, math.sin(angle) * SPAWN_RADIUS)
		local origin = position + Vector3.new(0, 200, 0)
		local result = workspace:Raycast(origin, Vector3.new(0, -400, 0))
		local groundedPosition = if result then result.Position + Vector3.new(0, 3, 0) else position + Vector3.new(0, 5, 0)

		local speciesKey = CULTIST_MODEL_KEYS[((i - 1) % #CULTIST_MODEL_KEYS) + 1]
		local model = animalAIService:SpawnNpc(speciesKey, CFrame.new(groundedPosition))
		if model then
			table.insert(raidCultists, model)
		end
	end
end

--[[
    @summary  Count how many of this raid's cultists are still alive.
    @returns  number
]]
local function countSurvivors(): number
	local count = 0
	for _, model in ipairs(raidCultists) do
		if not model.Parent then
			continue
		end
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health > 0 then
			count += 1
		end
	end
	return count
end

--[[
    @summary  Begin a raid: fire the started signal and spawn the wave.
    @param    dayNumber  number
]]
local function startRaid(dayNumber: number)
	raidActive = true
	raidDayNumber = dayNumber
	cleanupScheduled = false
	local count = computeRaidSize(dayNumber)
	spawnRaidWave(count)
	broadcastToAll(CultistRaidService.Client.RaidStarted, dayNumber, count)
end

--[[
    @summary  Destroy any cultists still alive once the cleanup grace
              period after dawn has elapsed.
]]
local function cleanupRemainingRaiders()
	for _, model in ipairs(raidCultists) do
		if model.Parent then
			model:Destroy()
		end
	end
	raidCultists = {}
	raidActive = false
end

--[[
    @summary  Heartbeat-driven raid lifecycle: detect day/night
              transitions, apply the dawn fuel penalty, and clear the
              raid once every cultist is dead.
    @param    dt  number
]]
local function onHeartbeat(dt: number)
	if not timeService or not timeService:IsRunning() then
		return
	end

	local phase = timeService:GetCurrentPhase()
	local dayNumber = timeService:GetDayNumber()

	if phase ~= lastPhase then
		lastPhase = phase
		if phase == "Day" and isRaidDay(dayNumber) then
			broadcastToAll(CultistRaidService.Client.RaidWarning, dayNumber)
		elseif phase == "Night" and isRaidDay(dayNumber) and not raidActive then
			startRaid(dayNumber)
		elseif phase == "Day" and raidActive then
			if not cleanupScheduled then
				cleanupScheduled = true
				task.delay(RAID_CLEANUP_DELAY, function()
					if raidActive then
						cleanupRemainingRaiders()
					end
				end)
			end
		end
	end

	if not raidActive then
		return
	end

	local survivors = countSurvivors()
	if survivors == 0 then
		raidActive = false
		broadcastToAll(CultistRaidService.Client.RaidCleared, raidDayNumber)
		return
	end

	if phase == "Day" and campfireService then
		campfireService:ApplyExternalDrain(RAID_PENALTY_PER_SURVIVOR * survivors * dt)
	end
end

-- // INITIALIZATION // --

function CultistRaidService:KnitStart()
	timeService = Knit.GetService("TimeService")
	worldService = Knit.GetService("WorldService")
	animalAIService = Knit.GetService("AnimalAIService")
	campfireService = Knit.GetService("CampfireService")

	RunService.Heartbeat:Connect(onHeartbeat)

end

return CultistRaidService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="88">
          <Properties>
            <string name="Name">DeerService</string>
            <string name="Source"><![CDATA[--[[
    @file    DeerService.luau
    @author  manik
    @date    2025

    @summary
    Server-authoritative unkillable stalker AI for the Deer and Ram
    Monster, including the flashlight-stun mechanic.

    @description
    Both entities share one behavioral family per the reference game:
    dormant by day, hunt the nearest player outside the campfire's
    safe zone at night in a straight line, speed up the longer they
    pursue one target, retreat when that target reaches the safe zone,
    and deal heavy contact damage instead of dying to weapons.  A
    flashlight beam interrupts an active chase with a stun whose
    duration shrinks on each consecutive use against the same
    instance, recovering over time between uses.

    @exports
    - DeerService:ApplyFlashlightStun(model, player) -> boolean  (server only)
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local _Debris = game:GetService("Debris")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local NpcConfig = require(ReplicatedStorage.Shared.NpcConfig)
local CombatTargetRegistry = require(script.Parent.Parent.CombatTargetRegistry)

-- | Objects | --
local DeerService = Knit.CreateService({
	Name = "DeerService",
	Client = {
		StalkerStunned = Knit.CreateSignal(),
		StalkerContact = Knit.CreateSignal(),
		StalkerActive = Knit.CreateSignal(),
	},
})

-- | Configuration | --
local NPC_SOURCE_PATH = ServerStorage.Assets["Assets Npcs"]
local DORMANT_HOLDING_POSITION = Vector3.new(0, 300, 0)
local DECISION_INTERVAL = 0.2
local CONTACT_RANGE = 14
local CONTACT_COOLDOWN = 2.5
local ATTACK_LOCKOUT = 1.6 -- time the Deer pauses to play attack animation
local PURSUIT_ACCEL_PER_SEC = 0.35
local PURSUIT_MAX_BONUS_SPEED = 14
local BASE_STUN_DURATION = 4
local STUN_DECAY_PER_USE = 0.6
local MIN_STUN_DURATION = 1
local STUN_RESISTANCE_RECOVERY_TIME = 45
local RETREAT_HOLD_TIME = 3
local GAIT_AMPLITUDE = math.rad(35)
local GAIT_ARM_AMPLITUDE = math.rad(22)
local IDLE_LERP_SPEED = 6

-- Ram Monster starts appearing from night 8 onwards, with a 30% chance
-- to replace the Deer on any given night (mirrors the 99 Nights wiki:
-- "there is a chance for the Ram to spawn each night; if it does,
-- the Deer will not spawn")
local RAM_START_DAY = 8
local RAM_SPAWN_CHANCE = 0.30

local STALKER_DEFS = {
	Deer = {
		ModelName = "Deer",
		BaseSpeed = 14,
		AttackDamage = 55,
		UsesFlashlightStun = true,
	},
	RamMonster = {
		ModelName = "Ram Monster",
		BaseSpeed = NpcConfig.RamMonster.WalkSpeed,
		AttackDamage = NpcConfig.RamMonster.AttackDamage,
		UsesFlashlightStun = true,
	},
}

-- | State Management | --
local worldService: any = nil
local timeService: any = nil
local campfireService: any = nil
local spawnService: any = nil
local playerLifeService: any = nil
local stalkers: { [string]: any } = {}
local deerSuppressed = false
local activeStalkerKey: string? = nil  -- which stalker is active tonight ("Deer" or "RamMonster")
local lastPhase: string? = nil

-- // FUNCTIONS // --

--[[
    @summary  Fire a Knit signal to every currently-connected player.
    @param    signal  KnitSignal
]]
local function broadcastToAll(signal, ...)
	for _, player in ipairs(Players:GetPlayers()) do
		signal:Fire(player, ...)
	end
end

--[[
	@summary  Collect every Motor6D whose second part is a leg or arm,
			  tagged with which side it is on for gait phasing.
	@param    model  Model
	@returns  { { motor: Motor6D, originalC0: CFrame, isLeg: boolean, side: string } }
]]
local function _collectGaitJoints(model)
	local joints = {}
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("Motor6D") and descendant.Part1 then
			local partName = descendant.Part1.Name
			local lower = partName:lower()
			local isLeg = lower:find("leg") ~= nil or lower:find("foot") ~= nil
			local isArm = lower:find("arm") ~= nil or lower:find("hand") ~= nil
			if isLeg or isArm then
				local side = if lower:find("left") or lower:find("%.l") then "Left" else "Right"
				table.insert(joints, {
					motor = descendant,
					originalC0 = descendant.C0,
					isLeg = isLeg,
					side = side,
				})
			end
		end
	end
	return joints
end

--[[
	@summary  Register KeyframeSequences via KeyframeSequenceProvider
	          and update the model's Animations folder with the local IDs.
	          This bypasses the need for published animation asset IDs.
	@param    model  Model
]]
local function registerKeyframeAnims(model: Model)
	local KSSP = game:GetService("KeyframeSequenceProvider")
	local kfFolder = model:FindFirstChild("KeyframeSequences")
	if not kfFolder then return end

	local animFolder = model:FindFirstChild("Animations")
	if not animFolder then
		animFolder = Instance.new("Folder")
		animFolder.Name = "Animations"
		animFolder.Parent = model
	end

	for _, kfs in ipairs(kfFolder:GetChildren()) do
		if kfs:IsA("KeyframeSequence") then
			-- RegisterKeyframeSequence returns a hash (not a numeric asset ID).
			-- It must be used as-is without the "rbxassetid://" prefix.
			local assetId = KSSP:RegisterKeyframeSequence(kfs)
			local animObj = animFolder:FindFirstChild(kfs.Name)
			if not animObj then
				animObj = Instance.new("Animation")
				animObj.Name = kfs.Name
				animObj.Parent = animFolder
			end
			animObj.AnimationId = assetId
		end
	end
end

--[[
	@summary  Drive procedural leg/arm swing via Motor6D offsets for
			  custom rigs with no working baked locomotion animation.
	@param    stalker   table
	@param    dt        number
	@param    isMoving  boolean
]]
local function applyProceduralGait(stalker, dt: number, isMoving: boolean)
	if not stalker.gaitJoints then
		return
	end

	if isMoving then
		local speedFactor = math.clamp(stalker.humanoid.WalkSpeed / 10, 0.6, 2.6)
		stalker.gaitPhase = (stalker.gaitPhase or 0) + dt * 8 * speedFactor
	end

	for _, joint in ipairs(stalker.gaitJoints) do
		local target: CFrame
		if isMoving then
			local phaseOffset = if joint.side == "Right" then math.pi else 0
			local amplitude = if joint.isLeg then GAIT_AMPLITUDE else GAIT_ARM_AMPLITUDE
			local swing = math.sin(stalker.gaitPhase + phaseOffset) * amplitude
			target = joint.originalC0 * CFrame.Angles(swing, 0, 0)
		else
			target = joint.originalC0
		end
		joint.motor.C0 = joint.motor.C0:Lerp(target, math.clamp(dt * IDLE_LERP_SPEED, 0, 1))
	end
end

local DEFAULT_R6_WALK_ID = "rbxassetid://180426354"
local DEFAULT_R6_IDLE_ID = "rbxassetid://180435571"
local DEFAULT_R6_RUN_ID = "rbxassetid://180426354"

--[[
    @summary  Load a stalker's baked Animations folder into AnimationTracks,
              falling back to the default R15 walk/idle/run set for a
              stalker with no baked Animations folder (Ram Monster shares
              the Deer's stalker logic but ships no baked animations).
    @param    stalker  table
]]
local function buildAnimationTracks(stalker)
	stalker.tracks = {}
	local humanoid = stalker.humanoid
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	-- Register KeyframeSequences FIRST so the Animations folder has valid local IDs
	registerKeyframeAnims(stalker.model)

	local function loadTrack(id: string, looped: boolean): AnimationTrack?
		local anim = Instance.new("Animation")
		anim.AnimationId = id
		local ok, track = pcall(function()
			return animator:LoadAnimation(anim)
		end)
		if not ok or not track then
			return nil
		end
		track.Looped = looped
		return track
	end

	local animFolder = stalker.model:FindFirstChild("Animations")
	if animFolder then
		for _, animInstance in ipairs(animFolder:GetChildren()) do
			if animInstance:IsA("Animation") then
				local ok, track = pcall(function()
					return animator:LoadAnimation(animInstance)
				end)
				if ok and track then
					track.Looped = animInstance.Name ~= "Jumpscare"
						and animInstance.Name ~= "StunnedStart"
						and animInstance.Name ~= "StunnedEnd"
						and animInstance.Name ~= "Attack"
					-- Set explicit priorities so Attack/Stunned override Walk/Run
					if animInstance.Name == "Attack" or animInstance.Name == "Jumpscare" or animInstance.Name == "Scared" then
						track.Priority = Enum.AnimationPriority.Action4
					elseif animInstance.Name:match("^Stunned") then
						track.Priority = Enum.AnimationPriority.Action4
					elseif animInstance.Name == "Walk" or animInstance.Name == "Run" then
						track.Priority = Enum.AnimationPriority.Action2
					elseif animInstance.Name == "Idle" then
						track.Priority = Enum.AnimationPriority.Idle
					end
					stalker.tracks[animInstance.Name] = track
				end
			end
		end
	end

	if not stalker.tracks.Walk then
		stalker.tracks.Walk = loadTrack(DEFAULT_R6_WALK_ID, true)
	end
	if not stalker.tracks.Run then
		stalker.tracks.Run = loadTrack(DEFAULT_R6_RUN_ID, true)
	end
	if not stalker.tracks.Idle then
		stalker.tracks.Idle = loadTrack(DEFAULT_R6_IDLE_ID, true)
	end
end

--[[
    @summary  Stop every currently-playing track on a stalker.
    @param    stalker  table
]]
local function stopAllTracks(stalker)
	for _, track in pairs(stalker.tracks) do
		if track.IsPlaying then
			track:Stop(0)
		end
	end
end

--[[
    @summary  Play a named track if it exists, without interrupting
              itself if already playing.
    @param    stalker  table
    @param    name     string
]]
local function playTrack(stalker, name: string)
	local track = stalker.tracks[name]
	if not track then
		warn("[DeerService] No track found for", name, "on", stalker.key)
		return
	end
	-- Don't restart if already playing (avoids stutter on looping tracks
	-- that are called every Heartbeat like Walk/Run/Idle)
	if track.IsPlaying then return end
	-- Only stop locomotion tracks to avoid nuking Attack/Stunned animations
	local locomotionTracks = { Walk = true, Run = true, Idle = true }
	for trackName, t in pairs(stalker.tracks) do
		if t ~= track and t.IsPlaying and locomotionTracks[trackName] then
			t:Stop(0.15)
		end
	end
	track:Play(0.15)
end

--[[
    @summary  Move a stalker to the hidden holding position and disable
              collision/visibility while dormant.
    @param    stalker  table
]]
local function enterDormant(stalker)
	stalker.state = "Dormant"
	stalker.target = nil
	stalker.pursuitStartTime = nil
	stalker.model:PivotTo(CFrame.new(DORMANT_HOLDING_POSITION))
	stalker.humanoid.WalkSpeed = 0
	if stalker.rootPart then
		stalker.rootPart.Anchored = true
	end
	stopAllTracks(stalker)
end

--[[
    @summary  Spawn a stalker's model into the world at a hidden holding
              position, ready to be activated at night.
    @param    key  string  -- key into STALKER_DEFS
]]
local function spawnStalker(key: string)
	local def = STALKER_DEFS[key]
	local template = NPC_SOURCE_PATH:FindFirstChild(def.ModelName)
	if not template or not template:IsA("Model") then
		warn("[DeerService] Missing template for", key)
		return
	end

	local model = template:Clone()
	model.Parent = workspace
	model:PivotTo(CFrame.new(DORMANT_HOLDING_POSITION))

	local humanoid = model:FindFirstChildOfClass("Humanoid") or model:FindFirstChild("NPC")
	-- Prefer HRP (the actual PrimaryPart) over HumanoidRootPart, since
	-- HumanoidRootPart may be a non-colliding anchored dummy in custom rigs
	local rootPart = model:FindFirstChild("HRP") or model:FindFirstChild("HumanoidRootPart")
	if not humanoid or not rootPart then
		warn("[DeerService] Template", def.ModelName, "missing Humanoid/root part")
		model:Destroy()
		return
	end

	-- Set PrimaryPart so external services (FlashlightService) can locate
	-- the stalker's position via model.PrimaryPart
	model.PrimaryPart = rootPart

	-- Anchor the root part to keep the model suspended at the dormant position.
	-- It will be un-anchored when the stalker activates at night.
	rootPart.Anchored = true
	-- Un-anchor everything else (including HumanoidRootPart, which is welded
	-- to HRP — if it stays anchored the weld prevents the whole model from moving).
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") and part ~= rootPart then
			part.Anchored = false
		end
	end

	local stalker = {
		key = key,
		def = def,
		model = model,
		humanoid = humanoid,
		rootPart = rootPart,
		state = "Dormant",
		target = nil,
		lastContactTime = 0,
		attackUntil = 0,
		consecutiveStuns = 0,
		lastStunTime = 0,
		stunUntil = 0,
		stunEndPlayed = false,
		retreatUntil = 0,
		nextDecisionTime = 0,
		pursuitStartTime = nil,
	}

	buildAnimationTracks(stalker)

	-- Note: Procedural gait is disabled for the Deer because we now have
	-- proper KeyframeSequence-based animations registered via
	-- KeyframeSequenceProvider that handle all joint movement.
	-- Using both would conflict as they both set Motor6D.Transform.

	stalkers[key] = stalker

	CombatTargetRegistry.Register(model, {
		ApplyDamage = function()
			return false, true
		end,
		IsImmune = true,
	})
end

--[[
    @summary  Pick the nearest in-game player who is currently outside
              the campfire's safe zone.
    @param    fromPosition  Vector3  -- the stalker's current position
    @returns  Player?, Vector3?
]]
local function findHuntableTarget(fromPosition: Vector3): (Player?, Vector3?)
	local nearest: Player? = nil
	local nearestPos: Vector3? = nil
	local nearestDist = math.huge
	for _, player in ipairs(Players:GetPlayers()) do
		if spawnService and not spawnService:IsPlayerSpawned(player) then
			continue
		end
		if playerLifeService and not playerLifeService:IsAlive(player) then
			continue
		end
		local character = player.Character
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		if not rootPart or not rootPart:IsA("BasePart") then
			continue
		end
		if campfireService and campfireService:IsInSafeZone(rootPart.Position) then
			continue
		end
		local dist = (rootPart.Position - fromPosition).Magnitude
		if dist < nearestDist then
			nearestDist = dist
			nearest = player
			nearestPos = rootPart.Position
		end
	end
	return nearest, nearestPos
end

--[[
    @summary  Compute a stalker's current speed based on how long it
              has been pursuing its current target.
    @param    stalker  table
    @returns  number
]]
local function computePursuitSpeed(stalker): number
	if not stalker.pursuitStartTime then
		return stalker.def.BaseSpeed
	end
	local elapsed = os.clock() - stalker.pursuitStartTime
	local bonus = math.min(elapsed * PURSUIT_ACCEL_PER_SEC, PURSUIT_MAX_BONUS_SPEED)
	return stalker.def.BaseSpeed + bonus
end

--[[
    @summary  Decide whether a dormant/patrolling stalker should begin
              or continue a pursuit, or retreat.
    @param    stalker  table
]]
local function updateStalkerState(stalker)
	local now = os.clock()

	if stalker.state == "Stunned" then
		if now >= stalker.stunUntil then
			-- Play StunnedEnd transition animation
			if not stalker.stunEndPlayed then
				stalker.stunEndPlayed = true
				stopAllTracks(stalker)
				local endTrack = stalker.tracks["StunnedEnd"]
				if endTrack then
					endTrack:Play(0.1)
				end
			end
			-- Wait a brief moment for StunnedEnd to start before transitioning state
			task.delay(0.3, function()
				if stalker.state == "Stunned" and os.clock() >= stalker.stunUntil then
					stalker.state = if stalker.target then "Pursuing" else "Patrol"
				end
			end)
		end
		return
	end

	if stalker.state == "Retreating" then
		if now >= stalker.retreatUntil then
			stalker.state = "Patrol"
			stalker.target = nil
		end
		return
	end

	local currentPhase = timeService and timeService:GetCurrentPhase() or "Day"

	-- Phase transition: decide which stalker is active tonight
	if currentPhase ~= lastPhase then
		lastPhase = currentPhase
		if currentPhase == "Night" then
			local dayNumber = timeService:GetDayNumber()
			-- Roll for Ram Monster replacing the Deer (from RAM_START_DAY onwards)
			if dayNumber >= RAM_START_DAY and math.random() <= RAM_SPAWN_CHANCE then
				activeStalkerKey = "RamMonster"
			else
				activeStalkerKey = "Deer"
			end
			broadcastToAll(DeerService.Client.StalkerActive, activeStalkerKey)
		elseif currentPhase == "Day" then
			activeStalkerKey = nil
		end
	end

	if currentPhase ~= "Night" then
		if stalker.state ~= "Dormant" then
			enterDormant(stalker)
		end
		return
	end

	-- Only the active stalker for tonight is allowed to hunt
	if stalker.key ~= activeStalkerKey then
		if stalker.state ~= "Dormant" then
			enterDormant(stalker)
		end
		return
	end

	-- Deer is suppressed when the Owl is active tonight
	if deerSuppressed and stalker.key == "Deer" then
		if stalker.state ~= "Dormant" then
			enterDormant(stalker)
		end
		return
	end

	if stalker.state == "Dormant" then
		stalker.state = "Patrol"
		local campfirePosition = (worldService and worldService:GetCampfireCFrame() or CFrame.new()).Position
		local angle = math.random() * math.pi * 2
		local entryOffset = Vector3.new(math.cos(angle) * 90, 0, math.sin(angle) * 90)
		-- Raycast down to find ground level so the Deer doesn't spawn underground
		local spawnPos = campfirePosition + entryOffset
		local rayOrigin = spawnPos + Vector3.new(0, 200, 0)
		local rayParams = RaycastParams.new()
		local rayResult = workspace:Raycast(rayOrigin, Vector3.new(0, -400, 0), rayParams)
		if rayResult then
			spawnPos = rayResult.Position + Vector3.new(0, 5, 0)
		else
			spawnPos = spawnPos + Vector3.new(0, 10, 0)
		end
		stalker.model:PivotTo(CFrame.new(spawnPos))
		-- Un-anchor the root part so the Deer can walk
		if stalker.rootPart then
			stalker.rootPart.Anchored = false
		end
	end

	if stalker.target then
		local character = (stalker.target :: Player).Character
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		if not rootPart or (campfireService and campfireService:IsInSafeZone(rootPart.Position)) then
			stalker.state = "Retreating"
			stalker.retreatUntil = now + RETREAT_HOLD_TIME
			stalker.target = nil
			stalker.pursuitStartTime = nil
			return
		end
		stalker.state = "Pursuing"
		return
	end

	local target, _ = findHuntableTarget(stalker.rootPart.Position)
	if target then
		stalker.target = target
		stalker.pursuitStartTime = now
		stalker.state = "Pursuing"
	else
		stalker.state = "Patrol"
	end
end

--[[
    @summary  Execute movement/contact-damage behavior for a stalker's
              current state.
    @param    stalker  table
]]
local function runStalkerBehavior(stalker)
	if stalker.state == "Dormant" or stalker.state == "Stunned" then
		stalker.humanoid.WalkSpeed = 0
		if stalker.state == "Stunned" then
			local startTrack = stalker.tracks["StunnedStart"]
			local loopTrack = stalker.tracks["StunnedLoop"]
			-- Stop Attack track if it's still playing from a recent contact
			local attackTrack = stalker.tracks["Attack"]
			if attackTrack and attackTrack.IsPlaying then
				attackTrack:Stop(0)
			end
			if startTrack and startTrack.IsPlaying then
				-- Let StunnedStart finish, then switch to StunnedLoop in next tick
			elseif loopTrack and not loopTrack.IsPlaying then
				if startTrack then startTrack:Stop(0) end
				loopTrack:Play(0.1)
			end
		end
		return
	end

	if stalker.state == "Retreating" then
		stalker.humanoid.WalkSpeed = stalker.def.BaseSpeed
		playTrack(stalker, "Run")
		local campfirePos = (worldService and worldService:GetCampfireCFrame() or CFrame.new()).Position
		local awayDir = stalker.rootPart.Position - campfirePos
		if awayDir.Magnitude < 1 then
			awayDir = Vector3.new(1, 0, 0)
		end
		awayDir = Vector3.new(awayDir.X, 0, awayDir.Z).Unit
		stalker.humanoid:MoveTo(stalker.rootPart.Position + awayDir * 40)
		return
	end

	if stalker.state == "Patrol" then
		stalker.humanoid.WalkSpeed = stalker.def.BaseSpeed * 0.4
		playTrack(stalker, "Idle")
		return
	end

	if stalker.state == "Pursuing" and stalker.target then
		local character = (stalker.target :: Player).Character
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		if not rootPart then
			return
		end

		local now = os.clock()

		-- Attack lockout: pause movement and let the Attack animation play
		if now < stalker.attackUntil then
			stalker.humanoid.WalkSpeed = 0
			return
		end

		local speed = computePursuitSpeed(stalker)
		stalker.humanoid.WalkSpeed = speed
		playTrack(stalker, if speed > stalker.def.BaseSpeed * 1.4 then "Run" else "Walk")
		stalker.humanoid:MoveTo(rootPart.Position)

		local dist = (stalker.rootPart.Position - rootPart.Position).Magnitude
		if dist <= CONTACT_RANGE and (now - stalker.lastContactTime) >= CONTACT_COOLDOWN then
			stalker.lastContactTime = now
			stalker.attackUntil = now + ATTACK_LOCKOUT
			local targetPlayer = stalker.target :: Player?
			if targetPlayer and playerLifeService and playerLifeService:IsAlive(targetPlayer) then
				playerLifeService:ApplyDamage(targetPlayer, stalker.def.AttackDamage, stalker.key)
				-- Stop only Walk/Run (not all tracks) to avoid nuking Attack
				if stalker.tracks.Walk and stalker.tracks.Walk.IsPlaying then
					stalker.tracks.Walk:Stop(0.1)
				end
				if stalker.tracks.Run and stalker.tracks.Run.IsPlaying then
					stalker.tracks.Run:Stop(0.1)
				end
				local attackTrack = stalker.tracks.Attack
				if attackTrack then
					attackTrack:Play(0.1)
				end
				broadcastToAll(DeerService.Client.StalkerContact, stalker.rootPart.Position, stalker.key)
			end
		end
	end
end

--[[
    @summary  Suppress or unsuppress the Deer (called by OwlService).
              When suppressed, the Deer stays dormant even at night.
    @param    suppressed  boolean
]]
function DeerService:SuppressDeer(suppressed: boolean)
	deerSuppressed = suppressed
	if suppressed then
		local deer = stalkers["Deer"]
		if deer and deer.state ~= "Dormant" then
			enterDormant(deer)
		end
	end
end

--[[
    @summary  Return whether the Deer stalker is currently active (not dormant).
    @returns  boolean
]]
function DeerService:IsDeerActive(): boolean
	local deer = stalkers["Deer"]
	return deer ~= nil and deer.state ~= "Dormant"
end

--[[
    @summary  Return every stalker to its hidden dormant state.
]]
function DeerService:ResetForRun()
	deerSuppressed = false
	activeStalkerKey = nil
	lastPhase = nil
	for _, stalker in pairs(stalkers) do
		enterDormant(stalker)
	end
end

--[[
    @summary  Interrupt a stalker's pursuit with a flashlight stun,
              shortening the duration for each consecutive use.
    @param    model   Model    -- the Deer/Ram Monster model
    @param    player  Player   -- the player holding the flashlight
    @returns  boolean          -- true if the stun was applied
]]
function DeerService:ApplyFlashlightStun(model: Model, player: Player): boolean
	for _, stalker in pairs(stalkers) do
		if stalker.model == model then
			if not stalker.def.UsesFlashlightStun or stalker.state == "Stunned" or stalker.state == "Dormant" then
				return false
			end

			local now = os.clock()
			if (now - stalker.lastStunTime) >= STUN_RESISTANCE_RECOVERY_TIME then
				stalker.consecutiveStuns = 0
			end
			stalker.consecutiveStuns += 1
			stalker.lastStunTime = now

			local duration = math.max(
				BASE_STUN_DURATION - (stalker.consecutiveStuns - 1) * STUN_DECAY_PER_USE,
				MIN_STUN_DURATION
			)

			stalker.state = "Stunned"
			stalker.stunUntil = now + duration
			stalker.humanoid.WalkSpeed = 0
			stalker.stunEndPlayed = false
			-- Stop all tracks immediately so Attack/Run don't override StunnedStart
			stopAllTracks(stalker)
			-- Play StunnedStart directly (not via playTrack which would call stopAllTracks again)
			local startTrack = stalker.tracks["StunnedStart"]
			if startTrack then
				startTrack:Play(0.1)
			else
				-- Fallback: if no StunnedStart track, play StunnedLoop directly
				local loopTrack = stalker.tracks["StunnedLoop"]
				if loopTrack then
					loopTrack:Play(0.1)
				end
			end

			broadcastToAll(DeerService.Client.StalkerStunned, stalker.rootPart.Position, stalker.key, duration)
			return true
		end
	end
	return false
end

--[[
    @summary  Heartbeat-driven tick for every registered stalker.
]]
local function onHeartbeat(dt: number)
	local now = os.clock()
	for _, stalker in pairs(stalkers) do
		if now >= stalker.nextDecisionTime then
			stalker.nextDecisionTime = now + DECISION_INTERVAL
			updateStalkerState(stalker)
		end
		runStalkerBehavior(stalker)

		-- Apply procedural gait for custom-rig stalkers (Deer)
		if stalker.gaitJoints then
			local vel = stalker.rootPart.AssemblyLinearVelocity
			local isMoving = Vector3.new(vel.X, 0, vel.Z).Magnitude > 1
			applyProceduralGait(stalker, dt, isMoving and stalker.state ~= "Stunned")
		end
	end
end

-- // INITIALIZATION // --

function DeerService:KnitStart()
	worldService = Knit.GetService("WorldService")
	timeService = Knit.GetService("TimeService")
	campfireService = Knit.GetService("CampfireService")
	spawnService = Knit.GetService("SpawnService")
	playerLifeService = Knit.GetService("PlayerLifeService")

	task.delay(3, function()
		spawnStalker("Deer")
		spawnStalker("RamMonster")
	end)

	RunService.Heartbeat:Connect(onHeartbeat)
end

return DeerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="89">
          <Properties>
            <string name="Name">EndingService</string>
            <string name="Source"><![CDATA[--[[
    @file    EndingService.luau
    @author  manik
    @date    2025

    @summary
    One-shot Day 67 victory or team-defeat transition, threat pause,
    result construction, idempotent lifetime records, and lobby return.
]]

-- // VARIABLES // --

-- | Services | --
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local RunConfig = require(ReplicatedStorage.Shared.RunConfig)

-- | Objects | --
local EndingService = Knit.CreateService({
	Name = "EndingService",
	Client = {
		EndingStarted = Knit.CreateSignal(),
		ResultsReady = Knit.CreateSignal(),
	},
})

-- | State Management | --
local runStateService: any = nil
local timeService: any = nil
local playerDataService: any = nil
local playerLifeService: any = nil
local rescueService: any = nil
local buildingService: any = nil
local animalAIService: any = nil
local deerService: any = nil
local owlService: any = nil
local endingRunId = ""

-- // FUNCTIONS // --

--[[
    @summary  Return a player's finalized result and persistence payload.
    @param    player      Player
    @param    reason      string
    @param    endingData  table
    @returns  table
]]
local function buildPlayerResult(player: Player, reason: string, endingData): { [string]: any }
	local data = playerDataService:GetData(player)
	local stats = data and data.Stats or {}
	local displayedDay = timeService:GetDisplayedDay()
	local cycleIndex = timeService:GetCycleIndex()
	local victory = reason == "DAY_67"
	return {
		runId = endingRunId,
		reason = reason,
		victory = victory,
		displayedDay = displayedDay,
		goalDay = RunConfig.GoalDay,
		cycleIndex = cycleIndex,
		elapsedSeconds = endingData.elapsedSeconds or runStateService:GetElapsedSeconds(),
		multiplier = runStateService:GetMultiplier(),
		multiplierSources = runStateService:GetMultiplierSources(),
		childrenRescued = stats.ChildrenRescued or rescueService:GetRescuedCount(),
		structuresBuilt = stats.StructuresBuilt or 0,
		treesChopped = stats.TreesChopped or 0,
		wolvesKilled = stats.WolvesKilled or 0,
		cultistsKilled = stats.CultistsKilled or 0,
		revives = stats.Revives or 0,
		downs = stats.Downs or 0,
		deaths = if playerLifeService:GetLifeState(player) == "Eliminated" then 1 else 0,
	}
end

--[[
    @summary  Persist and deliver final results to every run member.
    @param    reason  string
    @param    data    table
]]
local function finalizeResults(reason: string, data)
	for _, player in ipairs(runStateService:GetMembers()) do
		local result = buildPlayerResult(player, reason, data)
		local saved, saveCode = playerDataService:ApplyRunRecords(player, endingRunId, result)
		result.recordSaved = saved
		result.recordSaveCode = saveCode
		EndingService.Client.ResultsReady:Fire(player, result)
	end
end

--[[
    @summary  Pause active threats and begin the shared result sequence.
    @param    reason  string
    @param    data    table
]]
local function onRunEnding(reason: string, data)
	local currentRunId = runStateService:GetRunId()
	if currentRunId == "" or endingRunId == currentRunId then
		return
	end
	endingRunId = currentRunId
	timeService:Pause()
	animalAIService:CleanupAll()
	deerService:ResetForRun()
	owlService:ResetForRun()

	local presentation = {
		reason = reason,
		victory = reason == "DAY_67",
		displayedDay = timeService:GetDisplayedDay(),
		cycleIndex = timeService:GetCycleIndex(),
		goalDay = RunConfig.GoalDay,
		elapsedSeconds = data.elapsedSeconds or runStateService:GetElapsedSeconds(),
	}
	for _, player in ipairs(runStateService:GetMembers()) do
		EndingService.Client.EndingStarted:Fire(player, presentation)
	end
	finalizeResults(reason, data)

	local capturedRunId = endingRunId
	task.delay(RunConfig.ResultsDisplaySeconds, function()
		if runStateService:GetRunId() == capturedRunId then
			runStateService:CleanupRun(reason)
			endingRunId = ""
		end
	end)
end

-- // INITIALIZATION // --

function EndingService:KnitStart()
	runStateService = Knit.GetService("RunStateService")
	timeService = Knit.GetService("TimeService")
	playerDataService = Knit.GetService("PlayerDataService")
	playerLifeService = Knit.GetService("PlayerLifeService")
	rescueService = Knit.GetService("RescueService")
	buildingService = Knit.GetService("BuildingService")
	animalAIService = Knit.GetService("AnimalAIService")
	deerService = Knit.GetService("DeerService")
	owlService = Knit.GetService("OwlService")

	timeService:OnDawn(function(payload)
		if payload.reachedGoal == true then
			runStateService:BeginEnding("DAY_67", payload)
		end
	end)
	runStateService.RunEnding:Connect(onRunEnding)
end

return EndingService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="90">
          <Properties>
            <string name="Name">FlashlightService</string>
            <string name="Source"><![CDATA[--[[
    @file    FlashlightService.luau
    @author  manik
    @date    2025

    @summary
    Server-validated flashlight beam check with battery drain.

    @description
    Tracks per-player flashlight battery, drains it while the beam is
    on, and recharges it slowly while off. When the battery reaches
    zero the beam is forced off. Independently computes the wielder s
    facing, range, and cone alignment against active stalkers before
    applying a stun, so the client cannot dictate the outcome.

    @exports
    - Knit Remote: SetBeamActive(isActive: boolean)  (client -> server)
    - Knit Remote: GetBatteryState() -> { percent: number, isOn: boolean }
    - Knit Signal: BatteryChanged(percent: number, isOn: boolean)
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local RunConfig = require(ReplicatedStorage.Shared.RunConfig)
local CombatTargetRegistry = require(script.Parent.Parent.CombatTargetRegistry)

-- | Objects | --
local FlashlightService = Knit.CreateService({
	Name = "FlashlightService",
	Client = {
		BatteryChanged = Knit.CreateSignal(),
	},
})

-- | Configuration | --
local FLASHLIGHT_TOOL_NAME = "Flashlight"
local BEAM_RANGE = 35
local BEAM_HALF_ANGLE = math.rad(30)
local CHECK_INTERVAL = 0.15
local BATTERY_DRAIN_PER_SECOND = 5 -- 20 seconds of full use
local BATTERY_RECHARGE_PER_SECOND = 1.5 -- slow passive recharge
local STALKER_MODEL_NAMES = { "Deer", "Ram Monster", "Owl" }

-- | State Management | --
local deerService: any = nil
local owlService: any = nil
local beamActive: { [Player]: boolean } = {}
local battery: { [Player]: number } = {}
local lastBroadcastState: { [Player]: { percent: number, isOn: boolean } } = {}
local checkTimer = 0

-- // FUNCTIONS // --

--[[
    @summary  Return true if a player currently has the Flashlight
              tool equipped.
    @param    player  Player
    @returns  boolean
]]
local function hasFlashlightEquipped(player: Player): boolean
	local character = player.Character
	if not character then
		return false
	end
	local tool = character:FindFirstChild(FLASHLIGHT_TOOL_NAME)
	return tool ~= nil and tool:IsA("Tool")
end

--[[
    @summary  Check if the player's equipped flashlight SpotLight is
              actually enabled.  This bypasses the client-to-server
              remote entirely, reading the tool state directly on the
              server.
    @param    player  Player
    @returns  boolean
]]
local function isFlashlightBeamOn(player: Player): boolean
	local character = player.Character
	if not character then
		return false
	end
	local tool = character:FindFirstChild(FLASHLIGHT_TOOL_NAME)
	if not tool or not tool:IsA("Tool") then
		return false
	end
	local handle = tool:FindFirstChild("Handle")
	if not handle then
		return false
	end
	local spotLight = handle:FindFirstChildOfClass("SpotLight")
	return spotLight ~= nil and spotLight.Enabled
end

--[[
    @summary  Broadcast the current battery state to the owning player.
    @param    player  Player
]]
local function broadcastBattery(player: Player)
	local percent = math.floor(battery[player] or 100)
	local isOn = beamActive[player] == true

	local last = lastBroadcastState[player]
	if last and last.percent == percent and last.isOn == isOn then
		return
	end

	lastBroadcastState[player] = { percent = percent, isOn = isOn }
	FlashlightService.Client.BatteryChanged:Fire(player, percent, isOn)
end

--[[
    @summary  Initialise battery for a new player.
    @param    player  Player
]]
local function ensureBattery(player: Player)
	if battery[player] == nil then
		battery[player] = 100
	end
end

--[[
    @summary  Update battery for every player on each tick.
    @param    dt  number
]]
local function updateBatteries(dt: number)
	for player, isActive in pairs(beamActive) do
		ensureBattery(player)
		if not player.Parent then
			continue
		end

		local current = battery[player]
		if isActive and hasFlashlightEquipped(player) then
			current -= BATTERY_DRAIN_PER_SECOND * dt
			if current <= 0 then
				current = 0
				beamActive[player] = false
				-- Force the client to turn the visual beam off
				broadcastBattery(player)
			end
		else
			current += BATTERY_RECHARGE_PER_SECOND * dt
			if current > 100 then
				current = 100
			end
		end
		battery[player] = current
		broadcastBattery(player)
	end
end

--[[
    @summary  Check whether a player s facing direction is aligned
              with and in range of a stalker s position.
    @param    player   Player
    @param    stalker  Model
    @returns  boolean
]]
local function isBeamAlignedWithStalker(player: Player, stalker: Model): boolean
	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart or not rootPart:IsA("BasePart") then
		return false
	end

	local stalkerPart = stalker.PrimaryPart
		or stalker:FindFirstChild("HRP")
		or stalker:FindFirstChild("HumanoidRootPart")
		or stalker:FindFirstChildWhichIsA("BasePart", true)
	if not stalkerPart then
		return false
	end

	local toStalker = stalkerPart.Position - rootPart.Position
	local distance = toStalker.Magnitude
	if distance > BEAM_RANGE or distance <= 0 then
		return false
	end

	-- Use horizontal-only angle so height differences between player and
	-- stalker don't cause the beam alignment to fail.
	local flatToStalker = Vector3.new(toStalker.X, 0, toStalker.Z)
	local flatLook = Vector3.new(rootPart.CFrame.LookVector.X, 0, rootPart.CFrame.LookVector.Z)
	if flatLook.Magnitude <= 0 or flatToStalker.Magnitude <= 0 then
		return false
	end
	local angle = math.acos(math.clamp(flatLook.Unit:Dot(flatToStalker.Unit), -1, 1))
	local aligned = angle <= BEAM_HALF_ANGLE

	if aligned and RunConfig.IsTestEnabled("VerboseFlashlight") then
		print(string.format("[FlashlightService] beam aligned with %s at %.1f studs", stalker.Name, distance))
	end

	return aligned
end

--[[
    @summary  For every player currently holding their beam on, check
              alignment against active stalkers and apply a stun.
]]
local function checkAllBeams()
	if not deerService and not owlService then
		return
	end

	local candidates = CollectionService:GetTagged(CombatTargetRegistry.TagName)
	local stalkerModels = {}
	for _, model in ipairs(candidates) do
		if model:IsA("Model") and table.find(STALKER_MODEL_NAMES, model.Name) then
			table.insert(stalkerModels, model)
		end
	end
	if #stalkerModels == 0 then
		return
	end

	for player, isActive in pairs(beamActive) do
		if not isActive or not player.Parent or not hasFlashlightEquipped(player) then
			continue
		end
		for _, stalkerModel in ipairs(stalkerModels) do
			if isBeamAlignedWithStalker(player, stalkerModel) then
				if stalkerModel.Name == "Owl" and owlService then
					owlService:ApplyFlashlightStun(stalkerModel, player)
				elseif deerService then
					deerService:ApplyFlashlightStun(stalkerModel, player)
				end
			end
		end
	end

	-- Also check players who have the flashlight equipped and SpotLight
	-- enabled, even if the client never reported beam state via remote.
	for _, player in ipairs(Players:GetPlayers()) do
		if beamActive[player] then
			continue -- already checked above
		end
		if not player.Parent or not isFlashlightBeamOn(player) then
			continue
		end
		for _, stalkerModel in ipairs(stalkerModels) do
			if isBeamAlignedWithStalker(player, stalkerModel) then
				if stalkerModel.Name == "Owl" and owlService then
					owlService:ApplyFlashlightStun(stalkerModel, player)
				elseif deerService then
					deerService:ApplyFlashlightStun(stalkerModel, player)
				end
			end
		end
	end
end

--[[
    @summary  Client-facing remote reporting whether the local player s
              flashlight beam is currently switched on.
    @param    player     Player   -- injected by Knit
    @param    isActive   boolean  -- the requested beam state
]]
function FlashlightService.Client:SetBeamActive(player: Player, isActive: boolean)
	if typeof(isActive) ~= "boolean" then
		return
	end
	ensureBattery(player)
	-- Don t allow turning on if the battery is empty
	if isActive and (battery[player] or 0) <= 0 then
		isActive = false
	end
	beamActive[player] = isActive
	broadcastBattery(player)
end

--[[
    @summary  Client-facing remote returning the current battery state.
    @param    player  Player
    @returns  { percent: number, isOn: boolean }
]]
function FlashlightService.Client:GetBatteryState(player: Player): { percent: number, isOn: boolean }
	ensureBattery(player)
	return {
		percent = math.floor(battery[player] :: number),
		isOn = beamActive[player] == true,
	}
end

--[[
    @summary  Heartbeat-driven update: drain/recharge battery and
              throttled beam alignment check.
    @param    dt  number
]]
local function onHeartbeat(dt: number)
	updateBatteries(dt)

	checkTimer += dt
	if checkTimer < CHECK_INTERVAL then
		return
	end
	checkTimer = 0
	checkAllBeams()
end

-- // INITIALIZATION // --

function FlashlightService:KnitStart()
	deerService = Knit.GetService("DeerService")
	owlService = Knit.GetService("OwlService")
	RunService.Heartbeat:Connect(onHeartbeat)
end

Players.PlayerRemoving:Connect(function(player)
	beamActive[player] = nil
	battery[player] = nil
	lastBroadcastState[player] = nil
end)

return FlashlightService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="91">
          <Properties>
            <string name="Name">ForageService</string>
            <string name="Source"><![CDATA[--[[
    @file    ForageService.luau
    @author  manik
    @date    2025

    @summary
    Server-authoritative Berries/Mushrooms foraging and eating.

    @description
    Scatters pickup-able Berries (reusing the existing `Carrot` mesh as
    the closest available forage-food art) and Mushrooms (using the
    `Mushroom` model from Assets Items) near trees across the base-map.
    Players pick them up via the CarryController hover/pickup system (F key) into their inventory, then
    eat them from the Inventory UI to restore Hunger.  Respawns on a
    timer, mirroring HarvestService's tree/log pattern.

    @exports
    - Knit Remote: RequestEat(resourceName)  -> boolean  (client -> server)
]]

-- // VARIABLES // --

-- | Services | --
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local Constants = require(ReplicatedStorage.Shared.Constants)

-- | Objects | --
local ForageService = Knit.CreateService({
	Name = "ForageService",
	Client = {},
})

-- | Configuration | --
local ITEMS_PATH = ServerStorage.Assets[Constants.ITEMS_PATH]
local TREE_MODEL_NAMES = { "Tree", "bigtree" }
local BERRY_TARGET_COUNT = 35
local MUSHROOM_TARGET_COUNT = 25
local MIN_TREE_SCATTER_RADIUS = 4
local MAX_TREE_SCATTER_RADIUS = 45
local MAP_SCATTER_CHANCE = 0.4
local PICKUP_RANGE = 12
local RESPAWN_TIME = 60
local MIN_SUBMERGE = 0.65
local MAX_SUBMERGE = 1.15
local MUSHROOM_SUBMERGE_MAX = 0.15
local BERRY_HUNGER_RESTORE = 12
local MUSHROOM_HUNGER_RESTORE = 10
local RAW_MEAT_HUNGER_RESTORE = 15
local RABBIT_MEAT_HUNGER_RESTORE = 18
local COOKED_MEAT_HUNGER_RESTORE = 30
local EAT_HUNGER_RESTORE = {
	Berries = BERRY_HUNGER_RESTORE,
	Mushrooms = MUSHROOM_HUNGER_RESTORE,
	RawMeat = RAW_MEAT_HUNGER_RESTORE,
	RabbitMeat = RABBIT_MEAT_HUNGER_RESTORE,
	CookedMeat = COOKED_MEAT_HUNGER_RESTORE,
}

-- | State Management | --
local worldService: any = nil
local inventoryService: any = nil
local hungerService: any = nil
local treePivots: { CFrame } = {}
local groundPart: BasePart? = nil
local groundBounds: { minX: number, maxX: number, minZ: number, maxZ: number }? = nil
local activePickups = 0

-- // FUNCTIONS // --

--[[
    @summary  Build a Mushroom forage pickup using the stored Mushroom asset.
    @returns  Model
]]
local function buildMushroomProp(): Model
	if not inventoryService then
		local fallback = Instance.new("Model")
		fallback.Name = "MushroomPickup"
		return fallback
	end
	local model = inventoryService:BuildMushroomModel()
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = true
		end
	end
	return model
end

--[[
    @summary  Scan the base-map for tree pivots so forage points can be
              scattered near them.  Retries until the forest is ready.
]]
local function collectTreePivots()
	if not worldService or not worldService:IsForestReady() then
		task.defer(collectTreePivots)
		return
	end

	local baseMap = worldService:GetBaseMap()
	if not baseMap then
		task.defer(collectTreePivots)
		return
	end

	-- Remove edit-mode preview forage items before spawning real ones.
	local preview = baseMap:FindFirstChild("ForagePreview")
	if preview then
		preview:Destroy()
	end

	treePivots = {}
	for _, descendant in ipairs(baseMap:GetDescendants()) do
		if descendant:IsA("Model") and table.find(TREE_MODEL_NAMES, descendant.Name) then
			table.insert(treePivots, descendant:GetPivot())
		elseif descendant:IsA("BasePart") and descendant.Name == "Земля" then
			groundPart = descendant
			local halfSize = descendant.Size / 2
			groundBounds = {
				minX = descendant.Position.X - halfSize.X,
				maxX = descendant.Position.X + halfSize.X,
				minZ = descendant.Position.Z - halfSize.Z,
				maxZ = descendant.Position.Z + halfSize.Z,
			}
		end
	end

end

--[[
    @summary  Return the Y coordinate of the base-map ground plane.
    @returns  number?
]]
local function getGroundTopY(): number?
	if not groundPart then
		return nil
	end
	return groundPart.Position.Y + groundPart.Size.Y / 2
end

--[[
    @summary  Pick a completely random position within the base-map ground
              bounds so forage can appear anywhere, not only near trees.
    @returns  Vector3?
]]
local function randomMapPosition(): Vector3?
	if not groundBounds then
		return nil
	end
	local y = getGroundTopY()
	if not y then
		return nil
	end
	local x = math.random() * (groundBounds.maxX - groundBounds.minX) + groundBounds.minX
	local z = math.random() * (groundBounds.maxZ - groundBounds.minZ) + groundBounds.minZ
	return Vector3.new(x, y, z)
end

--[[
    @summary  Pick a random ground position near a random tree or anywhere
              on the map, using the true ground height.
    @returns  Vector3?
]]
local function randomForagePosition(): Vector3?
	local y = getGroundTopY()
	if not y then
		return nil
	end

	if math.random() < MAP_SCATTER_CHANCE then
		return randomMapPosition()
	end

	if #treePivots == 0 then
		return nil
	end
	local pivot = treePivots[math.random(1, #treePivots)]
	local angle = math.random() * math.pi * 2
	local radius = MIN_TREE_SCATTER_RADIUS + math.random() * (MAX_TREE_SCATTER_RADIUS - MIN_TREE_SCATTER_RADIUS)
	local x = pivot.Position.X + math.cos(angle) * radius
	local z = pivot.Position.Z + math.sin(angle) * radius
	return Vector3.new(x, y, z)
end

--[[
    @summary  Compute a ground-partially-submerged CFrame for a forage
              pickup, with random yaw.  Mushrooms stay upright to preserve
              the asset's authored axis and angle.
    @param    position      Vector3  -- ground position
    @param    resourceName  string
    @param    size          Vector3? -- size of the berry mesh
    @returns  CFrame
]]
local function buildForageCFrame(position: Vector3, resourceName: string, size: Vector3?): CFrame
	local x, z = position.X, position.Z
	local yaw = math.random() * math.pi * 2

	local function makeBerryCFrame(y: number, leanDegrees: number, roll: number?): CFrame
		local pitch = math.rad(leanDegrees)
		local rollRad = roll or 0

		-- long X axis leans from +Y (up) toward a random horizontal direction (yaw).
		local right = Vector3.new(
			math.sin(pitch) * math.sin(yaw),
			math.cos(pitch),
			math.sin(pitch) * math.cos(yaw)
		)

		-- choose an 'up' perpendicular to 'right' and the world Y plane.
		local up = Vector3.new(math.cos(yaw), 0, -math.sin(yaw))
		local back = right:Cross(up)

		-- roll around the long (right) axis.
		if rollRad ~= 0 then
			local cosR = math.cos(rollRad)
			local sinR = math.sin(rollRad)
			up = (up * cosR) + (back * sinR)
			back = right:Cross(up)
		end

		return CFrame.fromMatrix(Vector3.new(x, y, z), right, up)
	end

	if resourceName == "Berries" then
		local halfExtent = (size and math.sqrt(size.X * size.X + size.Y * size.Y) or 2.4) / 2
		local submerge = MIN_SUBMERGE + math.random() * (MAX_SUBMERGE - MIN_SUBMERGE)
		local lean = math.random(35, 55)
		local rightY = math.cos(math.rad(lean))
		local y = position.Y + halfExtent * rightY - submerge
		local roll = math.random() * math.pi * 2
		return makeBerryCFrame(y, lean, roll) * CFrame.Angles(0, 0, math.rad(-45))
	else
		local submerge = math.random() * MUSHROOM_SUBMERGE_MAX
		local y = position.Y - submerge
		local offset = inventoryService and inventoryService:GetMushroomBaseOffset() or 1.93
		return CFrame.new(x, y, z) * CFrame.Angles(0, yaw, 0) * CFrame.new(0, offset, 0)
	end
end

--[[
    @summary  Spawn one forage pickup of the given resource type and
              schedule its respawn after it's collected.
    @param    resourceName  string  -- "Berries" or "Mushrooms"
]]
local function spawnForagePickup(resourceName: string)
	local position = randomForagePosition()
	if not worldService then
		task.delay(2, spawnForagePickup, resourceName)
		return
	end
	local baseMap = worldService:GetBaseMap()
	if not position or not baseMap then
		task.delay(2, spawnForagePickup, resourceName)
		return
	end

	local model: Model
	local cframe: CFrame
	if resourceName == "Berries" then
		local source = ITEMS_PATH:FindFirstChild("Carrot")
		if not source then
			warn("[ForageService] Carrot mesh not found in Assets Items")
			return
		end
		model = Instance.new("Model")
		model.Name = "BerriesPickup"
		local clone = source:Clone()
		clone.Name = "BerriesMesh"
		clone.Anchored = true
		clone.CanCollide = true
		clone.Parent = model
		model.PrimaryPart = clone
		cframe = buildForageCFrame(position, resourceName, clone.Size)
	else
		model = buildMushroomProp()
		cframe = buildForageCFrame(position, resourceName, nil)
	end

	model:PivotTo(cframe)
	model:SetAttribute("ForageResource", resourceName)

	model.Parent = baseMap
	activePickups += 1
end

--[[
    @summary  Validate and process a forage pickup attempt.
    @param    model   Model   -- the forage pickup model
    @param    player  Player  -- the picking player
]]
local function tryForagePickup(model: Model, player: Player): boolean
	if not model.Parent then
		return false
	end
	if inventoryService and inventoryService:IsModelDragged(model) then
		return false
	end

	local resourceName = model:GetAttribute("ForageResource")
	if not resourceName then
		return false
	end

	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart or not rootPart:IsA("BasePart") then
		return false
	end

	if (rootPart.Position - model:GetPivot().Position).Magnitude > PICKUP_RANGE then
		return false
	end

	if not inventoryService then
		return false
	end
	local added = inventoryService:AddResource(player, resourceName, 1)
	if added <= 0 then
		return false
	end

	local isLiveForage = not model:GetAttribute("Resource")
	model:Destroy()
	if isLiveForage then
		activePickups -= 1
		task.delay(RESPAWN_TIME, spawnForagePickup, resourceName)
	end
	return true
end

--[[
    @summary  Spawn the initial population of Berries and Mushrooms
              once tree pivots are known.
]]
local function spawnInitialForage()
	if #treePivots == 0 then
		task.delay(2, spawnInitialForage)
		return
	end

	for _ = 1, BERRY_TARGET_COUNT do
		spawnForagePickup("Berries")
	end
	for _ = 1, MUSHROOM_TARGET_COUNT do
		spawnForagePickup("Mushrooms")
	end

end

-- // CLIENT REMOTES // --

--[[
    @summary  Client-to-server remote for eating a carried food resource.
    @desc     Consumes 1 unit of the resource and restores Hunger by a
              fixed amount per resource type.
    @param    player        Player  -- injected by Knit
    @param    resourceName  string  -- one of EAT_HUNGER_RESTORE's keys
    @returns  boolean               -- true if eaten successfully
]]
function ForageService.Client:RequestPickup(player: Player, model: Model): boolean
	if not model or not model:IsA("Model") or not model.Parent then
		return false
	end
	local resourceName = model:GetAttribute("ForageResource")
	if not resourceName or typeof(resourceName) ~= "string" then
		return false
	end
	if not worldService or not inventoryService then
		return false
	end
	local baseMap = worldService:GetBaseMap()
	if not baseMap or not model:IsDescendantOf(baseMap) then
		return false
	end
	return tryForagePickup(model, player)
end

--[[
    @summary  Client-to-server remote for eating a carried food resource.
    @desc     Consumes 1 unit of the resource and restores Hunger by a
              fixed amount per resource type.
    @param    player        Player  -- injected by Knit
    @param    resourceName  string  -- one of EAT_HUNGER_RESTORE's keys
    @returns  boolean               -- true if eaten successfully
]]
function ForageService.Client:RequestEat(player: Player, resourceName: string): boolean
	local restoreAmount = EAT_HUNGER_RESTORE[resourceName]
	if not restoreAmount then
		return false
	end

	if not inventoryService then
		return false
	end
	local consumed = inventoryService:ConsumeResource(player, resourceName, 1)
	if not consumed then
		return false
	end

	if hungerService then
		hungerService:RestoreHunger(player, restoreAmount)
	end
	return true
end

-- // INITIALIZATION // --

function ForageService:KnitStart()
	worldService = Knit.GetService("WorldService")
	inventoryService = Knit.GetService("InventoryService")
	hungerService = Knit.GetService("HungerService")

	collectTreePivots()
	task.delay(1, spawnInitialForage)

end

return ForageService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="92">
          <Properties>
            <string name="Name">HarvestService</string>
            <string name="Source"><![CDATA[--[[
    @file    HarvestService.luau
    @author  manik
    @date    2025

    @summary
    Server-authoritative tree chopping, felling, and wood pickup.

    @description
    Scans the cloned base-map for pre-placed Tree/bigtree models and
    wires a ProximityPrompt onto each.  Validates chop requests against
    range, cooldown, and an equipped Axe tool before decrementing a
    per-tree health counter.  A depleted tree tweens over mathematically
    (no physics), drops Log pickups, and respawns after a delay.  Also
    issues every player an Axe tool built from the ServerStorage mesh
    asset, since the source asset has no Handle/Tool wrapper.

    @exports
    - Knit Signal: TreeChopped(position: Vector3)  (server -> client, VFX hook)
    - Knit Remote: RequestChop(player)              (client -> server, click-to-chop)
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local Constants = require(ReplicatedStorage.Shared.Constants)

-- | Objects | --
local HarvestService = Knit.CreateService({
	Name = "HarvestService",
	Client = {
		TreeChopped = Knit.CreateSignal(),
	},
})

-- | Configuration | --
local TREE_HEALTH = 6
local CHOP_COOLDOWN = 0.5
local CHOP_RANGE = 12
local FELL_TWEEN_DURATION = 1.2
local FELL_LIE_DURATION = 3
local FELL_FADE_DURATION = 2
local TREE_RESPAWN_TIME = 45
local WOOD_SCATTER_RADIUS = 4
local SMALL_WOOD_DROP_MIN = 3
local SMALL_WOOD_DROP_MAX = 5
local BIG_WOOD_DROP_MIN = 5
local BIG_WOOD_DROP_MAX = 8
local PICKUP_RANGE = 12
local LOG_LIFETIME = 300
local ITEMS_PATH = ServerStorage.Assets[Constants.ITEMS_PATH]
local TREE_MODEL_NAMES = { "Tree", "bigtree" }
local AXE_TOOL_NAME = "Axe"

-- | State Management | --
local worldService: any = nil
local inventoryService: any = nil
local spawnService: any = nil
local axeTemplate: Tool? = nil
local treeRegistry: { [Model]: { health: number, part: { Position: Vector3 }, pivot: CFrame, felled: boolean } } = {}
local chopCooldowns: { [Player]: number } = {}

-- // FUNCTIONS // --

--[[
    @summary  Build a wearable Axe Tool by cloning the pre-configured
              axe MeshPart from the R6 Axe Animations asset.
    @desc     The source MeshPart already has the correct MeshId,
              TextureID, Size, and Material.  We clone it as the
              Tool's Handle and set the grip so the hand holds the
              lower portion of the shaft.
    @returns  Tool?
]]
local function buildAxeTool(): Tool?
	local animModel = ITEMS_PATH:FindFirstChild("AxeAnimations")
	if not animModel then
		warn("[HarvestService] AxeAnimations model not found in Assets Items")
		return nil
	end

	local r6Folder = animModel:FindFirstChild("R6 Axe Animations")
	if not r6Folder then
		warn("[HarvestService] R6 Axe Animations folder not found")
		return nil
	end

	local sourceAxe = r6Folder:FindFirstChild("Axe")
	if not sourceAxe or not sourceAxe:IsA("MeshPart") then
		warn("[HarvestService] Axe MeshPart not found in R6 Axe Animations")
		return nil
	end

	local tool = Instance.new("Tool")
	tool.Name = AXE_TOOL_NAME
	tool.RequiresHandle = true

	-- The axe mesh has a built-in rotation of ~91° on Z and ~25° on Y,
	-- which means the mesh's long axis (Y, 4 studs) is actually pointing
	-- along the world X axis after the part's rotation is applied.
	-- For a natural R15 grip, we need the hand to hold the bottom of the
	-- shaft with the blade pointing up and slightly forward.
	-- GripPos: hand sits 1.5 studs along the mesh's local Y (shaft bottom)
	-- GripUp: mesh local Y maps to tool Up (blade points up)
	-- GripForward: mesh local -Z maps to tool Forward (blade faces forward)
	-- GripRight: mesh local X maps to tool Right
	tool.GripPos = Vector3.new(0, -1.5, 0)
	tool.GripUp = Vector3.new(0, 1, 0)
	tool.GripForward = Vector3.new(1, 0, 0)
	tool.GripRight = Vector3.new(0, 0, 1)

	local handle = sourceAxe:Clone()
	handle.Name = "Handle"
	handle.CanCollide = false
	handle.Anchored = false
	handle.Transparency = 0
	-- Remove any children from the source (Animation instances, Motor6Ds)
	for _, child in ipairs(handle:GetChildren()) do
		child:Destroy()
	end
	handle.Parent = tool

	return tool
end

--[[
    @summary  Grant the Axe tool to a player's Backpack and StarterGear
              so it persists across respawns.
    @param    player  Player  -- the Roblox player
]]
local function giveAxe(player: Player)
	if not axeTemplate then
		return
	end
	if spawnService and not spawnService:IsPlayerSpawned(player) then
		return
	end

	local backpack = player:WaitForChild("Backpack")
	if not backpack:FindFirstChild(AXE_TOOL_NAME) then
		local clone = axeTemplate:Clone()
		clone.Parent = backpack
	end

	local starterGear = player:WaitForChild("StarterGear")
	if not starterGear:FindFirstChild(AXE_TOOL_NAME) then
		local clone = axeTemplate:Clone()
		clone.Parent = starterGear
	end
end

--[[
    @summary  Spawn a short-lived wood-chip particle burst at a position.
    @param    position  Vector3  -- world position of the chop impact
]]
local function spawnChopVFX(position: Vector3)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.Position = position
	anchor.Parent = workspace

	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
	emitter.Color = ColorSequence.new(Color3.fromRGB(120, 80, 45))
	emitter.Lifetime = NumberRange.new(0.4, 0.8)
	emitter.Speed = NumberRange.new(6, 12)
	emitter.SpreadAngle = Vector2.new(45, 45)
	emitter.Size = NumberSequence.new(0.3, 0.05)
	emitter.Rate = 0
	emitter.Parent = anchor

	emitter:Emit(14)
	Debris:AddItem(anchor, 2)
end

--[[
    @summary  Scatter Log pickups around a felled tree's base and wire
              a pickup ProximityPrompt on each.
    @param    position    Vector3  -- ground position of the felled tree
    @param    baseMap     Model    -- the cloned base-map to parent logs into
    @param    isBigTree   boolean  -- true for bigtree models
]]
local function spawnWoodDrops(position: Vector3, baseMap: Model, isBigTree: boolean)
	local source = ITEMS_PATH:FindFirstChild("Log")
	if not source then
		warn("[HarvestService] Log model not found in Assets Items")
		return
	end

	local dropMin = if isBigTree then BIG_WOOD_DROP_MIN else SMALL_WOOD_DROP_MIN
	local dropMax = if isBigTree then BIG_WOOD_DROP_MAX else SMALL_WOOD_DROP_MAX
	local count = math.random(dropMin, dropMax)
	for _ = 1, count do
		local log = source:Clone()
		local angle = math.random() * math.pi * 2
		local radius = math.random() * WOOD_SCATTER_RADIUS
		local offset = Vector3.new(math.cos(angle) * radius, 2, math.sin(angle) * radius)
		log:PivotTo(CFrame.new(position + offset) * CFrame.Angles(0, math.random() * math.pi * 2, 0))

		for _, descendant in ipairs(log:GetDescendants()) do
			if descendant:IsA("BasePart") then
				descendant.Anchored = false
				descendant.CanCollide = true
			end
		end

		-- Apply a random impulse so logs scatter naturally
		if log.PrimaryPart then
			local impulseDir = Vector3.new(math.random() - 0.5, 0.3, math.random() - 0.5).Unit
			log.PrimaryPart:ApplyImpulse(impulseDir * log.PrimaryPart.AssemblyMass * 8)
		end

		log:SetAttribute("PickupResource", "Wood")

		log.Parent = baseMap
		Debris:AddItem(log, LOG_LIFETIME)
	end
end

--[[
    @summary  Tween a felled tree over mathematically, then drop wood
              and schedule its respawn.
    @param    treeModel  Model   -- the tree to fell
    @param    baseMap    Model   -- the cloned base-map, for wood drops
]]
local function fellTree(treeModel: Model, baseMap: Model)
	local registry = treeRegistry[treeModel]
	if not registry or registry.felled then
		return
	end
	registry.felled = true

	local startPivot = registry.pivot

	-- Find the lowest point of the tree so we can rotate around its base,
	-- not its geometric center (which causes floating).
	local lowestY = math.huge
	for _, desc in ipairs(treeModel:GetDescendants()) do
		if desc:IsA("BasePart") then
			local partBottom = desc.Position.Y - desc.Size.Y / 2
			if partBottom < lowestY then
				lowestY = partBottom
			end
		end
	end
	if lowestY == math.huge then
		lowestY = startPivot.Position.Y
	end

	-- Base rotation point at ground level directly below the tree pivot
	local basePos = Vector3.new(startPivot.Position.X, lowestY, startPivot.Position.Z)
	local baseCFrame = CFrame.new(basePos)

	local yaw = math.random() * math.pi * 2
	local fallAngle = Instance.new("NumberValue")
	fallAngle.Value = 0

	local function applyFall(degrees: number)
		local rad = math.rad(degrees)
		local rotation = CFrame.Angles(0, yaw, 0) * CFrame.Angles(rad, 0, 0) * CFrame.Angles(0, -yaw, 0)
		-- Rotate the tree's original pivot around the base point:
		-- translate to base, apply rotation, translate back
		treeModel:PivotTo(baseCFrame * rotation * baseCFrame:Inverse() * startPivot)
	end

	fallAngle:GetPropertyChangedSignal("Value"):Connect(function()
		applyFall(fallAngle.Value)
	end)

	local tween = TweenService:Create(
		fallAngle,
		TweenInfo.new(FELL_TWEEN_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ Value = 88 }
	)

	tween.Completed:Connect(function()
		fallAngle:Destroy()
		spawnWoodDrops(startPivot.Position, baseMap, treeModel.Name == "bigtree")

		-- Lie on the ground for a moment, then fade out smoothly
		task.delay(FELL_LIE_DURATION, function()
			-- Collect all parts and their original transparency for fade-out
			local parts = {}
			for _, desc in ipairs(treeModel:GetDescendants()) do
				if desc:IsA("BasePart") then
					table.insert(parts, { part = desc, originalTransparency = desc.Transparency })
				end
			end

			local fadeValue = Instance.new("NumberValue")
			fadeValue.Value = 0
			fadeValue:GetPropertyChangedSignal("Value"):Connect(function()
				for _, entry in ipairs(parts) do
					entry.part.Transparency = entry.originalTransparency + fadeValue.Value * (1 - entry.originalTransparency)
				end
			end)

			local actualFadeTween = TweenService:Create(
				fadeValue,
				TweenInfo.new(FELL_FADE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ Value = 1 }
			)

			actualFadeTween.Completed:Connect(function()
				fadeValue:Destroy()
				-- Unparent the tree to hide it during respawn timer
				treeModel.Parent = nil
				-- Restore transparency so the tree is visible when respawned
				for _, entry in ipairs(parts) do
					if entry.part then
						entry.part.Transparency = entry.originalTransparency
					end
				end
				task.delay(TREE_RESPAWN_TIME, function()
					if not treeModel or not treeModel:GetChildren()[1] then return end
					if not baseMap or not baseMap.Parent then return end
					treeModel:PivotTo(startPivot)
					treeModel.Parent = baseMap
					registry.felled = false
					registry.health = TREE_HEALTH
				end)
			end)

			actualFadeTween:Play()
		end)
	end)

	tween:Play()
end

--[[
    @summary  Wire a ProximityPrompt onto a single tree model and
              register it for chop tracking.
    @param    treeModel  Model  -- a Tree/bigtree descendant of base-map
]]
local function registerTree(treeModel: Model)
	if treeRegistry[treeModel] then
		return
	end

	-- Use the tree's pivot position (base of trunk at ground level)
	-- for range checks. This is more reliable than finding the lowest
	-- part, which can be a tiny root far from the trunk center.
	local pivot = treeModel:GetPivot()

	treeRegistry[treeModel] = {
		health = TREE_HEALTH,
		part = { Position = pivot.Position },
		pivot = pivot,
		felled = false,
	}
end

--[[
    @summary  Scan the base-map for Tree/bigtree descendants and
              register each one for chopping.  Retries until the
              base-map has finished loading.
]]
local function registerAllTrees()
	if not worldService then
		task.defer(registerAllTrees)
		return
	end
	local baseMap = worldService:GetBaseMap()
	if not baseMap then
		task.defer(registerAllTrees)
		return
	end
	if not worldService:IsForestReady() then
		task.defer(registerAllTrees)
		return
	end

	local registeredCount = 0
	for _, descendant in ipairs(baseMap:GetDescendants()) do
		if descendant:IsA("Model") and table.find(TREE_MODEL_NAMES, descendant.Name) then
			registerTree(descendant)
			registeredCount += 1
		end
	end

end

--[[
    @summary  Validate and process a chop attempt against one tree.
    @param    treeModel  Model   -- the tree being chopped
    @param    registry   table   -- the tree's tracked state
    @param    player     Player  -- the chopping player
]]
local function tryChop(treeModel: Model, registry, player: Player)
	if registry.felled then
		return
	end

	local character = player.Character
	if not character then
		return
	end

	local axe = character:FindFirstChild(AXE_TOOL_NAME)
	if not axe or not axe:IsA("Tool") then
		return
	end

	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart or not rootPart:IsA("BasePart") then
		return
	end

	local dist = (rootPart.Position - registry.part.Position).Magnitude
	if dist > CHOP_RANGE then
		return
	end

	local now = os.clock()
	if chopCooldowns[player] and (now - chopCooldowns[player]) < CHOP_COOLDOWN then
		return
	end
	chopCooldowns[player] = now

	registry.health -= 1
	spawnChopVFX(registry.part.Position)
	HarvestService.Client.TreeChopped:Fire(player, registry.part.Position)

	if registry.health <= 0 then
		if not worldService then
			return
		end
		local baseMap = worldService:GetBaseMap()
		if baseMap then
			fellTree(treeModel, baseMap)
		end
	end
end

--[[
    @summary  Validate and process a wood pickup attempt.
    @param    logModel  Model   -- the dropped Log instance
    @param    player    Player  -- the picking player
]]
local function tryPickup(logModel: Model, player: Player): boolean
	if not logModel.Parent then
		return false
	end
	if inventoryService and inventoryService:IsModelDragged(logModel) then
		return false
	end

	local character = player.Character
	if not character then
		return false
	end

	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart or not rootPart:IsA("BasePart") then
		return false
	end

	if (rootPart.Position - logModel:GetPivot().Position).Magnitude > PICKUP_RANGE then
		return false
	end

	if not inventoryService then
		return false
	end
	local added = inventoryService:AddResource(player, "Wood", 1)
	if added <= 0 then
		return false
	end
	logModel:Destroy()
	return true
end

--[[
    @summary  Route a global ProximityPrompt trigger to the matching
              chop or pickup handler.
    @param    prompt  ProximityPrompt  -- the triggered prompt
    @param    player  Player           -- the triggering player
]]
local function onPromptTriggered(prompt: ProximityPrompt, player: Player)
	if prompt.Name == "PickupPrompt" then
		local logModel = prompt.Parent and prompt.Parent.Parent
		if logModel and logModel:IsA("Model") then
			tryPickup(logModel, player)
		end
	end
end

--[[
    @summary  Find the nearest registered tree within CHOP_RANGE of
              the player's character root part.
    @param    player  Player  -- the chopping player
    @returns  Model, table  -- the tree model and its registry entry, or nil
]]
local function findNearestTree(player: Player)
	local character = player.Character
	if not character then
		return nil, nil
	end

	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart or not rootPart:IsA("BasePart") then
		return nil, nil
	end

	local nearestModel: Model? = nil
	local nearestRegistry = nil
	local nearestDist = math.huge

	for treeModel, registry in pairs(treeRegistry) do
		if not registry.felled then
			local dist = (rootPart.Position - registry.part.Position).Magnitude
			if dist < nearestDist and dist <= CHOP_RANGE then
				nearestDist = dist
				nearestModel = treeModel
				nearestRegistry = registry
			end
		end
	end

	return nearestModel, nearestRegistry
end

--[[
    @summary  Publish a short, simple R15 tool-slash Animation to
              ReplicatedStorage so the client can play the axe swing.
    @desc     The default R15 tool-slash (asset 522635514) is a quick,
              minimal overhead strike that works for an axe/pickaxe
              without the exaggerated motion of a sword combo.
]]
local function publishAxeAnimation()
	local old = ReplicatedStorage:FindFirstChild("AxeStrikeKeyframeSequence")
	if old then
		old:Destroy()
	end

	local anim = Instance.new("Animation")
	anim.Name = "AxeStrikeAnimation"
	anim.AnimationId = "rbxassetid://522635514"
	anim.Parent = ReplicatedStorage

end

-- // INITIALIZATION // --

function HarvestService:KnitStart()
	worldService = Knit.GetService("WorldService")
	inventoryService = Knit.GetService("InventoryService")
	spawnService = Knit.GetService("SpawnService")

	axeTemplate = buildAxeTool()
	publishAxeAnimation()
	registerAllTrees()

	ProximityPromptService.PromptTriggered:Connect(onPromptTriggered)

	local spawnServicePublic = spawnService
	local function tryGiveAxe(player: Player)
		if spawnServicePublic and spawnServicePublic:IsPlayerSpawned(player) then
			giveAxe(player)
		end
	end

	Players.PlayerAdded:Connect(tryGiveAxe)
	for _, player in ipairs(Players:GetPlayers()) do
		tryGiveAxe(player)
	end

	-- Give the axe immediately when a player teleports to the game map.
	if spawnService then
		spawnService.PlayerSpawned:Connect(function(player: Player)
			giveAxe(player)
		end)
	end

end

Players.PlayerRemoving:Connect(function(player)
	chopCooldowns[player] = nil
end)

function HarvestService.Client:RequestPickup(player: Player, model: Model): boolean
	local resourceName = model and model:IsA("Model") and (model:GetAttribute("Resource") or model:GetAttribute("PickupResource") or model:GetAttribute("ForageResource"))
	if not model or not model:IsA("Model") or not model.Parent then
		return false
	end
	if resourceName ~= "Wood" then
		return false
	end
	if not worldService or not inventoryService then
		return false
	end
	local baseMap = worldService:GetBaseMap()
	if not baseMap or not model:IsDescendantOf(baseMap) then
		return false
	end
	local ok = tryPickup(model, player)
	return ok
end

--[[
    @summary  Find and chop the nearest tree in range for a player.
    @desc     Shared by the click-to-chop remote and CombatService's
              Axe fallback when no live NPC is in range.
    @param    player  Player
]]
function HarvestService:TryChopNearest(player: Player)
	local treeModel, registry = findNearestTree(player)
	if treeModel and registry then
		tryChop(treeModel, registry, player)
	end
end

-- // CLIENT REMOTES // --

--[[
    @summary  Client-to-server remote for click-to-chop.
    @desc     Finds the nearest tree within range and processes the chop.
    @param    player  Player  -- the requesting player (injected by Knit)
]]
function HarvestService.Client:RequestChop(player: Player)
	self.Server:TryChopNearest(player)
end

return HarvestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="93">
          <Properties>
            <string name="Name">HungerService</string>
            <string name="Source"><![CDATA[--[[
    @file    HungerService.luau
    @author  manik
    @date    2025

    @summary
    Server-authoritative hunger decay and starvation damage.

    @description
    Drains each active player's Hunger stat over time, applying an
    accelerated drain while the player is moving faster than the
    sprint threshold.  When Hunger reaches zero, the player's Humanoid
    takes continuous starvation damage until they die or eat.
    Broadcasts throttled hunger updates to the owning client so the
    HUD can stay in sync.

    @exports
    - Knit Signal: HungerChanged(hunger: number, maxHunger: number)  (server -> client)
    - HungerService:RestoreHunger(player, amount)  -> void  (server only)
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)

-- | Objects | --
local HungerService = Knit.CreateService({
	Name = "HungerService",
	Client = {
		HungerChanged = Knit.CreateSignal(),
	},
})

-- | Configuration | --
local HUNGER_DRAIN_PER_SEC = 100 / 600
local SPRINT_DRAIN_MULTIPLIER = 2
local SPRINT_SPEED_THRESHOLD = 20
local STARVE_DAMAGE_PER_SEC = 2
local BROADCAST_INTERVAL = 1

-- | State Management | --
local playerDataService: any = nil
local spawnService: any = nil
local playerLifeService: any = nil
local broadcastTimer = 0

-- // FUNCTIONS // --

--[[
    @summary  Return true if the player's character is moving faster
              than the sprint threshold.
    @param    player  Player  -- the Roblox player
    @returns  boolean
]]
local function isSprinting(player: Player): boolean
	local character = player.Character
	if not character then
		return false
	end
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart or not rootPart:IsA("BasePart") then
		return false
	end
	return rootPart.AssemblyLinearVelocity.Magnitude > SPRINT_SPEED_THRESHOLD
end

--[[
    @summary  Drain one player's Hunger and apply starvation damage.
    @param    player  Player  -- the Roblox player
    @param    dt      number  -- delta time in seconds
]]
local function tickPlayer(player: Player, dt: number)
	if not playerDataService then
		return
	end
	if spawnService and not spawnService:IsPlayerSpawned(player) then
		return
	end
	local data = playerDataService:GetData(player)
	if not data then
		return
	end

	local drain = HUNGER_DRAIN_PER_SEC * dt
	if isSprinting(player) then
		drain *= SPRINT_DRAIN_MULTIPLIER
	end

	local newHunger = math.clamp(data.Survival.Hunger - drain, 0, data.Survival.MaxHunger)
	playerDataService:UpdateData(player, function(playerData)
		playerData.Survival.Hunger = newHunger
	end)

	if newHunger <= 0 and playerLifeService then
		playerLifeService:ApplyDamage(player, STARVE_DAMAGE_PER_SEC * dt, "Starvation")
	end
end

--[[
    @summary  Restore hunger for a player (e.g. after eating) and push
              an immediate update to their client.
    @param    player  Player  -- the Roblox player
    @param    amount  number  -- hunger units to restore (positive)
]]
function HungerService:RestoreHunger(player: Player, amount: number)
	if amount <= 0 then
		return
	end

	if not playerDataService then
		return
	end
	local data = playerDataService:GetData(player)
	if not data then
		return
	end

	local newHunger = math.clamp(data.Survival.Hunger + amount, 0, data.Survival.MaxHunger)
	playerDataService:UpdateData(player, function(playerData)
		playerData.Survival.Hunger = newHunger
	end)

	HungerService.Client.HungerChanged:Fire(player, newHunger, data.Survival.MaxHunger)
end

--[[
    @summary  Heartbeat-driven tick and throttled broadcast for all
              active players.
    @param    dt  number  -- delta time in seconds
]]
local function onHeartbeat(dt: number)
	for _, player in ipairs(Players:GetPlayers()) do
		tickPlayer(player, dt)
	end

	broadcastTimer += dt
	if broadcastTimer < BROADCAST_INTERVAL then
		return
	end
	broadcastTimer = 0

	if not playerDataService then
		return
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if spawnService and not spawnService:IsPlayerSpawned(player) then
			continue
		end
		local data = playerDataService:GetData(player)
		if data then
			HungerService.Client.HungerChanged:Fire(player, data.Survival.Hunger, data.Survival.MaxHunger)
		end
	end
end

-- // INITIALIZATION // --

function HungerService:KnitStart()
	playerDataService = Knit.GetService("PlayerDataService")
	spawnService = Knit.GetService("SpawnService")
	playerLifeService = Knit.GetService("PlayerLifeService")
	RunService.Heartbeat:Connect(onHeartbeat)

	local function fireInitialHunger(player: Player)
		if not player.Parent then return end
		if not playerDataService then return end
		local data = playerDataService:GetData(player)
		if data then
			HungerService.Client.HungerChanged:Fire(player, data.Survival.Hunger, data.Survival.MaxHunger)
		end
	end

	playerDataService.ProfileLoaded:Connect(fireInitialHunger)

	for _, player in ipairs(Players:GetPlayers()) do
		fireInitialHunger(player)
	end

end

return HungerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="94">
          <Properties>
            <string name="Name">InventoryService</string>
            <string name="Source"><![CDATA[--[[
    @file    InventoryService.luau
    @author  manik
    @date    2025

    @summary
    Server-authoritative resource capacity, and the wearable carry-bag.

    @description
    Centralises every write to a player's `Resources` table so a single
    carry-capacity rule applies everywhere (chopping, foraging, cooking).
    Also equips the pre-placed `carry-bag` mesh as a welded backpack on
    every player's back, and grants it a larger capacity than going
    bag-less would allow — mirroring the reference game's "sack space"
    perk while staying a base-kit item rather than a paid upgrade.

    @exports
    - InventoryService:GetCapacity(player)               -> number
    - InventoryService:GetTotalCarried(player)            -> number
    - InventoryService:AddResource(player, name, amount)  -> number (actually added)
    - InventoryService:ConsumeResource(player, name, amount) -> boolean (success)
    - Knit Signal: ResourcesChanged(resources, capacity)  (server -> client)
    - Knit Remote: GetSnapshot -> { resources, capacity }
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local Constants = require(ReplicatedStorage.Shared.Constants)
local RunConfig = require(ReplicatedStorage.Shared.RunConfig)

-- | Objects | --
local InventoryService = Knit.CreateService({
	Name = "InventoryService",
	Client = {
		ResourcesChanged = Knit.CreateSignal(),
		DragTargetMoved = Knit.CreateSignal(),
	},
})

-- | Configuration | --
local BASE_CAPACITY = 40
local BAG_CAPACITY_BONUS = 40
local ITEMS_PATH = ServerStorage.Assets[Constants.ITEMS_PATH]
local CARRY_BAG_NAME = "carry-bag"
local CARRY_BAG_TOOL_NAME = "Carry Bag"
local FLASHLIGHT_TOOL_NAME = "Flashlight"
local RESOURCE_NAMES = {
	"Wood",
	"Scrap",
	"Coal",
	"Berries",
	"Mushrooms",
	"RawMeat",
	"CookedMeat",
	"RabbitMeat",
	"OwlFeather",
	"CultistGem",
	"Bandage",
}

local PICKUP_RANGE = 12
local DROP_SPACING = 2.2
local DROP_LIFETIME = 300

local DRAG_MAX_DISTANCE = 50

-- Map resources to the asset name in ITEMS_PATH.  Mushrooms use their own asset builder.
local DROP_ASSETS: { [string]: string? } = {
	Wood = "Log",
	Coal = "Coal",
	Scrap = "Coal",
	Berries = "Carrot",
	RawMeat = "rabbit-meat",
	CookedMeat = "wolf-meat",
	RabbitMeat = "rabbit-meat",
	OwlFeather = nil :: string?,
	CultistGem = nil :: string?,
	Bandage = nil :: string?,
}
local MUSHROOM_ASSET_NAME = "Mushroom"

-- | State Management | --
local playerDataService: any = nil
local worldService: any = nil
local spawnService: any = nil
local bagTemplate: Tool? = nil
local flashlightTemplate: Tool? = nil
local mushroomSource: Model? = nil
local mushroomBaseOffset: number? = nil

local dragging: { [Player]: { model: Model, alignPos: AlignPosition, alignOri: AlignOrientation?, dragTarget: BasePart, dragTargetAttach: Attachment, itemAttach: Attachment, originalCanCollide: { [BasePart]: boolean }, originalAnchored: { [BasePart]: boolean } } } = {}
local draggedBy: { [Model]: Player } = {}

-- // FUNCTIONS // --

local function getPlayerData(player: Player): any
	if not playerDataService then
		return nil
	end
	return playerDataService:GetData(player)
end

--[[
    @summary  Returns true if the given model is already being dragged.
]]
local function isModelDragged(model: Model): boolean
	return draggedBy[model] ~= nil
end

local function updatePlayerData(player: Player, fn: (data: any) -> ())
	if not playerDataService then
		return
	end
	playerDataService:UpdateData(player, fn)
end

--[[
    @summary  Return the maximum total resource units a player can carry.
    @param    player  Player  -- the Roblox player
    @returns  number
]]
function InventoryService:GetCapacity(player: Player): number
	local data = getPlayerData(player)
	if not data then
		return BASE_CAPACITY
	end
	local capacity = BASE_CAPACITY
	if not data.Inventory or data.Inventory.HasBag ~= false then
		capacity += BAG_CAPACITY_BONUS
	end
	return capacity
end

--[[
    @summary  Sum every resource field into one carried total.
    @param    player  Player  -- the Roblox player
    @returns  number
]]
function InventoryService:IsModelDragged(model: Model): boolean
	return draggedBy[model] ~= nil
end

--[[
    @summary  Sum every resource field into one carried total.
    @param    player  Player  -- the Roblox player
    @returns  number
]]
function InventoryService:GetTotalCarried(player: Player): number
	local data = getPlayerData(player)
	if not data then
		return 0
	end
	local total = 0
	for _, name in ipairs(RESOURCE_NAMES) do
		total += data.Resources[name] or 0
	end
	return total
end

--[[
    @summary  Return whether a resource identifier is supported.
    @param    name  string
    @returns  boolean
]]
function InventoryService:IsResource(name: string): boolean
	return table.find(RESOURCE_NAMES, name) ~= nil
end

--[[
    @summary  Fire the client-facing resources snapshot for one player.
    @param    player  Player  -- the Roblox player
]]
local function broadcastSnapshot(player: Player)
	local data = getPlayerData(player)
	if not data then
		return
	end
	InventoryService.Client.ResourcesChanged:Fire(player, table.clone(data.Resources), InventoryService:GetCapacity(player))
end

--[[
    @summary  Push the current resource state to one player.
    @param    player  Player
]]
function InventoryService:Refresh(player: Player)
	broadcastSnapshot(player)
end

--[[
    @summary  Add units of a resource, clamped by remaining capacity.
    @param    player  Player  -- the Roblox player
    @param    name    string  -- one of RESOURCE_NAMES
    @param    amount  number  -- units requested (must be positive)
    @returns  number          -- units actually added (may be less than amount)
]]
function InventoryService:AddResource(player: Player, name: string, amount: number): number
	if amount <= 0 or not table.find(RESOURCE_NAMES, name) then
		return 0
	end

	local data = getPlayerData(player)
	if not data then
		return 0
	end

	local capacity = self:GetCapacity(player)
	local carried = self:GetTotalCarried(player)
	local room = math.max(0, capacity - carried)
	local actualAmount = math.min(amount, room)
	if actualAmount <= 0 then
		return 0
	end

	updatePlayerData(player, function(playerData)
		playerData.Resources[name] = (playerData.Resources[name] or 0) + actualAmount

		if typeof(playerData.Inventory) ~= "table" then
			playerData.Inventory = {}
		end
		if typeof(playerData.Inventory.PickupOrder) ~= "table" then
			playerData.Inventory.PickupOrder = {}
		end
		local order = playerData.Inventory.PickupOrder
		for _ = 1, actualAmount do
			table.insert(order, name)
		end
	end)

	broadcastSnapshot(player)
	return actualAmount
end

--[[
    @summary  Consume units of a resource if the player has enough.
    @param    player  Player  -- the Roblox player
    @param    name    string  -- one of RESOURCE_NAMES
    @param    amount  number  -- units to consume
    @returns  boolean         -- true if the full amount was consumed
]]
function InventoryService:ConsumeResource(player: Player, name: string, amount: number): boolean
	if amount <= 0 or not table.find(RESOURCE_NAMES, name) then
		return false
	end

	local data = getPlayerData(player)
	if not data or (data.Resources[name] or 0) < amount then
		return false
	end

	updatePlayerData(player, function(playerData)
		playerData.Resources[name] = (playerData.Resources[name] or 0) - amount

		if typeof(playerData.Inventory) == "table" and typeof(playerData.Inventory.PickupOrder) == "table" then
			local order = playerData.Inventory.PickupOrder
			for _ = 1, amount do
				for i = #order, 1, -1 do
					if order[i] == name then
						table.remove(order, i)
						break
					end
				end
			end
		end
	end)

	broadcastSnapshot(player)
	return true
end

-- // PICKUP / DROP // --

--[[
    @summary  Compute how far the Mushroom asset's stem is above its base.
    @param    source  Model  -- the Mushroom template in Assets Items
    @returns  number
]]
local function computeMushroomBaseOffset(source: Model): number
	local pivot = source:GetPivot()
	local cf, size = source:GetBoundingBox()
	local up = pivot.UpVector
	local base = cf.Position - cf.UpVector * (size.Y / 2)

	-- BuildMushroomModel sets the stem as the model's PrimaryPart, so PivotTo
	-- will place the stem at the returned CFrame. Find the stem (tallest thin
	-- part) and measure from it to the base so spawned mushrooms rest on the
	-- ground instead of floating above it.
	local bestStem: BasePart? = nil
	local bestScore = 0
	for _, desc in ipairs(source:GetDescendants()) do
		if desc:IsA("BasePart") then
			local score = desc.Size.Y * (1 / (desc.Size.X * desc.Size.Z + 0.001))
			if score > bestScore then
				bestScore = score
				bestStem = desc
			end
		end
	end
	if bestStem then
		return (bestStem.Position - base):Dot(up)
	end

	return (pivot.Position - base):Dot(up)
end

--[[
    @summary  Load and cache the Mushroom asset from Assets Items.
    @returns  Model
]]
local function getMushroomSource(): Model?
	if not mushroomSource then
		mushroomSource = ITEMS_PATH:FindFirstChild(MUSHROOM_ASSET_NAME)
		if mushroomSource then
			mushroomBaseOffset = computeMushroomBaseOffset(mushroomSource)
		end
	end
	return mushroomSource
end

--[[
    @summary  Find the stem-like part in the mushroom model (tallest part with
              a small cross-section) so it can be used as the PrimaryPart.
    @param    model  Model
    @returns  BasePart?
]]
local function findMushroomStem(model: Model): BasePart?
	local best: BasePart? = nil
	local bestScore: number = 0
	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsA("BasePart") then
			local score = desc.Size.Y * (1 / (desc.Size.X * desc.Size.Z + 0.001))
			if score > bestScore then
				bestScore = score
				best = desc
			end
		end
	end
	return best
end

--[[
    @summary  Build a fresh Mushroom pickup from the stored asset.
    @returns  Model
]]
local function buildMushroomProp(): Model
	local source = getMushroomSource()
	if not source then
		warn("[InventoryService] Mushroom asset not found in Assets Items")
		local fallback = Instance.new("Model")
		fallback.Name = "MushroomPickup"
		local p = Instance.new("Part")
		p.Name = "Main"
		p.Size = Vector3.new(1, 1, 1)
		p.Color = Color3.fromRGB(180, 180, 180)
		p.Material = Enum.Material.SmoothPlastic
		p.Parent = fallback
		fallback.PrimaryPart = p
		return fallback
	end

	local model = source:Clone()
	model.Name = "MushroomPickup"

	local stem = findMushroomStem(model)
	if stem then
		model.PrimaryPart = stem
		for _, desc in ipairs(model:GetDescendants()) do
			if desc:IsA("BasePart") and desc ~= stem then
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = stem
				weld.Part1 = desc
				weld.Parent = stem
			end
		end
	end

	return model
end

--[[
    @summary  Return the base offset of the Mushroom asset, measured from the
              bottom of its bounding box to its stem along the up axis.
    @returns  number
]]
function InventoryService:GetMushroomBaseOffset(): number
	getMushroomSource()
	return mushroomBaseOffset or 1.93
end

--[[
    @summary  Public wrapper to build a Mushroom pickup from the asset.
    @returns  Model
]]
function InventoryService:BuildMushroomModel(): Model
	return buildMushroomProp()
end

--[[
    @summary  Make a fresh clone of a resource asset (or build one) and tag
              it with the attributes CarryController/HarvestService/ForageService
              will look for.
    @param    resourceName  string  -- one of RESOURCE_NAMES
    @returns  Model
]]
local function buildDropModel(resourceName: string): Model
	local model: Model

	if resourceName == "Mushrooms" then
		model = buildMushroomProp()
	else
		local assetName = DROP_ASSETS[resourceName]
		local source = assetName and ITEMS_PATH:FindFirstChild(assetName)
		if source and source:IsA("Model") then
			model = source:Clone()
			if not model.PrimaryPart then
				local first = model:FindFirstChildWhichIsA("BasePart", true)
				if first then
					model.PrimaryPart = first
				end
			end
		elseif source and source:IsA("BasePart") then
			model = Instance.new("Model")
			model.Name = source.Name .. "Pickup"
			local clone = source:Clone()
			clone.Anchored = false
			clone.CanCollide = true
			clone.Parent = model
			model.PrimaryPart = clone
		else
			model = Instance.new("Model")
			model.Name = resourceName .. "Pickup"
			local fallback = Instance.new("Part")
			fallback.Name = "Main"
			if resourceName == "OwlFeather" then
				fallback.Size = Vector3.new(0.5, 0.3, 2)
				fallback.Color = Color3.fromRGB(230, 220, 200)
				fallback.Material = Enum.Material.Neon
			else
				fallback.Size = Vector3.new(1, 1, 1)
				fallback.Color = Color3.fromRGB(180, 180, 180)
				fallback.Material = Enum.Material.SmoothPlastic
			end
			fallback.Parent = model
			model.PrimaryPart = fallback
		end
	end

	-- Prepare physics: let them fall and rest on the ground, and make sure
	-- every part is interactive for mouse raycasts and touch.
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Anchored = false
			descendant.CanCollide = true
			descendant.CanQuery = true
			descendant.CanTouch = true
		end
	end

	-- Generic identifier used by CarryController.
	model:SetAttribute("Resource", resourceName)

	-- Legacy identifiers so existing services can still handle their own items.
	if resourceName == "Wood" then
		model:SetAttribute("PickupResource", "Wood")
	elseif resourceName == "Berries" or resourceName == "Mushrooms" then
		model:SetAttribute("ForageResource", resourceName)
	end

	return model
end

--[[
    @summary  Public wrapper for buildDropModel so other services can spawn
              world items without duplicating drop logic.
    @param    resourceName  string
    @returns  Model
]]
function InventoryService:BuildDropModel(resourceName: string): Model
	return buildDropModel(resourceName)
end

--[[
    @summary  Build a drop CFrame for a resource, with mushrooms standing
              upright and everything else lying flat.
    @param    position      Vector3
    @param    resourceName  string
    @returns  CFrame
]]
local function buildDropCFrame(position: Vector3, resourceName: string): CFrame
	local yaw = math.random() * math.pi * 2
	if resourceName == "Mushrooms" then
		local offset = InventoryService:GetMushroomBaseOffset()
		return CFrame.new(position) * CFrame.Angles(0, yaw, 0) * CFrame.new(0, offset, 0)
	end
	return CFrame.new(position) * CFrame.Angles(0, yaw, 0)
end

--[[
    @summary  Validate and process a generic resource pickup.
    @param    model   Model   -- the world item to pick up
    @param    player  Player  -- the picking player
    @returns  boolean
]]
local function tryPickup(model: Model, player: Player): boolean
	if not model.Parent then
		return false
	end
	if isModelDragged(model) then
		return false
	end

	local resourceName = model:GetAttribute("Resource")
		or model:GetAttribute("PickupResource")
		or model:GetAttribute("ForageResource")
	if not resourceName or typeof(resourceName) ~= "string" then
		return false
	end
	if not table.find(RESOURCE_NAMES, resourceName) then
		return false
	end

	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart or not rootPart:IsA("BasePart") then
		return false
	end

	if (rootPart.Position - model:GetPivot().Position).Magnitude > PICKUP_RANGE then
		return false
	end

	if not worldService then
		return false
	end
	local baseMap = worldService:GetBaseMap()
	if not baseMap or not model:IsDescendantOf(baseMap) then
		return false
	end

	local added = InventoryService:AddResource(player, resourceName, 1)
	if added <= 0 then
		return false
	end

	model:Destroy()
	return true
end

--[[
    @summary  Drop every carried resource at the player's feet.
    @param    player  Player  -- the dropping player
    @returns  boolean
]]
local function tryDropAll(player: Player): boolean
	local data = getPlayerData(player)
	if not data then
		return false
	end

	if not worldService then
		return false
	end
	local baseMap = worldService:GetBaseMap()
	if not baseMap then
		return false
	end

	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart or not rootPart:IsA("BasePart") then
		return false
	end

	local origin = rootPart.Position
	local droppedAny = false

	for _, resourceName in ipairs(RESOURCE_NAMES) do
		local count = data.Resources[resourceName] or 0
		if count > 0 then
			droppedAny = true
			for i = 1, count do
				local golden = i * 2.3999632297
				local radius = math.sqrt(i) * DROP_SPACING
				local offset = Vector3.new(math.cos(golden) * radius, 0, math.sin(golden) * radius)
				local position = Vector3.new(origin.X + offset.X, origin.Y, origin.Z + offset.Z)

				local model = buildDropModel(resourceName); model:SetAttribute("DroppedBy", player.UserId)
				model:PivotTo(buildDropCFrame(position, resourceName))
				model.Parent = baseMap
				Debris:AddItem(model, DROP_LIFETIME)
			end

			updatePlayerData(player, function(playerData)
				playerData.Resources[resourceName] = 0
			end)
		end
	end

	if droppedAny then
		updatePlayerData(player, function(playerData)
			if typeof(playerData.Inventory) == "table" then
				playerData.Inventory.PickupOrder = {}
			end
		end)
		broadcastSnapshot(player)
	end
	return true
end

--[[
    @summary  Drop one item (the oldest from PickupOrder) at the player's feet.
    @param    player  Player  -- the dropping player
    @returns  boolean
]]
local function tryDropOne(player: Player): boolean
	local data = getPlayerData(player)
	if not data then
		return false
	end
	if not worldService then
		return false
	end
	local baseMap = worldService:GetBaseMap()
	if not baseMap then
		return false
	end

	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart or not rootPart:IsA("BasePart") then
		return false
	end

	local order = data.Inventory and data.Inventory.PickupOrder
	if not order then
		-- Backfill for profiles created before PickupOrder was added.
		order = {}
		for _, resourceName in ipairs(RESOURCE_NAMES) do
			for _ = 1, (data.Resources[resourceName] or 0) do
				table.insert(order, resourceName)
			end
		end
		updatePlayerData(player, function(playerData)
			if typeof(playerData.Inventory) ~= "table" then
				playerData.Inventory = {}
			end
			playerData.Inventory.PickupOrder = order
		end)
	end
	if #order == 0 then
		return false
	end

	local resourceName = order[1]
	local count = data.Resources[resourceName] or 0
	if count <= 0 then
		-- Stale entry; clean it up and try the next one.
		updatePlayerData(player, function(playerData)
			table.remove(playerData.Inventory.PickupOrder, 1)
		end)
		return tryDropOne(player)
	end

	local offset = rootPart.CFrame.LookVector * DROP_SPACING
	local position = Vector3.new(rootPart.Position.X + offset.X, rootPart.Position.Y, rootPart.Position.Z + offset.Z)

	local model = buildDropModel(resourceName); model:SetAttribute("DroppedBy", player.UserId)
	model:PivotTo(buildDropCFrame(position, resourceName))
	model.Parent = baseMap
	Debris:AddItem(model, DROP_LIFETIME)

	updatePlayerData(player, function(playerData)
		playerData.Resources[resourceName] -= 1
		table.remove(playerData.Inventory.PickupOrder, 1)
	end)

	broadcastSnapshot(player)
	return true
end

--[[
    @summary  Remove a player's drag constraints and restore the item.
    @param    player  Player
]]
local function stopDrag(player: Player)
	local entry = dragging[player]
	if not entry then
		return
	end

	if entry.alignPos then
		entry.alignPos:Destroy()
	end
	if entry.alignOri then
		entry.alignOri:Destroy()
	end
	if entry.dragTargetAttach then
		entry.dragTargetAttach:Destroy()
	end
	if entry.itemAttach then
		entry.itemAttach:Destroy()
	end
	if entry.dragTarget then
		entry.dragTarget:Destroy()
	end

	local model = entry.model
	if model and model.Parent then
		for _, desc in ipairs(model:GetDescendants()) do
			if desc:IsA("BasePart") then
				if entry.originalCanCollide[desc] ~= nil then
					desc.CanCollide = entry.originalCanCollide[desc]
				end
				if entry.originalAnchored[desc] ~= nil then
					desc.Anchored = entry.originalAnchored[desc]
				end
			end
		end

		local primaryPart = model.PrimaryPart
		if primaryPart and primaryPart.Parent then
			pcall(function()
				primaryPart:SetNetworkOwner(nil)
			end)
		end
	end

	dragging[player] = nil
	if model then
		draggedBy[model] = nil
	end
end

--[[
    @summary  Validate and start dragging a world item for a player.
    @param    player  Player
    @param    model   Model
    @returns  boolean
]]
local function tryStartDrag(player: Player, model: Model): boolean
	if not model or not model:IsA("Model") or not model.Parent then
		return false
	end

	local resourceName = model:GetAttribute("Resource")
		or model:GetAttribute("PickupResource")
		or model:GetAttribute("ForageResource")
	if not resourceName or typeof(resourceName) ~= "string" then
		return false
	end
	if not table.find(RESOURCE_NAMES, resourceName) then
		return false
	end

	if not worldService then
		return false
	end
	local baseMap = worldService:GetBaseMap()
	if not baseMap or not model:IsDescendantOf(baseMap) then
		return false
	end
	if dragging[player] then
		return false
	end
	if draggedBy[model] then
		return false
	end

	local character = player.Character
	if not character then
		return false
	end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp or not hrp:IsA("BasePart") then
		return false
	end
	local primaryPart = model.PrimaryPart
	if not primaryPart then
		return false
	end
	if (hrp.Position - model:GetPivot().Position).Magnitude > PICKUP_RANGE then
		return false
	end

	local originalCanCollide: { [BasePart]: boolean } = {}
	local originalAnchored: { [BasePart]: boolean } = {}
	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsA("BasePart") then
			originalCanCollide[desc] = desc.CanCollide
			originalAnchored[desc] = desc.Anchored
			desc.Anchored = false
			-- Keep original CanCollide so the item slides against the map like the real game.
		end
	end

	pcall(function()
		primaryPart:SetNetworkOwner(player)
	end)

	local dragTarget = Instance.new("Part")
	dragTarget.Name = "DragTarget_" .. tostring(player.UserId)
	dragTarget.Size = Vector3.new(1, 1, 1)
	dragTarget.Transparency = 1
	dragTarget.CanCollide = false
	dragTarget.Anchored = true
	dragTarget.CFrame = primaryPart.CFrame
	dragTarget.Parent = workspace

	local dragTargetAttach = Instance.new("Attachment")
	dragTargetAttach.Name = "DragTargetAttachment"
	dragTargetAttach.Position = Vector3.zero
	dragTargetAttach.Parent = dragTarget

	local itemAttach = Instance.new("Attachment")
	itemAttach.Name = "DragItemAttachment"
	itemAttach.Position = Vector3.zero
	itemAttach.Parent = primaryPart

	local alignPos = Instance.new("AlignPosition")
	alignPos.Name = "DragAlignPosition"
	alignPos.Attachment0 = itemAttach
	alignPos.Attachment1 = dragTargetAttach
	alignPos.RigidityEnabled = false
	alignPos.Responsiveness = 80
	alignPos.MaxForce = 2.5e5
	alignPos.ApplyAtCenterOfMass = true
	alignPos.Parent = primaryPart

	local alignOri = Instance.new("AlignOrientation")
	alignOri.Name = "DragAlignOrientation"
	alignOri.Attachment0 = itemAttach
	alignOri.Attachment1 = dragTargetAttach
	alignOri.RigidityEnabled = false
	alignOri.Responsiveness = 50
	alignOri.MaxTorque = 1e5
	alignOri.Parent = primaryPart

	dragging[player] = {
		model = model,
		alignPos = alignPos,
		alignOri = alignOri,
		dragTarget = dragTarget,
		dragTargetAttach = dragTargetAttach,
		itemAttach = itemAttach,
		originalCanCollide = originalCanCollide,
		originalAnchored = originalAnchored,
	}
	draggedBy[model] = player
	return true
end

--[[
    @summary  Drop any drag whose model, player, or distance has become invalid.
]]
local function cleanupDrags()
	local toStop: { Player } = {}
	for player, entry in pairs(dragging) do
		local character = player.Character
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")

		local model = entry.model
		if not model or not model.Parent then
			table.insert(toStop, player)
			continue
		end

		if not hrp or not hrp:IsA("BasePart") or humanoid and humanoid.Health <= 0 then
			table.insert(toStop, player)
			continue
		end

		local primaryPart = model.PrimaryPart
		if not primaryPart or not primaryPart:IsA("BasePart") or not primaryPart.Parent then
			table.insert(toStop, player)
			continue
		end

		if (hrp.Position - primaryPart.Position).Magnitude > DRAG_MAX_DISTANCE then
			table.insert(toStop, player)
			continue
		end

		local dragTarget = entry.dragTarget
		if not dragTarget or not dragTarget.Parent then
			table.insert(toStop, player)
			continue
		end

		if (hrp.Position - dragTarget.Position).Magnitude > DRAG_MAX_DISTANCE then
			table.insert(toStop, player)
			continue
		end

		if (dragTarget.Position - primaryPart.Position).Magnitude > 30 then
			table.insert(toStop, player)
			continue
		end

		if not worldService then
			continue
		end
		local baseMap = worldService:GetBaseMap()
		if not baseMap or not model:IsDescendantOf(baseMap) then
			table.insert(toStop, player)
			continue
		end
	end

	for _, player in ipairs(toStop) do
		stopDrag(player)
	end
end

-- // CLIENT REMOTES // --

--[[
    @summary  Client-to-server remote for picking up a generic resource drop.
    @param    player  Player  -- injected by Knit
    @param    model   Model   -- the resource model in the world
    @returns  boolean
]]
function InventoryService.Client:RequestPickup(player: Player, model: Model): boolean
	if not model or not model:IsA("Model") or not model.Parent then
		return false
	end
	return tryPickup(model, player)
end

--[[
    @summary  Client-to-server remote to drop the entire inventory.
    @param    player  Player  -- injected by Knit
    @returns  boolean
]]
function InventoryService.Client:RequestDropAll(player: Player): boolean
	return tryDropAll(player)
end

--[[
    @summary  Client-to-server remote to drop the oldest single item.
    @param    player  Player  -- injected by Knit
    @returns  boolean
]]
function InventoryService.Client:RequestDropOne(player: Player): boolean
	return tryDropOne(player)
end

--[[
    @summary  Client-to-server remote to drop a specific amount of a resource.
    @param    player        Player  -- injected by Knit
    @param    resourceName  string  -- one of RESOURCE_NAMES
    @param    amount        number  -- units to drop (default 1)
    @returns  boolean
]]
function InventoryService.Client:RequestDrop(player: Player, resourceName: string, amount: number?): boolean
	if not resourceName or typeof(resourceName) ~= "string" then
		return false
	end
	if not table.find(RESOURCE_NAMES, resourceName) then
		return false
	end

	local dropAmount = math.max(1, math.floor(amount or 1))
	local data = getPlayerData(player)
	if not data then
		return false
	end
	if (data.Resources[resourceName] or 0) < dropAmount then
		return false
	end
	if not worldService then
		return false
	end
	local baseMap = worldService:GetBaseMap()
	if not baseMap then
		return false
	end

	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart or not rootPart:IsA("BasePart") then
		return false
	end

	local origin = rootPart.Position
	local dropped = 0
	for i = 1, dropAmount do
		local golden = i * 2.3999632297
		local radius = math.sqrt(i) * DROP_SPACING
		local offset = Vector3.new(math.cos(golden) * radius, 0, math.sin(golden) * radius)
		local position = Vector3.new(origin.X + offset.X, origin.Y, origin.Z + offset.Z)

		local model = buildDropModel(resourceName); model:SetAttribute("DroppedBy", player.UserId)
		model:PivotTo(buildDropCFrame(position, resourceName))
		model.Parent = baseMap
		Debris:AddItem(model, DROP_LIFETIME)
		dropped += 1
	end

	if dropped > 0 then
		updatePlayerData(player, function(playerData)
			playerData.Resources[resourceName] -= dropped
			if typeof(playerData.Inventory) == "table" and typeof(playerData.Inventory.PickupOrder) == "table" then
				local order = playerData.Inventory.PickupOrder
				for _ = 1, dropped do
					for i = #order, 1, -1 do
						if order[i] == resourceName then
							table.remove(order, i)
							break
						end
					end
				end
			end
		end)
		broadcastSnapshot(player)
	end
	return dropped > 0
end

--[[
    @summary  Client-to-server remote to start dragging a world item.
    @param    player  Player  -- injected by Knit
    @param    model   Model   -- the item to drag
    @returns  boolean
]]
function InventoryService.Client:RequestDragStart(player: Player, model: Model): boolean
	return tryStartDrag(player, model)
end

--[[
    @summary  Client-to-server remote to stop dragging and release the item.
    @param    player  Player  -- injected by Knit
    @returns  boolean
]]
function InventoryService.Client:RequestDragStop(player: Player): boolean
	if not dragging[player] then
		return false
	end
	stopDrag(player)
	return true
end

--[[
    @summary  Build an equippable Carry Bag Tool from the pre-placed mesh.
    @desc     Clones the carry-bag Part as the Tool's Handle so the player
              can equip and unequip it like the Axe.
    @returns  Tool?
]]
local function buildCarryBagTool(): Tool?
	local source = ITEMS_PATH:FindFirstChild(CARRY_BAG_NAME)
	if not source or not source:IsA("BasePart") then
		warn("[InventoryService] carry-bag asset not found in Assets Items")
		return nil
	end

	local tool = Instance.new("Tool")
	tool.Name = CARRY_BAG_TOOL_NAME
	tool.RequiresHandle = true
	tool.CanBeDropped = false

	-- Hold the bag by its opening (top) so the body hangs downward from the hand.
	-- GripPos is in the Handle's local space: +Y is the top/opening of the mesh,
	-- so we place the grip point at +halfHeight to put the hand at the opening.
	local mesh = source:FindFirstChildWhichIsA("SpecialMesh")
	local halfHeight = source.Size.Y / 2
	if mesh and mesh:IsA("SpecialMesh") then
		halfHeight *= mesh.Scale.Y
	end
	tool.GripPos = Vector3.new(0, halfHeight, 0)
	tool.GripUp = Vector3.new(0, 1, 0)
	tool.GripForward = Vector3.new(0, 0, 1)
	tool.GripRight = Vector3.new(1, 0, 0)

	local handle = source:Clone()
	handle.Name = "Handle"
	handle.Anchored = false
	handle.CanCollide = false
	handle.CanQuery = false
	handle.CanTouch = false
	handle.Massless = true
	-- Strip the source's in-world Y-180 rotation so the Tool grip controls it fully.
	handle.CFrame = CFrame.new(handle.CFrame.Position)
	for _, child in ipairs(handle:GetChildren()) do
		if child:IsA("JointInstance") or child:IsA("Motor6D") then
			child:Destroy()
		end
	end
	handle.Parent = tool

	return tool
end

--[[
    @summary  Grant the Carry Bag tool to a player's Backpack and StarterGear
              so it persists across respawns.
    @param    player  Player  -- the Roblox player
]]
local function giveFlashlight(player: Player)
	if not flashlightTemplate then
		return
	end
	if spawnService and not spawnService:IsPlayerSpawned(player) then
		return
	end

	local backpack = player:WaitForChild("Backpack")
	if not backpack:FindFirstChild(FLASHLIGHT_TOOL_NAME) then
		flashlightTemplate:Clone().Parent = backpack
	end

	local starterGear = player:WaitForChild("StarterGear")
	if not starterGear:FindFirstChild(FLASHLIGHT_TOOL_NAME) then
		flashlightTemplate:Clone().Parent = starterGear
	end
end

local function giveCarryBag(player: Player)
	if not bagTemplate then
		return
	end
	if spawnService and not spawnService:IsPlayerSpawned(player) then
		return
	end

	local data = getPlayerData(player)
	if data and data.Inventory and data.Inventory.HasBag == false then
		return
	end

	local backpack = player:WaitForChild("Backpack")
	if not backpack:FindFirstChild(CARRY_BAG_TOOL_NAME) then
		local clone = bagTemplate:Clone()
		clone.Parent = backpack
	end

	local starterGear = player:WaitForChild("StarterGear")
	if not starterGear:FindFirstChild(CARRY_BAG_TOOL_NAME) then
		local clone = bagTemplate:Clone()
		clone.Parent = starterGear
	end
end

-- // CLIENT REMOTES // --

--[[
    @summary  Client-facing remote returning a one-shot resources/capacity snapshot.
    @param    player  Player  -- injected by Knit
    @returns  { resources: table, capacity: number } | nil
]]
function InventoryService.Client:GetSnapshot(player: Player)
	local data = getPlayerData(player)
	if not data then
		local empty = {}
		for _, name in ipairs(RESOURCE_NAMES) do
			empty[name] = 0
		end
		return { resources = empty, capacity = BASE_CAPACITY }
	end
	return {
		resources = table.clone(data.Resources),
		capacity = InventoryService:GetCapacity(player),
	}
end

-- // INITIALIZATION // --

function InventoryService:KnitStart()
	playerDataService = Knit.GetService("PlayerDataService")
	worldService = Knit.GetService("WorldService")
	spawnService = Knit.GetService("SpawnService")

	bagTemplate = buildCarryBagTool()
	flashlightTemplate = ITEMS_PATH:FindFirstChild(FLASHLIGHT_TOOL_NAME)
	if flashlightTemplate and not flashlightTemplate:IsA("Tool") then
		warn("[InventoryService] Flashlight asset is not a Tool, got:", flashlightTemplate.ClassName)
		flashlightTemplate = nil
	end

	playerDataService.ProfileLoaded:Connect(function(player: Player)
		giveCarryBag(player)
		giveFlashlight(player)
		broadcastSnapshot(player)
	end)

	-- Give bag and flashlight when player teleports to the game map.
	if spawnService then
		spawnService.PlayerSpawned:Connect(function(player: Player)
			giveCarryBag(player)
			giveFlashlight(player)
			if RunConfig.IsTestEnabled("GrantResources") then
				self:AddResource(player, "Wood", 50)
				self:AddResource(player, "Scrap", 30)
			end
			broadcastSnapshot(player)
		end)
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if getPlayerData(player) then
			giveCarryBag(player)
			giveFlashlight(player)
		end
	end

	InventoryService.Client.DragTargetMoved:Connect(function(player: Player, pos: any)
		if typeof(pos) ~= "Vector3" then
			return
		end
		local position = pos :: Vector3
		local entry = dragging[player]
		if not entry then
			return
		end
		local dragTarget = entry.dragTarget
		if not dragTarget or not dragTarget.Parent then
			return
		end
		local character = player.Character
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		if not hrp or not hrp:IsA("BasePart") then
			return
		end
		if (hrp.Position - position).Magnitude > DRAG_MAX_DISTANCE then
			return
		end
		dragTarget.CFrame = CFrame.new(position) * dragTarget.CFrame.Rotation
	end)

	Players.PlayerRemoving:Connect(stopDrag)
	local function onCharacterRemoving(player: Player)
		stopDrag(player)
	end
	Players.PlayerAdded:Connect(function(player: Player)
		player.CharacterRemoving:Connect(function()
			onCharacterRemoving(player)
		end)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		player.CharacterRemoving:Connect(function()
			onCharacterRemoving(player)
		end)
	end

	RunService.Heartbeat:Connect(cleanupDrags)
end

return InventoryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="95">
          <Properties>
            <string name="Name">LootService</string>
            <string name="Source"><![CDATA[--[[
    @file    LootService.luau
    @author  manik
    @date    2025

    @summary
    Server-owned one-open-per-run landmark chests and weighted loot.

    @description
    Chest prompts never accept a client-selected reward.  The server
    validates run membership and distance, rolls an allow-listed table,
    grants what fits in inventory, and permanently opens that chest for
    the current run.
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)

-- | Objects | --
local LootService = Knit.CreateService({
	Name = "LootService",
	Client = {
		ChestOpened = Knit.CreateSignal(),
	},
})

-- | Configuration | --
local OPEN_RANGE = 12
local OPEN_COOLDOWN = 0.5
local BASIC_CHEST_COUNT = 6
local GOLD_CHEST_COUNT = 2
local LANDMARK_NAMES = { "cabin", "Hunters Lodge", "Tower", "Treehouse", "Crashed Plane", "modern-house" }

local LOOT_TABLES = {
	Basic = {
		guaranteed = { resource = "Scrap", min = 1, max = 3 },
		extras = {
			{ resource = "Coal", min = 1, max = 2, weight = 30 },
			{ resource = "Berries", min = 1, max = 2, weight = 25 },
			{ resource = "Mushrooms", min = 1, max = 2, weight = 20 },
			{ resource = "RawMeat", min = 1, max = 1, weight = 15 },
			{ resource = "Bandage", min = 1, max = 1, weight = 10 },
		},
	},
	Gold = {
		guaranteed = { resource = "Scrap", min = 4, max = 7 },
		extras = {
			{ resource = "Bandage", min = 1, max = 2, weight = 30 },
			{ resource = "Coal", min = 2, max = 4, weight = 30 },
			{ resource = "CookedMeat", min = 1, max = 2, weight = 25 },
			{ resource = "Scrap", min = 2, max = 4, weight = 15 },
		},
	},
}

-- | State Management | --
local runStateService: any = nil
local inventoryService: any = nil
local worldService: any = nil
local openedChests: { [string]: boolean } = {}
local cooldowns: { [Player]: number } = {}
local randomGenerator = Random.new()

-- // FUNCTIONS // --

-- | Private | --

--[[
    @summary  Select one weighted loot entry from a tier table.
    @param    entries  table
    @returns  table
]]
local function chooseWeighted(entries)
	local totalWeight = 0
	for _, entry in ipairs(entries) do
		totalWeight += entry.weight
	end
	local roll = randomGenerator:NextNumber(0, totalWeight)
	local cursor = 0
	for _, entry in ipairs(entries) do
		cursor += entry.weight
		if roll <= cursor then
			return entry
		end
	end
	return entries[#entries]
end

--[[
    @summary  Return a usable chest model from the stored source asset.
    @param    tier  string
    @returns  Model?
]]
local function cloneChest(tier: string): Model?
	local mapsItems = ServerStorage.Assets:FindFirstChild("Assets maps items")
	local assetName = if tier == "Gold" then "Gold-chest" else "basic-chest"
	local source = mapsItems and mapsItems:FindFirstChild(assetName)
	if not source then
		return nil
	end

	if source:IsA("Model") then
		return source:Clone()
	end
	if source:IsA("BasePart") then
		local model = Instance.new("Model")
		local part = source:Clone()
		part.Name = "ChestBody"
		part.Parent = model
		model.PrimaryPart = part
		return model
	end
	return nil
end

--[[
    @summary  Find distinct landmarks to anchor chest positions.
    @returns  { Model }
]]
local function collectLandmarks(): { Model }
	local baseMap = worldService and worldService:GetBaseMap()
	local landmarks = {}
	if not baseMap then
		return landmarks
	end
	for _, child in ipairs(baseMap:GetChildren()) do
		if child:IsA("Model") and table.find(LANDMARK_NAMES, child.Name) then
			table.insert(landmarks, child)
		end
	end
	return landmarks
end

--[[
    @summary  Resolve a grounded position near a landmark.
    @param    landmark  Model
    @param    index     number
    @returns  CFrame
]]
local function chestCFrame(landmark: Model, index: number): CFrame
	local pivot = landmark:GetPivot()
	local angle = index * 2.399963
	local candidate = pivot.Position + Vector3.new(math.cos(angle) * 10, 30, math.sin(angle) * 10)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { worldService:GetBaseMap() }
	local result = workspace:Raycast(candidate, Vector3.new(0, -80, 0), params)
	local position = if result then result.Position + Vector3.new(0, 2, 0) else pivot.Position + Vector3.new(0, 3, 0)
	return CFrame.new(position) * CFrame.Angles(0, angle, 0)
end

--[[
    @summary  Grant a rolled chest reward to a player.
    @param    player  Player
    @param    tier    string
    @returns  table
]]
local function grantLoot(player: Player, tier: string): { [string]: number }
	local lootTable = LOOT_TABLES[tier]
	local granted = {}
	local guaranteed = lootTable.guaranteed
	local guaranteedAmount = randomGenerator:NextInteger(guaranteed.min, guaranteed.max)
	local added = inventoryService:AddResource(player, guaranteed.resource, guaranteedAmount)
	if added > 0 then
		granted[guaranteed.resource] = added
	end

	local extra = chooseWeighted(lootTable.extras)
	local extraAmount = randomGenerator:NextInteger(extra.min, extra.max)
	local extraAdded = inventoryService:AddResource(player, extra.resource, extraAmount)
	if extraAdded > 0 then
		granted[extra.resource] = (granted[extra.resource] or 0) + extraAdded
	end
	return granted
end

--[[
    @summary  Validate and open one live chest for a player.
    @param    player  Player
    @param    chest   Model
]]
local function openChest(player: Player, chest: Model)
	local chestId = chest:GetAttribute("ChestId")
	local tier = chest:GetAttribute("LootTier")
	local capturedRunId = chest:GetAttribute("RunId")
	if typeof(chestId) ~= "string" or (tier ~= "Basic" and tier ~= "Gold") then
		return
	end
	if openedChests[chestId] or not runStateService:IsCurrentRun(capturedRunId) then
		return
	end
	if not runStateService:IsActive() or not runStateService:IsMember(player) then
		return
	end

	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not rootPart or not rootPart:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
		return
	end
	if (rootPart.Position - chest:GetPivot().Position).Magnitude > OPEN_RANGE then
		return
	end

	local now = os.clock()
	if cooldowns[player] and now - cooldowns[player] < OPEN_COOLDOWN then
		return
	end
	cooldowns[player] = now
	openedChests[chestId] = true

	local granted = grantLoot(player, tier)
	chest:SetAttribute("Opened", true)
	local prompt = chest:FindFirstChildWhichIsA("ProximityPrompt", true)
	if prompt then
		prompt.Enabled = false
	end
	for _, descendant in ipairs(chest:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Color = descendant.Color:Lerp(Color3.fromRGB(65, 65, 65), 0.35)
		end
	end
	for _, member in ipairs(runStateService:GetMembers()) do
		LootService.Client.ChestOpened:Fire(member, chest:GetPivot().Position, tier, granted, player.UserId)
	end
end

--[[
    @summary  Spawn all configured chests for a new run.
]]
local function spawnChests()
	openedChests = {}
	cooldowns = {}
	local landmarks = collectLandmarks()
	if #landmarks == 0 then
		warn("[LootService] No landmarks found for chest placement")
		return
	end

	local folder = Instance.new("Folder")
	folder.Name = "Chests"
	folder.Parent = runStateService:GetRuntimeFolder()
	local total = BASIC_CHEST_COUNT + GOLD_CHEST_COUNT
	for index = 1, total do
		local tier = if index > BASIC_CHEST_COUNT then "Gold" else "Basic"
		local chest = cloneChest(tier)
		if not chest then
			continue
		end
		chest.Name = tier .. "Chest"
		chest:SetAttribute("ChestId", HttpService:GenerateGUID(false))
		chest:SetAttribute("LootTier", tier)
		chest:SetAttribute("RunId", runStateService:GetRunId())
		chest:SetAttribute("Opened", false)
		for _, descendant in ipairs(chest:GetDescendants()) do
			if descendant:IsA("BasePart") then
				descendant.Anchored = true
			end
		end
		chest.Parent = folder
		local landmark = landmarks[((index - 1) % #landmarks) + 1]
		chest:PivotTo(chestCFrame(landmark, index))

		local anchor = chest.PrimaryPart or chest:FindFirstChildWhichIsA("BasePart", true)
		if anchor then
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "OpenChest"
			prompt.ActionText = "Open"
			prompt.ObjectText = tier .. " Chest"
			prompt.MaxActivationDistance = OPEN_RANGE
			prompt.HoldDuration = 0.7
			prompt.RequiresLineOfSight = true
			prompt.Parent = anchor
			prompt.Triggered:Connect(function(player)
				openChest(player, chest)
			end)
		end
	end
end

-- // INITIALIZATION // --

function LootService:KnitStart()
	runStateService = Knit.GetService("RunStateService")
	inventoryService = Knit.GetService("InventoryService")
	worldService = Knit.GetService("WorldService")

	runStateService.RunStarted:Connect(spawnChests)
	Players.PlayerRemoving:Connect(function(player)
		cooldowns[player] = nil
	end)
end

return LootService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="96">
          <Properties>
            <string name="Name">MatchFlowService</string>
            <string name="Source"><![CDATA[--[[
    @file    MatchFlowService.luau
    @author  manik
    @date    2025

    @summary
    Server-authoritative lobby waiting room and match start.

    @description
    Teleporter pads open the Create Party UI. The host clicks Create,
    a 5-second countdown runs, the screen fades to the story text,
    then players are teleported while the screen is still dark. The
    Day 1 card appears on black, then the base map is slowly revealed.

    @exports
    - MatchFlowService:EnterWaiting(player)
    - MatchFlowService:GetState(player)
    - Client.RequestStart
    - Client.FlowStateChanged
    - Client.Countdown
    - Client.RosterChanged
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local Constants = require(ReplicatedStorage.Shared.Constants)

-- | Objects | --
local MatchFlowService = Knit.CreateService({
	Name = "MatchFlowService",
	Client = {
		RequestStart = Knit.CreateSignal(),
		FlowStateChanged = Knit.CreateSignal(),
		Countdown = Knit.CreateSignal(),
		RosterChanged = Knit.CreateSignal(),
	},
})

export type FlowState = "Lobby" | "Waiting" | "Countdown" | "Story" | "Day1" | "InGame"

type Session = {
	state: FlowState,
	host: Player,
	players: { [Player]: boolean },
	endsAt: number,
	duration: number,
	timerThread: thread?,
}

-- | Configuration | --
local COUNTDOWN_SECONDS = Constants.MATCH_COUNTDOWN_SECONDS or 5
local STORY_FADE_SECONDS = Constants.MATCH_STORY_FADE_SECONDS or 1.2
local STORY_HOLD_SECONDS = Constants.MATCH_STORY_HOLD_SECONDS or 5
local DAY1_HOLD_SECONDS = Constants.MATCH_DAY1_HOLD_SECONDS or 2

-- | State Management | --
local spawnService: any = nil
local timeService: any = nil
local runStateService: any = nil
local sessions: { [Player]: Session } = {}

-- // FUNCTIONS // --

local function getServerNow(): number
	return workspace:GetServerTimeNow()
end

local function buildRoster(session: Session): { { userId: number, name: string, isHost: boolean } }
	local roster = {}
	for player in pairs(session.players) do
		if player.Parent then
			table.insert(roster, {
				userId = player.UserId,
				name = player.DisplayName,
				isHost = player == session.host,
			})
		end
	end
	table.sort(roster, function(a, b)
		if a.isHost ~= b.isHost then
			return a.isHost
		end
		return a.name < b.name
	end)
	return roster
end

local function fireToSession(session: Session, signal, ...)
	for player in pairs(session.players) do
		if player.Parent then
			signal:Fire(player, ...)
		end
	end
end

local function cancelTimer(session: Session)
	if session.timerThread then
		pcall(task.cancel, session.timerThread)
		session.timerThread = nil
	end
end

local function destroySession(owner: Player)
	local session = sessions[owner]
	if not session then
		return
	end
	cancelTimer(session)
	for player, mappedSession in pairs(sessions) do
		if mappedSession == session then
			sessions[player] = nil
		end
	end
end

local function getSessionFor(player: Player): Session?
	return sessions[player]
end

--[[
    @summary  Merge other waiting players into the host's pending run.
    @param    hostSession  Session
]]
local function mergeWaitingSessions(hostSession: Session)
	local candidates = {}
	local seen = {}
	for _, candidate in pairs(sessions) do
		if candidate ~= hostSession and candidate.state == "Waiting" and not seen[candidate] then
			seen[candidate] = true
			table.insert(candidates, candidate)
		end
	end

	local memberCount = 0
	for _ in pairs(hostSession.players) do
		memberCount += 1
	end
	for _, candidate in ipairs(candidates) do
		for player in pairs(candidate.players) do
			if memberCount >= Constants.MAX_PLAYERS then
				return
			end
			if player.Parent and not hostSession.players[player] then
				hostSession.players[player] = true
				sessions[player] = hostSession
				memberCount += 1
			end
		end
		cancelTimer(candidate)
	end
end

--[[
    @summary  Remove one player while preserving a viable shared session.
    @param    player  Player
]]
local function removePlayerFromSession(player: Player)
	local session = sessions[player]
	if not session then
		return
	end
	sessions[player] = nil
	session.players[player] = nil
	if not next(session.players) then
		cancelTimer(session)
		return
	end
	if session.host == player then
		session.host = next(session.players) :: Player
	end
	fireToSession(session, MatchFlowService.Client.RosterChanged, buildRoster(session))
end

function MatchFlowService:GetState(player: Player): FlowState
	local session = getSessionFor(player)
	if not session then
		return "Lobby"
	end
	return session.state
end

local function beginStory(session: Session)
	if session.state ~= "Countdown" then
		return
	end
	cancelTimer(session)
	session.state = "Story"
	fireToSession(session, MatchFlowService.Client.FlowStateChanged, "Story")

	-- Fade to black + story hold, then teleport while still dark.
	task.delay(STORY_FADE_SECONDS + STORY_HOLD_SECONDS, function()
		if (session.state :: FlowState) ~= "Story" then
			return
		end

		local participants = {}
		for player in pairs(session.players) do
			if player.Parent then
				table.insert(participants, player)
			end
		end

		local startedRunId = runStateService and runStateService:StartRun(participants) or nil
		if not startedRunId then
			session.state = "Waiting"
			fireToSession(session, MatchFlowService.Client.FlowStateChanged, "Waiting")
			fireToSession(session, MatchFlowService.Client.RosterChanged, buildRoster(session))
			return
		end

		for _, player in ipairs(participants) do
			if spawnService then
				spawnService:SpawnPlayer(player)
			end
		end

		if timeService then
			timeService:StartMatch()
		end

		session.state = "Day1"
		fireToSession(session, MatchFlowService.Client.FlowStateChanged, "Day1")

		-- Hold Day 1 on black, then reveal world and begin gameplay.
		task.delay(DAY1_HOLD_SECONDS, function()
			if (session.state :: FlowState) ~= "Day1" then
				return
			end
			session.state = "InGame"
			fireToSession(session, MatchFlowService.Client.FlowStateChanged, "InGame")
		end)
	end)
end

local function scheduleTimer(session: Session)
	cancelTimer(session)
	local remaining = math.max(0, session.endsAt - getServerNow())
	session.timerThread = task.delay(remaining, function()
		session.timerThread = nil
		beginStory(session)
	end)
end

--[[
    @summary  Put a player into the waiting room without teleporting.
    @desc    Idempotent. Solo-first: each player owns their own session.
]]
function MatchFlowService:EnterWaiting(player: Player)
	if not player or not player.Parent then
		return
	end

	local existing = getSessionFor(player)
	if existing then
		if existing.state == "Waiting" then
			MatchFlowService.Client.FlowStateChanged:Fire(player, "Waiting")
			MatchFlowService.Client.RosterChanged:Fire(player, buildRoster(existing))
		elseif existing.state == "Countdown" then
			MatchFlowService.Client.FlowStateChanged:Fire(player, "Countdown")
			MatchFlowService.Client.Countdown:Fire(player, {
				endsAt = existing.endsAt,
				duration = existing.duration,
			})
			MatchFlowService.Client.RosterChanged:Fire(player, buildRoster(existing))
		end
		return
	end

	if spawnService and spawnService:IsPlayerSpawned(player) then
		return
	end

	local session: Session = {
		state = "Waiting",
		host = player,
		players = { [player] = true },
		endsAt = 0,
		duration = 0,
		timerThread = nil,
	}
	sessions[player] = session

	MatchFlowService.Client.FlowStateChanged:Fire(player, "Waiting")
	MatchFlowService.Client.RosterChanged:Fire(player, buildRoster(session))
end

-- // INITIALIZATION // --

function MatchFlowService:KnitInit()
	-- Defensive: if Knit.Start didn't convert the SIGNAL_MARKERs, create the RemoteSignals ourselves.
	local comm = self.KnitComm
	if typeof(self.Client.RequestStart) ~= "table" then
		self.Client.RequestStart = comm:CreateSignal("RequestStart", false)
		self.Client.FlowStateChanged = comm:CreateSignal("FlowStateChanged", false)
		self.Client.Countdown = comm:CreateSignal("Countdown", false)
		self.Client.RosterChanged = comm:CreateSignal("RosterChanged", false)
	end
end

function MatchFlowService:KnitStart()
	spawnService = Knit.GetService("SpawnService")
	timeService = Knit.GetService("TimeService")
	runStateService = Knit.GetService("RunStateService")

	runStateService.RunCleaned:Connect(function()
		local uniqueSessions = {}
		for _, session in pairs(sessions) do
			if not uniqueSessions[session] then
				uniqueSessions[session] = true
				cancelTimer(session)
			end
		end
		sessions = {}
		for _, player in ipairs(Players:GetPlayers()) do
			MatchFlowService.Client.FlowStateChanged:Fire(player, "Lobby")
		end
	end)

	self.Client.RequestStart:Connect(function(player: Player)
		local session = getSessionFor(player)
		if not session then
			return
		end
		if session.host ~= player then
			return
		end
		if session.state ~= "Waiting" then
			return
		end

		mergeWaitingSessions(session)
		cancelTimer(session)
		local now = getServerNow()
		session.state = "Countdown"
		session.endsAt = now + COUNTDOWN_SECONDS
		session.duration = COUNTDOWN_SECONDS
		scheduleTimer(session)

		fireToSession(session, MatchFlowService.Client.FlowStateChanged, "Countdown")
		fireToSession(session, MatchFlowService.Client.Countdown, {
			endsAt = session.endsAt,
			duration = session.duration,
		})
		fireToSession(session, MatchFlowService.Client.RosterChanged, buildRoster(session))
	end)
end

Players.PlayerRemoving:Connect(removePlayerFromSession)

return MatchFlowService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="97">
          <Properties>
            <string name="Name">OwlService</string>
            <string name="Source"><![CDATA[--[[
    @file    OwlService.luau
    @author  manik
    @date    2025

    @summary
    Server-authoritative Owl NPC — a neutral, unkillable night stalker
    with a movement-detection minigame, wolf-summoning, and feather drops.

    @description
    The Owl is a unique entity (not part of the generic AnimalAI
    population).  It spawns on randomized nights starting from Day 10,
    lands near a player, and observes.  An on-screen eye icon fills red
    when nearby players move; if it fills completely the Owl screams and
    chases like the Deer (faster, flashlight-stunnable, campfire
    retreat).  If players stand still, the Owl loses interest and flies
    away, dropping a feather.  At dawn it flies away without a feather.
    While the Owl is active, the Deer is suppressed.  The Owl can
    summon wolves to scare players into moving.

    States: Dormant → FlyingIn → Perched → Chasing → Stunned → Retreating → FlyingAway

    @exports
    - OwlService:ApplyFlashlightStun(model, player) -> boolean
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local CombatTargetRegistry = require(script.Parent.Parent.CombatTargetRegistry)

-- | Objects | --
local OwlService = Knit.CreateService({
	Name = "OwlService",
	Client = {
		OwlActive = Knit.CreateSignal(),
		OwlDetection = Knit.CreateSignal(),
		OwlScream = Knit.CreateSignal(),
		OwlContact = Knit.CreateSignal(),
		OwlStunned = Knit.CreateSignal(),
		OwlRetreated = Knit.CreateSignal(),
	},
})

-- | Configuration | --
local NPC_SOURCE_PATH = ServerStorage.Assets["Assets Npcs"]
local OWL_MODEL_NAME = "Owl"
local DORMANT_HOLDING_POSITION = Vector3.new(0, -500, 0)
local DECISION_INTERVAL = 0.15
local CONTACT_RANGE = 5
local CONTACT_COOLDOWN = 1.0
local PURSUIT_ACCEL_PER_SEC = 0.5
local PURSUIT_MAX_BONUS_SPEED = 18
local BASE_CHASE_SPEED = 20
local BASE_STUN_DURATION = 4
local STUN_DECAY_PER_USE = 0.6
local MIN_STUN_DURATION = 1
local STUN_RESISTANCE_RECOVERY_TIME = 45
local RETREAT_HOLD_TIME = 3

local OWL_START_DAY = 10
local OWL_SPAWN_CHANCE = 0.35
local PERCH_DURATION_MIN = 8
local PERCH_DURATION_MAX = 20
local PERCH_LAND_DISTANCE = 25
local PERCH_LAND_HEIGHT = 60
local FLY_TWEEN_TIME = 2.5
local FLY_AWAY_HEIGHT = 200

local DETECTION_RANGE = 60
local MOVEMENT_THRESHOLD = 2
local DETECTION_FILL_RATE = 0.8
local DETECTION_DECAY_RATE = 0.4
local WOLF_SUMMON_CHANCE = 0.3
local WOLF_SUMMON_DISTANCE = 35

local DEFAULT_R15_WALK_ID = "rbxassetid://913402848"
local DEFAULT_R15_IDLE_ID = "rbxassetid://507766388"

-- | State Management | --
local worldService: any = nil
local timeService: any = nil
local campfireService: any = nil
local spawnService: any = nil
local animalAIService: any = nil
local inventoryService: any = nil
local deerService: any = nil
local playerLifeService: any = nil

local owl: any = nil
local lastPhase = ""
local owlActiveTonight = false
local wolfSummoned = false

-- // FUNCTIONS // --

-- | Private | --

--[[
    @summary  Fire a Knit signal to every currently-connected player.
    @param    signal  KnitSignal
]]
local function broadcastToAll(signal, ...)
	for _, player in ipairs(Players:GetPlayers()) do
		signal:Fire(player, ...)
	end
end

--[[
    @summary  Load default R15 walk/idle AnimationTracks for the Owl.
    @param    data  table (owl state)
]]
local function buildAnimationTracks(data)
	data.tracks = {}
	local humanoid = data.humanoid
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	local function loadTrack(id: string, looped: boolean): AnimationTrack?
		local anim = Instance.new("Animation")
		anim.AnimationId = id
		local ok, track = pcall(function()
			return animator:LoadAnimation(anim)
		end)
		if not ok or not track then
			return nil
		end
		track.Looped = looped
		return track
	end

	data.tracks.Walk = loadTrack(DEFAULT_R15_WALK_ID, true)
	data.tracks.Idle = loadTrack(DEFAULT_R15_IDLE_ID, true)
end

--[[
    @summary  Stop every currently-playing track on the Owl.
    @param    data  table
]]
local function stopAllTracks(data)
	for _, track in pairs(data.tracks) do
		if track.IsPlaying then
			track:Stop(0.15)
		end
	end
end

--[[
    @summary  Play a named track if it exists.
    @param    data  table
    @param    name  string
]]
local function playTrack(data, name: string)
	local track = data.tracks[name]
	if track and not track.IsPlaying then
		stopAllTracks(data)
		track:Play(0.15)
	end
end

--[[
    @summary  Collect arm Motor6Ds for procedural wing flap.
    @param    model  Model
    @returns  { { motor: Motor6D, originalC0: CFrame, side: string } }
]]
local function collectWingJoints(model: Model)
	local joints = {}
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("Motor6D") and descendant.Part1 then
			local partName = descendant.Part1.Name
			local lower = partName:lower()
			if lower:find("arm") or lower:find("hand") then
				local side = if lower:find("left") or lower:find("%.l") then "Left" else "Right"
				table.insert(joints, {
					motor = descendant,
					originalC0 = descendant.C0,
					side = side,
				})
			end
		end
	end
	return joints
end

--[[
    @summary  Animate wing flaps procedurally via arm Motor6D offsets.
    @param    data     table
    @param    speed    number  -- flap speed multiplier
    @param    dt       number  -- delta time
]]
local function updateWingFlap(data, speed: number, dt: number)
	data.flapTime = (data.flapTime or 0) + dt * speed
	local angle = math.sin(data.flapTime * 6) * math.rad(35)
	for _, joint in ipairs(data.wingJoints) do
		local base = joint.originalC0
		local rot = if joint.side == "Left"
			then CFrame.Angles(0, 0, angle)
			else CFrame.Angles(0, 0, -angle)
		joint.motor.C0 = base * rot
	end
end

--[[
    @summary  Spawn the Owl model into the world at the dormant position.
]]
local function spawnOwl()
	if owl then
		return
	end

	local template = NPC_SOURCE_PATH:FindFirstChild(OWL_MODEL_NAME)
	if not template or not template:IsA("Model") then
		warn("[OwlService] Missing Owl template in", NPC_SOURCE_PATH:GetFullName())
		return
	end

	local model = template:Clone()
	model.Parent = workspace
	model:PivotTo(CFrame.new(DORMANT_HOLDING_POSITION))

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local rootPart = model:FindFirstChild("HumanoidRootPart")
	if not humanoid or not rootPart then
		warn("[OwlService] Owl template missing Humanoid or HumanoidRootPart")
		model:Destroy()
		return
	end

	owl = {
		model = model,
		humanoid = humanoid,
		rootPart = rootPart,
		state = "Dormant",
		target = nil,
		detectionMeter = 0,
		perchUntil = 0,
		lastContactTime = 0,
		consecutiveStuns = 0,
		lastStunTime = 0,
		stunUntil = 0,
		retreatUntil = 0,
		nextDecisionTime = 0,
		pursuitStartTime = nil,
		flapTime = 0,
		wingJoints = collectWingJoints(model),
		flyHeartbeat = nil,
	}

	buildAnimationTracks(owl)

	CombatTargetRegistry.Register(model, {
		ApplyDamage = function()
			return false, true
		end,
		IsImmune = true,
	})

end

--[[
    @summary  Pick a landing position near a random player, not near campfire.
    @returns  Vector3?
]]
local function pickLandingPosition(): Vector3?
	local players = Players:GetPlayers()
	local valid = {}
	for _, player in ipairs(players) do
		if spawnService and not spawnService:IsPlayerSpawned(player) then
			continue
		end
		local character = player.Character
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		if not rootPart or not rootPart:IsA("BasePart") then
			continue
		end
		if campfireService and campfireService:IsInSafeZone(rootPart.Position) then
			continue
		end
		table.insert(valid, rootPart.Position)
	end

	if #valid == 0 then
		return nil
	end

	local chosen = valid[math.random(1, #valid)]
	local angle = math.random() * math.pi * 2
	local offset = Vector3.new(math.cos(angle) * PERCH_LAND_DISTANCE, 0, math.sin(angle) * PERCH_LAND_DISTANCE)
	return chosen + offset
end

--[[
    @summary  Tween the Owl model from its current position to a target CFrame.
    @param    targetCFrame  CFrame
    @param    duration      number
    @param    callback      function?  -- called on completion
]]
local function flyTo(targetCFrame: CFrame, duration: number, callback: (() -> ())?)
	if not owl or not owl.rootPart then
		return
	end

	-- Clean up any previous flight
	if owl.flyHeartbeat then
		owl.flyHeartbeat:Disconnect()
		owl.flyHeartbeat = nil
	end

	owl.humanoid.WalkSpeed = 0
	stopAllTracks(owl)

	local startCFrame = owl.model:GetPivot()
	local startTime = os.clock()

	-- Anchor the rootPart during flight so physics doesn't fight the tween
	owl.rootPart.Anchored = true

	local function cleanup()
		if owl then
			owl.rootPart.Anchored = false
		end
	end

	owl.flyHeartbeat = RunService.Heartbeat:Connect(function()
		if not owl or not owl.flyHeartbeat then
			return
		end
		local elapsed = os.clock() - startTime
		local alpha = math.clamp(elapsed / duration, 0, 1)
		local eased = alpha * alpha * (3 - 2 * alpha)
		local pos = startCFrame.Position:Lerp(targetCFrame.Position, eased)
		local rot = startCFrame.Rotation:Lerp(targetCFrame.Rotation, eased)
		owl.model:PivotTo(CFrame.fromMatrix(pos, rot.XVector, rot.YVector, rot.ZVector))
		updateWingFlap(owl, 3, 1 / 60)
		if alpha >= 1 then
			owl.flyHeartbeat:Disconnect()
			owl.flyHeartbeat = nil
			owl.model:PivotTo(targetCFrame)
			cleanup()
			if callback then
				callback()
			end
		end
	end)
end

--[[
    @summary  Transition to FlyingIn — tween from above to a landing spot.
]]
local function enterFlyingIn()
	if not owl then
		return
	end
	owl.state = "FlyingIn"
	wolfSummoned = false

	local landingPos = pickLandingPosition()
	if not landingPos then
		landingPos = (worldService and worldService:GetCampfireCFrame() or CFrame.new()).Position
			+ Vector3.new(50, 0, 50)
	end

	-- Start from above the landing position
	local startPos = landingPos + Vector3.new(0, PERCH_LAND_HEIGHT, 0)
	owl.model:PivotTo(CFrame.new(startPos))

	local targetCFrame = CFrame.new(landingPos + Vector3.new(0, 3, 0), Vector3.new(landingPos.X, landingPos.Y, landingPos.Z - 1))

	flyTo(targetCFrame, FLY_TWEEN_TIME, function()
		if owl and owl.state == "FlyingIn" then
			owl.state = "Perched"
			owl.detectionMeter = 0
			owl.perchUntil = os.clock() + math.random(PERCH_DURATION_MIN, PERCH_DURATION_MAX)
			playTrack(owl, "Idle")
		end
	end)
end

--[[
    @summary  Transition to FlyingAway — tween upward and go dormant.
    @param    dropFeather  boolean  -- if true, spawn a feather at perch
]]
local function enterFlyingAway(dropFeather: boolean)
	if not owl then
		return
	end
	owl.state = "FlyingAway"
	owl.target = nil
	owl.pursuitStartTime = nil
	owl.detectionMeter = 0

	broadcastToAll(OwlService.Client.OwlRetreated)

	if dropFeather and owl.rootPart then
		local featherPos = owl.rootPart.Position
		task.delay(0.5, function()
			if inventoryService then
				local model = inventoryService:BuildDropModel("OwlFeather")
				if model then
					model:PivotTo(CFrame.new(featherPos + Vector3.new(0, 1, 0)))
					local baseMap = worldService and worldService:GetBaseMap()
					model.Parent = baseMap or workspace
					Debris:AddItem(model, 300)
				end
			end
		end)
	end

	local currentPos = owl.model:GetPivot().Position
	local awayPos = currentPos + Vector3.new(0, FLY_AWAY_HEIGHT, 0)
	flyTo(CFrame.new(awayPos), FLY_TWEEN_TIME, function()
		if owl then
			owl.state = "Dormant"
			owl.model:PivotTo(CFrame.new(DORMANT_HOLDING_POSITION))
			owl.humanoid.WalkSpeed = 0
			stopAllTracks(owl)
		end
	end)
end

--[[
    @summary  Transition to Chasing — scream and pursue the target.
    @param    target  Player
]]
local function enterChasing(target: Player)
	if not owl then
		return
	end
	owl.state = "Chasing"
	owl.target = target
	owl.pursuitStartTime = os.clock()
	owl.detectionMeter = 0
	broadcastToAll(OwlService.Client.OwlScream, owl.rootPart.Position)
end

--[[
    @summary  Transition to Retreating — move away from campfire.
]]
local function enterRetreating()
	if not owl then
		return
	end
	owl.state = "Retreating"
	owl.retreatUntil = os.clock() + RETREAT_HOLD_TIME
	owl.target = nil
	owl.pursuitStartTime = nil
end

--[[
    @summary  Summon 1-2 wolves near the perched Owl to scare players.
]]
local function summonWolves()
	if not owl or not animalAIService then
		return
	end
	local pos = owl.rootPart.Position
	for _ = 1, math.random(1, 2) do
		local angle = math.random() * math.pi * 2
		local offset = Vector3.new(math.cos(angle) * WOLF_SUMMON_DISTANCE, 0, math.sin(angle) * WOLF_SUMMON_DISTANCE)
		animalAIService:SpawnNpc("WolfModel", CFrame.new(pos + offset + Vector3.new(0, 5, 0)))
	end
	wolfSummoned = true
end

--[[
    @summary  Compute the movement-based detection meter while perched.
              Fills when nearby players move, decays when all are still.
]]
local function updateDetection(dt: number)
	if not owl or owl.state ~= "Perched" then
		return
	end

	local anyMoving = false
	for _, player in ipairs(Players:GetPlayers()) do
		if spawnService and not spawnService:IsPlayerSpawned(player) then
			continue
		end
		if playerLifeService and not playerLifeService:IsAlive(player) then
			continue
		end
		local character = player.Character
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		if not rootPart or not rootPart:IsA("BasePart") then
			continue
		end
		local dist = (rootPart.Position - owl.rootPart.Position).Magnitude
		if dist <= DETECTION_RANGE then
			local velocity = rootPart.AssemblyLinearVelocity
			local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
			if speed > MOVEMENT_THRESHOLD then
				anyMoving = true
				break
			end
		end
	end

	if anyMoving then
		owl.detectionMeter = math.clamp(owl.detectionMeter + DETECTION_FILL_RATE * dt, 0, 1)
	else
		owl.detectionMeter = math.clamp(owl.detectionMeter - DETECTION_DECAY_RATE * dt, 0, 1)
	end

	broadcastToAll(OwlService.Client.OwlDetection, owl.detectionMeter)

	if owl.detectionMeter >= 1.0 then
		local target
		-- Find the nearest moving player to chase
		local nearestDist = math.huge
		for _, player in ipairs(Players:GetPlayers()) do
			if spawnService and not spawnService:IsPlayerSpawned(player) then
				continue
			end
			local character = player.Character
			local rootPart = character and character:FindFirstChild("HumanoidRootPart")
			if not rootPart or not rootPart:IsA("BasePart") then
				continue
			end
			if campfireService and campfireService:IsInSafeZone(rootPart.Position) then
				continue
			end
			local dist = (rootPart.Position - owl.rootPart.Position).Magnitude
			if dist < nearestDist and dist <= DETECTION_RANGE then
				nearestDist = dist
				target = player
			end
		end
		if target then
			enterChasing(target)
		else
			-- No valid target, reset meter
			owl.detectionMeter = 0
		end
	end
end

--[[
    @summary  Find the nearest huntable player from a position.
    @param    fromPosition  Vector3
    @returns  Player?
]]
local function findHuntableTarget(fromPosition: Vector3): Player?
	local nearest: Player? = nil
	local nearestDist = math.huge
	for _, player in ipairs(Players:GetPlayers()) do
		if spawnService and not spawnService:IsPlayerSpawned(player) then
			continue
		end
		if playerLifeService and not playerLifeService:IsAlive(player) then
			continue
		end
		local character = player.Character
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		if not rootPart or not rootPart:IsA("BasePart") then
			continue
		end
		if campfireService and campfireService:IsInSafeZone(rootPart.Position) then
			continue
		end
		local dist = (rootPart.Position - fromPosition).Magnitude
		if dist < nearestDist then
			nearestDist = dist
			nearest = player
		end
	end
	return nearest
end

--[[
    @summary  Compute pursuit speed based on time chasing.
    @returns  number
]]
local function computePursuitSpeed(): number
	if not owl or not owl.pursuitStartTime then
		return BASE_CHASE_SPEED
	end
	local elapsed = os.clock() - owl.pursuitStartTime
	local bonus = math.min(elapsed * PURSUIT_ACCEL_PER_SEC, PURSUIT_MAX_BONUS_SPEED)
	return BASE_CHASE_SPEED + bonus
end

--[[
    @summary  Main state decision logic for the Owl.
]]
local function updateOwlState()
	if not owl then
		return
	end
	local now = os.clock()

	if owl.state == "Stunned" then
		if now >= owl.stunUntil then
			if owl.target then
				local character = owl.target.Character
				local rootPart = character and character:FindFirstChild("HumanoidRootPart")
				if rootPart and not (campfireService and campfireService:IsInSafeZone(rootPart.Position)) then
					owl.state = "Chasing"
				else
					enterRetreating()
				end
			else
				enterRetreating()
			end
		end
		return
	end

	if owl.state == "Retreating" then
		if now >= owl.retreatUntil then
			enterFlyingAway(false)
		end
		return
	end

	if owl.state == "FlyingIn" or owl.state == "FlyingAway" then
		return
	end

	-- Dawn check — fly away without feather
	if timeService and timeService:GetCurrentPhase() ~= "Night" then
		if owl.state ~= "Dormant" then
			enterFlyingAway(false)
		end
		return
	end

	if owl.state == "Perched" then
		-- Check if perch time expired with no full detection → fly away with feather
		if now >= owl.perchUntil and owl.detectionMeter < 1.0 then
			enterFlyingAway(true)
			return
		end

		-- Random wolf summon
		if not wolfSummoned and math.random() <= WOLF_SUMMON_CHANCE * 0.02 then
			summonWolves()
		end
		return
	end

	if owl.state == "Chasing" then
		if owl.target then
			local character = owl.target.Character
			local rootPart = character and character:FindFirstChild("HumanoidRootPart")
			if not rootPart or (campfireService and campfireService:IsInSafeZone(rootPart.Position)) then
				enterRetreating()
				return
			end
		else
			-- Lost target, try to find a new one
			local newTarget = findHuntableTarget(owl.rootPart.Position)
			if newTarget then
				owl.target = newTarget
				owl.pursuitStartTime = os.clock()
			else
				enterRetreating()
				return
			end
		end
	end
end

--[[
    @summary  Execute movement/behavior for the Owl's current state.
]]
local function runOwlBehavior(dt: number)
	if not owl then
		return
	end

	if owl.state == "Dormant" or owl.state == "FlyingIn" or owl.state == "FlyingAway" then
		owl.humanoid.WalkSpeed = 0
		-- Wing flap is handled by flyTo's heartbeat during flight
		return
	end

	if owl.state == "Stunned" then
		owl.humanoid.WalkSpeed = 0
		playTrack(owl, "Idle")
		updateWingFlap(owl, 0.3, dt)
		return
	end

	if owl.state == "Retreating" then
		owl.humanoid.WalkSpeed = BASE_CHASE_SPEED
		playTrack(owl, "Walk")
		-- Move away from the campfire
		local campfirePos = (worldService and worldService:GetCampfireCFrame() or CFrame.new()).Position
		local awayDir = (owl.rootPart.Position - campfirePos)
		if awayDir.Magnitude < 1 then
			awayDir = Vector3.new(1, 0, 0)
		end
		awayDir = Vector3.new(awayDir.X, 0, awayDir.Z).Unit
		owl.humanoid:MoveTo(owl.rootPart.Position + awayDir * 30)
		updateWingFlap(owl, 2, dt)
		return
	end

	if owl.state == "Perched" then
		owl.humanoid.WalkSpeed = 0
		playTrack(owl, "Idle")
		updateWingFlap(owl, 0.5, dt)
		return
	end

	if owl.state == "Chasing" and owl.target then
		local character = owl.target.Character
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		if not rootPart then
			return
		end

		local speed = computePursuitSpeed()
		owl.humanoid.WalkSpeed = speed
		playTrack(owl, "Walk")
		owl.humanoid:MoveTo(rootPart.Position)

		local dist = (owl.rootPart.Position - rootPart.Position).Magnitude
		local now = os.clock()
		if dist <= CONTACT_RANGE and (now - owl.lastContactTime) >= CONTACT_COOLDOWN then
			owl.lastContactTime = now
			local targetPlayer = owl.target :: Player?
			if targetPlayer and playerLifeService and playerLifeService:IsAlive(targetPlayer) then
				local damage = 25 + (timeService and timeService:GetCycleIndex() or 1) * 2
				playerLifeService:ApplyDamage(targetPlayer, damage, "Owl")
				broadcastToAll(OwlService.Client.OwlContact, owl.rootPart.Position)
			end
		end

		updateWingFlap(owl, 2.5, dt)
	end
end

--[[
    @summary  Heartbeat-driven tick for the Owl.
    @param    dt  number
]]
local function onHeartbeat(dt: number)
	if not owl then
		return
	end

	-- Detection meter updates every frame while perched
	if owl.state == "Perched" then
		updateDetection(dt)
	end

	local now = os.clock()
	if now >= owl.nextDecisionTime then
		owl.nextDecisionTime = now + DECISION_INTERVAL
		updateOwlState()
	end
	runOwlBehavior(dt)
end

--[[
    @summary  Check for night transition to potentially activate the Owl.
]]
local function checkNightTransition()
	if not timeService or not timeService:IsRunning() then
		return
	end

	local phase = timeService:GetCurrentPhase()
	if phase == lastPhase then
		return
	end
	lastPhase = phase

	if phase == "Night" then
		local dayNumber = timeService:GetDayNumber()
		if dayNumber >= OWL_START_DAY and not owlActiveTonight then
			-- Roll for Owl activation
			if math.random() <= OWL_SPAWN_CHANCE then
				owlActiveTonight = true
				-- Suppress the Deer for this night
				if deerService then
					deerService:SuppressDeer(true)
				end
				-- Announce and activate after a short delay
				task.delay(3, function()
					if owlActiveTonight and owl and owl.state == "Dormant" then
						broadcastToAll(OwlService.Client.OwlActive)
						enterFlyingIn()
					end
				end)
			end
		end
	elseif phase == "Day" then
		-- Reset for the next night
		if owlActiveTonight then
			owlActiveTonight = false
			if deerService then
				deerService:SuppressDeer(false)
			end
		end
	end
end

-- | Public | --

--[[
    @summary  Return the Owl to its hidden dormant state.
]]
function OwlService:ResetForRun()
	owlActiveTonight = false
	wolfSummoned = false
	lastPhase = ""
	if not owl then
		return
	end
	if owl.flyHeartbeat then
		owl.flyHeartbeat:Disconnect()
		owl.flyHeartbeat = nil
	end
	owl.state = "Dormant"
	owl.target = nil
	owl.detectionMeter = 0
	owl.pursuitStartTime = nil
	owl.rootPart.Anchored = true
	owl.humanoid.WalkSpeed = 0
	stopAllTracks(owl)
	owl.model:PivotTo(CFrame.new(DORMANT_HOLDING_POSITION))
	if deerService then
		deerService:SuppressDeer(false)
	end
end

--[[
    @summary  Interrupt the Owl's pursuit with a flashlight stun.
    @param    model   Model   -- the Owl model
    @param    player  Player  -- the player holding the flashlight
    @returns  boolean         -- true if the stun was applied
]]
function OwlService:ApplyFlashlightStun(model: Model, player: Player): boolean
	if not owl or owl.model ~= model then
		return false
	end
	if owl.state ~= "Chasing" then
		return false
	end

	local now = os.clock()
	if (now - owl.lastStunTime) >= STUN_RESISTANCE_RECOVERY_TIME then
		owl.consecutiveStuns = 0
	end
	owl.consecutiveStuns += 1
	owl.lastStunTime = now

	local duration = math.max(
		BASE_STUN_DURATION - (owl.consecutiveStuns - 1) * STUN_DECAY_PER_USE,
		MIN_STUN_DURATION
	)

	owl.state = "Stunned"
	owl.stunUntil = now + duration
	owl.humanoid.WalkSpeed = 0
	stopAllTracks(owl)
	playTrack(owl, "Idle")

	broadcastToAll(OwlService.Client.OwlStunned, owl.rootPart.Position, duration)
	return true
end

-- // INITIALIZATION // --

function OwlService:KnitStart()
	worldService = Knit.GetService("WorldService")
	timeService = Knit.GetService("TimeService")
	campfireService = Knit.GetService("CampfireService")
	spawnService = Knit.GetService("SpawnService")
	animalAIService = Knit.GetService("AnimalAIService")
	inventoryService = Knit.GetService("InventoryService")
	deerService = Knit.GetService("DeerService")
	playerLifeService = Knit.GetService("PlayerLifeService")

	task.delay(3, function()
		spawnOwl()
	end)

	RunService.Heartbeat:Connect(function(dt)
		checkNightTransition()
		onHeartbeat(dt)
	end)

end

return OwlService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="98">
          <Properties>
            <string name="Name">PlayerDataService</string>
            <string name="Source"><![CDATA[--[[
    @file    PlayerDataService.luau
    @author  manik
    @date    2025

    @summary
    Session-locked player data layer built on ProfileService.

    @description
    Wraps ProfileService to load, reconcile, and release player profiles
    with full session-locking guarantees.  Exposes read-only Knit Remote
    methods so the client can observe its own data, but all writes are
    server-authoritative.

    @exports
    - PlayerDataService:GetProfile(player)     -> Profile | nil
    - PlayerDataService:GetData(player)        -> table | nil
    - PlayerDataService:UpdateData(player, fn) -> void  (server only)
    - Knit Remote: GetData                      -> table  (client-safe copy)
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local Signal = require(ReplicatedStorage.Packages.Signal)
local ProfileService = require(ServerScriptService.ServerPackages.ProfileService)
local ProfileTemplate = require(script.Parent.Parent.Data.ProfileTemplate)
local Constants = require(ReplicatedStorage.Shared.Constants)
local RunConfig = require(ReplicatedStorage.Shared.RunConfig)

-- | Objects | --
local PlayerDataService = Knit.CreateService({
	Name = "PlayerDataService",
	Client = {},
})

PlayerDataService.ProfileLoaded = Signal.new()

-- | State Management | --
local profileStore = ProfileService.GetProfileStore(Constants.STORE_NAME, ProfileTemplate)
local profiles = {}

-- // FUNCTIONS // --

--[[
    @summary  Retrieve the live Profile object for a player.
    @param    player  Player  -- the Roblox player
    @returns  Profile | nil   -- nil if no profile is loaded
]]
function PlayerDataService:GetProfile(player: Player)
	return profiles[player]
end

--[[
    @summary  Retrieve the live data table for a loaded player profile.
    @param    player  Player  -- the Roblox player
    @returns  table | nil     -- nil if no profile is loaded
]]
function PlayerDataService:GetData(player: Player)
	local profile = profiles[player]
	if not profile then
		return nil
	end
	return profile.Data
end

--[[
    @summary  Mutate the player's data inside a transaction.
    @desc     The callback receives the Data table; mutations persist
              automatically because ProfileService writes through.
    @param    player  Player    -- the Roblox player
    @param    fn      function  -- callback(data: table) -> void
]]
function PlayerDataService:UpdateData(player: Player, fn: (data: { [string]: any }) -> ())
	local profile = profiles[player]
	if not profile then
		return
	end
	fn(profile.Data)
end

--[[
    @summary  Apply one completed run to lifetime records exactly once.
    @param    player   Player
    @param    runId    string
    @param    result   table  -- validated final run values
    @returns  boolean, string
]]
function PlayerDataService:ApplyRunRecords(player: Player, runId: string, result: { [string]: any }): (boolean, string)
	if runId == "" or typeof(result) ~= "table" then
		return false, "INVALID_RESULT"
	end

	local profile = profiles[player]
	if not profile then
		return false, "PROFILE_NOT_LOADED"
	end

	local data = profile.Data
	data.Internal = data.Internal or { LastAppliedRunId = "" }
	if data.Internal.LastAppliedRunId == runId then
		return true, "ALREADY_APPLIED"
	end

	data.Records = data.Records or {}
	local records = data.Records
	local displayedDay = math.max(0, math.floor(tonumber(result.displayedDay) or 0))
	local elapsedSeconds = math.max(0, tonumber(result.elapsedSeconds) or 0)

	records.HighestDay = math.max(records.HighestDay or 0, displayedDay)
	if result.victory == true then
		records.Wins = (records.Wins or 0) + 1
		if elapsedSeconds > 0 and ((records.FastestDay67Seconds or 0) <= 0 or elapsedSeconds < records.FastestDay67Seconds) then
			records.FastestDay67Seconds = elapsedSeconds
		end
	end

	local additiveKeys = {
		childrenRescued = "ChildrenRescued",
		treesChopped = "TreesChopped",
		wolvesKilled = "WolvesKilled",
		cultistsKilled = "CultistsKilled",
		revives = "Revives",
		deaths = "Deaths",
	}
	for resultKey, recordKey in pairs(additiveKeys) do
		local amount = math.max(0, math.floor(tonumber(result[resultKey]) or 0))
		records[recordKey] = (records[recordKey] or 0) + amount
	end
	records.TotalPlaytime = (records.TotalPlaytime or 0) + elapsedSeconds

	data.Internal.LastAppliedRunId = runId
	return true, "APPLIED"
end

--[[
    @summary  Bring a legacy profile up to the current schema version.
    @desc     Older saves stored run progress and inflated test health.
              Those tables are discarded so a returning player cannot
              start a fresh run with a finished camp or 300 health.
    @param    data  table  -- the reconciled profile data
]]
local function migrateProfile(data: { [string]: any })
	if (data.DataVersion or 1) >= 2 then
		return
	end

	local legacyStats = data.Stats or {}
	data.Records = data.Records or {}
	data.Records.TreesChopped = (data.Records.TreesChopped or 0) + (legacyStats.TreesChopped or 0)
	data.Records.WolvesKilled = (data.Records.WolvesKilled or 0) + (legacyStats.WolvesKilled or 0)
	data.Records.TotalPlaytime = (data.Records.TotalPlaytime or 0) + (legacyStats.TotalPlaytime or 0)

	local legacySurvival = data.Survival or {}
	data.Records.HighestDay = math.max(data.Records.HighestDay or 0, legacySurvival.HighestNightSurvived or 0)
	data.Records.Deaths = (data.Records.Deaths or 0) + (legacySurvival.DeathCount or 0)

	data.Survival = {
		Health = RunConfig.StartingHealth,
		MaxHealth = RunConfig.StartingHealth,
		Hunger = RunConfig.StartingHunger,
		MaxHunger = RunConfig.StartingHunger,
		DeathCount = 0,
		HighestNightSurvived = 0,
	}

	data.Resources = nil
	data.Base = nil
	data.Rescue = nil
	data.Stats = nil
	data.Campfire = nil
	data.Inventory = nil

	data.DataVersion = 2
end

--[[
    @summary  Load a profile for a player with session-locking.
    @desc     Called on PlayerAdded.  If the profile cannot be loaded
              within AUTO_LOAD_TIMEOUT seconds, the player is kicked.
    @param    player  Player  -- the Roblox player
]]
local function loadProfile(player: Player)
	local profile = profileStore:LoadProfileAsync(tostring(player.UserId), function(placeId, gameJobId)
		if player.Parent then
			player:Kick("Profile released by another server.")
		end
	end)

	if profile then
		migrateProfile(profile.Data)
		profile:Reconcile()
		-- Reset vital stats to max on each join so players don't spawn starving
		profile.Data.Survival.MaxHealth = RunConfig.StartingHealth
		profile.Data.Survival.MaxHunger = RunConfig.StartingHunger
		profile.Data.Survival.Hunger = profile.Data.Survival.MaxHunger
		profile.Data.Survival.Health = profile.Data.Survival.MaxHealth
		profile:ListenToRelease(function()
			profiles[player] = nil
			if player.Parent then
				player:Kick("Profile released by another server.")
			end
		end)

		if player.Parent then
			profiles[player] = profile
			PlayerDataService.ProfileLoaded:Fire(player)
		else
			profile:Release()
		end
	elseif player.Parent then
		player:Kick("Failed to load profile. Please rejoin.")
	end
end

--[[
    @summary  Release the profile for a departing player.
    @param    player  Player  -- the Roblox player
]]
local function releaseProfile(player: Player)
	local profile = profiles[player]
	if profile then
		profile:Release()
	end
	profiles[player] = nil
end

--[[
    @summary  Client-facing remote returning a copy of the caller's data.
    @param    player  Player  -- injected by Knit
    @returns  table | nil
]]
function PlayerDataService.Client:GetData(player: Player)
	local profile = profiles[player]
	if not profile then
		return nil
	end
	return table.clone(profile.Data)
end

-- // INITIALIZATION // --

Players.PlayerAdded:Connect(function(player)
	task.spawn(loadProfile, player)
end)

Players.PlayerRemoving:Connect(function(player)
	releaseProfile(player)
end)

for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(loadProfile, player)
end

game:BindToClose(function()
	for player, profile in pairs(profiles) do
		profile:Release()
		profiles[player] = nil
	end
end)

return PlayerDataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="99">
          <Properties>
            <string name="Name">PlayerLifeService</string>
            <string name="Source"><![CDATA[--[[
    @file    PlayerLifeService.luau
    @author  manik
    @date    2025

    @summary
    Server-authoritative player damage, downing, teammate revive,
    bleed-out elimination, controlled character loading, and team loss.

    @exports
    - PlayerLifeService:ApplyDamage(player, amount, source) -> table
    - PlayerLifeService:GetLifeState(player) -> string
    - PlayerLifeService:IsAlive(player) -> boolean
    - Knit Signal: LifeStateChanged(userId, state, payload)
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local Signal = require(ReplicatedStorage.Packages.Signal)
local RunConfig = require(ReplicatedStorage.Shared.RunConfig)

-- | Objects | --
local PlayerLifeService = Knit.CreateService({
	Name = "PlayerLifeService",
	Client = {
		LifeStateChanged = Knit.CreateSignal(),
		TeammateDowned = Knit.CreateSignal(),
		ReviveCompleted = Knit.CreateSignal(),
	},
})

PlayerLifeService.PlayerDowned = Signal.new()
PlayerLifeService.PlayerRevived = Signal.new()
PlayerLifeService.PlayerEliminated = Signal.new()

export type LifeState = "Lobby" | "Alive" | "Downed" | "Eliminated"

-- | State Management | --
local runStateService: any = nil
local inventoryService: any = nil
local spawnService: any = nil

local lifeStates: { [Player]: LifeState } = {}
local downTokens: { [Player]: string } = {}
local savedMovement: { [Player]: { walkSpeed: number, jumpPower: number, autoRotate: boolean } } = {}
local graceUntil: { [Player]: number } = {}
local loadingCharacters: { [Player]: boolean } = {}

-- // FUNCTIONS // --

-- | Private | --

--[[
    @summary  Broadcast one player's life-state change to all run members.
    @param    player   Player
    @param    state    LifeState
    @param    payload  table?
]]
local function broadcastState(player: Player, state: LifeState, payload: { [string]: any }?)
	local data = payload or {}
	data.userId = player.UserId
	data.state = state
	for _, member in ipairs(Players:GetPlayers()) do
		PlayerLifeService.Client.LifeStateChanged:Fire(member, data)
	end
end

--[[
    @summary  Load one player's character without overlapping load calls.
    @param    player  Player
    @returns  boolean
]]
local function loadCharacter(player: Player): boolean
	if loadingCharacters[player] or not player.Parent then
		return false
	end
	loadingCharacters[player] = true
	local ok, err = pcall(function()
		player:LoadCharacterAsync()
	end)
	loadingCharacters[player] = nil
	if not ok then
		warn("[PlayerLifeService] Character load failed for", player.Name, err)
	end
	return ok
end

--[[
    @summary  Configure a newly loaded character for managed life states.
    @param    player     Player
    @param    character  Model
]]
local function configureCharacter(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid or not humanoid:IsA("Humanoid") then
		return
	end
	humanoid.BreakJointsOnDeath = false
	humanoid.MaxHealth = RunConfig.StartingHealth
	humanoid.Health = RunConfig.StartingHealth
	character:SetAttribute("LifeState", lifeStates[player] or "Lobby")
end

--[[
    @summary  Return whether at least one run member can still act.
    @returns  boolean
]]
local function hasLivingMember(): boolean
	if not runStateService then
		return true
	end
	for _, member in ipairs(runStateService:GetMembers()) do
		if lifeStates[member] == "Alive" then
			return true
		end
	end
	return false
end

--[[
    @summary  End the run when nobody remains capable of reviving.
]]
local function checkTeamLoss()
	if runStateService and runStateService:IsActive() and not hasLivingMember() then
		runStateService:BeginEnding("ALL_PLAYERS_LOST", {
			displayedDay = Knit.GetService("TimeService"):GetDisplayedDay(),
			cycleIndex = Knit.GetService("TimeService"):GetCycleIndex(),
		})
	end
end

--[[
    @summary  Remove movement and attach the teammate revive prompt.
    @param    player  Player
]]
local function applyDownedPresentation(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not character or not humanoid or not rootPart or not rootPart:IsA("BasePart") then
		return
	end

	savedMovement[player] = {
		walkSpeed = humanoid.WalkSpeed,
		jumpPower = humanoid.JumpPower,
		autoRotate = humanoid.AutoRotate,
	}
	humanoid.WalkSpeed = 0
	humanoid.JumpPower = 0
	humanoid.AutoRotate = false
	humanoid.Health = math.max(1, humanoid.Health)
	character:SetAttribute("LifeState", "Downed")

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "RevivePrompt"
	prompt.ActionText = "Revive with Bandage"
	prompt.ObjectText = player.DisplayName
	prompt.MaxActivationDistance = RunConfig.ReviveRange
	prompt.HoldDuration = RunConfig.ReviveHoldDuration
	prompt.RequiresLineOfSight = true
	prompt.Parent = rootPart
	prompt.Triggered:Connect(function(reviver)
		PlayerLifeService:TryRevive(reviver, player)
	end)
end

--[[
    @summary  Restore movement after a successful revive.
    @param    player  Player
]]
local function clearDownedPresentation(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local prompt = character and character:FindFirstChild("RevivePrompt", true)
	if prompt then
		prompt:Destroy()
	end
	if humanoid then
		local movement = savedMovement[player]
		humanoid.WalkSpeed = if movement then movement.walkSpeed else 16
		humanoid.JumpPower = if movement then movement.jumpPower else 50
		humanoid.AutoRotate = if movement then movement.autoRotate else true
	end
	if character then
		character:SetAttribute("LifeState", lifeStates[player] or "Alive")
	end
	savedMovement[player] = nil
end

--[[
    @summary  Finish a downed player's bleed-out and enter spectating.
    @param    player  Player
    @param    token   string
]]
local function eliminateAfterBleedout(player: Player, token: string)
	task.wait(RunConfig.DownedDuration)
	if not player.Parent or downTokens[player] ~= token or lifeStates[player] ~= "Downed" then
		return
	end
	if not runStateService:IsActive() then
		return
	end

	downTokens[player] = nil
	lifeStates[player] = "Eliminated"
	clearDownedPresentation(player)
	local character = player.Character
	if character then
		character:SetAttribute("LifeState", "Eliminated")
		local rootPart = character:FindFirstChild("HumanoidRootPart")
		if rootPart and rootPart:IsA("BasePart") then
			rootPart.Anchored = true
			rootPart.CFrame = CFrame.new(0, -350, 0)
		end
	end

	PlayerLifeService.PlayerEliminated:Fire(player)
	broadcastState(player, "Eliminated", {})
	checkTeamLoss()
end

--[[
    @summary  Enter the downed state and start the server bleed-out timer.
    @param    player  Player
    @param    source  string
]]
local function downPlayer(player: Player, source: string)
	if lifeStates[player] ~= "Alive" then
		return
	end
	lifeStates[player] = "Downed"
	local token = game:GetService("HttpService"):GenerateGUID(false)
	downTokens[player] = token
	applyDownedPresentation(player)
	runStateService:IncrementStat(player, "Downs", 1)

	local payload = {
		source = source,
		bleedOutAt = workspace:GetServerTimeNow() + RunConfig.DownedDuration,
	}
	broadcastState(player, "Downed", payload)
	for _, member in ipairs(runStateService:GetMembers()) do
		if member ~= player then
			PlayerLifeService.Client.TeammateDowned:Fire(member, player.UserId, payload.bleedOutAt)
		end
	end
	PlayerLifeService.PlayerDowned:Fire(player, source)
	task.spawn(eliminateAfterBleedout, player, token)
	checkTeamLoss()
end

-- | Public | --

--[[
    @summary  Return a player's authoritative life state.
    @param    player  Player
    @returns  LifeState
]]
function PlayerLifeService:GetLifeState(player: Player): LifeState
	return lifeStates[player] or "Lobby"
end

--[[
    @summary  Return whether a player may perform gameplay actions.
    @param    player  Player
    @returns  boolean
]]
function PlayerLifeService:IsAlive(player: Player): boolean
	return lifeStates[player] == "Alive"
end

--[[
    @summary  Apply validated damage and resolve lethal damage as a down.
    @param    player  Player
    @param    amount  number
    @param    source  string?
    @returns  table
]]
function PlayerLifeService:ApplyDamage(player: Player, amount: number, source: string?): { [string]: any }
	if typeof(amount) ~= "number" or amount <= 0 or amount ~= amount then
		return { applied = 0, downed = false }
	end
	if lifeStates[player] ~= "Alive" or os.clock() < (graceUntil[player] or 0) then
		return { applied = 0, downed = false }
	end
	if not runStateService:IsActive() or not runStateService:IsMember(player) then
		return { applied = 0, downed = false }
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return { applied = 0, downed = false }
	end

	local applied = math.min(amount, humanoid.Health)
	if amount >= humanoid.Health then
		humanoid.Health = 1
		downPlayer(player, source or "Unknown")
		return { applied = applied, downed = true }
	end

	humanoid.Health -= amount
	return { applied = applied, downed = false }
end

--[[
    @summary  Revive a nearby downed teammate using one Bandage.
    @param    reviver  Player
    @param    target   Player
    @returns  boolean
]]
function PlayerLifeService:TryRevive(reviver: Player, target: Player): boolean
	if reviver == target or lifeStates[reviver] ~= "Alive" or lifeStates[target] ~= "Downed" then
		return false
	end
	if not runStateService:IsActive() or not runStateService:IsMember(reviver) or not runStateService:IsMember(target) then
		return false
	end
	local reviverRoot = reviver.Character and reviver.Character:FindFirstChild("HumanoidRootPart")
	local targetRoot = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
	if not reviverRoot or not targetRoot or not reviverRoot:IsA("BasePart") or not targetRoot:IsA("BasePart") then
		return false
	end
	if (reviverRoot.Position - targetRoot.Position).Magnitude > RunConfig.ReviveRange then
		return false
	end
	if not inventoryService:ConsumeResource(reviver, "Bandage", 1) then
		return false
	end

	downTokens[target] = nil
	lifeStates[target] = "Alive"
	graceUntil[target] = os.clock() + RunConfig.ReviveGracePeriod
	local humanoid = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.Health = math.clamp(RunConfig.ReviveHealth, 1, humanoid.MaxHealth)
	end
	clearDownedPresentation(target)
	runStateService:IncrementStat(reviver, "Revives", 1)
	PlayerLifeService.PlayerRevived:Fire(reviver, target)
	broadcastState(target, "Alive", { health = RunConfig.ReviveHealth, reviverUserId = reviver.UserId })
	for _, member in ipairs(runStateService:GetMembers()) do
		PlayerLifeService.Client.ReviveCompleted:Fire(member, target.UserId, reviver.UserId)
	end
	return true
end

--[[
    @summary  Return a client-safe snapshot of all run life states.
    @param    player  Player  -- injected by Knit
    @returns  table
]]
function PlayerLifeService.Client:GetSnapshot(player: Player): { [string]: any }
	local states = {}
	for member, state in pairs(lifeStates) do
		if member.Parent then
			states[tostring(member.UserId)] = state
		end
	end
	return { selfState = lifeStates[player] or "Lobby", states = states }
end

-- // INITIALIZATION // --

Players.CharacterAutoLoads = false

function PlayerLifeService:KnitStart()
	runStateService = Knit.GetService("RunStateService")
	inventoryService = Knit.GetService("InventoryService")
	spawnService = Knit.GetService("SpawnService")

	local function onPlayerAdded(player: Player)
		lifeStates[player] = "Lobby"
		player.CharacterAdded:Connect(function(character)
			configureCharacter(player, character)
		end)
		if not player.Character then
			task.spawn(loadCharacter, player)
		end
	end

	for _, player in ipairs(Players:GetPlayers()) do
		onPlayerAdded(player)
	end
	Players.PlayerAdded:Connect(onPlayerAdded)

	runStateService.RunStarted:Connect(function()
		for _, player in ipairs(runStateService:GetMembers()) do
			lifeStates[player] = "Alive"
			if player.Character then
				configureCharacter(player, player.Character)
				player.Character:SetAttribute("LifeState", "Alive")
			end
			broadcastState(player, "Alive", {})
		end
	end)

	runStateService.RunCleaned:Connect(function()
		for _, player in ipairs(Players:GetPlayers()) do
			lifeStates[player] = "Lobby"
			downTokens[player] = nil
			graceUntil[player] = nil
			clearDownedPresentation(player)
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid.Health = humanoid.MaxHealth
				humanoid.WalkSpeed = 16
				humanoid.JumpPower = 50
				humanoid.AutoRotate = true
			end
			if character then
				character:SetAttribute("LifeState", "Lobby")
			end
			local backpack = player:FindFirstChild("Backpack")
			if backpack then
				backpack:ClearAllChildren()
			end
			local starterGear = player:FindFirstChild("StarterGear")
			if starterGear then
				starterGear:ClearAllChildren()
			end
			spawnService:ReturnToLobby(player)
			broadcastState(player, "Lobby", {})
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		lifeStates[player] = nil
		downTokens[player] = nil
		graceUntil[player] = nil
		savedMovement[player] = nil
		loadingCharacters[player] = nil
	end)
end

return PlayerLifeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="100">
          <Properties>
            <string name="Name">RescueService</string>
            <string name="Source"><![CDATA[--[[
    @file    RescueService.luau
    @author  manik
    @date    2025

    @summary
    Four campfire-gated caves, guard packs, keys, gates, child carrying,
    safe-zone rescue completion, tents, poster targeting, and multiplier.

    @exports
    - RescueService:GetRescuedCount() -> number
    - RescueService:DropCarriedChild(player)
    - Knit Remote: RequestDropChild()
    - Knit Remote: RequestBoardTarget()
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local RescueConfig = require(ReplicatedStorage.Shared.RescueConfig)

-- | Objects | --
local RescueService = Knit.CreateService({
	Name = "RescueService",
	Client = {
		RescueChanged = Knit.CreateSignal(),
		WaypointChanged = Knit.CreateSignal(),
		ChildCarryChanged = Knit.CreateSignal(),
		CaveUnlocked = Knit.CreateSignal(),
	},
})

-- | Configuration | --
local CAVE_OFFSETS = {
	Dino = Vector3.new(180, 0, 40),
	Kraken = Vector3.new(-220, 0, -35),
	Squid = Vector3.new(55, 0, 270),
	Koala = Vector3.new(-70, 0, -320),
}
local TENT_COLORS = {
	Color3.fromRGB(185, 55, 50),
	Color3.fromRGB(55, 115, 195),
	Color3.fromRGB(225, 190, 55),
	Color3.fromRGB(135, 75, 160),
}
local PICKUP_RANGE = 10
local DROP_COOLDOWN = 0.35
local CARRY_WALK_SPEED = 10
local RESCUE_CHECK_INTERVAL = 0.2

-- | State Management | --
local runStateService: any = nil
local worldService: any = nil
local campfireService: any = nil
local animalAIService: any = nil
local playerLifeService: any = nil
local timeService: any = nil

local caveRecords: { [string]: any } = {}
local carriedBy: { [Player]: string } = {}
local keyOwners: { [Player]: { [string]: boolean } } = {}
local dropCooldowns: { [Player]: number } = {}
local rescuedCount = 0
local rescueOrder = 0
local rescueCheckTimer = 0
local cavesFolder: Folder? = nil
local tentsFolder: Folder? = nil
local posterBoard: Part? = nil
local heartbeatConnection: RBXScriptConnection? = nil

-- // FUNCTIONS // --

-- | Private | --

--[[
    @summary  Broadcast one rescue-state delta to all run members.
    @param    signal   table
    @param    payload  table
]]
local function broadcast(signal, payload)
	for _, player in ipairs(runStateService:GetMembers()) do
		signal:Fire(player, payload)
	end
end

--[[
    @summary  Return ground beneath a desired cave or tent position.
    @param    position  Vector3
    @returns  Vector3
]]
local function groundPosition(position: Vector3): Vector3
	local baseMap = worldService and worldService:GetBaseMap()
	if not baseMap then
		return position
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { baseMap }
	local result = workspace:Raycast(position + Vector3.new(0, 120, 0), Vector3.new(0, -240, 0), params)
	return if result then result.Position else position
end

--[[
    @summary  Create one anchored cave enclosure and gate.
    @param    definition  table
    @param    center      Vector3
    @returns  Model, Part
]]
local function createCaveModel(definition, center: Vector3): (Model, Part)
	local cave = Instance.new("Model")
	cave.Name = definition.Id .. "Cave"
	cave:SetAttribute("CaveId", definition.Id)
	cave:SetAttribute("RequiredCampfireLevel", definition.RequiredCampfireLevel)
	cave:SetAttribute("State", "Locked")

	local floor = Instance.new("Part")
	floor.Name = "Floor"
	floor.Size = Vector3.new(34, 1, 32)
	floor.Position = center + Vector3.new(0, 0.5, 0)
	floor.Anchored = true
	floor.Material = Enum.Material.Slate
	floor.Color = Color3.fromRGB(62, 58, 55)
	floor.Parent = cave
	cave.PrimaryPart = floor

	local wallData = {
		{ Vector3.new(34, 12, 2), Vector3.new(0, 6, -15) },
		{ Vector3.new(12, 12, 2), Vector3.new(-11, 6, 15) },
		{ Vector3.new(12, 12, 2), Vector3.new(11, 6, 15) },
		{ Vector3.new(2, 12, 30), Vector3.new(-16, 6, 0) },
		{ Vector3.new(2, 12, 30), Vector3.new(16, 6, 0) },
	}
	for index, entry in ipairs(wallData) do
		local wall = Instance.new("Part")
		wall.Name = "CaveWall" .. index
		wall.Size = entry[1]
		wall.Position = center + entry[2]
		wall.Anchored = true
		wall.Material = Enum.Material.Rock
		wall.Color = Color3.fromRGB(55, 52, 50)
		wall.Parent = cave
	end

	local gate = Instance.new("Part")
	gate.Name = "Gate"
	gate.Size = Vector3.new(10, 10, 1)
	gate.Position = center + Vector3.new(0, 5, 14)
	gate.Anchored = true
	gate.Material = Enum.Material.Metal
	gate.Color = definition.CaveColor
	gate:SetAttribute("CaveId", definition.Id)
	gate:SetAttribute("Locked", true)
	gate.Parent = cave

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "UnlockGatePrompt"
	prompt.ActionText = "Unlock"
	prompt.ObjectText = definition.KeyName .. " Gate"
	prompt.MaxActivationDistance = PICKUP_RANGE
	prompt.Enabled = false
	prompt.Parent = gate
	prompt.Triggered:Connect(function(player)
		RescueService:TryUnlockGate(player, definition.Id)
	end)

	return cave, gate
end

--[[
    @summary  Apply a distinct visual variant to a duplicated child rig.
    @param    model       Model
    @param    definition  table
]]
local function styleChildVariant(model: Model, definition)
	if not definition.Variant then
		return
	end
	local bodyColor = if definition.Variant == "Squid" then Color3.fromRGB(225, 190, 70) else Color3.fromRGB(85, 80, 90)
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") and descendant.Name ~= "HumanoidRootPart" then
			descendant.Color = descendant.Color:Lerp(bodyColor, 0.35)
		end
	end
	local head = model:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then
		return
	end
	local hat = Instance.new("Part")
	hat.Name = definition.Variant .. "Hat"
	hat.Shape = Enum.PartType.Ball
	hat.Size = if definition.Variant == "Squid" then Vector3.new(2.2, 1.3, 2.2) else Vector3.new(2.3, 1.1, 2.1)
	hat.Color = definition.CaveColor
	hat.Material = Enum.Material.SmoothPlastic
	hat.CanCollide = false
	hat.Massless = true
	hat.CFrame = head.CFrame * CFrame.new(0, 1, 0)
	hat.Parent = model
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = head
	weld.Part1 = hat
	weld.Parent = hat
end

--[[
    @summary  Clone and prepare one child inside its cave.
    @param    definition  table
    @param    center      Vector3
    @returns  Model?
]]
local function createChild(definition, center: Vector3): Model?
	local npcAssets = ServerStorage.Assets:FindFirstChild("Assets Npcs")
	local source = npcAssets and npcAssets:FindFirstChild(definition.RigTemplate)
	if not source or not source:IsA("Model") then
		warn("[RescueService] Missing child rig", definition.RigTemplate)
		return nil
	end
	local child = source:Clone()
	child.Name = definition.DisplayName
	child:SetAttribute("ChildId", definition.Id)
	child:SetAttribute("RescueState", "Locked")
	for _, descendant in ipairs(child:GetDescendants()) do
		if descendant:IsA("BaseScript") or descendant:IsA("ModuleScript") then
			descendant:Destroy()
		elseif descendant:IsA("BasePart") then
			descendant.CanCollide = false
		end
	end
	styleChildVariant(child, definition)
	child.Parent = cavesFolder
	child:PivotTo(CFrame.new(center + Vector3.new(0, 3, -7)))
	local rootPart = child:FindFirstChild("HumanoidRootPart")
	if rootPart and rootPart:IsA("BasePart") then
		rootPart.Anchored = true
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "RescueChildPrompt"
		prompt.ActionText = "Carry Child"
		prompt.ObjectText = definition.DisplayName
		prompt.MaxActivationDistance = PICKUP_RANGE
		prompt.Enabled = false
		prompt.Parent = rootPart
		prompt.Triggered:Connect(function(player)
			RescueService:TryCarryChild(player, definition.Id)
		end)
	end
	return child
end

--[[
    @summary  Build all four cave records for a fresh run.
]]
local function buildCaves()
	caveRecords = {}
	carriedBy = {}
	keyOwners = {}
	rescuedCount = 0
	rescueOrder = 0
	rescueCheckTimer = 0

	cavesFolder = Instance.new("Folder")
	cavesFolder.Name = "Caves"
	cavesFolder.Parent = runStateService:GetRuntimeFolder()
	tentsFolder = Instance.new("Folder")
	tentsFolder.Name = "RescueTents"
	tentsFolder.Parent = runStateService:GetRuntimeFolder()

	local campfireCFrame = worldService:GetCampfireCFrame()
	if not campfireCFrame then
		return
	end
	for rescueId, definition in pairs(RescueConfig) do
		local center = groundPosition(campfireCFrame.Position + CAVE_OFFSETS[rescueId])
		local cave, gate = createCaveModel(definition, center)
		cave.Parent = cavesFolder
		local child = createChild(definition, center)
		caveRecords[rescueId] = {
			definition = definition,
			model = cave,
			gate = gate,
			child = child,
			center = center,
			state = "Locked",
			guards = {},
			keyModel = nil,
			carrier = nil,
			carryWeld = nil,
			originalWalkSpeed = nil,
		}
	end
end

--[[
    @summary  Spawn one cave's configured guard pack.
    @param    record  table
]]
local function spawnGuards(record)
	for index = 1, record.definition.GuardCount do
		local angle = index / record.definition.GuardCount * math.pi * 2
		local position = record.center + Vector3.new(math.cos(angle) * 24, 4, math.sin(angle) * 24)
		local guard = animalAIService:SpawnNpc(record.definition.GuardSpecies, CFrame.new(position))
		if guard then
			guard:SetAttribute("GuardCaveId", record.definition.Id)
			guard:SetAttribute("GuardIndex", index)
			guard:SetAttribute("GuardIcon", record.definition.Id)
			record.guards[guard] = true
		end
	end
end

--[[
    @summary  Activate all caves reached by the current campfire level.
    @param    campfireLevel  number
]]
local function unlockForLevel(campfireLevel: number)
	for rescueId, record in pairs(caveRecords) do
		if record.state == "Locked" and campfireLevel >= record.definition.RequiredCampfireLevel then
			record.state = "Available"
			record.model:SetAttribute("State", "Available")
			spawnGuards(record)
			broadcast(RescueService.Client.CaveUnlocked, {
				rescueId = rescueId,
				displayName = record.definition.DisplayName,
				position = record.center,
				requiredCampfireLevel = record.definition.RequiredCampfireLevel,
			})
		end
	end
end

--[[
    @summary  Spawn the matching key after a cave guard pack is cleared.
    @param    record  table
]]
local function spawnKey(record)
	if record.keyModel or (record.state ~= "Available" and record.state ~= "KeyDropped") then
		return
	end
	record.state = "KeyDropped"
	local key = Instance.new("Model")
	key.Name = record.definition.KeyName
	key:SetAttribute("CaveId", record.definition.Id)
	key:SetAttribute("RunId", runStateService:GetRunId())
	local part = Instance.new("Part")
	part.Name = "Key"
	part.Size = Vector3.new(0.5, 0.5, 2.3)
	part.Color = record.definition.CaveColor
	part.Material = Enum.Material.Neon
	part.Anchored = true
	part.CanCollide = false
	part.Parent = key
	key.PrimaryPart = part
	key.Parent = cavesFolder
	key:PivotTo(CFrame.new(record.center + Vector3.new(0, 2, 8)))
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Take Key"
	prompt.ObjectText = record.definition.KeyName
	prompt.MaxActivationDistance = PICKUP_RANGE
	prompt.Parent = part
	prompt.Triggered:Connect(function(player)
		RescueService:TryPickupKey(player, record.definition.Id)
	end)
	record.keyModel = key
	local gatePrompt = record.gate:FindFirstChildWhichIsA("ProximityPrompt")
	if gatePrompt then
		gatePrompt.Enabled = true
	end
end

--[[
    @summary  Remove one guard from its cave and resolve pack completion.
    @param    model  Model
]]
local function onNpcDied(model: Model)
	local caveId = model:GetAttribute("GuardCaveId")
	local record = typeof(caveId) == "string" and caveRecords[caveId] or nil
	if not record or not record.guards[model] then
		return
	end
	record.guards[model] = nil
	for guard in pairs(record.guards) do
		if guard.Parent then
			return
		end
		record.guards[guard] = nil
	end
	spawnKey(record)
end

--[[
    @summary  Create the camp poster board and interaction prompt.
]]
local function createPosterBoard()
	if posterBoard then
		posterBoard:Destroy()
	end
	local campfireCFrame = worldService:GetCampfireCFrame()
	if not campfireCFrame then
		return
	end
	posterBoard = Instance.new("Part")
	posterBoard.Name = "MissingChildrenBoard"
	posterBoard.Size = Vector3.new(10, 7, 0.8)
	posterBoard.Anchored = true
	posterBoard.Material = Enum.Material.WoodPlanks
	posterBoard.Color = Color3.fromRGB(100, 67, 42)
	posterBoard.CFrame = campfireCFrame * CFrame.new(-13, 4, 0) * CFrame.Angles(0, math.rad(90), 0)
	posterBoard.Parent = runStateService:GetRuntimeFolder()
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Track Child"
	prompt.ObjectText = "Missing Children"
	prompt.MaxActivationDistance = PICKUP_RANGE
	prompt.Parent = posterBoard
	prompt.Triggered:Connect(function(player)
		RescueService:SelectBoardTarget(player)
	end)
end

--[[
    @summary  Build a colored tent and settle a rescued child at camp.
    @param    record  table
]]
local function settleAtCamp(record)
	rescueOrder += 1
	local color = TENT_COLORS[math.clamp(rescueOrder, 1, #TENT_COLORS)]
	local campfireCFrame = worldService:GetCampfireCFrame()
	local angle = rescueOrder / 4 * math.pi * 2
	local campPosition = groundPosition(campfireCFrame.Position + Vector3.new(math.cos(angle) * 24, 0, math.sin(angle) * 24))

	local tent = Instance.new("Model")
	tent.Name = record.definition.Id .. "Tent"
	local floor = Instance.new("Part")
	floor.Name = "TentFloor"
	floor.Size = Vector3.new(8, 0.5, 6)
	floor.Position = campPosition + Vector3.new(0, 0.25, 0)
	floor.Anchored = true
	floor.Material = Enum.Material.Fabric
	floor.Color = color
	floor.Parent = tent
	tent.PrimaryPart = floor
	local roof = Instance.new("WedgePart")
	roof.Name = "TentRoof"
	roof.Size = Vector3.new(8, 4, 6)
	roof.Position = campPosition + Vector3.new(0, 2.25, 0)
	roof.Anchored = true
	roof.CanCollide = false
	roof.Material = Enum.Material.Fabric
	roof.Color = color
	roof.Parent = tent
	tent:SetAttribute("ChildId", record.definition.Id)
	tent:SetAttribute("RescueOrder", rescueOrder)
	tent.Parent = tentsFolder

	local child = record.child
	if child then
		local rootPart = child:FindFirstChild("HumanoidRootPart")
		if rootPart and rootPart:IsA("BasePart") then
			rootPart.Anchored = true
		end
		child:PivotTo(CFrame.new(campPosition + Vector3.new(0, 3, -5)))
		child:SetAttribute("RescueState", "Rescued")
	end
end

--[[
    @summary  Complete one carried child's rescue in the lit safe zone.
    @param    player  Player
    @param    record  table
]]
local function completeRescue(player: Player, record)
	if record.state ~= "Carried" or record.carrier ~= player then
		return
	end
	if record.carryWeld then
		record.carryWeld:Destroy()
		record.carryWeld = nil
	end
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid and record.originalWalkSpeed then
		humanoid.WalkSpeed = record.originalWalkSpeed
	end
	if player.Character then
		player.Character:SetAttribute("CarryingChild", nil)
	end
	carriedBy[player] = nil
	record.carrier = nil
	record.state = "Rescued"
	rescuedCount += 1
	settleAtCamp(record)
	runStateService:AddMultiplierSource("Child:" .. record.definition.Id, 1)
	runStateService:IncrementStat(player, "ChildrenRescued", 1)
	broadcast(RescueService.Client.ChildCarryChanged, { userId = player.UserId, childId = record.definition.Id, carrying = false })
	broadcast(RescueService.Client.RescueChanged, {
		childId = record.definition.Id,
		displayName = record.definition.DisplayName,
		rescuedCount = rescuedCount,
		rescueOrder = rescueOrder,
		multiplier = runStateService:GetMultiplier(),
	})
end

--[[
    @summary  Check carried children for arrival inside the lit safe zone.
    @param    dt  number
]]
local function onHeartbeat(dt: number)
	rescueCheckTimer += dt
	if rescueCheckTimer < RESCUE_CHECK_INTERVAL then
		return
	end
	rescueCheckTimer = 0
	if not runStateService:IsActive() or not campfireService:IsLit() then
		return
	end
	for player, childId in pairs(carriedBy) do
		local rootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local record = caveRecords[childId]
		if rootPart and rootPart:IsA("BasePart") and record and campfireService:IsInSafeZone(rootPart.Position) then
			completeRescue(player, record)
		end
	end
end

-- | Public | --

--[[
    @summary  Return how many children have reached camp this run.
    @returns  number
]]
function RescueService:GetRescuedCount(): number
	return rescuedCount
end

--[[
    @summary  Give a matching cleared-cave key to a nearby player.
    @param    player   Player
    @param    caveId   string
    @returns  boolean
]]
function RescueService:TryPickupKey(player: Player, caveId: string): boolean
	local record = caveRecords[caveId]
	if not record or record.state ~= "KeyDropped" or not record.keyModel then
		return false
	end
	if not playerLifeService:IsAlive(player) or not runStateService:IsMember(player) then
		return false
	end
	local rootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not rootPart or not rootPart:IsA("BasePart") or (rootPart.Position - record.keyModel:GetPivot().Position).Magnitude > PICKUP_RANGE then
		return false
	end
	keyOwners[player] = keyOwners[player] or {}
	keyOwners[player][caveId] = true
	record.keyModel:Destroy()
	record.keyModel = nil
	return true
end

--[[
    @summary  Open a cleared cave using its matching carried key.
    @param    player  Player
    @param    caveId  string
    @returns  boolean
]]
function RescueService:TryUnlockGate(player: Player, caveId: string): boolean
	local record = caveRecords[caveId]
	if not record or record.state ~= "KeyDropped" or not keyOwners[player] or not keyOwners[player][caveId] then
		return false
	end
	local rootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not rootPart or not rootPart:IsA("BasePart") or (rootPart.Position - record.gate.Position).Magnitude > PICKUP_RANGE then
		return false
	end
	keyOwners[player][caveId] = nil
	record.state = "Unlocked"
	record.gate:SetAttribute("Locked", false)
	record.gate.CanCollide = false
	record.gate.Transparency = 0.7
	local gatePrompt = record.gate:FindFirstChildWhichIsA("ProximityPrompt")
	if gatePrompt then
		gatePrompt.Enabled = false
	end
	local childPrompt = record.child and record.child:FindFirstChild("RescueChildPrompt", true)
	if childPrompt then
		childPrompt.Enabled = true
	end
	if record.child then
		record.child:SetAttribute("RescueState", "Available")
	end
	return true
end

--[[
    @summary  Attach one available child to an eligible player.
    @param    player  Player
    @param    caveId  string
    @returns  boolean
]]
function RescueService:TryCarryChild(player: Player, caveId: string): boolean
	local record = caveRecords[caveId]
	if not record or record.state ~= "Unlocked" or not record.child or carriedBy[player] then
		return false
	end
	if not playerLifeService:IsAlive(player) or record.carrier then
		return false
	end
	local character = player.Character
	local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
	local childRoot = record.child:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not playerRoot or not childRoot or not playerRoot:IsA("BasePart") or not childRoot:IsA("BasePart") or not humanoid then
		return false
	end
	if character:FindFirstChildOfClass("Tool") or (playerRoot.Position - childRoot.Position).Magnitude > PICKUP_RANGE then
		return false
	end

	childRoot.Anchored = false
	record.child:PivotTo(playerRoot.CFrame * CFrame.new(0, 0, 2.4))
	local weld = Instance.new("WeldConstraint")
	weld.Name = "ChildCarryWeld"
	weld.Part0 = playerRoot
	weld.Part1 = childRoot
	weld.Parent = childRoot
	record.carryWeld = weld
	record.carrier = player
	record.originalWalkSpeed = humanoid.WalkSpeed
	record.state = "Carried"
	carriedBy[player] = caveId
	humanoid.WalkSpeed = math.min(humanoid.WalkSpeed, CARRY_WALK_SPEED)
	character:SetAttribute("CarryingChild", caveId)
	record.child:SetAttribute("RescueState", "Carried")
	local prompt = record.child:FindFirstChild("RescueChildPrompt", true)
	if prompt then
		prompt.Enabled = false
	end
	broadcast(RescueService.Client.ChildCarryChanged, { userId = player.UserId, childId = caveId, carrying = true })
	return true
end

--[[
    @summary  Drop a player's carried child onto nearby ground.
    @param    player  Player
]]
function RescueService:DropCarriedChild(player: Player)
	local caveId = carriedBy[player]
	local record = caveId and caveRecords[caveId] or nil
	if not record or record.carrier ~= player then
		return
	end
	if record.carryWeld then
		record.carryWeld:Destroy()
		record.carryWeld = nil
	end
	local character = player.Character
	local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local childRoot = record.child and record.child:FindFirstChild("HumanoidRootPart")
	if humanoid and record.originalWalkSpeed then
		humanoid.WalkSpeed = record.originalWalkSpeed
	end
	if character then
		character:SetAttribute("CarryingChild", nil)
	end
	if childRoot and childRoot:IsA("BasePart") then
		childRoot.Anchored = true
		local dropPosition = groundPosition((playerRoot and playerRoot.Position or record.center) + Vector3.new(3, 0, 0))
		record.child:PivotTo(CFrame.new(dropPosition + Vector3.new(0, 3, 0)))
	end
	carriedBy[player] = nil
	record.carrier = nil
	record.state = "Unlocked"
	record.child:SetAttribute("RescueState", "Available")
	local prompt = record.child:FindFirstChild("RescueChildPrompt", true)
	if prompt then
		prompt.Enabled = true
	end
	broadcast(RescueService.Client.ChildCarryChanged, { userId = player.UserId, childId = caveId, carrying = false })
end

--[[
    @summary  Select the nearest available child cave for one player.
    @param    player  Player
]]
function RescueService:SelectBoardTarget(player: Player)
	if not campfireService:IsLit() then
		return
	end
	local rootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not rootPart or not rootPart:IsA("BasePart") or not posterBoard or (rootPart.Position - posterBoard.Position).Magnitude > PICKUP_RANGE then
		return
	end
	local nearestRecord = nil
	local nearestDistance = math.huge
	for _, record in pairs(caveRecords) do
		if record.state ~= "Locked" and record.state ~= "Rescued" then
			local distance = (record.center - rootPart.Position).Magnitude
			if distance < nearestDistance then
				nearestDistance = distance
				nearestRecord = record
			end
		end
	end
	if nearestRecord then
		RescueService.Client.WaypointChanged:Fire(player, {
			childId = nearestRecord.definition.Id,
			displayName = nearestRecord.definition.DisplayName,
			position = nearestRecord.center,
		})
	else
		RescueService.Client.WaypointChanged:Fire(player, { cleared = true })
	end
end

--[[
    @summary  Client request to drop the caller's carried child.
    @param    player  Player  -- injected by Knit
    @returns  boolean
]]
function RescueService.Client:RequestDropChild(player: Player): boolean
	local now = os.clock()
	if dropCooldowns[player] and now - dropCooldowns[player] < DROP_COOLDOWN then
		return false
	end
	dropCooldowns[player] = now
	if not carriedBy[player] then
		return false
	end
	RescueService:DropCarriedChild(player)
	return true
end

--[[
    @summary  Client request to select a child from the camp board.
    @param    player  Player  -- injected by Knit
]]
function RescueService.Client:RequestBoardTarget(player: Player)
	RescueService:SelectBoardTarget(player)
end

--[[
    @summary  Return a client-safe rescue snapshot.
    @param    player  Player  -- injected by Knit
    @returns  table
]]
function RescueService.Client:GetSnapshot(player: Player): { [string]: any }
	local records = {}
	for rescueId, record in pairs(caveRecords) do
		records[rescueId] = {
			state = record.state,
			displayName = record.definition.DisplayName,
			position = record.center,
			requiredCampfireLevel = record.definition.RequiredCampfireLevel,
		}
	end
	return { records = records, rescuedCount = rescuedCount, carrying = carriedBy[player] }
end

-- // INITIALIZATION // --

function RescueService:KnitStart()
	runStateService = Knit.GetService("RunStateService")
	worldService = Knit.GetService("WorldService")
	campfireService = Knit.GetService("CampfireService")
	animalAIService = Knit.GetService("AnimalAIService")
	playerLifeService = Knit.GetService("PlayerLifeService")
	timeService = Knit.GetService("TimeService")

	runStateService.RunStarted:Connect(function()
		buildCaves()
		createPosterBoard()
		unlockForLevel(campfireService:GetLevel())
		if not heartbeatConnection then
			heartbeatConnection = RunService.Heartbeat:Connect(onHeartbeat)
		end
	end)
	campfireService.LevelChangedServer:Connect(function(level)
		unlockForLevel(level)
	end)
	animalAIService.NpcDiedServer:Connect(onNpcDied)
	playerLifeService.PlayerDowned:Connect(function(player)
		RescueService:DropCarriedChild(player)
		for caveId in pairs(keyOwners[player] or {}) do
			local record = caveRecords[caveId]
			if record then
				spawnKey(record)
			end
		end
		keyOwners[player] = nil
	end)
	runStateService.RunCleaned:Connect(function()
		caveRecords = {}
		carriedBy = {}
		keyOwners = {}
		posterBoard = nil
		cavesFolder = nil
		tentsFolder = nil
		if heartbeatConnection then
			heartbeatConnection:Disconnect()
			heartbeatConnection = nil
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		RescueService:DropCarriedChild(player)
		for caveId in pairs(keyOwners[player] or {}) do
			local record = caveRecords[caveId]
			if record then
				spawnKey(record)
			end
		end
		keyOwners[player] = nil
		dropCooldowns[player] = nil
	end)
end

return RescueService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="101">
          <Properties>
            <string name="Name">RunStateService</string>
            <string name="Source"><![CDATA[--[[
    @file    RunStateService.luau
    @author  manik
    @date    2025

    @summary
    Authoritative owner of one forest run: lifecycle phase, run token,
    membership, day multiplier, run statistics, and per-run cleanup.

    @description
    Every Phase 4 system asks this service whether a run is active and
    whether a captured token is still current before mutating state.
    Run-scoped profile tables are cleared when a run starts and again
    when it ends, so a finished camp never carries into the next run.

    @exports
    - RunStateService:GetRunId()                 -> string
    - RunStateService:GetPhase()                 -> RunPhase
    - RunStateService:IsActive()                 -> boolean
    - RunStateService:IsCurrentRun(runId)        -> boolean
    - RunStateService:IsMember(player)           -> boolean
    - RunStateService:StartRun(players)          -> string?
    - RunStateService:EndRun(reason, payload)
    - RunStateService:GetRuntimeFolder()         -> Folder
    - RunStateService:AddMultiplierSource(key, amount)
    - RunStateService:GetMultiplier()            -> number
    - RunStateService:IncrementStat(player, key, amount)
    - Knit Signal: RunPhaseChanged(phase, payload)
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local Signal = require(ReplicatedStorage.Packages.Signal)
local RunConfig = require(ReplicatedStorage.Shared.RunConfig)

-- | Objects | --
local RunStateService = Knit.CreateService({
	Name = "RunStateService",
	Client = {
		RunPhaseChanged = Knit.CreateSignal(),
		MultiplierChanged = Knit.CreateSignal(),
		RunEnded = Knit.CreateSignal(),
	},
})

export type RunPhase = "Lobby" | "Starting" | "Active" | "Ending" | "Ended"

RunStateService.PhaseChanged = Signal.new()
RunStateService.RunStarted = Signal.new()
RunStateService.RunEnding = Signal.new()
RunStateService.RunCleaned = Signal.new()

-- | Configuration | --
local RUNTIME_FOLDER_NAME = "Runtime"
local RUN_SCOPED_PROFILE_KEYS = { "Resources", "Base", "Rescue", "Stats", "Campfire", "Inventory" }

-- | State Management | --
local playerDataService: any = nil
local timeService: any = nil
local spawnService: any = nil
local campfireService: any = nil
local animalAIService: any = nil

local runId = ""
local phase: RunPhase = "Lobby"
local runStartedAt = 0
local members: { [Player]: boolean } = {}
local multiplierSources: { [string]: number } = {}
local runtimeFolder: Folder? = nil
local cleanupCallbacks: { () -> () } = {}

-- // FUNCTIONS // --

-- | Private | --

--[[
    @summary  Return a fresh copy of a run-scoped profile table.
    @param    key  string  -- top-level profile table name
    @returns  table
]]
local function freshRunTable(key: string): { [string]: any }
	if key == "Resources" then
		return {
			Wood = 0,
			Scrap = 0,
			Coal = 0,
			Berries = 0,
			Mushrooms = 0,
			RawMeat = 0,
			RabbitMeat = 0,
			CookedMeat = 0,
			OwlFeather = 0,
			CultistGem = 0,
			Bandage = 0,
		}
	elseif key == "Base" then
		return { BedCount = 0, DayMultiplier = 1, UnlockedStructures = {} }
	elseif key == "Rescue" then
		return { ChildrenRescued = {}, CavesUnlocked = {} }
	elseif key == "Stats" then
		return {
			TreesChopped = 0,
			WolvesKilled = 0,
			CultistsKilled = 0,
			StructuresBuilt = 0,
			ChildrenRescued = 0,
			Revives = 0,
			Downs = 0,
			TotalPlaytime = 0,
		}
	elseif key == "Campfire" then
		return { Level = 1, Progress = 0, Fuel = 0 }
	end
	return { HasBag = true, PickupOrder = {} }
end

--[[
    @summary  Reset every run-scoped table on one player's profile.
    @param    player  Player
]]
local function resetPlayerRunData(player: Player)
	if not playerDataService then
		return
	end
	playerDataService:UpdateData(player, function(data)
		for _, key in ipairs(RUN_SCOPED_PROFILE_KEYS) do
			data[key] = freshRunTable(key)
		end
		data.Survival = data.Survival or {}
		data.Survival.Health = RunConfig.StartingHealth
		data.Survival.MaxHealth = RunConfig.StartingHealth
		data.Survival.Hunger = RunConfig.StartingHunger
		data.Survival.MaxHunger = RunConfig.StartingHunger
	end)
end

--[[
    @summary  Create or reuse the folder that holds all run instances.
    @returns  Folder
]]
local function ensureRuntimeFolder(): Folder
	if runtimeFolder and runtimeFolder.Parent then
		return runtimeFolder
	end
	local existing = workspace:FindFirstChild(RUNTIME_FOLDER_NAME)
	if existing and existing:IsA("Folder") then
		runtimeFolder = existing
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = RUNTIME_FOLDER_NAME
	folder.Parent = workspace
	runtimeFolder = folder
	return folder
end

--[[
    @summary  Broadcast the current lifecycle phase to every member.
    @param    payload  table?  -- optional extra state for clients
]]
local function broadcastPhase(payload: { [string]: any }?)
	local data = payload or {}
	data.phase = phase
	data.runId = runId
	for _, player in ipairs(Players:GetPlayers()) do
		RunStateService.Client.RunPhaseChanged:Fire(player, data)
	end
	RunStateService.PhaseChanged:Fire(phase, data)
end

-- | Public | --

--[[
    @summary  Return the identifier of the current run.
    @returns  string
]]
function RunStateService:GetRunId(): string
	return runId
end

--[[
    @summary  Return the current lifecycle phase.
    @returns  RunPhase
]]
function RunStateService:GetPhase(): RunPhase
	return phase
end

--[[
    @summary  Return whether gameplay actions are currently permitted.
    @returns  boolean
]]
function RunStateService:IsActive(): boolean
	return phase == "Active"
end

--[[
    @summary  Return whether a captured token still matches the live run.
    @param    token  string?
    @returns  boolean
]]
function RunStateService:IsCurrentRun(token: string?): boolean
	return token ~= nil and token == runId and runId ~= ""
end

--[[
    @summary  Return whether a player belongs to the current run.
    @param    player  Player
    @returns  boolean
]]
function RunStateService:IsMember(player: Player): boolean
	return members[player] == true
end

--[[
    @summary  Return every player still participating in the run.
    @returns  { Player }
]]
function RunStateService:GetMembers(): { Player }
	local list = {}
	for player in pairs(members) do
		if player.Parent then
			table.insert(list, player)
		end
	end
	return list
end

--[[
    @summary  Return the folder that owns all run-created instances.
    @returns  Folder
]]
function RunStateService:GetRuntimeFolder(): Folder
	return ensureRuntimeFolder()
end

--[[
    @summary  Register work that must run when the current run is cleaned.
    @param    callback  function
]]
function RunStateService:AddCleanupTask(callback: () -> ())
	table.insert(cleanupCallbacks, callback)
end

--[[
    @summary  Return the number of seconds the run has been going.
    @returns  number
]]
function RunStateService:GetElapsedSeconds(): number
	if runStartedAt <= 0 then
		return 0
	end
	return os.clock() - runStartedAt
end

--[[
    @summary  Set how many multiplier points one named source contributes.
    @param    key     string  -- unique source identifier
    @param    amount  number  -- points contributed by that source
]]
function RunStateService:AddMultiplierSource(key: string, amount: number)
	if typeof(key) ~= "string" or typeof(amount) ~= "number" then
		return
	end
	multiplierSources[key] = math.max(0, math.floor(amount))

	local multiplier = self:GetMultiplier()
	for _, player in ipairs(Players:GetPlayers()) do
		RunStateService.Client.MultiplierChanged:Fire(player, {
			multiplier = multiplier,
			sources = table.clone(multiplierSources),
		})
	end
end

--[[
    @summary  Return the active day multiplier from all live sources.
    @returns  number
]]
function RunStateService:GetMultiplier(): number
	local total = RunConfig.BaseMultiplier
	for _, amount in pairs(multiplierSources) do
		total += amount
	end
	return math.clamp(total, RunConfig.BaseMultiplier, RunConfig.MaxMultiplier)
end

--[[
    @summary  Return a copy of the current multiplier contributions.
    @returns  table
]]
function RunStateService:GetMultiplierSources(): { [string]: number }
	return table.clone(multiplierSources)
end

--[[
    @summary  Increase one run statistic for a player.
    @param    player  Player
    @param    key     string
    @param    amount  number?
]]
function RunStateService:IncrementStat(player: Player, key: string, amount: number?)
	if not playerDataService or not player.Parent then
		return
	end
	local delta = amount or 1
	playerDataService:UpdateData(player, function(data)
		data.Stats = data.Stats or freshRunTable("Stats")
		data.Stats[key] = (data.Stats[key] or 0) + delta
	end)
end

--[[
    @summary  Add a player to the live run without restarting it.
    @param    player  Player
]]
function RunStateService:AddMember(player: Player)
	if phase == "Lobby" or phase == "Ended" then
		return
	end
	members[player] = true
end

--[[
    @summary  Begin a new run for the given players.
    @param    participants  { Player }
    @returns  string?  -- the new run identifier, or nil when refused
]]
function RunStateService:StartRun(participants: { Player }): string?
	if phase == "Active" or phase == "Starting" or phase == "Ending" then
		return nil
	end
	if #participants == 0 or not playerDataService then
		return nil
	end
	for _, player in ipairs(participants) do
		if not player.Parent or not playerDataService:GetData(player) then
			return nil
		end
	end

	runId = HttpService:GenerateGUID(false)
	phase = "Starting"
	runStartedAt = os.clock()
	members = {}
	multiplierSources = {}
	cleanupCallbacks = {}

	for _, player in ipairs(participants) do
		if player.Parent then
			members[player] = true
			resetPlayerRunData(player)
		end
	end

	ensureRuntimeFolder()
	if campfireService then
		campfireService:ResetForRun()
	end
	if animalAIService then
		animalAIService:ResetForRun()
	end
	broadcastPhase({ startedAt = runStartedAt })
	RunStateService.RunStarted:Fire(runId)

	phase = "Active"
	broadcastPhase({ startedAt = runStartedAt })

	return runId
end

--[[
    @summary  Move the run into its ending sequence exactly once.
    @param    reason   string
    @param    payload  table?
    @returns  boolean  -- true when this call performed the transition
]]
function RunStateService:BeginEnding(reason: string, payload: { [string]: any }?): boolean
	if phase ~= "Active" then
		return false
	end

	phase = "Ending"

	local data = payload or {}
	data.reason = reason
	data.elapsedSeconds = self:GetElapsedSeconds()
	data.multiplier = self:GetMultiplier()

	broadcastPhase(data)
	RunStateService.RunEnding:Fire(reason, data)

	return true
end

--[[
    @summary  Destroy run-owned state and return the server to the lobby.
    @param    reason  string
]]
function RunStateService:CleanupRun(reason: string)
	if phase == "Lobby" then
		return
	end

	phase = "Ended"

	for _, callback in ipairs(cleanupCallbacks) do
		local ok, err = pcall(callback)
		if not ok then
			warn("[RunStateService] Cleanup task failed:", err)
		end
	end
	cleanupCallbacks = {}

	if runtimeFolder then
		runtimeFolder:Destroy()
		runtimeFolder = nil
	end

	if timeService then
		timeService:ResetMatch()
	end

	for player in pairs(members) do
		if player.Parent then
			resetPlayerRunData(player)
			if spawnService then
				spawnService:ResetPlayer(player)
			end
		end
	end

	members = {}
	multiplierSources = {}
	runStartedAt = 0
	runId = ""
	phase = "Lobby"

	broadcastPhase({ reason = reason })
	RunStateService.RunCleaned:Fire(reason)
end

--[[
    @summary  Client-facing snapshot of the run for HUD binding.
    @param    player  Player  -- injected by Knit
    @returns  table
]]
function RunStateService.Client:GetSnapshot(player: Player): { [string]: any }
	return {
		runId = runId,
		phase = phase,
		isMember = members[player] == true,
		multiplier = RunStateService:GetMultiplier(),
		sources = table.clone(multiplierSources),
		goalDay = RunConfig.GoalDay,
		elapsedSeconds = RunStateService:GetElapsedSeconds(),
	}
end

-- // INITIALIZATION // --

function RunStateService:KnitStart()
	playerDataService = Knit.GetService("PlayerDataService")
	timeService = Knit.GetService("TimeService")
	spawnService = Knit.GetService("SpawnService")
	campfireService = Knit.GetService("CampfireService")
	animalAIService = Knit.GetService("AnimalAIService")

	if timeService then
		timeService:SetMultiplierProvider(function()
			return RunStateService:GetMultiplier()
		end)
	end

	Players.PlayerRemoving:Connect(function(player)
		members[player] = nil
	end)
end

return RunStateService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="102">
          <Properties>
            <string name="Name">SpawnService</string>
            <string name="Source"><![CDATA[--[[
    @file    SpawnService.luau
    @author  manik
    @date    2025

    @summary
    Server-authoritative lobby-to-game teleportation.

    @description
    Wires the lobby-map teleporter pads (Teleporter1/2/3 EnterPart)
    to teleport players to the base-map Campfire on touch.  Also
    exposes a Knit Remote for programmatic spawn requests.

    @exports
    - Knit Remote: RequestSpawn  -> void  (client -> server)
    - SpawnService:SpawnPlayer(player)    (server only)
]]

-- // VARIABLES // --

-- | Services | --
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local Signal = require(ReplicatedStorage.Packages.Signal)
local RunConfig = require(ReplicatedStorage.Shared.RunConfig)

-- | Objects | --
local SpawnService = Knit.CreateService({
	Name = "SpawnService",
	Client = {
		RequestSpawn = Knit.CreateSignal(),
		PlayerSpawned = Knit.CreateSignal(),
	},
})

SpawnService.PlayerSpawned = Signal.new()

-- | Configuration | --
local SPAWN_RADIUS = 15
local SPAWN_HEIGHT = 5
local TELEPORT_COOLDOWN = 5

-- | State Management | --
local worldService: any = nil
local matchFlowService: any = nil
local runStateService: any = nil
local spawnedPlayers: { [Player]: boolean } = {}
local teleportCooldowns: { [Player]: number } = {}

-- // FUNCTIONS // --

--[[
    @summary  Teleport a player's character to a random point around the Campfire.
    @desc    Uses math.random so players do not stack on each other.
             Server-authoritative — the client cannot choose a position.
    @param   player  Player  -- the Roblox player
]]
function SpawnService:SpawnPlayer(player: Player)
	if spawnedPlayers[player] then
		return
	end

	local character = player.Character
	if not character then
		return
	end

	local primaryPart = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
	if not primaryPart then
		return
	end

	local campfireCFrame = worldService and worldService:GetCampfireCFrame() or nil
	if not campfireCFrame then
		warn("[SpawnService] Campfire CFrame not available")
		return
	end

	local angle = math.random() * math.pi * 2
	local offsetX = math.cos(angle) * SPAWN_RADIUS
	local offsetZ = math.sin(angle) * SPAWN_RADIUS

	local targetCFrame = campfireCFrame * CFrame.new(offsetX, SPAWN_HEIGHT, offsetZ)
	primaryPart.CFrame = targetCFrame

	spawnedPlayers[player] = true
	SpawnService.Client.PlayerSpawned:Fire(player)
	SpawnService.PlayerSpawned:Fire(player)
end

--[[
    @summary  Wire all teleporter EnterParts in the lobby-map for touch teleport.
    @desc    Finds Teleporter1/2/3 models in the lobby-map and connects
             Touched events on their EnterPart children.  When a player
             touches an EnterPart, they are teleported to the base-map.
]]
local function wireTeleporters()
	if not worldService then
		task.defer(wireTeleporters)
		return
	end
	local lobbyMap = worldService:GetLobbyMap()
	if not lobbyMap then
		task.defer(wireTeleporters)
		return
	end

	for _, child in ipairs(lobbyMap:GetChildren()) do
		if child:IsA("Model") and child.Name:match("^Teleporter%d") then
			-- Connect Touched on ALL EnterPart children (each teleporter has 4)
			for _, desc in ipairs(child:GetDescendants()) do
				if desc.Name == "EnterPart" and desc:IsA("BasePart") then
					desc.Touched:Connect(function(hit)
						local character = hit:FindFirstAncestorOfClass("Model")
						if not character then return end
						local player = Players:GetPlayerFromCharacter(character)
						if not player then return end
						if spawnedPlayers[player] then return end

						local now = os.clock()
						if teleportCooldowns[player] and (now - teleportCooldowns[player]) < TELEPORT_COOLDOWN then
							return
						end
						teleportCooldowns[player] = now

						-- Move the player inside the teleporter box instantly before the UI opens.
						local teleporter = desc:FindFirstAncestorOfClass("Model")
						local destination = teleporter and teleporter:FindFirstChild("TeleportHere")
						if destination and destination:IsA("BasePart") then
							local hrp = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
							if hrp then
								hrp.CFrame = destination.CFrame * CFrame.new(0, 3, 0)
								local humanoid = character:FindFirstChildOfClass("Humanoid")
								if humanoid then
									humanoid:Move(Vector3.new(), true)
								end
							end
						end

						if matchFlowService then
							matchFlowService:EnterWaiting(player)
						else
							SpawnService:SpawnPlayer(player)
						end
					end)
				end
			end
		end
	end
end

--[[
    @summary  Client-facing remote requesting teleportation to the game map.
    @desc    The server validates that the player has not already spawned
             and that a character exists before teleporting.
    @param   player  Player  -- injected by Knit
]]
function SpawnService.Client:RequestSpawn(player: Player)
	if matchFlowService then
		matchFlowService:EnterWaiting(player)
	else
		self.Server:SpawnPlayer(player)
	end
end

--[[
    @summary  Check whether a player has been teleported to the game map.
    @param    player  Player
    @returns  boolean
]]
function SpawnService:IsPlayerSpawned(player: Player): boolean
	return spawnedPlayers[player] == true
end

-- // INITIALIZATION // --

--[[
    @summary  Clear the spawned flag so a player can join the next run.
    @param    player  Player
]]
function SpawnService:ResetPlayer(player: Player)
	spawnedPlayers[player] = nil
	teleportCooldowns[player] = nil
end

--[[
    @summary  Move an existing character back to a safe lobby position.
    @param    player  Player
    @returns  boolean
]]
function SpawnService:ReturnToLobby(player: Player): boolean
	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	local lobbyMap = worldService and worldService:GetLobbyMap()
	if not rootPart or not rootPart:IsA("BasePart") or not lobbyMap then
		return false
	end
	local destination = lobbyMap:FindFirstChild("TeleportHere", true)
	local targetCFrame = if destination and destination:IsA("BasePart")
		then destination.CFrame * CFrame.new(0, 4, 0)
		else lobbyMap:GetPivot() * CFrame.new(0, 8, 0)
	rootPart.Anchored = false
	rootPart.CFrame = targetCFrame
	self:ResetPlayer(player)
	return true
end

--[[
    @summary  Studio-only shortcut that skips the lobby and starts a run.
    @param    player  Player
]]
local function autoSpawnPlayer(player: Player)
	if not RunConfig.IsTestEnabled("SkipLobby") then
		return
	end
	if spawnedPlayers[player] then
		return
	end

	if not player.Character then
		player.CharacterAdded:Wait()
	end
	task.wait(0.5)

	if not player.Parent then
		return
	end

	if runStateService and runStateService:GetPhase() == "Lobby" then
		local startedRunId = nil
		for _ = 1, 30 do
			startedRunId = runStateService:StartRun({ player })
			if startedRunId or not player.Parent or runStateService:GetPhase() ~= "Lobby" then
				break
			end
			task.wait(0.5)
		end
		if not startedRunId and runStateService:GetPhase() == "Lobby" then
			warn("[SpawnService] Studio test could not start because the profile was not ready")
			return
		end
	end
	SpawnService:SpawnPlayer(player)

	local timeService = Knit.GetService("TimeService")
	if timeService and not timeService:IsRunning() then
		timeService:StartMatch()
	end

	task.wait(1)

	if not player.Parent then
		return
	end

	if RunConfig.IsTestEnabled("ForceNight") then
		local Lighting = game:GetService("Lighting")
		Lighting.ClockTime = 0
		Lighting.Ambient = Color3.fromRGB(20, 22, 32)
		Lighting.OutdoorAmbient = Color3.fromRGB(12, 14, 20)
		Lighting.Brightness = 0.35
	end

	if matchFlowService then
		matchFlowService.Client.FlowStateChanged:Fire(player, "InGame")
	end
end

function SpawnService:KnitStart()
	worldService = Knit.GetService("WorldService")
	matchFlowService = Knit.GetService("MatchFlowService")
	runStateService = Knit.GetService("RunStateService")
	wireTeleporters()

	if RunConfig.IsTestEnabled("SkipLobby") then
		warn("[SpawnService] Studio test: SkipLobby is enabled")
		task.delay(1, function()
			for _, player in ipairs(Players:GetPlayers()) do
				task.spawn(autoSpawnPlayer, player)
			end
		end)
		Players.PlayerAdded:Connect(function(player)
			task.spawn(autoSpawnPlayer, player)
		end)
	end
end

Players.PlayerRemoving:Connect(function(player)
	spawnedPlayers[player] = nil
	teleportCooldowns[player] = nil
end)

return SpawnService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="103">
          <Properties>
            <string name="Name">TimeService</string>
            <string name="Source"><![CDATA[--[[
    @file    TimeService.luau
    @author  manik
    @date    2025

    @summary
    Server-authoritative day/night cycle controller.

    @description
    Advances in-game time via a Heartbeat loop, fires Knit Signals
    when day or night begins, and drives Lighting transitions with
    TweenService for smooth visual changes.

    The clock stays paused until StartMatch() so lobby time does not
    consume Day 1.

    @exports
    - TimeService.DayStarted    (Knit Signal)
    - TimeService.NightStarted  (Knit Signal)
    - TimeService:GetCurrentPhase()  -> "Day" | "Night"
    - TimeService:GetClockTime()     -> number
    - TimeService:StartMatch()       -- begins the day/night clock
]]

-- // VARIABLES // --

-- | Services | --
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local RunConfig = require(ReplicatedStorage.Shared.RunConfig)

-- | Objects | --
local TimeService = Knit.CreateService({
	Name = "TimeService",
	Client = {
		DayStarted = Knit.CreateSignal(),
		NightStarted = Knit.CreateSignal(),
		DawnAdvanced = Knit.CreateSignal(),
		GetPhaseState = Knit.CreateProperty("Day"),
	},
})

-- | Configuration | --
local DAY_START_CLOCK = RunConfig.DayStartClock
local DAY_END_CLOCK = RunConfig.DayEndClock
local DAY_AMBIENT = Color3.fromRGB(128, 128, 128)
local NIGHT_AMBIENT = Color3.fromRGB(20, 22, 32)
local DAY_OUTDOOR_AMBIENT = Color3.fromRGB(128, 128, 128)
local NIGHT_OUTDOOR_AMBIENT = Color3.fromRGB(12, 14, 20)
local DAY_BRIGHTNESS = 1
local NIGHT_BRIGHTNESS = 0.35
local DAY_FOG_END = 100000
local NIGHT_FOG_END = 80
local TWEEN_DURATION = 8

-- | State Management | --
local currentPhase: "Day" | "Night" = "Day"
local phaseTimer = 0
local clockTime = DAY_START_CLOCK
local cycleIndex = 1
local displayedDay = 1
local isRunning = false
local heartbeatConnection: RBXScriptConnection? = nil
local multiplierProvider: (() -> number)? = nil
local dawnListeners: { (payload: { [string]: any }) -> () } = {}

-- // FUNCTIONS // --

--[[
    @summary  Return the current phase string.
    @returns  "Day" | "Night"
]]
function TimeService:GetCurrentPhase(): string
	return currentPhase
end

--[[
    @summary  Return the current in-game clock time (0–24).
    @returns  number
]]
function TimeService:GetClockTime(): number
	return clockTime
end

--[[
    @summary  Return how many night cycles have actually been played.
    @desc     Scheduling (raids, entity unlocks, spawn scaling) must use
              this value, never the displayed progress value.
    @returns  number
]]
function TimeService:GetCycleIndex(): number
	return cycleIndex
end

--[[
    @summary  Return the survival progress value shown to players.
    @returns  number
]]
function TimeService:GetDisplayedDay(): number
	return displayedDay
end

--[[
    @summary  Return the scheduling cycle index.
    @returns  number
]]
function TimeService:GetDayNumber(): number
	return cycleIndex
end

function TimeService.Client:GetDayNumber(_player: Player): number
	return displayedDay
end

function TimeService.Client:GetProgress(_player: Player): { [string]: any }
	return {
		displayedDay = displayedDay,
		cycleIndex = cycleIndex,
		goalDay = RunConfig.GoalDay,
		phase = currentPhase,
	}
end

function TimeService:IsRunning(): boolean
	return isRunning
end

--[[
    @summary  Pause the clock without resetting run progress.
]]
function TimeService:Pause()
	isRunning = false
end

--[[
    @summary  Register the source of the current day multiplier.
    @param    provider  function  -- returns the current multiplier
]]
function TimeService:SetMultiplierProvider(provider: () -> number)
	multiplierProvider = provider
end

--[[
    @summary  Register a server listener for dawn progression.
    @param    listener  function  -- receives the dawn payload
]]
function TimeService:OnDawn(listener: (payload: { [string]: any }) -> ())
	table.insert(dawnListeners, listener)
end

--[[
    @summary  Return the currently active day multiplier.
    @returns  number
]]
local function getMultiplier(): number
	if not multiplierProvider then
		return RunConfig.BaseMultiplier
	end
	local ok, value = pcall(multiplierProvider)
	if not ok or typeof(value) ~= "number" then
		return RunConfig.BaseMultiplier
	end
	return math.clamp(math.floor(value), RunConfig.BaseMultiplier, RunConfig.MaxMultiplier)
end

--[[
    @summary  Tween Lighting properties to day values.
]]
local function transitionToDay()
	local tweenInfo = TweenInfo.new(TWEEN_DURATION, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	TweenService:Create(Lighting, tweenInfo, {
		Ambient = DAY_AMBIENT,
		OutdoorAmbient = DAY_OUTDOOR_AMBIENT,
		Brightness = DAY_BRIGHTNESS,
		FogEnd = DAY_FOG_END,
	}):Play()
end

--[[
    @summary  Tween Lighting properties to night values.
]]
local function transitionToNight()
	local tweenInfo = TweenInfo.new(TWEEN_DURATION, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	TweenService:Create(Lighting, tweenInfo, {
		Ambient = NIGHT_AMBIENT,
		OutdoorAmbient = NIGHT_OUTDOOR_AMBIENT,
		Brightness = NIGHT_BRIGHTNESS,
		FogEnd = NIGHT_FOG_END,
	}):Play()
end

--[[
    @summary  Broadcast a signal to all clients.
    @desc    Knit signals do not have FireAll, so we iterate players.
    @param   signal  KnitSignal
]]
local function broadcastSignal(signal, ...)
	for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
		signal:Fire(player, ...)
	end
end

--[[
    @summary  Switch to the day phase and apply survival progression.
]]
local function startDay()
	currentPhase = "Day"
	phaseTimer = 0
	cycleIndex += 1

	local multiplier = getMultiplier()
	local previousDay = displayedDay
	displayedDay = math.min(RunConfig.GoalDay, displayedDay + multiplier)

	transitionToDay()
	TimeService.Client.GetPhaseState:Set("Day")

	local payload = {
		previousDay = previousDay,
		displayedDay = displayedDay,
		cycleIndex = cycleIndex,
		multiplier = multiplier,
		goalDay = RunConfig.GoalDay,
		reachedGoal = displayedDay >= RunConfig.GoalDay,
	}

	broadcastSignal(TimeService.Client.DayStarted, cycleIndex)
	broadcastSignal(TimeService.Client.DawnAdvanced, payload)

	for _, listener in ipairs(dawnListeners) do
		task.spawn(listener, payload)
	end
end

--[[
    @summary  Switch to the night phase.
]]
local function startNight()
	currentPhase = "Night"
	phaseTimer = 0
	transitionToNight()
	TimeService.Client.GetPhaseState:Set("Night")
	broadcastSignal(TimeService.Client.NightStarted, cycleIndex)
end

--[[
    @summary  Heartbeat-driven time advancement.
    @param   dt  number  -- delta time in seconds
]]
local function onHeartbeat(dt: number)
	if not isRunning then
		return
	end

	phaseTimer += dt

	local duration = RunConfig.GetPhaseDuration(currentPhase)
	local progress = phaseTimer / duration
	clockTime = if currentPhase == "Day"
		then DAY_START_CLOCK + (DAY_END_CLOCK - DAY_START_CLOCK) * progress
		else (DAY_END_CLOCK + (DAY_END_CLOCK - DAY_START_CLOCK) * progress) % 24

	Lighting.ClockTime = clockTime

	if phaseTimer >= duration then
		if currentPhase == "Day" then
			startNight()
		else
			startDay()
		end
	end
end

local function applyDayLightingImmediate()
	Lighting.ClockTime = DAY_START_CLOCK
	Lighting.Ambient = DAY_AMBIENT
	Lighting.OutdoorAmbient = DAY_OUTDOOR_AMBIENT
	Lighting.Brightness = DAY_BRIGHTNESS
	Lighting.FogEnd = DAY_FOG_END
end

--[[
    @summary  Begin the day/night clock at the start of a run.
    @desc    Idempotent while already running.
]]
function TimeService:StartMatch()
	if isRunning then
		return
	end

	isRunning = true
	currentPhase = "Day"
	phaseTimer = 0
	clockTime = DAY_START_CLOCK
	cycleIndex = 1
	displayedDay = 1
	applyDayLightingImmediate()
	TimeService.Client.GetPhaseState:Set("Day")
	broadcastSignal(TimeService.Client.DayStarted, cycleIndex)
	broadcastSignal(TimeService.Client.DawnAdvanced, {
		previousDay = 1,
		displayedDay = 1,
		cycleIndex = 1,
		multiplier = getMultiplier(),
		goalDay = RunConfig.GoalDay,
		reachedGoal = false,
	})

	if not heartbeatConnection then
		heartbeatConnection = RunService.Heartbeat:Connect(onHeartbeat)
	end
end

--[[
    @summary  Stop the clock and restore the pre-run lighting baseline.
]]
function TimeService:ResetMatch()
	isRunning = false
	currentPhase = "Day"
	phaseTimer = 0
	clockTime = DAY_START_CLOCK
	cycleIndex = 1
	displayedDay = 1
	applyDayLightingImmediate()
	TimeService.Client.GetPhaseState:Set("Day")
	if heartbeatConnection then
		heartbeatConnection:Disconnect()
		heartbeatConnection = nil
	end
end

-- // INITIALIZATION // --

Lighting.ClockTime = DAY_START_CLOCK
Lighting.Ambient = DAY_AMBIENT
Lighting.OutdoorAmbient = DAY_OUTDOOR_AMBIENT
Lighting.Brightness = DAY_BRIGHTNESS
Lighting.FogEnd = DAY_FOG_END

return TimeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="104">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[--[[
    @file    WorldService.luau
    @author  manik
    @date    2025

    @summary
    Manages pre-placed game maps and the campfire anchor.

    @description
    Finds the lobby-map and base-map pre-placed in Workspace at server
    start.  Places the visual Bonfire model at the centre of the base-map
    and creates an invisible Campfire anchor part for SpawnService to
    reference.

    @exports
    - WorldService:GetLobbyMap()    -> Model
    - WorldService:GetBaseMap()     -> Model
    - WorldService:GetCampfire()    -> Part
    - WorldService:GetCampfireCFrame() -> CFrame
]]

-- // VARIABLES // --

-- | Services | --
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- | Modules | --
local Knit = require(ReplicatedStorage.Packages.Knit)
local Constants = require(ReplicatedStorage.Shared.Constants)

-- | Objects | --
local WorldService = Knit.CreateService({
	Name = "WorldService",
	Client = {},
})

-- | Configuration | --
local ITEMS_PATH = ServerStorage.Assets[Constants.ITEMS_PATH]
local CAMPFIRE_SIZE = Vector3.new(6, 3, 6)
local GROUND_RAY_HEIGHT = 500
local BONFIRE_SCALE = 2

-- | State Management | --
local lobbyMap: Model? = nil
local baseMap: Model? = nil
local campfire: Part? = nil
local bonfire: Model? = nil
local forestReady: boolean = false

-- // FUNCTIONS // --

--[[
    @summary  Return the lobby map model.
    @returns  Model?
]]
function WorldService:GetLobbyMap(): Model?
	return lobbyMap
end

--[[
    @summary  Return the base (game) map model.
    @returns  Model?
]]
function WorldService:GetBaseMap(): Model?
	return baseMap
end

--[[
    @summary  Return the Campfire anchor part.
    @returns  Part?
]]
function WorldService:GetCampfire(): Part?
	return campfire
end

--[[
    @summary  Return the visual Bonfire model.
    @returns  Model?
]]
function WorldService:GetBonfire(): Model?
	return bonfire
end

--[[
    @summary  Return whether forest generation has completed.
    @returns  boolean
]]
function WorldService:IsForestReady(): boolean
	return forestReady
end

--[[
    @summary  Return the CFrame of the Campfire anchor.
    @returns  CFrame?
]]
function WorldService:GetCampfireCFrame(): CFrame?
	if not campfire then return nil end
	return campfire.CFrame
end

--[[
    @summary  Find a pre-placed map in Workspace.
    @desc     Maps are pre-placed in Workspace at edit time so they are
              visible in Studio and don't need to be cloned at runtime.
              Roblox reverts Workspace to its edit-time state when play
              stops, so the clean map is always restored.
    @param    mapName  string  -- name of the model in Workspace
    @returns  Model?           -- the map model found in Workspace
]]
local function findMap(mapName: string): Model?
	local map = workspace:FindFirstChild(mapName)
	if not map then
		warn(("[WorldService] Map '%s' not found in Workspace"):format(mapName))
		return nil
	end
	return map
end

--[[
    @summary  Set a PrimaryPart on a cloned map if it doesn't have one.
    @desc     Picks the first BasePart in the model as PrimaryPart
              so that GetPivot() is deterministic.
    @param    map  Model  -- the cloned map
]]
local function ensurePrimaryPart(map: Model)
	if map.PrimaryPart then return end
	for _, descendant in ipairs(map:GetDescendants()) do
		if descendant:IsA("BasePart") then
			map.PrimaryPart = descendant
			return
		end
	end
end

--[[
    @summary  Find the ground-level CFrame at the map's centre.
    @desc     Locates the large ground baseplate (named "Земля") inside
              the map and returns a CFrame at its top surface centre.
              Falls back to raycasting from the map pivot if the
              ground part is not found.
    @param    map  Model  -- the cloned map
    @returns  CFrame       -- ground-level CFrame at map centre
]]
local function findGroundCFrame(map: Model): CFrame
	-- Strategy 1: find the ground baseplate by name
	for _, desc in ipairs(map:GetDescendants()) do
		if desc:IsA("BasePart") and desc.Name == "Земля" then
			local topY = desc.Position.Y + desc.Size.Y / 2
			return CFrame.new(desc.Position.X, topY, desc.Position.Z)
		end
	end

	-- Strategy 2: raycast from above the map pivot
	local pivot = map:GetPivot()
	local origin = CFrame.new(pivot.Position.X, GROUND_RAY_HEIGHT, pivot.Position.Z)
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Include
	rayParams.FilterDescendantsInstances = {map}
	local result = workspace:Raycast(origin.Position, Vector3.new(0, -GROUND_RAY_HEIGHT * 2, 0), rayParams)
	if result then
		return CFrame.new(result.Position.X, result.Position.Y, result.Position.Z)
	end

	-- Fallback: use the map pivot
	return pivot
end

--[[
    @summary  Create a Campfire anchor part at ground level on the base-map.
    @desc     The part is invisible and anchored; it exists solely as
              a CFrame reference for SpawnService.
    @param    map     Model   -- the cloned base-map
    @param    ground  CFrame  -- ground-level CFrame from findGroundCFrame
    @returns  Part
]]
local function createCampfire(map: Model, ground: CFrame): Part
	local part = Instance.new("Part")
	part.Name = "Campfire"
	part.Anchored = true
	part.CanCollide = false
	part.Transparency = 1
	part.Size = CAMPFIRE_SIZE
	part.CFrame = ground
	part.Parent = map
	return part
end

--[[
    @summary  Place the visual Bonfire model at the campfire anchor.
    @desc     If a Bonfire model was pre-placed in the map at edit time,
              reuses it (positioning, lighting, anchoring).  Otherwise
              clones one from Assets Items.  The bonfire's base is
              offset so it sits flush on the ground.
    @param    map     Model   -- the base-map
    @param    ground  CFrame  -- ground-level CFrame from findGroundCFrame
    @returns  Model?
]]
local function placeBonfire(map: Model, ground: CFrame): Model?
	-- Reuse an existing Bonfire if one was pre-placed in the map at edit time
	local existing = map:FindFirstChild("Bonfire")
	if existing and existing:IsA("Model") then
		-- Position it at ground level (in case the map was moved)
		local scaledPivot = existing:GetPivot()
		local minY = math.huge
		for _, desc in ipairs(existing:GetDescendants()) do
			if desc:IsA("BasePart") and desc.Position.Y < minY then
				minY = desc.Position.Y
			end
		end
		local bonfireBaseOffset = scaledPivot.Position.Y - minY
		existing:PivotTo(ground * CFrame.new(0, bonfireBaseOffset, 0))

		-- Add a PointLight for night-time visibility if not already present
		local lightPart = existing:FindFirstChildWhichIsA("BasePart", true)
		if lightPart and not lightPart:FindFirstChild("BonfireLight") then
			local pointLight = Instance.new("PointLight")
			pointLight.Name = "BonfireLight"
			pointLight.Color = Color3.fromRGB(255, 100, 40)
			pointLight.Range = 12
			pointLight.Brightness = 1
			pointLight.Parent = lightPart
		end

		-- Ensure all parts are anchored
		for _, desc in ipairs(existing:GetDescendants()) do
			if desc:IsA("BasePart") then
				desc.Anchored = true
			end
		end

		-- Create a large, nearly-invisible anchor so campfire prompts have a
		-- properly-sized BasePart parent (the tiny Fire part is too small).
		local firePart = existing:FindFirstChild("Fire")
		if firePart and firePart:IsA("BasePart") and not existing:FindFirstChild("PromptAnchor") then
			local promptAnchor = Instance.new("Part")
			promptAnchor.Name = "PromptAnchor"
			promptAnchor.CFrame = firePart.CFrame
			promptAnchor.Size = Vector3.new(2, 2, 2)
			promptAnchor.Transparency = 0.99
			promptAnchor.Color = Color3.fromRGB(100, 100, 100)
			promptAnchor.Material = Enum.Material.SmoothPlastic
			promptAnchor.Anchored = true
			promptAnchor.CanCollide = false
			promptAnchor.CanTouch = false
			promptAnchor.CanQuery = false
			promptAnchor.CastShadow = false
			promptAnchor.Parent = existing
		end

		return existing
	end

	-- No pre-placed Bonfire — clone one from Assets Items
	local source = ITEMS_PATH:FindFirstChild("Bonfire")
	if not source then
		warn("[WorldService] Bonfire model not found in Assets Items")
		return nil
	end
	local clone = source:Clone()
	clone.Name = "Bonfire"

	clone:ScaleTo(BONFIRE_SCALE)

	local scaledPivot = clone:GetPivot()
	local minY = math.huge
	for _, desc in ipairs(clone:GetDescendants()) do
		if desc:IsA("BasePart") and desc.Position.Y < minY then
			minY = desc.Position.Y
		end
	end
	local bonfireBaseOffset = scaledPivot.Position.Y - minY
	clone:PivotTo(ground * CFrame.new(0, bonfireBaseOffset, 0))

	local lightPart = clone:FindFirstChildWhichIsA("BasePart", true)
	if lightPart then
		local pointLight = Instance.new("PointLight")
		pointLight.Name = "BonfireLight"
		pointLight.Color = Color3.fromRGB(255, 100, 40)
		pointLight.Range = 12
		pointLight.Brightness = 1
		pointLight.Parent = lightPart
	end

	for _, desc in ipairs(clone:GetDescendants()) do
		if desc:IsA("BasePart") then
			desc.Anchored = true
		end
	end

	-- Create a large, nearly-invisible anchor so campfire prompts have a
	-- properly-sized BasePart parent (the tiny Fire part is too small).
	local firePart = clone:FindFirstChild("Fire")
	if firePart and firePart:IsA("BasePart") and not clone:FindFirstChild("PromptAnchor") then
		local promptAnchor = Instance.new("Part")
		promptAnchor.Name = "PromptAnchor"
		promptAnchor.CFrame = firePart.CFrame
		promptAnchor.Size = Vector3.new(2, 2, 2)
		promptAnchor.Transparency = 0.99
		promptAnchor.Color = Color3.fromRGB(100, 100, 100)
		promptAnchor.Material = Enum.Material.SmoothPlastic
		promptAnchor.Anchored = true
		promptAnchor.CanCollide = false
		promptAnchor.CanTouch = false
		promptAnchor.CanQuery = false
		promptAnchor.CastShadow = false
		promptAnchor.Parent = clone
	end

	clone.Parent = map
	return clone
end

--[[
    @summary  Disable known broken pre-existing scripts in map models.
    @desc     Some asset models contain Scripts that reference workspace
              paths that don't exist in our setup.  This disables them to
              prevent runtime errors.
    @param    map  Model  -- the map to clean
]]
local function disableBrokenScripts(map: Model)
	for _, descendant in ipairs(map:GetDescendants()) do
		if descendant:IsA("Script") or descendant:IsA("LocalScript") then
			local name = descendant.Name
			if name == "FireSystem" or name == "FridgeRightDoorScript" or name == "FridgeLeftDoorScript" or name == "Script" then
				descendant.Disabled = true
			end
		end
	end
end

-- // CLIENT REMOTES // --

--[[
    @summary  Client-facing remote returning the campfire's world position,
              so clients can compute distance locally instead of polling
              the server every frame.  Returns the invisible Campfire
              anchor, which is the same centre used by the safe-zone
              logic on the server and the player spawn point.
    @returns  Vector3?
]]
function WorldService.Client:GetCampfirePosition(): Vector3?
	if not campfire then
		return nil
	end
	return campfire.Position
end

-- // INITIALIZATION // --

function WorldService:KnitStart()
	lobbyMap = findMap("lobby-map")
	baseMap = findMap("Base-map")

	if lobbyMap then
		ensurePrimaryPart(lobbyMap)
		disableBrokenScripts(lobbyMap)
	end

	if baseMap then
		ensurePrimaryPart(baseMap)
		-- Map is pre-populated in edit mode (structures, trees, ground all
		-- permanently placed). Only create campfire/bonfire at runtime:
		local ground = findGroundCFrame(baseMap)
		campfire = createCampfire(baseMap, ground)
		bonfire = placeBonfire(baseMap, ground)
		forestReady = true
		disableBrokenScripts(baseMap)
	end
end

return WorldService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
